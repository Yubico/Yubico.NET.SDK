<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yubico.NativeShims" Version="[$(NativeShimsVersion)]" />
  </ItemGroup>

  <Target Name="RequireNativeShimsVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(NativeShimsVersion)' == ''"
           Text="NativeShimsVersion must be supplied as an exact package version." />
  </Target>
</Project>
