<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NativeShimsVersion Condition="'$(NativeShimsVersion)' == ''">1.17.2</NativeShimsVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yubico.NativeShims" Version="[$(NativeShimsVersion)]" />
  </ItemGroup>
</Project>
