{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "files": [
            "**/Yubico.Core.csproj"
          ],
          "src": "./Yubico.Core/src/"
        }
      ],
      "disableGitFeatures": true,
      "disableDefaultFilter": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "filter": "./docs/filterConfig.yml",
      "output": "./.docbuild/metadata/core-api",
      "properties": {
        "TargetFramework": "netstandard2.0",
        "NuGetLockFilePath": "obj/docfx.packages.lock.json"
      }
    },
    {
      "src": [
        {
          "files": [
            "**/Yubico.YubiKey.csproj"
          ],
          "src": "./Yubico.YubiKey/src/"
        }
      ],
      "disableGitFeatures": true,
      "disableDefaultFilter": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "filter": "./docs/filterConfig.yml",
      "output": "./.docbuild/metadata/yubikey-api",
      "properties": {
        "TargetFramework": "netstandard2.0",
        "NuGetLockFilePath": "obj/docfx.packages.lock.json"
      }
    }
  ],
  "build": {
    "sitemap": {
      "baseUrl": "https://docs.yubico.com/yesdk",
      "changefreq": "monthly"
    },
    "content": [
      {
        "files": [
          "yubikey-api/index.md",
          "core-api/index.md",
          "users-manual/**.md",
          "users-manual/**/toc.yml",
          "toc.yml",
          "*.md",
          "v2-api/index.md",
          "core-api/**/*.yml",
          "yubikey-api/**/*.yml",
          "v2-api/**/*.yml"
        ],
        "src": "./docs/"
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ],
        "src": "./docs/"
      },
      {
        "files": [
          "build-info.json"
        ],
        "src": "./.docbuild/"
      }
    ],
    "overwrite": [
      {
        "files": [
          "namespaces/**.md"
        ],
        "exclude": [
          "obj/**",
          "_site/**"
        ],
        "src": "./docs/"
      }
    ],
    "output": "./docs/_site/",
    "globalMetadataFiles": [],
    "globalMetadata": {
      "_googleAnalyticsTagId": "G-WLE96T8XZ3",
      "_appFaviconPath": "./images/favicon.ico",
      "_enableSearch": true,
      "_appName": "Yubico",
      "_appLogoPath": "./images/yubico-circle-y-mark-white.png",
      "_lang": "en",
      "_gitContribute": {
        "repo": "https://github.com/Yubico/Yubico.NET.SDK",
        "branch": "develop"
      }
    },
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "docs/custom-template"
    ],
    "postProcessors": [
      "ExtractSearchIndex"
    ],
    "disableGitFeatures": false
  }
}
