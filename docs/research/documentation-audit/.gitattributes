records/** -text -whitespace
maintenance/**/validation/** -text -whitespace
# Retained compiler inputs, projects and logs are hashed evidence; preserve exact bytes/EOFs.
modules/**/validation/** -text -whitespace
modules/**/evidence/** -text -whitespace
