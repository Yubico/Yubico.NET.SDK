+    private static HidDescriptorInfo Descriptor(bool otp, string path) => new()
+    {
+        DevicePath = path,
+        VendorId = 0x1050,
+        ProductId = 0x0407,
+        UsagePage = otp ? (ushort)1 : (ushort)0xF1D0,
+        Usage = otp ? (ushort)6 : (ushort)1
+    };
