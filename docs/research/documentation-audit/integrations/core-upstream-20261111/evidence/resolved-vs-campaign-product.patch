+```csharp
+// Every YubiKey reachable as a smart card (CCID); HID is never enumerated.
+var smartCardYubiKeys = await YubiKeyManager.FindAllAsync(interfaces: ConnectionType.SmartCard, cancellationToken: cancellationToken);
