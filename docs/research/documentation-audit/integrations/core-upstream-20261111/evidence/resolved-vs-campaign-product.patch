+    }
+
+    public void Dispose()
+    {
+        if (Interlocked.Exchange(ref _disposed, 1) != 0)
+            return;
+
+        TaskCompletionSource changed;
+        lock (AdmissionLock)
+        {
+            foreach (var gate in _gates)
+                gate.Release();
+            changed = _availabilityChanged;
+            _availabilityChanged = new(TaskCreationOptions.RunContinuationsAsynchronously);
+        }
+
+        changed.SetResult();
+    }
