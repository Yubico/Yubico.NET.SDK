-    private static void InterlockedMax(ref int target, int candidate)
-    {
-        while (true)
-        {
-            var current = Volatile.Read(ref target);
-            if (candidate <= current || Interlocked.CompareExchange(ref target, candidate, current) == current)
-            {
-                return;
-            }
-        }
-    }
