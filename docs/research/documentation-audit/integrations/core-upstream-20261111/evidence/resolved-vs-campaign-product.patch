+    /// rethrown; either outcome disposes the partially created monitor before returning.
+    /// </remarks>
+    internal static async Task<YubiKeyMonitor> CreateAsync(
+        IMonitoredDiscovery discovery,
+        IReadOnlyList<ListenerSource> listeners,
