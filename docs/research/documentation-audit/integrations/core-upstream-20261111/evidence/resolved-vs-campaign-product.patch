+    internal static Task<YubiKeyMonitor> CreateAsync(CancellationToken cancellationToken) =>
+        CreateAsync(
+            FindYubiKeys.Create(),
+            [new(ConnectionType.Hid, HidDeviceListener.Create), new(ConnectionType.SmartCard, DesktopSmartCardDeviceListener.Create)],
