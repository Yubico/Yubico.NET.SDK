+        for (int index = 0; index < 40; index++)
+        {
+            using var handle = Descriptor(42);
+            var token = reactor.Register(handle, index, (_, _) => { }, _ => { });
+            await native.NextPoll();
+            await Drain(token);
+        }
+        await reactor.DisposeAsync();
