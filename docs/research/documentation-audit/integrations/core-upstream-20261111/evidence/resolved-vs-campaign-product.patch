+        var otpApi = new OtpApi { OpenError = new IOException("open") };
+        var device = Device(Slot(false, fidoApi, new Reactor()), Slot(true, otpApi));
+        await Assert.ThrowsAsync<IOException>(() => OpenAsync(device, otp, Token));
