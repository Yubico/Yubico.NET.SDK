-            repository.UpdateCache([new FakeYubiKey($"device-{i}", ConnectionType.SmartCard)]);
-        }
-
-        elapsed.Stop();
-
-        Assert.True(
-            elapsed.Elapsed < TimeSpan.FromSeconds(10),
