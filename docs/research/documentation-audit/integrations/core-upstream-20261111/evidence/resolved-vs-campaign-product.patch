+        var failure = await Assert.ThrowsAnyAsync<Exception>(() => connection.DisposeAsync().AsTask());
+        Assert.Same(failure, await Assert.ThrowsAnyAsync<Exception>(() => connection.DisposeAsync().AsTask()));
+        if (error == 9)
