  </ItemGroup>

  <ItemGroup>
    </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../../../../../../../src/Management/src/Yubico.YubiKit.Management.csproj" />
  </ItemGroup>

</Project>
