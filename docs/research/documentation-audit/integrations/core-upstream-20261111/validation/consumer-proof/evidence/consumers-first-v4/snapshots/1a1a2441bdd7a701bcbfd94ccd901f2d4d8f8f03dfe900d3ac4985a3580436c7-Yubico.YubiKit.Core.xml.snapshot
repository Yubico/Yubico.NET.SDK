        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.Aes256">
            <summary>AES with a 256-bit key; no block mode is implied.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.Secp256k1">
            <summary>Ordinary EC representation on secp256k1, distinct from NIST P-256.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.BrainpoolP256r1">
            <summary>Ordinary EC representation on brainpoolP256r1.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.BrainpoolP384r1">
            <summary>Ordinary EC representation on brainpoolP384r1.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.BrainpoolP512r1">
            <summary>Ordinary EC representation on brainpoolP512r1.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.All">
            <summary>All concrete keys in stable KeyType numeric order; None is not a key.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.Get(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Gets immutable metadata for a concrete key identity.</summary>
            <param name="keyType">The concrete key identity, not an operation or protocol number.</param>
            <returns>The catalog's shared metadata instance.</returns>
            <exception cref="T:System.ArgumentException">The identity is None or is not in the catalog.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.TryGet(Yubico.YubiKit.Core.Cryptography.KeyType,Yubico.YubiKit.Core.Cryptography.KeyInfo@)">
            <summary>Tries to find immutable metadata for a concrete key identity.</summary>
            <param name="keyType">The concrete key identity.</param>
            <param name="keyInfo">The shared metadata instance on success; null on a miss.</param>
            <returns>False for None or an unknown identity, without throwing.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.FindByCurve(Yubico.YubiKit.Core.Cryptography.CurveInfo)">
            <summary>Finds all concrete constructions for a mathematical curve, in catalog order.</summary>
            <param name="curveInfo">The curve to match by its case-sensitive catalog identity.</param>
            <returns>An immutable collection, empty if no construction is modeled.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.GetByCurve(Yubico.YubiKit.Core.Cryptography.CurveInfo)">
            <summary>Gets the sole modeled construction for a mathematical curve.</summary>
            <param name="curveInfo">The curve to match by its case-sensitive catalog identity.</param>
            <returns>The unique concrete key; never an arbitrary first match.</returns>
            <exception cref="T:System.NotSupportedException">No construction is modeled for the curve.</exception>
            <exception cref="T:System.InvalidOperationException">Multiple constructions are modeled; use <see cref="M:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.FindByCurve(Yubico.YubiKit.Core.Cryptography.CurveInfo)"/>.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.GetByRsaLength(System.Int32)">
            <summary>Resolves an RSA modulus size, retaining the existing one-bit size tolerance.</summary>
            <param name="keySizeBits">The RSA modulus length in bits, not bytes or security strength.</param>
            <returns>The modeled RSA key whose nominal size is within one bit of the supplied length.</returns>
            <exception cref="T:System.NotSupportedException">No modeled RSA size is within that tolerance.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.CryptographyProviders">
            <summary>
            This class contains properties that specify cryptographic providers.
            </summary>
            <remarks>
            During the course of operations, the SDK will need to perform
            cryptographic operations, such as random number generation, HMAC,
            Triple-DES encryption, and so on. Any SDK operation that needs crypto
            will get it from this class.
            <para>
            The properties in this class are delegates. They are functions that can
            build objects that will perform the required crypto. The reason these
            properties are methods that build objects, rather than objects
            themselves, is because the crypto classes implement <c>IDisposable</c>.
            In order to avoid the complex problem of ownership of an object that will
            be disposed once it goes out of scope, the SDK will create a new object
            each time one is needed. This new object will be in scope only for the
            duration of its use in the SDK, and will be disposed immediately when the
            SDK is done with it.
            </para>
            <para>
            This class will return default implementations, but can be replaced. That
            is, if you do nothing, the SDK will use default C# cryptography. If you
            want the SDK to use your own implementations, you can do so. See the
            User's Manual entry on
            <xref href="UsersManualAlternateCrypto"> alternate crypto implementations</xref>
            for a detailed description of replacing the defaults. Generally, you will
            simply need to set the appropriate property with a new function.
            </para>
            <para>
            Most applications will not replace the defaults, but for those that want
            the SDK to use a hardware RNG, hardware accelerator, or any other
            specific implementation for whatever reason, it is possible.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographyProviders.RngCreator">
            <summary>
            This property is a delegate (function pointer). The method loaded
            will return an instance of <c>RandomNumberGenerator</c>.
            </summary>
            <remarks>
            When an SDK operation needs random numbers it will generate them
            using an implementation of the
            <c>System.Security.Cryptography.RandomNumberGenerator</c> abstract
            class. However, when it needs the RNG class, it will ask this
            delegate to build an object, rather than ask for an object itself.
            This has to do with the fact that the <c>RandomNumberGenerator</c>
            class implements <c>IDisposable</c>. In order to avoid the complex
            problem of ownership of an object that will be disposed once it goes
            out of scope, the SDK will create a new object each time one is
            needed. This new object will be in scope only for the duration of its
            use in the SDK, and will be disposed immediately when the SDK is done
            with it.
            <para>
            The method loaded will return an object. This class is initialized
            with a method that will build and return an instance of the C#
            default implementation. For example, it could be used as follows.
            <code language="csharp">
              RandomNumberGenerator randomObject =
                  CryptographyProviders.RngCreator();
            </code>
            </para>
            <para>
            If you want to replace the implementation, you will likely do
            something like this in your application.
            <code language="csharp">
                CryptographyProviders.RngCreator = () =>
                {
                    Handle rngHandle = RngImpl.GetRngHandle();
                    return RngImpl.GetRandomObject(rngHandle);
                };
            </code>
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographyProviders.Sha1Creator">
            <summary>
            This property is a delegate (function pointer). The method loaded
            will return an instance of <c>SHA1</c>.
            </summary>
            <remarks>
            When an SDK operation needs to digest data using SHA-1, it will do so
            using an implementation of the
            <c>System.Security.Cryptography.SHA1</c> abstract class. However,
            when it needs the SHA1 class, it will ask this delegate to build an
            object, rather than ask for an object itself. This has to do with the
            fact that the <c>SHA1</c> class implements <c>IDisposable</c>. In
            order to avoid the complex problem of ownership of an object that
            will be disposed once it goes out of scope, the SDK will create a new
            object each time one is needed. This new object will be in scope only
            for the duration of its use in the SDK, and will be disposed
            immediately when the SDK is done with it.
            <para>
            The method loaded will return an object. This class is initialized
            with a method that will build and return an instance of the C#
            default implementation. For example, it could be used as follows.
            <code language="csharp">
              SHA1 sha1Object = CryptographyProviders.Sha1Creator();
            </code>
            </para>
            <para>
            If you want to replace the implementation, you will likely do
            something like this in your application.
            <code language="csharp">
                CryptographyProviders.Sha1Creator = () =>
                {
                    Handle sha1Handle = Sha1Impl.GetSha1Handle();
                    return Sha1Impl.GetSha1Object(sha1Handle);
                };
            </code>
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographyProviders.Sha256Creator">
            <summary>
            This property is a delegate (function pointer). The method loaded
            will return an instance of <c>SHA256</c>.
            </summary>
            <remarks>
            When an SDK operation needs to digest data using SHA-256, it will do
            so using an implementation of the
            <c>System.Security.Cryptography.SHA256</c> abstract class. However,
            when it needs the SHA256 class, it will ask this delegate to build an
            object, rather than ask for an object itself. This has to do with the
            fact that the <c>SHA256</c> class implements <c>IDisposable</c>. In
            order to avoid the complex problem of ownership of an object that
            will be disposed once it goes out of scope, the SDK will create a new
            object each time one is needed. This new object will be in scope only
            for the duration of its use in the SDK, and will be disposed
            immediately when the SDK is done with it.
            <para>
            The method loaded will return an object. This class is initialized
            with a method that will build and return an instance of the C#
            default implementation. For example, it could be used as follows.
            <code language="csharp">
              SHA256 sha256Object = CryptographyProviders.Sha256Creator();
            </code>
            </para>
            <para>
            If you want to replace the implementation, you will likely do
            something like this in your application.
            <code language="csharp">
                CryptographyProviders.Sha256Creator = () =>
                {
                    Handle sha256Handle = Sha256Impl.GetSha256Handle();
                    return Sha256Impl.GetSha256Object(sha256Handle);
                };
            </code>
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographyProviders.Sha384Creator">
            <summary>
            This property is a delegate (function pointer). The method loaded
            will return an instance of <c>SHA384</c>.
            </summary>
            <remarks>
            When an SDK operation needs to digest data using SHA-384, it will do
            so using an implementation of the
            <c>System.Security.Cryptography.SHA384</c> abstract class. However,
            when it needs the SHA384 class, it will ask this delegate to build an
            object, rather than ask for an object itself. This has to do with the
            fact that the <c>SHA384</c> class implements <c>IDisposable</c>. In
            order to avoid the complex problem of ownership of an object that
            will be disposed once it goes out of scope, the SDK will create a new
            object each time one is needed. This new object will be in scope only
            for the duration of its use in the SDK, and will be disposed
            immediately when the SDK is done with it.
            <para>
            The method loaded will return an object. This class is initialized
            with a method that will build and return an instance of the C#
            default implementation. For example, it could be used as follows.
            <code language="csharp">
              SHA384 sha384Object = CryptographyProviders.Sha384Creator();
            </code>
            </para>
            <para>
            If you want to replace the implementation, you will likely do
            something like this in your application.
            <code language="csharp">
                CryptographyProviders.Sha384Creator = () =>
                {
                    Handle sha384Handle = Sha384Impl.GetSha384Handle();
                    return Sha384Impl.GetSha384Object(sha384Handle);
                };
            </code>
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographyProviders.Sha512Creator">
            <summary>
            This property is a delegate (function pointer). The method loaded
            will return an instance of <c>SHA512</c>.
            </summary>
            <remarks>
            When an SDK operation needs to digest data using SHA-512, it will do
            so using an implementation of the
            <c>System.Security.Cryptography.SHA512</c> abstract class. However,
            when it needs the SHA512 class, it will ask this delegate to build an
            object, rather than ask for an object itself. This has to do with the
            fact that the <c>SHA512</c> class implements <c>IDisposable</c>. In
            order to avoid the complex problem of ownership of an object that
            will be disposed once it goes out of scope, the SDK will create a new
            object each time one is needed. This new object will be in scope only
            for the duration of its use in the SDK, and will be disposed
            immediately when the SDK is done with it.
            <para>
            The method loaded will return an object. This class is initialized
            with a method that will build and return an instance of the C#
            default implementation. For example, it could be used as follows.
            <code language="csharp">
              SHA512 sha512Object = CryptographyProviders.Sha512Creator();
            </code>
            </para>
            <para>
            If you want to replace the implementation, you will likely do
            something like this in your application.
            <code language="csharp">
                CryptographyProviders.Sha512Creator = () =>
                {
                    Handle sha512Handle = Sha512Impl.GetSha512Handle();
                    return Sha512Impl.GetSha512Object(sha512Handle);
                };
            </code>
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographyProviders.AesCreator">
            <summary>
            This property is a delegate (function pointer). The method loaded
            will return an instance of <c>AES</c>.
            </summary>
            <remarks>
            When an SDK operation needs to encrypt or decrypt data using
            AES, it will do so using an implementation of the
            <c>System.Security.Cryptography.AES</c> abstract class.
            However, when it needs the AES class, it will ask this delegate to
            build an object, rather than ask for an object itself. This has to do
            with the fact that the <c>AES</c> class implements
            <c>IDisposable</c>. In order to avoid the complex problem of
            ownership of an object that will be disposed once it goes out of
            scope, the SDK will create a new object each time one is needed. This
            new object will be in scope only for the duration of its use in the
            SDK, and will be disposed immediately when the SDK is done with it.
            <para>
            The method loaded will return an object. This class is initialized
            with a method that will build and return an instance of the C#
            default implementation. For example, it could be used as follows.
            <code language="csharp">
              AES aesObject = CryptographyProviders.AesCreator();
            </code>
            </para>
            <para>
            If you want to replace the implementation, you will likely do
            something like this in your application.
            <code language="csharp">
                CryptographyProviders.AesCreator = () =>
                {
                    Handle aesHandle = GetHandle();
                    return AesImpl.GetAesObject(aesHandle);
                };
            </code>
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CryptographyProviders.ArkgPrimitivesCreator">
            <summary>
            This property is a delegate (function pointer). The method loaded
            will return an instance of ARKG-P256 cryptographic primitives.
            </summary>
            <remarks>
            When an SDK operation needs to perform ARKG-P256 cryptographic primitives
            (point validation, ECDH, key derivation), it will do so using the
            internal IArkgPrimitives interface. However, when it needs an instance,
            it will ask this delegate to build an object, rather than build it itself.
            <para>
            The method loaded will return an object. This class is initialized
            with a method that will build and return an instance of the default
            OpenSSL-backed implementation.
            </para>
            <para>
            If you want to replace the implementation, you will likely do
            something like this in your application.
            <code language="csharp">
                CryptographyProviders.ArkgPrimitivesCreator = () =>
                {
                    return ArkgImpl.GetArkgObject();
                };
            </code>
            </para>
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey">
            <summary>
            Represents a Curve25519 private key.
            </summary>
            <remarks>
            This sealed class encapsulates Curve25519 private key data and supports
            both Ed25519 seed and X25519 scalar representations. It does not choose or perform an operation.
            It also provides factory methods for creating instances from private key values or DER-encoded data.
            Imported private key bytes are copied and preserved unchanged. In particular, X25519 masking occurs
            when a cryptographic operation decodes the scalar as specified by RFC 7748, not when key bytes are
            imported, encoded, or exported.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.KeyType">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.KeyInfo">
            <summary>
            Gets the metadata associated with this Curve25519 private key.
            </summary>
            <value>
            A <see cref="P:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.KeyInfo"/> object that describes the key's representation.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.PrivateKey">
            <summary>
            Gets the raw private key bytes exactly as imported.
            </summary>
            <value>
            A borrowed read-only view of the key-owned bytes. The view remains valid until this object
            is disposed. The caller must not attempt to modify or clear the underlying memory.
            </value>
            <exception cref="T:System.ObjectDisposedException">This object has been disposed.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.ExportPkcs8PrivateKey">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.Clear">
            <summary>
            Clears the private key.
            </summary>
            <remarks>
            This method securely zeroes out the private key data.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.CreateFromPkcs8(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey"/> from a PKCS#8
            ASN.1 DER-encoded private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method copies the decoded private value and
            does not modify or clear the input.
            </param>
            <returns>
            A new disposable key that owns and clears its copied private-key material.
            </returns>
            <exception cref="T:System.ArgumentException">
            Thrown if the algorithm OID is not X25519 or Ed25519.
            </exception>
            <exception cref="T:System.Security.Cryptography.CryptographicException">Thrown if privateKey does not match expected format.</exception>
            <remarks>
            This method accepts version 0 PKCS#8 <c>PrivateKeyInfo</c>. RFC 5958 version value 1
            <c>OneAsymmetricKey</c>, which may carry a <c>publicKey</c> field, is valid but unsupported:
            this type holds no public value, because a supplied one cannot be checked against the private key
            (.NET provides no Ed25519/X25519 primitives). Read the public key from the device after import.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey.CreateFromValue(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey"/> from the given
            <paramref name="privateKey"/> and <paramref name="keyType"/>.
            </summary>
            <param name="privateKey">
            The 32 borrowed raw private-key bytes. These are copied and preserved unchanged. The caller
            retains ownership and remains responsible for clearing the input.
            </param>
            <param name="keyType">The type of key this is.</param>
            <returns>A new disposable key that owns and clears its copied private-key material.</returns>
            <exception cref="T:System.ArgumentException">Thrown if <paramref name="keyType"/> is not X25519 or Ed25519, or if <paramref name="privateKey"/> is not exactly 32 bytes.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey">
            <summary>
            Represents a Curve25519 public key.
            </summary>
            <remarks>
            Stores the RFC 8410 public value: an Ed25519 compressed Edwards point or an X25519
            little-endian Montgomery u-coordinate. These are distinct constructions, not interchangeable points.
            It also provides factory methods for creating instances from public point values or DER-encoded data.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey.KeyInfo">
            <summary>
            Gets the metadata associated with this 25519 public key.
            </summary>
            <value>
            A <see cref="P:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey.KeyInfo"/> object that describes the key's representation.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey.KeyType">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey.PublicPoint">
            <summary>
            Gets the RFC 8410 public value for the concrete construction.
            </summary>
            <returns>A <see cref="T:System.ReadOnlyMemory`1"/> containing the public key bytes.</returns>
            <remarks>
            The public key is represented as a byte array, which is the raw public key data.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey.ExportSubjectPublicKeyInfo">
            <summary>
            Converts this public key to an ASN.1 DER encoded format (X.509 SubjectPublicKeyInfo).
            </summary>
            <returns>
            A byte array containing the ASN.1 DER encoded public key.
            </returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey.CreateFromSubjectPublicKeyInfo(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates a new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey"/> from a DER-encoded SubjectPublicKeyInfo.
            </summary>
            <param name="subjectPublicKeyInfo">
            The DER-encoded SubjectPublicKeyInfo.
            </param>
            <returns>
            A new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey"/>.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
            Thrown if the subjectPublicKeyInfo is invalid.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey.CreateFromValue(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey"/> from the given
            <paramref name="publicPoint"/> and <paramref name="keyType"/>.
            </summary>
            <param name="publicPoint">The raw 32-byte RFC 8410 public value for the concrete construction.</param>
            <param name="keyType">The type of key this is.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey"/>.</returns>
            <exception cref="T:System.ArgumentException">
            Thrown if the public key data length is not valid.
            </exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.CurveForm">
            <summary>The mathematical form of an elliptic curve, not a signing algorithm.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.CurveForm.ShortWeierstrass">
            <summary>Short-Weierstrass form, used by ordinary EC key representations.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.CurveForm.Montgomery">
            <summary>Montgomery form, such as Curve25519; not an operation identifier.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.CurveForm.Edwards">
            <summary>Edwards form, such as Edwards25519; not an EdDSA variant selection.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.CurveInfo">
            <summary>Immutable mathematical curve metadata. Representation widths belong to <see cref="T:Yubico.YubiKit.Core.Cryptography.KeyInfo"/>.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.Id">
            <summary>Stable, case-sensitive catalog identity, independent of display names and wire identifiers.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.DisplayName">
            <summary>A human-readable curve label; use <see cref="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.Id"/> for catalog lookups.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.Form">
            <summary>The mathematical curve form, independent of key construction and operation.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.FieldSizeBits">
            <summary>Bit length of the field modulus, not a key encoding width or security-strength estimate.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.OrderSizeBits">
            <summary>Bit length of the prime subgroup order, not the full curve group order.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.CoordinateLengthBytes">
            <summary>Width in bytes needed to store one field coordinate; does not specify a point or scalar encoding.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.CurveInfo.NamedCurveOid">
            <summary>Standard ASN.1 named-curve OID, or null when none is modeled; never an RFC 8410 key algorithm OID.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.EcdhPrimitives">
            <summary>
            Creates the default .NET ECDH primitive implementation.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.EcdhPrimitives.Create">
            <summary>
            Creates a new ECDH primitive implementation.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ECParametersExtensions">
            <summary>
                Helper extensions for parameter copying
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECParametersExtensions.DeepCopy(System.Security.Cryptography.ECParameters)">
            <inheritdoc cref="M:Yubico.YubiKit.Core.Cryptography.ECParametersExtensions.&lt;G&gt;$11FB3EBD89BB3B2B671D134DCB6BFFBF.DeepCopy"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECParametersExtensions.&lt;G&gt;$11FB3EBD89BB3B2B671D134DCB6BFFBF.DeepCopy">
            <summary>
                Performs a deep copy of the EC parameters.
