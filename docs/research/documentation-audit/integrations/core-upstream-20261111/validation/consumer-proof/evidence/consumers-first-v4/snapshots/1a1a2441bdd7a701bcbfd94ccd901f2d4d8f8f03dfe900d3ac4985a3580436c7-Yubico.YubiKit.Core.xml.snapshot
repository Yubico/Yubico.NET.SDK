        <member name="T:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier">
            <summary>
            Represents a COSE algorithm identifier.
            <remarks>
            This enumeration is based on the IANA COSE Algorithms registry.
            <para>
            https://www.iana.org/assignments/cose/cose.xhtml#algorithms
            </para>
            </remarks>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier.None">
            <summary>
            No algorithm specified.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier.Es256">
            <summary>
            ECDSA with SHA-256. Profiles such as WebAuthn constrain the curve to P-256.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier.EcdhEsHkdf256">
            <summary>
            ECDH ephemeral-static with HKDF using SHA-256 (ECDH-ES + HKDF-256).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier.Es384">
            <summary>
            ECDSA with SHA-384. Profiles may constrain the curve to P-384.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier.Es512">
            <summary>
            ECDSA with SHA-512. Profiles may constrain the curve to P-521.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier.EdDsa">
            <summary>
            Pure EdDSA, not ECDSA. The curve is separate metadata (for example Ed25519 or Ed448).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier.Rs256">
            <summary>
            RSASSA-PKCS1-v1_5 with SHA-256
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve">
            <summary>
            An enumeration of the elliptic curves that are supported by COSE representations.
            <remarks>
            This enumeration is based on the IANA COSE Elliptic Curves registry.
            <para>
            https://www.iana.org/assignments/cose/cose.xhtml#elliptic-curves
            </para>
            </remarks>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.Unknown">
            <summary>
            The EC curve could not be determined.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.P256">
            <summary>
            NIST P-256 (also known as secp256r1)
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.P384">
            <summary>
            NIST P-384 (also known as secp384r1)
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.P521">
            <summary>
            NIST P-521 (also known as secp521r1)
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.X25519">
            <summary>
            X25519 for use with ECDH only
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.X448">
            <summary>
            X448 for use with ECDH only
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.Ed25519">
            <summary>
            Ed25519 for use with EdDSA only
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.Ed448">
            <summary>
            Ed448 for use with EdDSA only
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.Secp256k1">
            <summary>secp256k1, IANA COSE curve 8.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.BrainpoolP256r1">
            <summary>brainpoolP256r1, IANA COSE curve 256 (ISO/IEC 18013-5).</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.BrainpoolP384r1">
            <summary>brainpoolP384r1, IANA COSE curve 258 (ISO/IEC 18013-5).</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Cose.CoseEcCurve.BrainpoolP512r1">
            <summary>brainpoolP512r1, IANA COSE curve 259 (ISO/IEC 18013-5).</summary>
        </member>
