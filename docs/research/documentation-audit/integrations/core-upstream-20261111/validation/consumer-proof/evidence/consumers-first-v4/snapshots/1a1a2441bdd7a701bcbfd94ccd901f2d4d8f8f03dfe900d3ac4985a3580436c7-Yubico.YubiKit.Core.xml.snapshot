        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey">
            <summary>
            Represents the parameters for an Elliptic Curve (EC) private key.
            </summary>
            <remarks>
            This class encapsulates the parameters specific to EC private keys
            and provides factory methods for creating instances from EC parameters
            or DER-encoded data.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.Parameters">
            <summary>
            Gets the Elliptic Curve parameters associated with this instance.
            </summary>
            <value>
            An <see cref="T:System.Security.Cryptography.ECParameters"/> structure containing the curve parameters, key, and other
            cryptographic elements needed for EC operations. The array fields are owned by this
            object, must not be modified or cleared by the caller, and are cleared when the object is
            disposed.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.KeyInfo">
            <summary>
            Gets the metadata associated with this EC private key.
            </summary>
            <value>
            A <see cref="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.KeyInfo"/> object that describes the key's representation.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.KeyType">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.#ctor(System.Security.Cryptography.ECParameters,System.Action{System.Security.Cryptography.ECParameters})">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> class.
            It is a wrapper for the <see cref="T:System.Security.Cryptography.ECParameters"/> class.
            </summary>
            <remarks>
            This constructor is used to create an instance from a <see cref="T:System.Security.Cryptography.ECParameters"/> object. It will deep copy
            the parameters from the ECParameters object.
            </remarks>
            <param name="parameters">The EC parameters.</param>
            <param name="parametersCopied">An optional internal observation hook.</param>
            <exception cref="T:System.ArgumentException">Thrown when parameters do not contain D value.</exception>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
                Thrown when <c>Q</c> is present and is not <c>d·G</c> on the curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.ExportPkcs8PrivateKey">
            <inheritdoc/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.Clear">
            <inheritdoc/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromPkcs8(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates a new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from a DER-encoded private key.
            </summary>
            <param name="encodedKey">
            The borrowed DER-encoded private key. This method copies the decoded key material and
            does not modify or clear the input.
            </param>
            <returns>
            A new disposable key that owns and clears its copied private-key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
            Thrown if the private key is invalid.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromParameters(System.Security.Cryptography.ECParameters)">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from the given <paramref name="parameters"/>.
            </summary>
            <param name="parameters">
            The borrowed parameters to copy. The caller retains ownership of every input array and
            remains responsible for clearing sensitive arrays.
            </param>
            <returns>A new disposable key that owns and clears its copied private-key material.</returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
                <paramref name="parameters"/> carries a <c>Q</c> that is not <c>d·G</c> on the curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromEcdh(System.Security.Cryptography.ECDiffieHellman)">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from an <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance.
            </summary>
            <param name="ecdh">
            The borrowed <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance containing the private key. This
            method does not dispose it.
            </param>
            <returns>A new disposable key that owns and clears its copied private-key material.</returns>
            <remarks>
            This method exports the private key parameters from the <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance
            and creates a new <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> wrapper. This is useful when working with ephemeral
            keys generated via <see cref="M:System.Security.Cryptography.ECDiffieHellman.Create(System.Security.Cryptography.ECCurve)"/> for protocols like SCP11.
            </remarks>
            <exception cref="T:System.ArgumentNullException">Thrown if <paramref name="ecdh"/> is null.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromValue(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Creates a new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from the given
            <paramref name="privateValue"/> and <paramref name="keyType"/>.
            </summary>
            <remarks>
            <para>
            The <paramref name="privateValue"/> is taken as the raw private key data (scalar value). The
            public point is derived from it by the .NET runtime, and the copies this SDK makes on the way
            are cleared.
            </para>
            <para>
            On macOS the runtime's own derivation keeps a copy of the scalar that it does not clear. This
            is a runtime behaviour, not one the SDK can reach. Supplying the public point yourself through
            <see cref="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromParameters(System.Security.Cryptography.ECParameters)"/> does not avoid it, because the SDK checks that the point
            belongs to the scalar by signing with the same runtime path.
            </para>
            </remarks>
            <param name="privateValue">
            The borrowed raw private value to copy. The caller retains ownership and remains
            responsible for clearing the input.
            </param>
            <param name="keyType">The type of key this is.</param>
            <returns>A new disposable key that owns and clears its copied private-key material.</returns>
            <exception cref="T:System.ArgumentException">
            Thrown if the key type is not a valid EC key.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.ToECDiffieHellman">
            <summary>
            Converts this EC private key to an <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance for use in key agreement operations.
            </summary>
            <returns>An <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance initialized with this key's parameters.</returns>
            <remarks>
            This method creates a new <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance from the stored EC parameters.
            The returned instance can be used for ECDH key agreement operations, such as those used in
            SCP11 (Secure Channel Protocol 11).
            <para>
            The caller is responsible for disposing the returned <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance
            to ensure proper cleanup of cryptographic resources.
            </para>
            </remarks>
            <exception cref="T:System.ObjectDisposedException">Thrown if this instance has been disposed.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey">
            <summary>
                Represents an Elliptic Curve (EC) public key.
            </summary>
            <remarks>
                This class encapsulates EC public key parameters and provides cryptographic operations
                for modeled short-Weierstrass curves and provides factory methods for creating instances from EC parameters or DER-encoded
                data.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.#ctor(System.Security.Cryptography.ECParameters)">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> class.
                It is a wrapper for the <see cref="T:System.Security.Cryptography.ECParameters" /> class.
            </summary>
            <remarks>
                This constructor is used to create an instance from a <see cref="T:System.Security.Cryptography.ECParameters" /> object.
                It will deep copy the parameters from the <see cref="T:System.Security.Cryptography.ECParameters" /> object.
            </remarks>
            <param name="parameters">The EC parameters containing the public key data.</param>
            <exception cref="T:System.ArgumentException">Thrown when the parameters contain private key data (D value).</exception>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.Parameters">
            <summary>
                Gets the Elliptic Curve parameters associated with this instance.
            </summary>
            <value>
                An <see cref="T:System.Security.Cryptography.ECParameters" /> structure containing the curve parameters, key, and other
                cryptographic elements needed for EC operations.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.KeyInfo">
            <summary>
                Gets the metadata associated with this EC public key.
            </summary>
            <value>
                A <see cref="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.KeyInfo" /> object that describes the key's representation.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.PublicPoint">
            <summary>
                Gets the bytes representing the public key coordinates.
            </summary>
            <returns>A <see cref="T:System.ReadOnlyMemory`1" /> containing the public key bytes with the format 0x04 || X || Y.</returns>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.KeyType">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.ExportSubjectPublicKeyInfo">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromParameters(System.Security.Cryptography.ECParameters)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from the given <paramref name="parameters" />.
            </summary>
            <param name="parameters">The parameters to create the key from.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromEcdh(System.Security.Cryptography.ECDiffieHellman)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from an <see cref="T:System.Security.Cryptography.ECDiffieHellman" /> instance.
            </summary>
            <param name="ecdh">The ECDiffieHellman instance containing the public key.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
            <remarks>
                This method extracts the public key from the <see cref="T:System.Security.Cryptography.ECDiffieHellman" /> instance
                and creates a new <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> wrapper. This is useful when working with ephemeral
                keys generated via <see cref="M:System.Security.Cryptography.ECDiffieHellman.Create(System.Security.Cryptography.ECCurve)" /> for protocols like SCP11.
            </remarks>
            <exception cref="T:System.ArgumentNullException">Thrown if <paramref name="ecdh" /> is null.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromEcdh(System.Security.Cryptography.ECDiffieHellmanPublicKey)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from an <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> instance.
            </summary>
            <param name="publicKey">The ECDiffieHellmanPublicKey instance.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
            <remarks>
                This method exports the public key parameters from the <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> instance
                and creates a new <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> wrapper. This is useful when receiving public keys
                from key agreement operations or certificate imports.
            </remarks>
            <exception cref="T:System.ArgumentNullException">Thrown if <paramref name="publicKey" /> is null.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromValue(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from the given
                <paramref name="publicPoint" /> and <paramref name="keyType" />.
            </summary>
            <param name="publicPoint">The raw public key data, formatted as an uncompressed point (0x04 || X || Y).</param>
            <param name="keyType">The type of key this is.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
            <exception cref="T:System.ArgumentException">
                Thrown if the key type is not a valid EC key.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromSubjectPublicKeyInfo(System.ReadOnlyMemory{System.Byte})">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from a DER-encoded SubjectPublicKeyInfo.
            </summary>
            <param name="subjectPublicKeyInfo">The DER-encoded SubjectPublicKeyInfo.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.IPublicKey" />.</returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
                Thrown if the subjectPublicKeyInfo is invalid.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.ToECDiffieHellmanPublicKey">
            <summary>
                Converts this EC public key to an <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> for use in key agreement operations.
            </summary>
            <returns>An <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> instance that can be used with <see cref="T:System.Security.Cryptography.ECDiffieHellman" />.</returns>
            <remarks>
                This method creates a new <see cref="T:System.Security.Cryptography.ECDiffieHellman" /> instance from the stored EC parameters
                and returns its public key. This is useful for ECDH key agreement operations such as those
                used in SCP11 (Secure Channel Protocol 11).
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives">
            <summary>
            Defines cryptographic primitives required for ARKG-P256 operations.
            </summary>
            <remarks>
            This interface abstracts platform-specific implementations of
            elliptic curve operations needed for Asynchronous Remote Key Generation.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives.IsPointOnCurve(System.ReadOnlySpan{System.Byte})">
            <summary>
            Verifies that an elliptic curve point lies on the P-256 curve.
            </summary>
            <param name="point">The point to verify, in uncompressed SEC1 format.</param>
            <returns><c>true</c> if the point is on the curve; otherwise, <c>false</c>.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives.ComputeEcdhSharedSecret(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <summary>
            Computes an ECDH shared secret using a private scalar and public point.
            </summary>
            <param name="privateScalar">The private scalar value.</param>
            <param name="publicPoint">The public point in uncompressed SEC1 format.</param>
            <returns>The computed shared secret.</returns>
            <remarks>
            The returned array is owned by the caller and should be zeroed after use via
            <see cref="M:System.Security.Cryptography.CryptographicOperations.ZeroMemory(System.Span{System.Byte})"/>.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives.Derive(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <summary>
            Derives a public key and ARKG key handle using the ARKG-P256 algorithm.
            </summary>
            <remarks>
            <para>
            This method implements the ARKG-P256 key derivation algorithm as specified
            in the previewSign WebAuthn extension. Given the blinding and KEM public
            keys from the YubiKey, along with application-provided input keying material
            and context, it derives a new public key.
            </para>
            <para>
            The derived public key can be used to verify signatures produced by the
            YubiKey when called with the corresponding ARKG key handle and context.
            The ARKG key handle returned by this method must be provided to the
            YubiKey during signing operations.
            </para>
            <para>
            The context string allows multiple independent public keys to be derived
            from the same generated key material. Each unique context produces a
            unique derived key pair.
            </para>
            </remarks>
            <param name="pkBl">The blinding public key in uncompressed SEC1 format.</param>
            <param name="pkKem">The KEM public key in uncompressed SEC1 format.</param>
            <param name="ikm">Input keying material for HKDF derivation.</param>
            <param name="ctx">Context string for domain separation.</param>
            <returns>
            A tuple containing the derived public key (in uncompressed SEC1 format)
            and the ARKG key handle (to be passed to the YubiKey during signing).
            Both returned arrays are owned by the caller and should be zeroed after use.
            </returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ICmacPrimitives">
            <summary>
            Provides replaceable cipher-based message authentication code operations.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ICmacPrimitives.CmacInit(System.ReadOnlySpan{System.Byte})">
            <summary>Initializes a CMAC operation with <paramref name="keyData"/>.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ICmacPrimitives.CmacUpdate(System.ReadOnlySpan{System.Byte})">
            <summary>Appends data to the current CMAC operation.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ICmacPrimitives.CmacFinal(System.Span{System.Byte})">
            <summary>Completes the current CMAC operation.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IEcdhPrimitives">
            <summary>
            Provides replaceable elliptic-curve Diffie-Hellman primitive operations.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IEcdhPrimitives.GenerateKeyPair(System.Security.Cryptography.ECCurve)">
            <summary>
            Generates an ECDH key pair on <paramref name="curve"/>.
            </summary>
            <remarks>The returned private value in <see cref="F:System.Security.Cryptography.ECParameters.D"/> is caller-owned and must be zeroed.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IEcdhPrimitives.ComputeSharedSecret(System.Security.Cryptography.ECParameters,System.Security.Cryptography.ECParameters)">
            <summary>
            Computes the raw ECDH shared secret between <paramref name="localPrivateKey"/> and
            <paramref name="remotePublicKey"/>.
            </summary>
            <remarks>
            <paramref name="localPrivateKey"/> must contain a private value (<see cref="F:System.Security.Cryptography.ECParameters.D"/>) and a
            public point (<see cref="F:System.Security.Cryptography.ECParameters.Q"/>) that correspond to the same key pair, such as the value
            returned by exporting an existing key's parameters with its private component included. Passing a
            public point that does not correspond to the private value produces an invalid shared secret and may
            be rejected by some platform crypto backends.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IKeyBase">
            <summary>
            Defines the base contract for all cryptographic keys, providing key type identification.
            </summary>
            <remarks>
            This interface serves as the foundation for both public and private key abstractions,
            enabling polymorphic key type handling across different cryptographic algorithms.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.IKeyBase.KeyInfo">
            <summary>Gets immutable shared metadata for this concrete key representation.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.IKeyBase.KeyType">
            <summary>
            Gets the type of the cryptographic key.
            </summary>
            <value>
            A <see cref="P:Yubico.YubiKit.Core.Cryptography.IKeyBase.KeyType"/> value indicating the type of the key.
            </value>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey">
            <summary>
            Defines the contract for cryptographic private keys.
            </summary>
            <remarks>
            This interface extends <see cref="T:Yubico.YubiKit.Core.Cryptography.IKeyBase"/> to include private key-specific operations
            for PKCS#8 export and secure memory cleanup.
            Known implementations include <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/>, <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey"/> and <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey"/>,.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IPrivateKey.ExportPkcs8PrivateKey">
            <summary>
            Exports the current key in the PKCS#8 PrivateKeyInfo format.
            </summary>
            <returns>
            A new caller-owned byte array containing the PKCS#8 PrivateKeyInfo representation of this
            key. The caller must clear the array when it is no longer needed.
            </returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IPrivateKey.Clear">
            <summary>
            Clears the buffers containing private key data.
            </summary>
            <remarks>Callers should not use the key after clearing it.</remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IPrivateKeyExtensions">
            <summary>
            Extension methods for <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/> to provide type-safe casting operations.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IPrivateKeyExtensions.Cast``1(Yubico.YubiKit.Core.Cryptography.IPrivateKey)">
            <summary>
            Safely casts an <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/> instance to a specific derived type.
            </summary>
            <typeparam name="T">The target type that implements <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/>.</typeparam>
            <param name="key">The private key instance to cast.</param>
            <returns>The private key cast to the specified type <typeparamref name="T"/>.</returns>
            <exception cref="T:System.InvalidCastException">
            Thrown when the <paramref name="key"/> cannot be cast to type <typeparamref name="T"/>.
            The exception message includes both the source and target type names for debugging.
            </exception>
            <example>
            <code>
            IPrivateKey genericKey = GetPrivateKey();
            RsaPrivateKey rsaKey = genericKey.Cast&lt;RsaPrivateKey&gt;();
            // throws InvalidCastException if genericKey is not an RsaPrivateKey
            </code>
            </example>
            <remarks>
            This method provides a more explicit alternative to direct casting with clearer error messages.
            Prefer this over unsafe casting operations when type safety is critical for cryptographic operations.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IPublicKey">
            <summary>
            Defines the contract for cryptographic public keys.
            </summary>
            <remarks>
            This interface extends <see cref="T:Yubico.YubiKit.Core.Cryptography.IKeyBase"/> to include public key-specific operations
            for X.509 SubjectPublicKeyInfo export.
            <para>
            Concrete implementations include <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey"/>, <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPublicKey"/> and <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey"/>, each providing
            algorithm-specific public key handling and export mechanisms.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IPublicKey.ExportSubjectPublicKeyInfo">
            <summary>
            Exports the public-key portion of the current key in the X.509 SubjectPublicKeyInfo format.
            </summary>
            <returns>
            A byte array containing the X.509 SubjectPublicKeyInfo representation of the public-key portion of this key
            </returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IPublicKeyExtensions.Cast``1(Yubico.YubiKit.Core.Cryptography.IPublicKey)">
            <summary>
            Casts the given <see cref="T:Yubico.YubiKit.Core.Cryptography.IPublicKey"/> to the specified type.
            </summary>
            <param name="key"></param>
            <typeparam name="T"></typeparam>
            <returns></returns>
            <exception cref="T:System.InvalidCastException"></exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.KeyFamily">
            <summary>Structural key families, independent of operations and protocol identifiers.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyFamily.EllipticCurve">
            <summary>Elliptic-curve keys; the curve form and concrete construction are separate metadata.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyFamily.Rsa">
            <summary>RSA keys identified by their modulus size.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyFamily.Aes">
            <summary>Symmetric AES keys.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyFamily.TripleDes">
            <summary>Three-key Triple DES, including stored parity bits.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.KeyInfo">
            <summary>Immutable metadata for a concrete key representation. Contains no key material.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.KeyType">
            <summary>The concrete catalog identity, not an operation or protocol identifier.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.DisplayName">
            <summary>A human-readable label; use <see cref="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.KeyType"/> for identity.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.Family">
            <summary>The structural family, independent of operation selection.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.KeySizeBits">
            <summary>
            Nominal size: RSA modulus bits, ordinary EC field bits, or symmetric stored key bits (including
            Triple DES parity). For 25519 representations this retains the 256 stored-bit size, not the
            255-bit field size or security strength. See <see cref="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.Curve"/> for mathematical sizes.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.KeySizeBytes">
            <summary>
            RSA modulus width, ordinary EC coordinate width, or symmetric/25519 stored key width, in bytes.
            This is not the encoded public point length or a security-strength estimate. Use
            <see cref="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.PrivateValueLengthBytes"/> for scalar or seed widths, which can differ from coordinate widths.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.PrivateValueLengthBytes">
            <summary>Raw private scalar, seed, or symmetric value width; null for structured RSA keys.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.PublicValueLengthBytes">
            <summary>Uncompressed ordinary EC point or RFC 8410 public value width; null for other families.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.Curve">
            <summary>The mathematical curve, or null for RSA and symmetric families.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.Asn1">
            <summary>ASN.1 key representation, or null when no bare-key representation is modeled.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.Cose">
            <summary>Registered COSE kty/crv metadata, or null when no mapping is modeled; never selects an alg.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.IsEllipticCurve">
            <summary>Whether this key belongs to the elliptic-curve family, regardless of curve form.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.IsRsa">
            <summary>Whether this key belongs to the RSA family.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.IsAsymmetric">
            <summary>Whether this key belongs to an asymmetric family (RSA or elliptic curve).</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.IsSymmetric">
            <summary>Whether this key belongs to the AES or Triple DES family.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.IsShortWeierstrass">
            <summary>Whether the mathematical curve has short-Weierstrass form; does not select ECDSA over ECDH.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyInfo.ToString">
            <summary>Returns the display label and nominal size for diagnostics, not a persistence format.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.KeyType">
            <summary>
            Identifies a concrete supported cryptographic key variant, not an operation algorithm or wire identifier.
            </summary>
            <remarks>Numeric values are explicit. Enum names and ToString output are not a persistence contract.</remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.None">
            <summary>No concrete key; not a catalog entry.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.P256">
            <summary>Ordinary EC representation on NIST P-256.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.P384">
            <summary>Ordinary EC representation on NIST P-384.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.P521">
            <summary>Ordinary EC representation on NIST P-521.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.X25519">
            <summary>X25519 construction on the Montgomery Curve25519 curve.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Ed25519">
            <summary>Ed25519 construction on the Edwards25519 curve.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Rsa1024">
            <summary>RSA with a 1024-bit modulus; historical metadata, not a recommendation.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Rsa2048">
            <summary>RSA with a 2048-bit modulus.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Rsa3072">
            <summary>RSA with a 3072-bit modulus.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Rsa4096">
            <summary>RSA with a 4096-bit modulus.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.TripleDes">
            <summary>Three-key Triple DES, stored in 24 bytes including parity.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Aes128">
            <summary>AES with a 128-bit key, without an implied block mode.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Aes192">
            <summary>AES with a 192-bit key, without an implied block mode.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Aes256">
            <summary>AES with a 256-bit key, without an implied block mode.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.Secp256k1">
            <summary>Ordinary EC representation on secp256k1, distinct from P-256.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.BrainpoolP256r1">
            <summary>Ordinary EC representation on brainpoolP256r1.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.BrainpoolP384r1">
            <summary>Ordinary EC representation on brainpoolP384r1.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.KeyType.BrainpoolP512r1">
            <summary>Ordinary EC representation on brainpoolP512r1.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions">
            <summary>Queries shared metadata and structural classifications for concrete key identities.</summary>
            <remarks>
            These queries do not establish operation, codec, provider, hardware, slot or protocol-profile support.
            Metadata/size/mapping lookups reject <see cref="F:Yubico.YubiKit.Core.Cryptography.KeyType.None"/> and unknown values; classification
            predicates return false for them instead.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.GetKeyInfo(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Gets the catalog's immutable metadata instance for a concrete key.</summary>
            <param name="keyType">The concrete key identity, not a protocol identifier or operation algorithm.</param>
            <returns>The same instance as <see cref="M:Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions.Keys.Get(Yubico.YubiKit.Core.Cryptography.KeyType)"/>.</returns>
            <exception cref="T:System.ArgumentException"><paramref name="keyType"/> is None or is not in the catalog.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.GetKeySizeBits(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Gets the nominal key size in bits, not a security-strength estimate.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>
            RSA modulus bits, ordinary EC field bits, or stored symmetric/25519 key bits. The 25519 stored
            size is 256 bits despite its 255-bit field; Triple DES includes parity bits.
            </returns>
            <remarks>Use <see cref="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.Curve"/> for field/order sizes and representation-specific properties for encoded lengths.</remarks>
            <exception cref="T:System.ArgumentException"><paramref name="keyType"/> is None or is not in the catalog.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.GetKeySizeBytes(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Gets the key representation's nominal component width in bytes.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>RSA modulus width, ordinary EC coordinate width, or stored symmetric/25519 key width, in bytes.</returns>
            <remarks>This is not the encoded public point, SPKI or PKCS#8 length. See <see cref="P:Yubico.YubiKit.Core.Cryptography.KeyInfo.KeySizeBytes"/>.</remarks>
            <exception cref="T:System.ArgumentException"><paramref name="keyType"/> is None or is not in the catalog.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.HasCoseMapping(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Determines whether a known concrete key has registered COSE representation metadata.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>True when kty/crv metadata is modeled; false for a known unmapped key such as Triple DES.</returns>
            <remarks>A mapping does not choose an alg or establish codec, operation or profile support.</remarks>
            <exception cref="T:System.ArgumentException"><paramref name="keyType"/> is None or is not in the catalog.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.GetCoseKeyType(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Gets a known key's registered COSE key family (kty), when modeled.</summary>
            <param name="keyType">The concrete key identity, never a numeric COSE kty or crv.</param>
            <returns>The COSE family, or null for a known key without a modeled mapping.</returns>
            <exception cref="T:System.ArgumentException"><paramref name="keyType"/> is None or is not in the catalog.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.IsShortWeierstrass(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Determines whether the key uses a modeled ordinary short-Weierstrass curve.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>True for that mathematical form; false for other forms, other families, None or unknown values.</returns>
            <remarks>This structural predicate does not select ECDSA over ECDH or imply protocol support.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.IsCurve25519(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Determines whether the key uses the modeled Curve25519 or Edwards25519 construction.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>True for X25519 or Ed25519 representations; false for other keys, None or unknown values.</returns>
            <remarks>The Montgomery and Edwards forms and their public encodings remain distinct.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.IsAsymmetric(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Determines whether the key belongs to a modeled asymmetric family.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>True for RSA or elliptic-curve keys; false for other families, None or unknown values.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.IsSymmetric(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Determines whether the key belongs to a modeled symmetric family.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>True for AES or Triple DES keys; false for other families, None or unknown values.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.IsEllipticCurve(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Determines whether the key belongs to the modeled elliptic-curve family.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>True for short-Weierstrass, Montgomery or Edwards keys; false for other families, None or unknown values.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyTypeExtensions.IsRsa(Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>Determines whether the key belongs to the modeled RSA family.</summary>
            <param name="keyType">The concrete key identity.</param>
            <returns>True for RSA keys; false for other families, None or unknown values.</returns>
        </member>
