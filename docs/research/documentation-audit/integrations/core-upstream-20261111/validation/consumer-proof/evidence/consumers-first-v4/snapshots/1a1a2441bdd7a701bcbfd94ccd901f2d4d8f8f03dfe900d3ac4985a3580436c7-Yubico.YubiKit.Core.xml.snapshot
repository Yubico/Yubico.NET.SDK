        <member name="M:Yubico.YubiKit.Core.Cryptography.X963Kdf.DeriveKeyMaterial(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.Int32)">
            <summary>
                Core X9.63-2001 KDF implementation using SHA-256.
                Derives key material from shared secret Z and optional SharedInfo.
            </summary>
