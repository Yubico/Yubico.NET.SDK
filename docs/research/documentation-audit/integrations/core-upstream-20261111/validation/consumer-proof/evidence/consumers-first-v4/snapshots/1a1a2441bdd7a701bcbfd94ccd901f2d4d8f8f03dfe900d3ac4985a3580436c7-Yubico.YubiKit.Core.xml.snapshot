        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Asn1ParameterKind.NamedCurve">
            <summary>A single named-curve OBJECT IDENTIFIER is encoded after id-ecPublicKey.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.Asn1KeyInfo">
            <summary>ASN.1 key AlgorithmIdentifier metadata, not operation algorithm metadata.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Asn1KeyInfo.AlgorithmOid">
            <summary>The key AlgorithmIdentifier OID; shared identifiers do not determine a curve or RSA modulus size.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Asn1KeyInfo.ParameterKind">
            <summary>The parameters encoding emitted for this key representation.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.Asn1KeyInfo.NamedCurveOid">
            <summary>The curve OID used as parameters, or null unless <see cref="P:Yubico.YubiKit.Core.Cryptography.Asn1KeyInfo.ParameterKind"/> is NamedCurve.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder">
            <summary>
            A class that converts ASN.1 DER encoded private keys to parameters and values.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreatePrivateKey(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/> from a PKCS#8
            ASN.1 DER-encoded private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            A new disposable private-key object that owns its decoded key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">Thrown if privateKey does not match expected format.</exception>
            <exception cref="T:System.InvalidOperationException">Thrown if the algorithm is not supported</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreateCurve25519Key(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey"/> from a PKCS#8
            ASN.1 DER-encoded private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            A new disposable private-key object that owns its decoded key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">Thrown if privateKey does not match expected format.</exception>
            <exception cref="T:System.ArgumentException">Thrown if the algorithm is not <see cref="F:Yubico.YubiKit.Core.Cryptography.Oids.X25519"/> or 
            <see cref="F:Yubico.YubiKit.Core.Cryptography.Oids.Ed25519"/></exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.GetCurve25519PrivateKeyData(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes a Curve25519 private value and its key type from a PKCS#8 private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            A caller-owned 32-byte private-value array and the decoded key type. The caller must clear
            the returned array when it is no longer needed.
            </returns>
            <exception cref="T:System.ArgumentException">The algorithm is not X25519 or Ed25519.</exception>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The private-key encoding or length is invalid.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreateECParameters(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes elliptic-curve parameters from a PKCS#8 private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            Parameters containing caller-owned arrays. The caller must clear <see cref="F:System.Security.Cryptography.ECParameters.D"/>
            when the parameters are no longer needed.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The private-key encoding is invalid.</exception>
            <exception cref="T:System.InvalidOperationException">The algorithm or curve is unsupported.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreateRSAParameters(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes RSA parameters from a PKCS#8 private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            Parameters containing caller-owned arrays. The caller must clear the private parameter
            arrays when they are no longer needed.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The private-key encoding is invalid.</exception>
            <exception cref="T:System.InvalidOperationException">The algorithm is unsupported.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder">
            <summary>
            A class that converts private key parameters to ASN.1 DER encoding.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.ReadOnlyMemory{System.Byte},System.Nullable{System.ReadOnlyMemory{System.Byte}},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Converts a private key and its corresponding public point to ASN.1 DER encoded format.
            </summary>
            <param name="privateKey">The private key as a byte array.</param>
            <param name="publicPoint">The public key point as a byte array (optional).</param>
            <param name="keyType">The type of the key.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key.</returns>
            <remarks>
            Both EC overloads validate scalar width against the named curve. Curve25519 encodings retain
            the exact imported 32 bytes and RFC 8410's absent algorithm parameters.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Converts a private key and key type to ASN.1 DER encoded format in PKCS#8 structure.
            </summary>
            <param name="privateKey">The private key as a byte array.</param>
            <param name="keyType">The type of the key.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key in PKCS#8 format.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.Security.Cryptography.RSAParameters)">
            <summary>
            Converts RSA private key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The RSA parameters including private key values.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key in PKCS#8 format.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.Security.Cryptography.ECParameters)">
            <summary>
            Converts EC private key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The EC parameters including private key value.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key in PKCS#8 format.</returns>
            <exception cref="T:System.ArgumentException">
            The private key parameter D is null or is not the curve's coordinate size, the curve is not
            a modeled short-Weierstrass curve, or the public point is half supplied (exactly one of
            <c>Q.X</c> and <c>Q.Y</c> is null).
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeECKey(System.ReadOnlyMemory{System.Byte},System.String,System.Nullable{System.ReadOnlyMemory{System.Byte}})">
            <summary>
            Creates an EC private key encoded in ASN.1 DER format.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyDecoder">
            <summary>
            A class that converts ASN.1 DER encoded X.509 SubjectPublicKeyInfo to instances of IPublicKey.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyDecoder.CreatePublicKey(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.IPublicKey"/> from a
            ASN.1 DER-encoded SubjectPublicKeyInfo.
            </summary>
            <param name="subjectPublicKeyInfo">
            The ASN.1 DER-encoded SubjectPublicKeyInfo.
            </param>
            <returns>
            A new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.IPublicKey"/>.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">Thrown if public key does not match expected format.</exception>
            <exception cref="T:System.InvalidOperationException">Thrown if the algorithm is not supported</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder">
            <summary>
            A class that converts public key parameters to ASN.1 DER encoding.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Converts a public point and key type to ASN.1 DER encoded format.
            </summary>
            <param name="publicPoint">The public key point as a byte array.</param>
            <param name="keyType">The type of the key.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.ReadOnlyMemory{System.Byte},System.ReadOnlyMemory{System.Byte})">
            <summary>
            Converts an RSA public key from modulus and exponent to ASN.1 DER encoded format.
            </summary>
            <param name="modulus">The modulus of the RSA key as a byte array.</param>
            <param name="exponent">The exponent of the RSA key as a byte array.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.Security.Cryptography.RSAParameters)">
            <summary>
            Converts RSA public key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The RSA public key parameters.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.Security.Cryptography.ECParameters)">
            <summary>
            Converts EC public key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The EC public key parameters.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.EcPointDefect">
            <summary>
            Why an EC point failed <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.InspectUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.Int32)"/>.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.None">
            <summary>The point is a well-formed uncompressed point for the curve.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.Empty">
            <summary>The point has no octets at all, so there is no format prefix to inspect.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.NotUncompressed">
            <summary>The point does not start with the 0x04 uncompressed-format prefix.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.WrongLength">
            <summary>The point is not exactly <c>1 + 2 * coordinateLengthBytes</c> octets long.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.InspectUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.Int32)">
            <summary>
            The single authority on the shape of an EC point in this SDK: an uncompressed point is
            <c>0x04 || X || Y</c> with both coordinates exactly the curve's coordinate size.
            </summary>
            <remarks>
            <para>This mirrors the strictness of the Rust <c>yubikit</c> crate. Compressed and hybrid
            point formats are deliberately rejected rather than decompressed. Callers translate the
            result into the exception type their layer owes: <see cref="T:System.Security.Cryptography.CryptographicException"/> for
            malformed encoded key data, and <see cref="T:System.ArgumentException"/> for bad caller-supplied
            input.</para>
            <para>That split governs <em>point shape</em> only. Whether a curve is supported at all is
            each decoder's own concern and each rejects it before reaching this file:
            <c>AsnPublicKeyDecoder</c> throws <see cref="T:System.NotSupportedException"/> and
            <c>AsnPrivateKeyDecoder</c> throws <see cref="T:System.InvalidOperationException"/>. The
            <see cref="T:System.Security.Cryptography.CryptographicException"/> that <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetDecodedCoordinateLengthBytes(System.String)"/> raises for
            an unsupported curve is therefore a defensive backstop, not a taxonomy this file imposes on
            its callers.</para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.ValidateDecodedEcPoint(System.ReadOnlySpan{System.Byte},System.String)">
            <summary>
            Validates an EC point that was read out of an encoded key. Malformed encoded data is a
            <see cref="T:System.Security.Cryptography.CryptographicException"/>, never an argument exception.
            </summary>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
            The point is not a valid uncompressed point, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.ValidateEcPointArgument(System.ReadOnlySpan{System.Byte},System.String,System.String)">
            <summary>
            Validates an EC point supplied by a caller of an encoder. Bad caller input is an
            <see cref="T:System.ArgumentException"/>, never a <see cref="T:System.Security.Cryptography.CryptographicException"/>.
            </summary>
            <exception cref="T:System.ArgumentException">
            The point is not a valid uncompressed point, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.BuildUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.String,System.String)">
            <summary>
            Builds the uncompressed point <c>0x04 || X || Y</c> for the named curve, rejecting
            coordinates that are not exactly the curve's coordinate size.
            </summary>
            <remarks>
            Checking each coordinate separately is stricter than checking the assembled point, because
            an oversized X paired with an undersized Y produces a correctly sized but silently wrong point.
            </remarks>
            <exception cref="T:System.ArgumentException">
            A coordinate does not match the curve, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.ValidateEcPrivateScalarArgument(System.ReadOnlySpan{System.Byte},System.String,System.String)">
            <summary>
            Validates a caller-supplied EC private scalar against the curve it will be encoded under,
            and in doing so gates the curve OID itself before it is written into an
            <c>id-ecPublicKey</c> AlgorithmIdentifier.
            </summary>
            <remarks>
            The scalar of an RFC 5915 <c>ECPrivateKey</c> is a fixed-width, left-padded integer of the
            curve's subgroup-order width. Any other width contradicts the curve parameter sitting in the same
            structure. The message reports lengths only: the value being rejected is key material.
            </remarks>
            <exception cref="T:System.ArgumentException">
            The scalar does not match the curve, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetDecodedCoordinateLengthBytes(System.String)">
            <summary>
            Resolves the coordinate size of an EC point read out of encoded key data.
            </summary>
            <remarks>
            Both decoders reject an unsupported curve before calling in here, each with its own
            exception type, so the throwing branch is a backstop that no production caller reaches. See
            the remarks on <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.InspectUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.Int32)"/>.
            </remarks>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The curve is not a supported prime curve.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetCoordinateLengthBytesArgument(System.String,System.String)">
            <summary>
            Resolves the coordinate size for a curve OID supplied by a caller of an encoder.
            </summary>
            <exception cref="T:System.ArgumentException">The curve is not a supported prime curve.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.TryGetCoordinateLengthBytes(System.String,System.Int32@)">
            <summary>
            Resolves the coordinate size of one of the EC prime curves this SDK supports.
            </summary>
            <remarks>
            Only the named-curve index is consulted. A key algorithm or CBC operation OID must never
            pass an ordinary EC point check just because its key representation has the same width.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetOwnedIntegerContentOctets(System.ReadOnlySpan{System.Byte})">
            <summary>
            Returns a newly allocated buffer containing the minimal positive ASN.1 INTEGER content octets.
            </summary>
            <remarks>
            Unlike <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetIntegerBytes(System.Span{System.Byte})"/>, this method never aliases the input.
            The caller owns the returned buffer and is responsible for zeroing it when it contains
            sensitive material.
            </remarks>
        </member>
