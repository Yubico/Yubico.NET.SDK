        <member name="T:Yubico.YubiKit.Core.Devices.HidConnectionSlot">
            <summary>One live enumerated HID interface candidate that can open its raw FIDO or OTP connection.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.HidConnectionSlot.ConnectionType">
            <summary>Either <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidFido" /> or <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidOtp" /> (ctor-enforced).</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.HidConnectionSlot.OwnsNativeLifetime">
            <summary>The built-in connection accepts its claim before acquiring native resources.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.HidConnectionSlot.OpenRegisteredConnectionAsync(System.IDisposable,System.Threading.CancellationToken)">
            <summary>Transfers a registry connection or discovery claim to the built-in native owner before open.</summary>
            <param name="physicalClaim">
            The opaque release token acquired by <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyDevice" /> or discovery. The native owner,
            not the caller, releases it after proven native cleanup, including failed or canceled opens;
            uncertain release retains the claim. It is not the connection being opened.
            </param>
            <param name="cancellationToken">Requests cancellation without detaching native acquisition or cleanup.</param>
            <returns>The opened connection after the owner has accepted responsibility for the claim.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.HidConnectionSlot.OpenBuiltInConnectionAsync(System.IDisposable,System.Threading.CancellationToken)">
            <summary>Opens a built-in macOS/Linux connection with an optional transferred physical claim.</summary>
            <param name="physicalClaim">
            Registry/discovery release token, or <see langword="null" /> for an unregistered raw open.
            Forwarded unchanged: the registry encapsulates concrete token types and quarantine handling.
            </param>
            <param name="cancellationToken">Passed to the native owner even when already canceled.</param>
            <remarks>
            Do not short-circuit cancellation here: after transfer the native owner alone releases the claim,
            including a pre-canceled open. Raw callers checked cancellation before reaching this route.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.HotplugSignals">
            <summary>Starts optional transport listeners and coalesces their rescan hints.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.HotplugSignals.#ctor(System.Collections.Generic.IReadOnlyList{Yubico.YubiKit.Core.Devices.ListenerSource},Microsoft.Extensions.Logging.ILogger)">
            <summary>Creates and starts each listener, logging failures without preventing other listeners from starting.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.HotplugSignals.Dispose">
            <summary>Clears all callbacks, stops all listeners, disposes all listeners, then completes the signal channel.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.ListenerSource">
            <summary>Pairs a transport hint with its listener factory.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.ListenerSource.#ctor(Yubico.YubiKit.Core.Devices.ConnectionType,System.Func{Yubico.YubiKit.Core.Transports.IDeviceChangeListener})">
            <summary>Pairs a transport hint with its listener factory.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.IDeviceTopologyResolver">
            <summary>
                Resolves an OPTIONAL per-interface topology key that identifies the physical USB device an interface
                belongs to — the strongest evidence tier in composite grouping (tier 1, above serial and PID).
            </summary>
            <remarks>
                <para>
                    Topology evidence is optional by contract. It is absent on macOS and Linux (no supported
                    reader-name → USB-device mapping exists on either platform), and absent on Windows whenever the
                    topology read fails — a stale devnode mid-hotplug, <c>CR_NO_SUCH_DEVNODE</c>, a missing
                    ContainerId property, or the API being unavailable. A resolver NEVER guesses: it either returns a
                    key it read, or returns <c>false</c>.
                </para>
                <para>
                    When no key is available the interface falls through to the unchanged serial / PID-complete /
                    deduction / conservative tiers, so a topology failure degrades Windows to exactly the
                    macOS/Linux semantics.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IDeviceTopologyResolver.TryGetTopologyKey(Yubico.YubiKit.Core.Abstractions.IDevice,Yubico.YubiKit.Core.Devices.ConnectionType,System.String@)">
            <summary>
                Attempts to read the topology key grouping <paramref name="device" />'s interface with the other
                interfaces of the same physical USB device.
            </summary>
            <returns><c>true</c> and a non-empty key when topology evidence was read; otherwise <c>false</c>.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.NullDeviceTopologyResolver">
            <summary>
                The no-topology resolver used on platforms with no supported reader/interface → USB device mapping
                (macOS, Linux). Always reports "unknown", which is the documented platform bound.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.DeviceTopologyResolver">
            <summary>
                Platform selection for <see cref="T:Yubico.YubiKit.Core.Devices.IDeviceTopologyResolver" />, mirroring the repo's
                <see cref="T:Yubico.YubiKit.Core.Native.SdkPlatformInfo" /> factory pattern.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.DeviceTopologyResolver.Create">
            <summary>
                The Windows Container-ID resolver on Windows; the no-topology resolver everywhere else. The
                Windows implementation is constructed only on Windows, so no Windows-only native entry point is
                bound on other platforms.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.IDiscoveryConnectionProvider">
            <summary>
                Internal connection path used only while the caller holds the interface's discovery lease. Unlike a
                normal session connect, this path does not attempt to acquire shared session ownership itself.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.IMonitoredDiscovery">
            <summary>Discovery and evidence lifetime owned by a monitor.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IMonitoredDiscovery.FindAllAsync(System.Threading.CancellationToken)">
            <summary>Discovers all YubiKeys in this finder's scope.</summary>
            <param name="cancellationToken">Cancels the scan's wait.</param>
            <returns>The physical keys observed by the scan.</returns>
            <exception cref="T:System.OperationCanceledException">The scan was canceled.</exception>
            <exception cref="T:System.TimeoutException">
            A transport's interface enumeration exceeded its budget. The result would be partial, so nothing is returned
            for the monitor to publish; the next trigger scans again.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IMonitoredDiscovery.InvalidateEvidence(Yubico.YubiKit.Core.Devices.ConnectionType)">
            <summary>Discards cached evidence and supersedes pending reads after transport activity.</summary>
            <param name="transport">The transport reporting activity, not an eviction scope.</param>
            <remarks>Called by the monitor's scan loop before the scan a hotplug trigger requests. Does not reactivate retired discovery.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IMonitoredDiscovery.Retire">
            <summary>Permanently retires discovery reads without releasing already-open native work.</summary>
            <remarks>The monitor must stop its listeners and end its scan loop before calling this method.</remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.IYubiKeyConnectionSlot">
            <summary>
                One concrete transport slot that can open its raw, unregistered connection.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.IYubiKeyConnectionSlot.InterfaceId">
            <summary>The stable identifier for this enumerated interface.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.IYubiKeyConnectionSlot.ConnectionType">
            <summary>The single concrete connection exposed by this slot.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IYubiKeyConnectionSlot.OpenRawConnectionAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Threading.CancellationToken)">
            <summary>Opens this slot's raw, unregistered connection.</summary>
            <remarks>
                The default exists for non-openable or fake slot implementations. It throws the narrow
                <see cref="T:Yubico.YubiKit.Core.Devices.NonOpenableConnectionSlotException" /> so published-device discovery can translate
                that case to a typed skip without misclassifying failures from real transport implementations.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.NonOpenableConnectionSlotException">
            <summary>Identifies a slot that relies on the non-openable default raw-connection implementation.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.NonOpenableConnectionSlotException.#ctor(System.String)">
            <summary>Identifies a slot that relies on the non-openable default raw-connection implementation.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.PcscConnectionSlot">
            <summary>One live enumerated PC/SC interface candidate that can open its raw smart-card connection.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.ProtocolDeviceInfo">
            <summary>
                Reads <see cref="T:Yubico.YubiKit.Core.Devices.DeviceInfo"/> over an already-open connection by building the matching Core protocol.
            </summary>
            <remarks>
                Borrows the supplied connection. It builds and disposes the matching protocol before returning, but
                protocol disposal does not dispose the connection. The caller retains ownership and must dispose the
                connection. Shared by discovery's serial-disambiguation read and the composite metadata read.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.ReaderNamePidParser">
            <summary>
                Derives a YubiKey USB Product ID from a PC/SC reader name, and identifies known Yubico PIDs.
            </summary>
            <remarks>
                Composite discovery correlates the interfaces of one physical USB YubiKey by USB Product ID. The CCID
                interface exposes no PID directly, but a USB YubiKey's PC/SC reader name encodes its enabled USB
                interfaces (e.g. "Yubico YubiKey OTP+FIDO+CCID 00 00"), which maps deterministically to a PID. This
                mirrors the Rust reference (<c>pid_from_reader_name</c> / <c>pid_from_interfaces</c>). HID interfaces
                use their real descriptor <c>ProductId</c> instead; this parser is for the CCID reader name only.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.ReaderNamePidParser.SkyPid">
            <summary>
                The Security Key (SKY) USB Product ID. SKY is FIDO-HID-only and has no CCID reader; its PID is read
                from the HID descriptor, not parsed from a reader name.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.ReaderNamePidParser.KnownPids">
            <summary>All USB Product IDs this parser can produce, plus SKY. Used to gate mergeability.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.ReaderNamePidParser.IsKnownPid(System.UInt16)">
            <summary>Whether <paramref name="pid"/> is a known Yubico USB Product ID usable as a merge key.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.ReaderNamePidParser.IsSky(System.UInt16)">
            <summary>Whether <paramref name="pid"/> is the Security Key (SKY) Product ID.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.ReaderNamePidParser.ExpectedConnectionsForPid(System.UInt16)">
            <summary>Returns the concrete USB interfaces encoded by a known Yubico Product ID.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.ReaderNamePidParser.FromReaderName(System.String)">
            <summary>
                Parses the USB Product ID from a USB YubiKey PC/SC reader name, or returns <c>null</c> when the name
                is not a recognizable USB Yubico reader or the interface combination is not a valid YubiKey PID.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.RegisteredSmartCardConnection">
            <summary>
                Transparent connection decorators that release a <see cref="T:Yubico.YubiKit.Core.Devices.DeviceConnectionRegistry" /> ownership lease
                exactly once when the wrapped connection is disposed. Disposal runs through a <see cref="T:Yubico.YubiKit.Core.Devices.DisposalGate" />,
                so the inner connection is torn down exactly once, the lease is released only afterwards, and every
                disposal call — sync or async, concurrent or repeated — returns only once teardown has finished. Pure
                passthrough otherwise — behavior of the inner connection is unchanged.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.RegisteredSmartCardConnection.#ctor(Yubico.YubiKit.Core.Transports.SmartCard.ISmartCardConnection,System.IDisposable)">
            <summary>
                Transparent connection decorators that release a <see cref="T:Yubico.YubiKit.Core.Devices.DeviceConnectionRegistry" /> ownership lease
                exactly once when the wrapped connection is disposed. Disposal runs through a <see cref="T:Yubico.YubiKit.Core.Devices.DisposalGate" />,
                so the inner connection is torn down exactly once, the lease is released only afterwards, and every
                disposal call — sync or async, concurrent or repeated — returns only once teardown has finished. Pure
                passthrough otherwise — behavior of the inner connection is unchanged.
            </summary>
        </member>
