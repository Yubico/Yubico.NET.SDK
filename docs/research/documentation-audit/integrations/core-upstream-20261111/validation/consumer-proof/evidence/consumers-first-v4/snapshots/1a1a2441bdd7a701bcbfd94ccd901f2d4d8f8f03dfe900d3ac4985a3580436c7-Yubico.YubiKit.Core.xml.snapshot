        <member name="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException">
            <summary>
                The exception that is thrown when an ISO 7816 application has encountered an error.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException.#ctor">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException" /> class with a default message.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException.#ctor(System.String)">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException" /> class with a specified error
                message.
            </summary>
            <param name="message">The message that describes the error.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException.#ctor(System.String,System.Exception)">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException" /> class with a specified error
                message and a reference to the inner exception that is the cause of this exception.
            </summary>
            <param name="message">The error message that explains the reason for the exception.</param>
            <param name="innerException">
                The exception that is the cause of the current exception,
                or a null reference (<see langword="Nothing" /> in Visual Basic) if no inner exception
                is specified.
            </param>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException.SW">
            <summary>
                Gets or sets the status word (SW), the ISO 7816 numerical value which represents
                the specific error or warning encountered.
            </summary>
            <value>
                The status word value. This can either be an industry defined error, or vendor defined.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException.Cla">
            <summary>
                Gets or sets the APDU class associated with this exception.
            </summary>
            <value>
                The class value of the command APDU when the exception occurred.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException.Ins">
            <summary>
                Gets or sets the APDU instruction associated with this exception.
            </summary>
            <value>
