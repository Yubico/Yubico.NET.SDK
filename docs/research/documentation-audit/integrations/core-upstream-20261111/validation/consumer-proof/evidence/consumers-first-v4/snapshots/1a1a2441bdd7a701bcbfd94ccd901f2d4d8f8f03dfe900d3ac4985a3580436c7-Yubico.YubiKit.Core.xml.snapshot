            <param name="additionalContext">Optional additional context to include in the error message.</param>
            <returns>A new <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException" /> with status word and descriptive message.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse">
            <summary>
                Represents an ISO 7816 application response.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.#ctor(System.ReadOnlyMemory{System.Byte})">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse" /> class.
            </summary>
            <param name="data">The raw data returned by the ISO 7816 smart card.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.#ctor(System.Byte[],System.Int16)">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse" /> class.
            </summary>
            <param name="dataWithoutSW">
                The raw data returned by the ISO 7816 smart card without the
                trailing status bytes.
            </param>
            <param name="sw">The status word, 'SW', for the APDU response.</param>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.RawData">
            <summary>
                Gets the raw response data including the status word bytes.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.SW">
            <summary>
                The status word (two byte) code which represents the overall result of a CCID interaction.
                The most common value is 0x9000 which represents a successful result.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.SW1">
            <summary>
                A convenience property accessor for the high byte of SW
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.SW2">
            <summary>
                A convenience property accessor for the low byte of SW
            </summary>
        </member>
