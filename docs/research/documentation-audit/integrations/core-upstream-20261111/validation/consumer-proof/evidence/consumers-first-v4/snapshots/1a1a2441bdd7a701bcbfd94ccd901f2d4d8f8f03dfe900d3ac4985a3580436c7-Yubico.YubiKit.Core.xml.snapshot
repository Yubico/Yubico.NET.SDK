        <member name="T:Yubico.YubiKit.Core.Cryptography.PrivateKey">
            <summary>
            Abstract base class for private key implementations.
            </summary>
            <remarks>
            This class implements the standard .NET disposal pattern to ensure secure cleanup
            of sensitive cryptographic material and provides disposal state checking for derived classes.
            <para>
            Concrete implementations include <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/>, <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey"/> and <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey"/>,
            each providing algorithm-specific key handling and cryptographic operations.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.PrivateKey.KeyInfo">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.PrivateKey.KeyType">
            <inheritdoc /> 
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.ExportPkcs8PrivateKey">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.Clear">
            <inheritdoc /> 
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.Dispose">
            <summary>
            Clears the private key data and disposes the object
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.ThrowIfDisposed">
            <summary>
            Throws an <see cref="T:System.ObjectDisposedException"/> if this instance has been disposed.
            </summary>
            <exception cref="T:System.ObjectDisposedException">
            Thrown when this method is called after the object has been disposed.
            </exception>
            <remarks>
            This method should be called at the beginning of all public methods and properties
            in derived classes to prevent operations on disposed cryptographic key material.
            The exception message includes the concrete type name for debugging purposes.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.PrivateKeyConsistency">
            <summary>
                Checks that the public and private components of a key belong together before the SDK wraps
                them. The YubiKey derives its own public key from the private material it is sent, so a wrapper
                that reported an unrelated public component would describe a key the device never had.
            </summary>
            <remarks>
                <para>
                    References: RFC 8017 §3.1 (λ(n)), §3.2 (private key representation and e·d ≡ 1 mod λ(n)),
                    Appendix A.1.2 (CRT components); SEC 1 v2 §3.2.2 / FIPS 186-5 §6.2.1 (Q = d·G).
                </para>
                <para>
                    <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey" /> needs no counterpart here: it holds no public value and the
                    decoder rejects a PKCS#8 v2 <c>publicKey</c> field, so it can never carry an unchecked one.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKeyConsistency.ThrowIfPublicPointDoesNotMatch(System.Security.Cryptography.ECParameters@)">
            <summary>
                Verifies that <c>Q = d·G</c> by signing a fixed digest with the key as supplied and verifying
                with a public-only key built from the same <c>Q</c>. A signature made with <c>d</c> verifies
                under <c>Q</c> only if they match; an off-curve <c>Q</c> fails the same way. No D-only key is
                ever imported, so no public point is derived by the runtime.
            </summary>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The point does not match the scalar, or is invalid.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKeyConsistency.ThrowIfInconsistent(System.Security.Cryptography.RSAParameters@)">
            <summary>
                Verifies the RSA relations of RFC 8017 §3.1, §3.2 and Appendix A.1.2:
                <c>n = p·q</c>, <c>dP = d mod (p−1)</c>, <c>dQ = d mod (q−1)</c>, <c>qInv·q ≡ 1 (mod p)</c> and
                <c>e·d ≡ 1 (mod lcm(p−1, q−1))</c>.
            </summary>
            <remarks>
                Uses <see cref="T:System.Numerics.BigInteger" />, which is neither constant-time nor zeroable. The private values
                already exist in the caller-supplied managed arrays, so this adds no exposure the import does not
                already have.
            </remarks>
            <exception cref="T:System.Security.Cryptography.CryptographicException">A component is missing or a relation does not hold.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.PublicKey">
            <summary>
            Abstract base class for public key implementations.
            </summary>
            <remarks>
            This class provides common structure for public key types, requiring derived classes
            to implement key type identification and X.509 export operations.
            <para>
            Concrete implementations include <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey"/>, <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPublicKey"/> and <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey"/>, each providing
            algorithm-specific public key handling and export mechanisms.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.PublicKey.KeyInfo">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.PublicKey.KeyType">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PublicKey.ExportSubjectPublicKeyInfo">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAParametersExtensions.DeepCopy(System.Security.Cryptography.RSAParameters)">
            <summary>
            Performs a deep copy of the RSA parameters.
            </summary>
            <param name="original">The original RSAParameters to copy.</param>
            <returns>A new RSAParameters with the same values as the original.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAParametersExtensions.NormalizeParameters(System.Security.Cryptography.RSAParameters)">
            <summary>
            Normalizes the RSA parameters to ensure consistent cross-platform behavior:
            - If D is present, it must have the same length as Modulus
            - If D is present, P, Q, DP, DQ, and InverseQ are required and must have half the length of Modulus (rounded up)
            
            This ensures compatibility with stricter platforms like Windows BCrypt while preserving the original key data.
            </summary>
            <param name="parameters">The RSA parameters to normalize</param>
            <returns>A new (copied) RSAParameters with normalized values</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAParametersExtensions.PadToLength(System.Byte[],System.Int32)">
            <summary>
            Pads a byte array to the specified length by adding leading zeros.
            This preserves the value of the array while ensuring it meets length requirements.
            Leading zeros do not change the mathematical value of the integer.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey">
            <summary>
            Represents the parameters for an RSA private key.
            </summary>
            <remarks>
            This class encapsulates the parameters specific to RSA private keys 
            and provides factory methods for creating instances from RSA parameters
            or DER-encoded data.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.Parameters">
            <summary>
            Gets the RSA cryptographic parameters required for the private key operations.
            </summary>
            <value>
            A structure containing the RSA parameters. The array fields are owned by this object, must
            not be modified or cleared by the caller, and are cleared when the object is disposed.
            </value>
            <remarks>
            This property provides access to the fundamental mathematical components needed for RSA private key operations.
            The parameters are used in cryptographic operations such as decryption and digital signature creation.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.KeyInfo">
            <summary>
            Gets the metadata associated with this RSA private key.
            </summary>
            <value>
            A <see cref="P:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.KeyInfo"/> object that describes the key's representation.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.KeyType">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.#ctor(System.Security.Cryptography.RSAParameters,System.Action{System.Security.Cryptography.RSAParameters})">
            <exception cref="T:System.Security.Cryptography.CryptographicException">
                Thrown when a component is missing or the RFC 8017 relations between <c>n, e, d, p, q, dP, dQ, qInv</c>
                do not hold.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.ExportPkcs8PrivateKey">
            <summary>
            Exports the RSA private key in PKCS#8 DER encoded format.
            </summary>
            <returns>A byte array containing the DER encoded private key.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.Clear">
            <summary>
            Securely clears the RSA private key by zeroing out all parameters.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.CreateFromPkcs8(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates a new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey"/> from a DER-encoded
            PKCS#8 private key.
            </summary>
            <param name="encodedKey">
            The borrowed DER-encoded PKCS#8 private key. This method copies the decoded key material and
            does not modify or clear the input.
            </param>
            <returns>
            A new disposable key that owns and clears its copied private-key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
            Thrown if the private key is invalid.
            </exception>
            <exception cref="T:System.NotSupportedException">
            When the RSA key length is not supported.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey.CreateFromParameters(System.Security.Cryptography.RSAParameters)">
            <summary>
            Creates a new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey"/> from the given
            <paramref name="parameters"/>.
            </summary>
            <param name="parameters">
            The borrowed RSA parameters to copy. The caller retains ownership of every input array and
            remains responsible for clearing sensitive arrays.
            </param>
            <returns>
            A new disposable key that owns and clears its copied private-key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
            A component is missing or the RFC 8017 relations between the components do not hold.
            </exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.RSAPublicKey">
            <summary>
            Represents an RSA public key.
            </summary>
            <remarks>
            This sealed class encapsulates RSA public key parameters (Modulus and Exponent)
            and provides factory methods for creating instances from RSA parameters or DER-encoded data.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.RSAPublicKey.Parameters">
