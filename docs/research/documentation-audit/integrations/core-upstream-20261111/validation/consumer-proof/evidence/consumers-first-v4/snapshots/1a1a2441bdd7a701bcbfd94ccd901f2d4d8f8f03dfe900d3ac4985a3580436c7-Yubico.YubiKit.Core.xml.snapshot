        <member name="M:Yubico.YubiKit.Core.Transports.Hid.Linux.LinuxHidReportApi.Write(Yubico.YubiKit.Core.Native.Linux.Libc.LinuxFileSafeHandle,System.ReadOnlySpan{System.Byte})">
