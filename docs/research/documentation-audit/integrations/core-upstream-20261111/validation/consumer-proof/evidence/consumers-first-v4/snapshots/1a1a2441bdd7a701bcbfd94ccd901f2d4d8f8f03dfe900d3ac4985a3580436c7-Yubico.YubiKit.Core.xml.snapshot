            <param name="buffer">The buffer to be checksummed.</param>
            <returns>A two byte CRC checksum.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer">
            <summary>
            A disposable buffer backed by <see cref="T:System.Buffers.ArrayPool`1"/> that securely clears memory on disposal.
            Implements <see cref="T:System.Buffers.IMemoryOwner`1"/> for compatibility with async APIs.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer.#ctor(System.Int32,System.Boolean)">
            <summary>
            Creates a new buffer of the specified size from the shared array pool.
            </summary>
            <param name="size">The size of the buffer to allocate.</param>
            <param name="clearOnCreate">If true, zeros the buffer after allocation. Defaults to true.</param>
            <exception cref="T:System.ArgumentOutOfRangeException">Thrown when size is zero or negative.</exception>
        </member>
        <member name="P:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer.Memory">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer.Span">
            <summary>
            Gets a span over the buffer's memory.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer.Length">
            <summary>
            Gets the logical length of the buffer.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer.CreateFromSpan(System.ReadOnlySpan{System.Byte})">
            <summary>
            Creates a buffer from a source span, copying the data.
            </summary>
            <param name="source">The source data to copy into the new buffer.</param>
            <returns>A new buffer containing a copy of the source data.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer.Dispose">
            <inheritdoc />
        </member>
        <member name="T:Yubico.YubiKit.Core.Utilities.DisposableBufferHandle">
            <summary>
                Wraps a <see cref="T:System.Memory`1"/> buffer and zeroes it when disposed.
            </summary>
            <remarks>
                <b>Ownership transfer:</b> This type takes ownership of the provided buffer.
                The buffer is zeroed via <see cref="M:System.Security.Cryptography.CryptographicOperations.ZeroMemory(System.Span{System.Byte})"/>
                when <see cref="M:Yubico.YubiKit.Core.Utilities.DisposableBufferHandle.Dispose"/> is called. Callers must not read from or write to
                the original <paramref name="data"/> after disposing this handle.
                Always pass a freshly-allocated or rented buffer — never wrap caller-held memory
                that must survive beyond the scope of this handle.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableBufferHandle.#ctor(System.Memory{System.Byte})">
            <summary>
                Wraps a <see cref="T:System.Memory`1"/> buffer and zeroes it when disposed.
            </summary>
            <remarks>
                <b>Ownership transfer:</b> This type takes ownership of the provided buffer.
                The buffer is zeroed via <see cref="M:System.Security.Cryptography.CryptographicOperations.ZeroMemory(System.Span{System.Byte})"/>
                when <see cref="M:Yubico.YubiKit.Core.Utilities.DisposableBufferHandle.Dispose"/> is called. Callers must not read from or write to
                the original <paramref name="data"/> after disposing this handle.
                Always pass a freshly-allocated or rented buffer — never wrap caller-held memory
                that must survive beyond the scope of this handle.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Utilities.DisposableTlvList">
            <summary>
                A disposable collection of TLV objects that ensures all contained TLVs are properly disposed.
            </summary>
            <remarks>
                This class is used to manage the lifetime of multiple TLV objects, ensuring that sensitive
                cryptographic data is properly zeroed out when no longer needed.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableTlvList.#ctor(Yubico.YubiKit.Core.Utilities.Tlv[])">
            <summary>
                Creates a new collection with the specified TLV objects.
            </summary>
            <param name="tlvs">The TLV objects to include in the collection.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableTlvList.#ctor(System.Collections.Generic.IEnumerable{Yubico.YubiKit.Core.Utilities.Tlv})">
            <summary>
                Creates a new collection from an enumerable of TLV objects.
            </summary>
            <param name="tlvs">The TLV objects to include in the collection.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableTlvList.Dispose">
            <summary>
                Disposes all TLV objects in the collection, securely zeroing their data.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Utilities.DisposableTlvList.Item(System.Int32)">
            <summary>
                Gets the TLV object at the specified index.
            </summary>
            <param name="index">The zero-based index of the TLV to get.</param>
            <returns>The TLV at the specified index.</returns>
        </member>
        <member name="P:Yubico.YubiKit.Core.Utilities.DisposableTlvList.Count">
            <summary>
                Gets the number of TLV objects in the collection.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableTlvList.GetEnumerator">
            <summary>
                Returns an enumerator that iterates through the collection.
            </summary>
            <returns>An enumerator for the collection.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.DisposableTlvList.AsSpan">
            <summary>
                Returns a span view of the collection for efficient iteration.
            </summary>
            <returns>A span containing all TLV objects in the collection.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Utilities.ExchangeGuard">
            <summary>
                Refuses overlapping logical exchanges against a stateful sequential peer (a smart card or HID device).
                Callers wrap a <em>complete</em> multi-step exchange so no foreign traffic can interleave it on the
                shared underlying connection.
            </summary>
            <remarks>
                <para>
                    Sessions support one operation at a time. An overlapping caller receives an
                    <see cref="T:System.InvalidOperationException" /> immediately rather than waiting. Once entered, the exchange
                    runs to completion: the delegate receives
                    <see cref="P:System.Threading.CancellationToken.None" />, so a caller's token can never abort a logical exchange
                    between its constituent transmits (which would strand chained command/response or SCP MAC state
                    on the card and poison the next caller's exchange).
                </para>
                <para>
                    The guard must not be re-entered from within a running exchange. Keep the wrapped delegate confined
                    to transport/processor calls that never call back into guarded methods.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.ExchangeGuard.RunAsync``1(System.Func{System.Threading.CancellationToken,System.Threading.Tasks.Task{``0}},System.Threading.CancellationToken)">
            <summary>
                Runs <paramref name="exchange" /> exclusively; overlapping calls are refused immediately.
                A pre-canceled <paramref name="cancellationToken" /> throws before the guard is claimed.
                The delegate is invoked with <see cref="P:System.Threading.CancellationToken.None" /> so the in-flight exchange always
                completes.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.ExchangeGuard.RunAsync(System.Func{System.Threading.CancellationToken,System.Threading.Tasks.Task},System.Threading.CancellationToken)">
            <summary>
                Result-free overload of <see cref="M:Yubico.YubiKit.Core.Utilities.ExchangeGuard.RunAsync``1(System.Func{System.Threading.CancellationToken,System.Threading.Tasks.Task{``0}},System.Threading.CancellationToken)" /> for exchanges whose only purpose is their side
                effect (lazy initialization, for example).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.ExchangeGuard.Run(System.Action)">
            <summary>Runs a synchronous state mutation under the same close-aware admission as an exchange.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.ExchangeGuard.CloseAndDrain">
            <summary>Refuses future admissions and synchronously waits for an admitted exchange to finish.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Utilities.ExchangeGuard.CloseAndDrainAsync">
            <summary>Refuses future admissions and asynchronously waits for an admitted exchange to finish.</summary>
        </member>
