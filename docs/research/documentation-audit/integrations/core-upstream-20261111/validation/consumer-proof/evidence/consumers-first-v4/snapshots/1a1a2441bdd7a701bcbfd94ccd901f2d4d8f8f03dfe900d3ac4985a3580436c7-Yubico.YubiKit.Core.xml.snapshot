        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.MacOS.IIOKitDeviceLifetime.RegisterInputReportCallback(System.IntPtr,System.Byte[],System.Int32,System.IntPtr,System.IntPtr)">
