        <member name="M:Yubico.YubiKit.Core.Transports.Hid.Linux.LinuxHidReadReactor.Registration.#ctor(Yubico.YubiKit.Core.Transports.Hid.Linux.LinuxHidReadReactor,Yubico.YubiKit.Core.Native.Linux.Libc.LinuxFileSafeHandle,System.Int32,System.Int64,System.Action{System.Int64,System.Int16},System.Action{System.Exception})">
