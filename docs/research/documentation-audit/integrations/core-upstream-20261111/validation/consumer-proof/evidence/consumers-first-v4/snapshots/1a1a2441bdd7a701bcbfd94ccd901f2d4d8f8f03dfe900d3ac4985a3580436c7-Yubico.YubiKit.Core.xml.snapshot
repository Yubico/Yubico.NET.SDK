        <member name="M:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_IO_REQUEST.#ctor(Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_PROTOCOL)">
            <summary>
                Generates an IO Request structure based on the desired protocol.
            </summary>
            <param name="protocol">
                The protocol to use.
            </param>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_PROTOCOL.T0">
            <summary>
                Use the T=0 protocol - an asynchronous, character-oriented half-duplex transmission
                protocol.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_PROTOCOL.T1">
            <summary>
                Use the T=1 protocol - an asynchronous, block-oriented half-duplex transmission
                protocol.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_PROTOCOL.Tx">
            <summary>
                Both the T=0 and T=1 protocol may be used.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_READER_STATE.CreateMany(System.Collections.Generic.IEnumerable{System.String},System.Func{System.String,System.IntPtr},System.Action{System.IntPtr})">
            <summary>
                Allocates reader names, releasing earlier allocations if construction fails.
                On success, the caller owns the names and must call <see cref="M:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_READER_STATE.FreeReaderNames(System.Span{Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_READER_STATE},System.Action{System.IntPtr})" /> in finally.
            </summary>
            <remarks>
                Struct copies borrow the same pointers; release only through one owning array.
                Optional allocation/release delegates must be paired, and release must not throw.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_READER_STATE.FreeReaderNames(System.Span{Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_READER_STATE},System.Action{System.IntPtr})">
            <summary>
                Releases owned reader names and clears their pointers in the supplied storage.
                Clearing permits repeated cleanup of that storage, not cleanup of borrowed struct copies.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_SCOPE">
            <summary>
                The scope or domain in which database operations are to be performed.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_SCOPE.USER">
            <summary>
                Database operations are performed within the domain of the user.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_SCOPE.SYSTEM">
            <summary>
                Database operations are performed within the domain of the system. The calling
                application must have appropriate access permissions for any database actions.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_SHARE">
            <summary>
                A value that indicates whether other applications may form connections to the card once
                a connection has been established.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_SHARE.EXCLUSIVE">
            <summary>
                This application is not willing to share the card with other applications.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_SHARE.SHARED">
            <summary>
                This application is willing to share the card with other applications.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_SHARE.DIRECT">
            <summary>
                This application is allocating the reader for its private use, and will be controlling
                it directly. No other applications are allowed access to it.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE">
            <summary>
                Flags to represent the current (expected) state of a smart card reader, as well as reflect
                what is known to be true by the system.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.UNAWARE">
            <summary>
                <para>
                    CurrentState: The application is unaware of the current state, and would like to know.
                    The use of this value results in an immediate return from the state transition
                    monitoring services. This is represented by all bits set to zero.
                </para>
                <para>
                    EventState: This flag will not be set.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.IGNORE">
            <summary>
                <para>
                    CurrentState: The application is not interested in this reader, and it should not be
                    considered during monitoring operations. If this bit value is set, all other bits
                    are ignored.
                </para>
                <para>
                    EventState: This reader should be ignored.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.CHANGED">
            <summary>
                <para>
                    CurrentState: This flag has no meaning and should not be used.
                </para>
                <para>
                    EventState: There is a difference between the state believed by the application, and
                    the state known by the resource manager. When this bit is set, the application may
                    assume a significant state change has occurred on this reader.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.UNKNOWN">
            <summary>
                <para>
                    CurrentState: This flag has no meaning and should not be used.
                </para>
                <para>
                    EventState: The given reader name is not recognized by the resource manager. If this
                    bit is set, then CHANGED and IGNORE will also be set.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.UNAVAILABLE">
            <summary>
                <para>
                    CurrentState: The application expects that this reader is not available for use. If
                    this bit is set, all the following bits are ignored.
                </para>
                <para>
                    EventState: The actual state of this reader is not available. If this bit is set,
                    then all the following bits are clear.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.EMPTY">
            <summary>
                <para>
                    CurrentState: The application expects that there is no card in the reader. If this
                    bit is set, all the following bits are ignored.
                </para>
                <para>
                    EventState: There is no card in the reader. If this bit is set, all the following
                    bits with be clear.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.PRESENT">
            <summary>
                <para>
                    CurrentState: The application expects that there is a card in the reader.
                </para>
                <para>
                    EventState: There is a card in the reader.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.ATRMATCH">
            <summary>
                <para>
                    CurrentState: The application expects that there is a card in the reader with an ATR
                    that matches one of the target cards. If this bit is set, PRESENT is assumed. This
                    bit has no meaning to SCardGetStatusChange beyond PRESENT.
                </para>
                <para>
                    EventState: There is a card in the reader with an ATR matching one of the target cards.
                    If this bit is set, PRESENT will also be set. This bit is only returned on the
                    SCardLocateCards function.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.EXCLUSIVE">
            <summary>
                <para>
                    CurrentState: The application expects that the card in the reader is allocated for
                    exclusive use by another application. If this bit is set, PRESENT is assumed.
                </para>
                <para>
                    EventState: The card in the reader is allocated for exclusive use by another application.
                    If this bit is set, PRESENT will also be set.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.INUSE">
            <summary>
                <para>
                    CurrentState: The application expects that the card in the reader is in use by one
                    or more other applications, but may be connected to in shared mode. If this bit is
                    set, PRESENT is assumed.
                </para>
                <para>
                    EventState: The card in the reader is in use by one or more other applications, but
                    may be connected to in shared mode. If this bit is set, PRESENT will also be set.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.MUTE">
            <summary>
                <para>
                    CurrentState: The application expects that there is an unresponsive card in the reader.
                </para>
                <para>
                    EventState: There is an unresponsive card in the reader.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATE.UNPOWERED">
            <summary>
                <para>
                    CurrentState: This flag has no meaning and should not be used.
                </para>
                <para>
                    EventState: There is a card in the reader, but it is unpowered.
                </para>
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATUS.ABSENT">
            <summary>
                There is no card in the reader.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATUS.PRESENT">
            <summary>
                There is a card in the reader, but it has not been moved into position for use.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATUS.SWALLOWED">
            <summary>
                There is a card in the reader in position for use. The card is not powered.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATUS.POWERED">
            <summary>
                Power is being provided to the card, but the reader driver is unaware of the mode of
                the card.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATUS.NEGOTIABLE">
            <summary>
                The card has been reset and is awaiting PTS negotiation.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Desktop.SCard.SCARD_STATUS.SPECIFIC">
            <summary>
                The card has been reset and specific communication protocols have been established.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Native.Libraries">
            <summary>
                Handles the loading and management of native libraries required by the Yubico SDK.
            </summary>
            <remarks>
                This class provides cross-platform and cross-framework support for loading native libraries.
                The implementation differs based on the target framework:
                For .NET Framework 4.7:
                - Native libraries must be placed in architecture-specific subdirectories (x86/x64)
                - Library loading is handled explicitly at runtime based on process architecture
                - Requires proper cleanup through the Cleanup method
                For Modern .NET:
                - Native libraries are handled by the runtime's built-in library loading mechanism
                - Architecture-specific loading is managed automatically
                - No explicit cleanup is required
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Libraries.NativeShims">
            <summary>
                The filename of the native shims library for modern .NET versions.
            </summary>
            <remarks>
                For modern .NET, the runtime automatically handles library loading and architecture selection.
                The DLL extension is omitted as it's platform-specific and managed by the runtime.
                The library should be properly packaged with the correct runtimes/* folder structure in the NuGet package.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Native.Linux.Libc.NativeMethods.PollFd">
            <summary>
            Structure for poll() file descriptor monitoring.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Native.Linux.Libc.NativeMethods.POLLIN">
