            <summary>Key derivation, possibly including a key-agreement step.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.CryptographicOperation.Encryption">
            <summary>Encryption or decryption; integrity protection is not implied.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.KeyApplicability">
            <summary>Small declarative structural constraint; not a provider, device or protocol policy.</summary>
            <remarks>All specified fields must match. An algorithm's collection of constraints is a set of OR alternatives.</remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyApplicability.Family">
            <summary>The required structural key family.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyApplicability.CurveForm">
            <summary>The required mathematical curve form, or null for no form constraint.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyApplicability.CurveId">
            <summary>The required case-sensitive curve identity, or null for no curve constraint.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyApplicability.MinimumKeySizeBits">
            <summary>Inclusive minimum nominal key size in bits; zero means no lower bound.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyApplicability.MaximumKeySizeBits">
            <summary>Inclusive maximum nominal key size in bits, or null for no upper bound.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.KeyApplicability.KeyType">
            <summary>The required concrete construction, or null when family/form/size constraints suffice.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.KeyApplicability.Matches(Yubico.YubiKit.Core.Cryptography.KeyInfo)">
            <summary>Determines whether every specified structural constraint matches a concrete key.</summary>
            <param name="keyInfo">The concrete representation to inspect.</param>
            <returns>True for a structural match; does not establish provider, device or profile support.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo">
            <summary>Immutable operation metadata. Applicability does not mean support or recommendation.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.Id">
            <summary>Stable, case-sensitive catalog identity, distinct from display labels, OIDs and COSE numbers.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.DisplayName">
            <summary>A human-readable label including selected parameters; use <see cref="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.Id"/> for identity.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.Operation">
            <summary>The operation's purpose, independent of the key representation.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.Applicability">
            <summary>OR alternatives: a key matches if any constraint matches all of its specified fields.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.AlgorithmOid">
            <summary>Operation OID, or null when none is modeled; may identify multiple parameterized definitions.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.CoseAlgorithmId">
            <summary>Registered COSE alg number, independent of kty/crv; null if no mapping is modeled.</summary>
            <remarks>
            Protocol parameter/security requirements still apply. In particular COSE AES-CBC requires
            RFC 9459's PKCS#7 padding and companion integrity protection; a CBC mapping is not a codec.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.HashAlgorithm">
            <summary>A separately selected hash, or null when not separately parameterized.</summary>
            <remarks>
            Null can mean an unspecified hash (generic ECDSA), an intrinsic construction (Ed25519),
            or no hash parameter (CBC); it does not by itself mean the operation is generic or hash-free.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.SignaturePadding">
            <summary>The RSA signature padding, or null for other families or unspecified RSA encoding.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.MaskGenerationHashAlgorithm">
            <summary>The MGF1 hash for RSA-PSS, or null when not applicable or not selected.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.SaltLengthBytes">
            <summary>The RSA-PSS salt length in bytes, or null when not applicable or not selected.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.TrailerField">
            <summary>RSA-PSS trailerField; 1 for the modeled EMSA-PSS encodings, otherwise null.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.CipherMode">
            <summary>The block cipher mode, or null when not applicable or not selected.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.Derivation">
            <summary>The named KDF construction, or null when none is modeled for the operation.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.Equals(Yubico.YubiKit.Core.Cryptography.AlgorithmInfo)">
            <summary>Compares metadata by value, including the ordered applicability alternatives.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AlgorithmInfo.GetHashCode">
            <inheritdoc/>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ArkgPrimitives">
            <summary>
            Factory for the default <see cref="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives"/> implementation.
            </summary>
            <remarks>
            This factory creates instances of the platform-specific ARKG-P256
            cryptographic primitives implementation. The default implementation
            uses OpenSSL via P/Invoke through the Yubico.NativeShims library.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitives.Create">
            <summary>
            Creates the OpenSSL-backed ARKG primitives instance.
            </summary>
            <returns>
            An <see cref="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives"/> implementation that performs
            ARKG-P256 operations using OpenSSL.
            </returns>
            <remarks>
            <para>
            This method returns a new instance on each call. The implementation
            is stateless and thread-safe.
            </para>
            <para>
            For testing or custom implementations, applications can replace the
            default factory by setting the <c>ArkgPrimitivesCreator</c> property
            in <see cref="T:Yubico.YubiKit.Core.Cryptography.CryptographyProviders"/>.
            </para>
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl">
            <summary>
            OpenSSL-backed implementation of <see cref="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives"/> for ARKG-P256.
            </summary>
            <remarks>
            Provides the security-critical primitives required by the ARKG-P256
            algorithm: on-curve point validation, ECDH shared-secret computation,
            and the full draft-bradleylundberg-cfrg-arkg-09 derivation. Point math
            goes through Yubico.NativeShims (OpenSSL); scalar reduction uses
            <see cref="T:System.Numerics.BigInteger"/>.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl.IsPointOnCurve(System.ReadOnlySpan{System.Byte})">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl.ComputeEcdhSharedSecret(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl.Derive(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <inheritdoc />
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.Asn1ParameterKind">
            <summary>The parameters field of an ASN.1 key AlgorithmIdentifier.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.Asn1ParameterKind.Absent">
