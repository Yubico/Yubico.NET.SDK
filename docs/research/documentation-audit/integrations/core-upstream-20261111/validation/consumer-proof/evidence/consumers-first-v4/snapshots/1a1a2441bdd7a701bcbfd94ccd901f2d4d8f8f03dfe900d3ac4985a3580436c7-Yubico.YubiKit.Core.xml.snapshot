        <member name="T:Yubico.YubiKit.Core.Devices.VersionQualifierType">
            <summary>
                Represents the type of version qualifier for a firmware version.
                The version qualifier type indicates whether the version is an Alpha, Beta, or Final release.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.VersionQualifier">
            <summary>
                Represents a version qualifier for a firmware version.
                A version qualifier typically includes the firmware version, a type (such as Alpha, Beta, or Final),
                and an iteration number.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.VersionQualifier.#ctor(Yubico.YubiKit.Core.Devices.FirmwareVersion,Yubico.YubiKit.Core.Devices.VersionQualifierType,System.Int64)">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Devices.VersionQualifier" /> class.
                This constructor allows you to specify the firmware version, type, and iteration.
                The iteration must be a non-negative value and less than or equal to int.MaxValue.
                If the firmware version is null, an <see cref="T:System.ArgumentNullException" /> will be thrown.
                If the iteration is negative or greater than int.MaxValue, an <see cref="T:System.ArgumentOutOfRangeException" /> will be
                thrown.
            </summary>
            <param name="firmwareVersion">The firmware version associated with this qualifier.</param>
            <param name="type">The type of version qualifier (Alpha, Beta, Final).</param>
            <param name="iteration">
                The iteration number of the version qualifier, must be a non-negative value and less than or
                equal to int.MaxValue.
            </param>
            <exception cref="T:System.ArgumentOutOfRangeException"></exception>
            <exception cref="T:System.ArgumentNullException"></exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.VersionQualifier.#ctor">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Devices.VersionQualifier" /> class with default values.
                The default firmware version is set to a new instance of <see cref="P:Yubico.YubiKit.Core.Devices.VersionQualifier.FirmwareVersion" />,
                the type is set to <see cref="F:Yubico.YubiKit.Core.Devices.VersionQualifierType.Final" />, and the iteration is set to 0.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.VersionQualifier.FirmwareVersion">
            <summary>
                Represents the firmware version associated with this qualifier.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.VersionQualifier.Type">
            <summary>
                Represents the type of version qualifier, such as Alpha, Beta, or Final.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.VersionQualifier.Iteration">
            <summary>
                Represents the iteration number of the version qualifier.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.VersionQualifier.ToString">
            <summary>
                Returns a string that represents the current <see cref="T:Yubico.YubiKit.Core.Devices.VersionQualifier" />.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.IWindowsTopologyNativeOps">
            <summary>
                The two scripted-able native operations the Windows topology tier is composed from. Kept as a seam
                (mirroring the <c>LinuxUdevHidEventSource</c> pattern) so all resolver logic is unit-testable keyless
                on any OS.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IWindowsTopologyNativeOps.TryGetReaderDeviceInstanceId(System.String,System.String@)">
            <summary>
                PC/SC reader name → device instance ID (<c>SCardGetReaderDeviceInstanceIdW</c>, Windows 8+).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IWindowsTopologyNativeOps.TryGetContainerIdByInstanceId(System.String,System.Guid@)">
            <summary>
                Device instance ID → <c>DEVPKEY_Device_ContainerId</c> (via <c>CM_Locate_DevNode</c>).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.IWindowsTopologyNativeOps.TryGetContainerIdByDevicePath(System.String,System.Guid@)">
            <summary>
                HID device interface path → <c>DEVPKEY_Device_ContainerId</c>.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.WindowsDeviceTopologyResolver">
            <summary>
                Windows topology tier: maps an interface to the Container ID of the physical USB device that owns it.
                The Container ID GUID is identical across every interface of one composite USB device, including its
                HID interfaces, which is exactly the grouping key composite discovery needs.
            </summary>
            <remarks>
                CCID resolves through <c>SCardGetReaderDeviceInstanceIdW</c> → devnode → ContainerId; HID resolves
                directly from its device interface path. EVERY failure mode — API unavailable, unknown reader, stale
                devnode (<c>CR_NO_SUCH_DEVNODE</c>), missing ContainerId property, or an all-zero ContainerId (which
                Windows reports for devices with no container and would otherwise fuse unrelated interfaces) — yields
                "unknown", never a guess. The interface then falls through to the unchanged serial / PID / deduction
                tiers, degrading Windows to exactly the macOS/Linux semantics.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.WindowsDeviceTopologyResolver.#ctor(Yubico.YubiKit.Core.Devices.IWindowsTopologyNativeOps)">
            <summary>
                Windows topology tier: maps an interface to the Container ID of the physical USB device that owns it.
                The Container ID GUID is identical across every interface of one composite USB device, including its
                HID interfaces, which is exactly the grouping key composite discovery needs.
            </summary>
            <remarks>
                CCID resolves through <c>SCardGetReaderDeviceInstanceIdW</c> → devnode → ContainerId; HID resolves
                directly from its device interface path. EVERY failure mode — API unavailable, unknown reader, stale
                devnode (<c>CR_NO_SUCH_DEVNODE</c>), missing ContainerId property, or an all-zero ContainerId (which
                Windows reports for devices with no container and would otherwise fuse unrelated interfaces) — yields
                "unknown", never a guess. The interface then falls through to the unchanged serial / PID / deduction
                tiers, degrading Windows to exactly the macOS/Linux semantics.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.WindowsTopologyNativeOps">
            <summary>
                The real Windows topology native operations: <c>SCardGetReaderDeviceInstanceIdW</c> for CCID readers
                and <see cref="T:Yubico.YubiKit.Core.Native.Windows.Cfgmgr32.CmDevice" /> (Cfgmgr32) for Container-ID lookups.
            </summary>
            <remarks>
                Constructed only on Windows (see <see cref="M:Yubico.YubiKit.Core.Devices.DeviceTopologyResolver.Create" />). Every method is
                best-effort: a native failure returns <c>false</c> rather than throwing, because topology evidence is
                optional and its absence must degrade cleanly rather than abort a scan.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions">
            <summary>
                Connection-selection helpers for <see cref="T:Yubico.YubiKit.Core.Abstractions.IYubiKey" />.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions.CreateRawSmartCardSessionAsync(Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Threading.CancellationToken)">
            <summary>Opens exactly the SmartCard transport and creates a raw APDU session that owns it.</summary>
            <remarks>No application is selected. The returned session must be disposed.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions.CreateRawSmartCardSessionAsync(Yubico.YubiKit.Core.Abstractions.IYubiKey,Yubico.YubiKit.Core.Protocols.SmartCard.Scp.ScpKeyParameters,Yubico.YubiKit.Core.Devices.FirmwareVersion,System.Nullable{Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ProtocolConfiguration},System.Threading.CancellationToken)">
            <summary>
                Opens exactly the SmartCard transport, configures APDU framing, establishes SCP, and returns a raw
                session that owns the connection.
            </summary>
            <remarks>
                Configuration is applied before SCP establishment. The caller retains ownership of
                <paramref name="scpKeyParameters" />.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions.CreateRawCtapHidSessionAsync(Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Threading.CancellationToken)">
            <summary>Opens exactly the FIDO HID transport and creates a raw CTAP HID session that owns it.</summary>
            <remarks>No fallback transport is attempted. The returned session must be disposed.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions.CreateRawOtpHidSessionAsync(Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Threading.CancellationToken)">
            <summary>Opens exactly the OTP HID transport and creates a raw OTP HID session that owns it.</summary>
            <remarks>No fallback transport is attempted. The returned session must be disposed.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions.ResolvePreferredConnection(Yubico.YubiKit.Core.Abstractions.IYubiKey,Yubico.YubiKit.Core.Devices.ConnectionType[])">
            <summary>
                Returns the first connection in <paramref name="preferenceOrder" /> that this device supports, or
                <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Unknown" /> when it supports none of them.
            </summary>
            <remarks>
                This is a policy-free mechanism: the caller supplies the preference order. Application/module
                extension methods use it to pick a concrete transport on a physical (possibly multi-connection)
                device instead of the ambiguity-throwing parameterless <see cref="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.ConnectAsync(System.Threading.CancellationToken)" />.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions.ResolveSessionTransport(Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Nullable{Yubico.YubiKit.Core.Devices.ConnectionType},System.String,Yubico.YubiKit.Core.Devices.ConnectionType[])">
            <summary>
                Resolves the concrete transport a multi-transport application session should open, applying the
                app-specific smart default and an optional explicit caller override.
            </summary>
            <param name="yubiKey">The physical device.</param>
            <param name="preferredConnection">
                The explicit caller override, or <see langword="null" /> to use the application's documented default
                order. When non-null it must be exactly one concrete transport
                (<see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.SmartCard" />, <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidFido" />, or
                <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidOtp" />) that is valid for this session (present in
                <paramref name="defaultOrder" />) and supported by the device.
            </param>
            <param name="sessionName">The application/session name, used only for diagnostic messages.</param>
            <param name="defaultOrder">
                The application's ordered defaults. It also defines the transports valid for an explicit override.
            </param>
            <returns>
                The explicit override, or the first supported concrete transport in <paramref name="defaultOrder" />.
            </returns>
            <exception cref="T:System.ArgumentException">
                <paramref name="preferredConnection" /> is not exactly one concrete transport (e.g. a group flag,
                a combined value, or <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Unknown" />), or it is a concrete transport that is
                not valid for this session.
            </exception>
            <exception cref="T:System.NotSupportedException">
                An override that is valid for the session is not exposed by the device, or — for the default path —
                the device exposes none of the session's candidate transports.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyConnectionExtensions.CreateSessionOverTransportAsync``1(Yubico.YubiKit.Core.Abstractions.IYubiKey,Yubico.YubiKit.Core.Devices.ConnectionType,System.Func{Yubico.YubiKit.Core.Abstractions.IConnection,System.Threading.CancellationToken,System.Threading.Tasks.Task{``0}},System.Threading.CancellationToken)">
            <summary>
                Opens exactly one selected transport and creates a session-shaped result over it.
            </summary>
            <remarks>
                No fallback is attempted. Connection and session-creation failures propagate unchanged. If opening
                succeeds but <paramref name="createAsync" /> fails, the connection is disposed before the failure is
                rethrown. If disposal also fails, that cleanup failure is logged and the original creation failure
                still propagates unchanged.
            </remarks>
            <param name="yubiKey">The physical device.</param>
            <param name="transport">The single concrete transport selected for the session.</param>
            <param name="createAsync">Creates the result over the opened connection.</param>
            <param name="cancellationToken">A token to cancel connection opening or session creation.</param>
            <returns>The result created over the opened connection.</returns>
            <exception cref="T:System.ArgumentException"><paramref name="transport" /> is not one concrete transport.</exception>
            <exception cref="T:Yubico.YubiKit.Core.Devices.ConnectionInUseException">The physical YubiKey already has a live connection.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyDevice">
            <summary>
                The single production device shape published by discovery, with at most one slot for each concrete
                connection type.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDevice.AvailableConnections">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDevice.DeviceInfo">
            <summary>The most recent device metadata read successfully for this stable interface set.</summary>
            <remarks>
                Null updates are ignored deliberately: a transient read failure must not erase the last successful
                metadata snapshot while the published device retains the same interface identity.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDevice.CachedDeviceInfo">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDevice.SerialNumber">
            <summary>
                The latched hardware serial number per the <see cref="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.SerialNumber" /> contract:
                null until a metadata read delivering a serial succeeds, monotonically non-null afterward.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDevice.PhysicalIdentityKeyFor(Yubico.YubiKit.Core.Abstractions.IYubiKey)">
            <summary>
                Returns the internal interface-set identity for production devices and a one-DeviceId encoding
                for transparent third-party or test implementations.
            </summary>
            <remarks>
                <see cref="P:Yubico.YubiKit.Core.Devices.YubiKeyDevice.DeviceId" /> names the evidence tier used by discovery, so it can change while the
                physical key remains unchanged. The interface set does not change merely because merge evidence
                changes; broader identity-policy comparisons belong in the architecture documentation.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDevice.TransfersOwnership(Yubico.YubiKit.Core.Devices.ConnectionType,Yubico.YubiKit.Core.Devices.IYubiKeyConnectionSlot)">
            <summary>
                Built-in PC/SC, macOS HID and Linux HID connections take the registry claim before native open and release it
                themselves after proven teardown; every other slot is wrapped in a registered connection.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDevice.TryResolveSlot(Yubico.YubiKit.Core.Devices.ConnectionType,Yubico.YubiKit.Core.Devices.IYubiKeyConnectionSlot@)">
            <summary>
                The one slot-selection rule shared by normal connect, discovery connect, and registry identity
                resolution.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyDiscovery">
            <summary>Performs independent one-shot discovery with a new scoped finder for every call.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDiscovery.#ctor(System.Func{Yubico.YubiKit.Core.Devices.ConnectionType,Yubico.YubiKit.Core.Devices.FindYubiKeys})">
            <summary>Performs independent one-shot discovery with a new scoped finder for every call.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyManager">
             <summary>
             Discovers YubiKeys on demand, streams changes, and creates shared monitors for continuous tracking.
             </summary>
             <remarks>
             Find operations perform independent one-shot discovery. Dispose watch enumerations when finished;
             dispose shared monitors with <c>await using</c>. Manager watch creates a producer; monitor watch
             subscribes to an existing one. Discovery failures and cancellation propagate to the caller;
             watch enumerations also throw on subscriber overflow or terminal monitoring failure.
             </remarks>
             <example>
             <code>
             var key = await YubiKeyManager.FindFirstAsync(
                 predicate: key => key.SerialNumber == serial, cancellationToken: ct);
            
             await using var monitor = await YubiKeyManager.CreateMonitorAsync(ct);
             await foreach (var change in monitor.WatchAsync(ct))
                 Apply(change); // DeviceAdded replay, SnapshotComplete, then live changes.
             </code>
             </example>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Threading.CancellationToken)">
            <summary>
            Performs fresh one-shot discovery using only the requested interfaces.
            </summary>
            <param name="interfaces">
            Interfaces to enumerate and probe, not a result filter. Flags select places to look, not a
            requirement that each result expose every selected interface. <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Hid"/>
            includes FIDO and OTP; <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Unknown"/> scans nothing. Undefined bits are ignored.
            </param>
            <param name="cancellationToken">Cancels discovery waits, not already-dispatched native work.</param>
            <returns>
            The YubiKeys found, each a device view exposing only its observed in-scope interfaces, or an empty list.
            </returns>
            <exception cref="T:System.OperationCanceledException">The cancellation token is canceled.</exception>
            <exception cref="T:Yubico.YubiKit.Core.PlatformInteropException">A requested platform API fails.</exception>
            <remarks>
            Each call uses fresh identity and metadata evidence without changing running monitors. Ordering is
            unspecified. Grouping is conservative: ambiguous evidence can split one physical key into several
            results. Metadata is best-effort last-known data. For full composite keys, discover All and filter
            locally with <see cref="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.SupportsConnection(Yubico.YubiKit.Core.Devices.ConnectionType)"/>. Coordinate YubiKeys from disjoint scopes before
            opening connections: physical-key exclusion relies on overlapping known interface IDs. Cancellation
            bounds waits, not dispatched native work; returned YubiKeys remain usable after discovery ends.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindFirstAsync(System.Func{Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Boolean},Yubico.YubiKit.Core.Devices.ConnectionType,System.Threading.CancellationToken)">
            <summary>Discovers now and selects the first YubiKey satisfying an optional predicate.</summary>
            <param name="predicate">Optional device selection predicate, evaluated after discovery.</param>
            <param name="interfaces">Interfaces to enumerate and probe, as for <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Threading.CancellationToken)"/>.</param>
            <param name="cancellationToken">Requests discovery cancellation.</param>
            <returns>The first matching device.</returns>
            <exception cref="T:System.InvalidOperationException">No matching YubiKey was found.</exception>
            <exception cref="T:System.OperationCanceledException">The cancellation token is canceled.</exception>
            <exception cref="T:Yubico.YubiKit.Core.PlatformInteropException">A requested platform API fails.</exception>
            <remarks>
            Performs one independent discovery operation; does not wait for insertion. Ordering is unspecified.
            Discovery and predicate exceptions propagate unchanged. No monitor or shared cache is initialized.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindFirstOrDefaultAsync(System.Func{Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Boolean},Yubico.YubiKit.Core.Devices.ConnectionType,System.Threading.CancellationToken)">
            <summary>Discovers now and selects the first matching YubiKey, or returns null.</summary>
            <param name="predicate">Optional device selection predicate, evaluated after discovery.</param>
            <param name="interfaces">Interfaces to enumerate and probe, as for <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Threading.CancellationToken)"/>.</param>
            <param name="cancellationToken">Requests discovery cancellation.</param>
            <returns>The first matching device, or null when none matches.</returns>
            <exception cref="T:System.OperationCanceledException">The cancellation token is canceled.</exception>
            <exception cref="T:Yubico.YubiKit.Core.PlatformInteropException">A requested platform API fails.</exception>
            <remarks>
            Performs one independent discovery operation; does not wait for insertion. Ordering is unspecified.
            Discovery and predicate exceptions propagate unchanged. No monitor or shared cache is initialized.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)">
            <summary>
            Creates a private monitor for the lifetime of this enumeration; replay as <see cref="T:Yubico.YubiKit.Core.Devices.DeviceAdded"/>,
            then <see cref="T:Yubico.YubiKit.Core.Devices.SnapshotComplete"/>, then live changes.
            </summary>
            <param name="cancellationToken">Cancels initialization or ends this enumeration and its private monitor.</param>
            <returns>A lazy stream that creates a monitor on the first <c>MoveNextAsync</c>.</returns>
            <remarks>
            Each enumeration runs its own listeners and scans; to share one monitor across several consumers,
            use <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.CreateMonitorAsync(System.Threading.CancellationToken)"/>. All interfaces are scanned; filter changes locally.
            Dispose the enumeration when finished, for example with <c>await foreach</c>; its monitor is disposed
            on completion, cancellation, an exception, or a consumer break. First-scan discovery exceptions
            propagate unchanged from the first <c>MoveNextAsync</c>.
            </remarks>
            <exception cref="T:System.OperationCanceledException">The cancellation token is canceled.</exception>
            <exception cref="T:System.InvalidOperationException">The subscriber overflowed, or monitoring failed terminally.</exception>
            <exception cref="T:Yubico.YubiKit.Core.PlatformInteropException">A requested platform API fails during the first scan.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.CreateMonitorAsync(System.Threading.CancellationToken)">
            <summary>Creates an independent, active monitor with its initial membership already published.</summary>
            <param name="cancellationToken">Cancels initialization only; after return the caller owns the monitor lifetime.</param>
            <returns>An initialized monitor, including when its first successful snapshot is empty.</returns>
            <remarks>
            Dispose the returned monitor with <c>await using</c> and share it across consumers to use one set of
            listeners and scans. It scans all interfaces even without watchers. Initialization failure or
            cancellation cleans up partial ownership. First-scan discovery exceptions propagate unchanged;
            successful initialization does not guarantee every interface or metadata field was accessible.
            </remarks>
            <exception cref="T:System.OperationCanceledException">Initialization was canceled.</exception>
            <exception cref="T:Yubico.YubiKit.Core.PlatformInteropException">A requested platform API fails during the first scan.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyMonitor">
            <summary>
            Tracks connected YubiKeys continuously and streams their changes to any number of subscribers.
            </summary>
            <remarks>
            <para>Create one monitor per application through <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.CreateMonitorAsync(System.Threading.CancellationToken)"/> and share
            it; every monitor runs its own OS listeners and discovery scans. Creation completes after the first scan
            has been published, so the first <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.WatchAsync(System.Threading.CancellationToken)"/> replay is never empty because a scan is pending.</para>
            <para>A monitor has one lifetime: it runs from creation until <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.DisposeAsync"/> and cannot be
            paused or restarted. To resume tracking after disposal, create a new monitor. Disposal does not dispose
            caller-owned sessions or connections.</para>
            <para>Concurrent <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.WatchAsync(System.Threading.CancellationToken)"/> enumerations are safe, and <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.DisposeAsync"/> may run while
            enumerations are active: they end normally. Do not call <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.DisposeAsync"/> concurrently with
            itself.</para>
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.DefaultRescanInterval">
            <summary>Fallback rescan interval when no listener reports a change.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.WatchAsync(System.Threading.CancellationToken)">
            <summary>
            Replays the connected devices as <see cref="T:Yubico.YubiKit.Core.Devices.DeviceAdded"/>, emits <see cref="T:Yubico.YubiKit.Core.Devices.SnapshotComplete"/>, then
            streams every later change in order.
            </summary>
            <param name="cancellationToken">Ends this enumeration only; the monitor keeps running.</param>
            <returns>A lazy stream. Nothing is subscribed until the first <c>MoveNextAsync</c>.</returns>
            <remarks>
            Each enumeration has its own bounded buffer. Keep consuming it: a subscriber that falls more than
            256 changes behind is ended with <see cref="T:System.InvalidOperationException"/> instead of silently losing
            changes; clear the projection and enumerate again to recover. Changes published before disposal may
            still be delivered; an enumeration started after disposal ends immediately.
            </remarks>
            <exception cref="T:System.OperationCanceledException"><paramref name="cancellationToken"/> was canceled.</exception>
            <exception cref="T:System.InvalidOperationException">This subscriber overflowed, or monitoring failed terminally.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.CreateAsync(Yubico.YubiKit.Core.Devices.IMonitoredDiscovery,System.Collections.Generic.IReadOnlyList{Yubico.YubiKit.Core.Devices.ListenerSource},System.TimeSpan,System.TimeProvider,System.Threading.CancellationToken)">
            <summary>Starts listeners and the scan loop, then awaits the first published scan.</summary>
            <remarks>
            <paramref name="cancellationToken"/> bounds only this wait. A first-scan failure is terminal and
            rethrown; either outcome disposes the partially created monitor before returning.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.DisposeAsync">
            <summary>
            Stops tracking and ends every <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.WatchAsync(System.Threading.CancellationToken)"/> enumeration normally. Idempotent.
            </summary>
            <remarks>
            Returns after the scan loop has stopped, which waits for an in-flight scan to finish within its
            discovery budgets. Active <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyMonitor.WatchAsync(System.Threading.CancellationToken)"/> enumerations end normally. Not safe to call concurrently
            with itself.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.PlatformInteropException">
            <summary>
            Exception thrown when a platform interop (P/Invoke) operation fails.
            </summary>
            <remarks>
            This exception wraps platform-specific errors from native API calls (PC/SC, HID, etc.)
            and provides context about what operation failed.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.PlatformInteropException.#ctor">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.PlatformInteropException"/> class.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.PlatformInteropException.#ctor(System.String)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.PlatformInteropException"/> class with a specified error message.
            </summary>
            <param name="message">The error message that explains the reason for the exception.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.PlatformInteropException.#ctor(System.String,System.Exception)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.PlatformInteropException"/> class with a specified error message
            and a reference to the inner exception that is the cause of this exception.
            </summary>
            <param name="message">The error message that explains the reason for the exception.</param>
            <param name="innerException">The exception that is the cause of the current exception.</param>
        </member>
