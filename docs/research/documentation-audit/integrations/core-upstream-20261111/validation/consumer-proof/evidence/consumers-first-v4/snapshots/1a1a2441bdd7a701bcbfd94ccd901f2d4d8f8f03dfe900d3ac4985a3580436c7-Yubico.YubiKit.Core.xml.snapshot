        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.IDeviceChangeListener">
            <summary>Monitors transport changes that may require device discovery to run again.</summary>
            <remarks>
            Set <see cref="P:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Changed"/> before calling <see cref="M:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Start"/>. Notifications are rescan hints,
            never authoritative device arrival or removal state. Do not call <see cref="M:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Stop"/> or
            <see cref="M:System.IDisposable.Dispose"/> inside the callback: native listener shutdown may wait for it to return.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Changed">
            <summary>Gets or sets the callback invoked when a transport change requires a rescan.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Status">
            <summary>Gets the listener's current diagnostic status.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Start">
            <summary>Establishes baseline state and begins monitoring subsequent changes.</summary>
            <remarks>Set <see cref="P:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Changed"/> first. Check <see cref="P:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Status"/> after starting.</remarks>
            <exception cref="T:System.ObjectDisposedException">The listener has been disposed.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Stop">
            <summary>Stops monitoring and releases monitoring resources.</summary>
            <remarks>Call outside the <see cref="P:Yubico.YubiKit.Core.Transports.IDeviceChangeListener.Changed"/> callback to avoid waiting on that callback.</remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.SmartCard.DesktopSmartCardDeviceListener">
            <summary>
            Monitors for SmartCard reader arrival and removal using PC/SC SCardGetStatusChange.
            </summary>
            <remarks>
            Uses a dedicated background thread with 1000ms timeout for responsive cancellation.
            On Windows, also watches for PnP notifications via the special <c>\\?\PnP?\Notification</c> reader.
            <para>
            The listener does not auto-start. Call <see cref="M:Yubico.YubiKit.Core.Transports.SmartCard.DesktopSmartCardDeviceListener.Start"/> after setting up <see cref="P:Yubico.YubiKit.Core.Transports.SmartCard.DesktopSmartCardDeviceListener.Changed"/>
            callback. The listener establishes baseline during <see cref="M:Yubico.YubiKit.Core.Transports.SmartCard.DesktopSmartCardDeviceListener.Start"/> to avoid duplicate events.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.SmartCard.DesktopSmartCardDeviceListener.Changed">
            <inheritdoc />
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.SmartCard.DesktopSmartCardDeviceListener.Status">
            <inheritdoc />
        </member>
