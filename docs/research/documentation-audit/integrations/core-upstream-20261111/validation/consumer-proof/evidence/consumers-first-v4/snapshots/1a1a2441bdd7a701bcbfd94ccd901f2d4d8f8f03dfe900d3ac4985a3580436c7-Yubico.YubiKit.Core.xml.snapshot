<?xml version="1.0"?>
<doc>
    <assembly>
        <name>Yubico.YubiKit.Core</name>
    </assembly>
    <members>
        <member name="T:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation">
            <summary>
                The tri-state answer to "do these two <see cref="T:Yubico.YubiKit.Core.Abstractions.IYubiKey" /> references describe the same
                physical key?" as returned by <see cref="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.SameDeviceAs(Yubico.YubiKit.Core.Abstractions.IYubiKey)" />.
            </summary>
            <remarks>
                The answer is honest rather than convenient: physical identity can only be proven by the
                hardware serial number, and whole device classes (for example the Security Key series) never
                report one. Reference identity is evaluated first; for distinct references, an unknown serial on
                either side produces <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Unknown" /> rather than a guess based on transport paths, product
                IDs, or timing.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Unknown">
            <summary>
                The references are distinct and at least one serial number is unknown, so physical identity
                cannot be determined. Treat this as "cannot correlate", not as "different".
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Same">
            <summary>
                The references describe the same physical key: they are the same object, or both serials
                are known and equal.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Different">
            <summary>Both serials are known and unequal: provably different physical keys.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IApplicationSession.FirmwareVersion">
            <summary>
                Gets the effective firmware version used to configure the application protocol and evaluate features.
                This is the detected applet or device version unless session creation explicitly supplied a firmware
                version override.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IApplicationSession.ConnectionType">
            <summary>Gets the type of connection used by this session.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IApplicationSession.IsInitialized">
            <summary>
                Gets a value indicating whether the session has initialized its application protocol.
                Returns <c>false</c> once disposal begins.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IApplicationSession.IsAuthenticated">
            <summary>
                Gets a value indicating whether the session has established application-protocol authentication,
                such as SCP. Applet-specific authentication state is exposed by the respective session type.
                Returns <c>false</c> once disposal begins.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Abstractions.IApplicationSession.IsSupported(Yubico.YubiKit.Core.Devices.Feature)">
            <summary>Evaluates known firmware compatibility, not runtime authorization or operation success.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Abstractions.IConnection">
            <summary>
                Base interface for all device connections.
            </summary>
            <remarks>
                Implements both <see cref="T:System.IDisposable" /> and <see cref="T:System.IAsyncDisposable" /> to support
                both synchronous and asynchronous disposal patterns. Prefer <c>await using</c> for async code.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Abstractions.IDevice">
            <summary>
                Represents properties and methods common to all devices.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Abstractions.IProtocol">
            <summary>
                Base contract for a configured transport protocol over a single opened YubiKey connection.
            </summary>
            <remarks>
                <para>
                    A protocol is a user of the connection it was created from, never its owner. Disposing a
                    protocol does not dispose that connection: whoever created the connection disposes it. The
                    one deliberate exception is a decorating protocol such as the SCP wrapper, which owns the
                    protocol it wraps and disposes it (along with any session key material) — the cascade still
                    stops before the connection.
                </para>
                <para>
                    Sessions configure the protocol after applet probing has resolved firmware. Call
                    <see cref="M:Yubico.YubiKit.Core.Abstractions.IProtocol.Configure(Yubico.YubiKit.Core.Devices.FirmwareVersion,System.Nullable{Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ProtocolConfiguration})" /> before normal applet operations and before establishing decorators
                    such as SCP.
                </para>
                <para>
                    Implementations admit one logical exchange at a time. An overlapping operation throws
                    <see cref="T:System.InvalidOperationException" /> immediately because YubiKey transports maintain chained
                    APDU, CTAP HID, OTP HID, or SCP state across packets.
                </para>
                <para>
                    Application sessions keep the effective protocol for the session lifetime and dispose it when
                    the session is disposed. Applet backends borrow the protocol; they do not own it.
                </para>
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Abstractions.IYubiKey">
            <summary>
                Represents a physical YubiKey and the set of connections (interfaces) it exposes.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.DeviceId">
            <summary>
                An identifier for this physical device, suitable for correlating devices <em>within one
                discovery session</em>. It is not a durable identity and must not be persisted, parsed, or
                compared across processes or platforms.
            </summary>
            <remarks>
                <para>
                    The value is derived from whatever grouping evidence discovery had available, so it takes
                    one of several shapes: <c>ykphysical:topology:{key}</c> (Windows Container ID),
                    <c>ykphysical:{serial}</c>, or <c>ykphysical:pid:{PID}</c>. When discovery cannot prove that
                    multiple interfaces belong together, a one-interface device preserves its transport-shaped
                    <c>hid:*</c> or <c>pcsc:*</c> identifier. The shape is an implementation detail, is
                    platform-dependent, and may change.
                </para>
                <para>
                    <strong>The same physical key can present different values.</strong> Evidence depends on what
                    else is attached: a key alone may group by PID, while inserting a second key of the same
                    product ID forces serial evidence to tell them apart. Measured on macOS hardware, one key
                    reported <c>ykphysical:pid:0407</c> alone and <c>ykphysical:103</c> once a same-PID sibling
                    was inserted. The device did not change; the available evidence did.
                </para>
                <para>
                    <strong>A live repository and a fresh scan can legitimately disagree.</strong> When an
                    evidence-only tier change occurs, the repository keeps publishing the object it already
                    handed out rather than churning subscribers, so a concurrent independent scan may report a
                    different identifier for the same key. Both are correct.
                </para>
                <para>
                    For a durable key — persistence, audit logs, allow lists — use <see cref="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.SerialNumber" />
                    instead, and note that it is <see langword="null" /> until discovery has read it and on
                    devices which do not report a serial (for example Security Key series). Firmware version is
                    deliberately not part of identity: it can differ per applet on the same key and is not a
                    disambiguator.
                </para>
                <para>
                    A grouped device identifier is distinct from the per-interface identifiers (<c>hid:*</c>,
                    <c>pcsc:*</c>) used by the connection registry. A one-interface device intentionally uses
                    that sole interface identifier as its physical-device identifier.
                </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.AvailableConnections">
            <summary>
                The set of concrete connections this physical device exposes (any combination of
                <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.SmartCard"/>, <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidFido"/>, and
                <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidOtp"/>). Never contains the <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Hid"/>
                group flag or <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.All"/>.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.SerialNumber">
            <summary>
                The hardware serial number read by discovery, or <see langword="null" /> while it is unknown.
                Available without opening a session and without a Management package dependency.
            </summary>
            <remarks>
                <para>Contract:</para>
                <list type="bullet">
                    <item><description>
                        <see langword="null" /> until a discovery metadata read has succeeded — and possibly
                        forever: reads can fail persistently, the discovery read budget can be exhausted, and
                        whole device classes (for example the Security Key series) report no serial at all.
                    </description></item>
                    <item><description>
                        Once non-<see langword="null" />, it never reverts to <see langword="null" />. It may
                        transition from <see langword="null" /> to a value after publication, without any
                        device event.
                    </description></item>
                    <item><description>
                        A manager-retained object's known value does not change to another known value. If a
                        fresh scan reports a different known serial for the same interface set, the manager
                        republishes the device as a removal followed by an addition.
                    </description></item>
                    <item><description>
                        A republished device object (see the retention contract in
                        <c>docs/architecture/device-identity.md</c>) never inherits identity from its
                        predecessor object. It exposes only what discovery established for that fresh object,
                        which may already include a serial when the addition is published.
                    </description></item>
                    <item><description>
                        The object delivered with a removal event retains its last-known value.
                    </description></item>
                </list>
                <para>
                    This is the only durable physical identity the SDK offers. When it is
                    <see langword="null" />, physical identity is unknowable without a live session.
                </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.CachedDeviceInfo">
            <summary>
                The last successfully observed device metadata, or <see langword="null" /> when unavailable.
                Reading this property performs no I/O and does not open a connection or session.
            </summary>
            <remarks>
                <para>
                    This is a last-known snapshot, not guaranteed-current device state. Existing discovery and
                    repository updates may replace it without a device event; a failed metadata read does not
                    clear a previously successful snapshot. A value already returned to a caller does not change.
                </para>
                <para>
                    Metadata may be stale after configuration changes or disconnection. A retained device object
                    can continue to expose historical metadata; this getter neither checks presence nor refreshes
                    the snapshot. Use <c>ManagementSession.GetDeviceInfoAsync</c> for a live read. That operation
                    does not promise to update discovery metadata.
                </para>
                <para>
                    <see cref="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.SerialNumber" /> retains its independent identity contract. In particular, it can
                    remain known even when the latest metadata snapshot does not contain a serial number. Use
                    that property, not the serial in this snapshot, for durable physical identity.
                </para>
                <para>
                    The default implementation returns <see langword="null" /> so existing custom device
                    implementations need not provide metadata.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.SameDeviceAs(Yubico.YubiKit.Core.Abstractions.IYubiKey)">
            <summary>
                Answers whether this reference and <paramref name="other" /> describe the same physical key.
                Reference identity is evaluated first. Distinct references are then compared by serial number,
                with <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Unknown" /> returned when either serial is unknown.
            </summary>
            <remarks>
                The same object is always <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Same" />. Two references with known,
                equal serials are <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Same" />; known, unequal serials are
                <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Different" />. This three-valued correlation is not a total
                equality predicate: <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Unknown" /> conveys neither equality nor
                inequality and must not be coerced to either result for collection equality or deduplication.
                No equality comparer over this relation is offered: the serial arrives after publication, so
                any serial-derived hash could mutate while the object already keys a collection. Key
                collections by reference instead — instance retention within one manager makes that a
                supported pattern.
            </remarks>
            <param name="other">The device reference to compare with this reference.</param>
            <returns>
                <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Same" /> for the same reference or equal known serials,
                <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Different" /> for unequal known serials, or
                <see cref="F:Yubico.YubiKit.Core.Abstractions.DeviceCorrelation.Unknown" /> for distinct references when either serial is unknown.
            </returns>
            <exception cref="T:System.ArgumentNullException"><paramref name="other" /> is <see langword="null" />.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.SupportsConnection(Yubico.YubiKit.Core.Devices.ConnectionType)">
            <summary>
                Whether this device can open the requested connection. Only concrete openable types are valid
                (<see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.SmartCard"/>, <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidFido"/>,
                <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.HidOtp"/>); <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Hid"/> means a HID interface is present;
                <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Unknown"/>, <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.All"/>, and other combinations return <c>false</c>.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.ConnectAsync``1(System.Threading.CancellationToken)">
            <summary>
                Opens the requested interface after claiming the physical YubiKey's known member interface IDs.
            </summary>
            <exception cref="T:Yubico.YubiKit.Core.Devices.ConnectionInUseException">The physical YubiKey already has a live connection.</exception>
            <exception cref="T:Yubico.YubiKit.Core.Devices.UnrecoveredConnectionException">
                A previous native connection or discovery operation for this YubiKey was not proven released.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.ConnectAsync(System.Threading.CancellationToken)">
            <summary>
                Opens the device's connection when it exposes exactly one. For a physical device that exposes
                several connections this is ambiguous and throws; callers must use <see cref="M:Yubico.YubiKit.Core.Abstractions.IYubiKey.ConnectAsync``1(System.Threading.CancellationToken)"/>
                or an application-specific extension that selects a transport intentionally.
            </summary>
            <exception cref="T:Yubico.YubiKit.Core.Devices.UnrecoveredConnectionException">
                A previous native connection or discovery operation for this YubiKey was not proven released.
            </exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.ConsoleCredentialReader">
            <summary>
            Console-based credential reader that securely reads sensitive input.
            </summary>
            <remarks>
            <para>
            This reader provides masked input when running in an interactive terminal,
            with fallback to unmasked line-based input when running non-interactively
            (e.g., in a pipeline or with redirected input).
            </para>
            <para>
            <b>Security Features:</b>
            <list type="bullet">
            <item>Never allocates credential data as managed strings</item>
            <item>Returns <see cref="T:System.Buffers.IMemoryOwner`1"/> that zeros memory on disposal</item>
            <item>Uses timing-safe comparison for credential confirmation</item>
            <item>Clears intermediate buffers on all code paths</item>
            </list>
            </para>
            <para>
            <b>Platform Limitations:</b>
            <list type="bullet">
            <item>Windows: Full support for masked input</item>
            <item>Linux/macOS: Requires TTY; masked input may not work over SSH without PTY</item>
            <item>Non-interactive mode: Input is not masked (warning displayed)</item>
            </list>
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.ConsoleCredentialReader.#ctor">
            <summary>
            Creates a new console credential reader using the real console.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.ConsoleCredentialReader.#ctor(Yubico.YubiKit.Core.Credentials.IConsoleInputSource)">
            <summary>
            Creates a new console credential reader with the specified input source.
            </summary>
            <param name="console">The console input source (for testing).</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.ConsoleCredentialReader.ReadCredential(Yubico.YubiKit.Core.Credentials.CredentialReaderOptions,System.Threading.CancellationToken)">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.ConsoleCredentialReader.ReadCredentialWithConfirmation(Yubico.YubiKit.Core.Credentials.CredentialReaderOptions,System.Threading.CancellationToken)">
            <inheritdoc />
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.CredentialKind">
            <summary>
            The kind of secret being requested by an <see cref="T:Yubico.YubiKit.Core.Credentials.ICredentialPrompt"/>.
            </summary>
            <remarks>
            Implementations should treat an unrecognized value as a generic secret
            request rather than failing, so that new kinds can be added without
            breaking existing implementations.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.Pin">
            <summary>A PIN (personal identification number).</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.Puk">
            <summary>A PUK (PIN unblocking key).</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.Password">
            <summary>A password or passphrase.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.ManagementKey">
            <summary>A management key, conventionally entered as hexadecimal.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.NewPin">
            <summary>A new PIN being established by a change or initialize flow.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.NewPuk">
            <summary>A new PUK being established.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.NewPassword">
            <summary>A new password being established.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.CredentialKind.ResetCode">
            <summary>A reset code, for example the OpenPGP resetting code.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.CredentialPromptContext">
            <summary>
            Describes a single credential request made through <see cref="T:Yubico.YubiKit.Core.Credentials.ICredentialPrompt"/>.
            </summary>
            <remarks>
            This is a non-positional record so that optional properties can be added in
            later releases without breaking implementations or callers. Implementations
            should ignore properties they do not use.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialPromptContext.Kind">
            <summary>Gets the kind of secret being requested.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialPromptContext.Scope">
            <summary>
            Gets a display-oriented description of what the secret unlocks, such as
            a relying-party identifier (<c>"example.com"</c>) for WebAuthn or an
            application name (<c>"PIV"</c>) elsewhere. May be <c>null</c> when no
            meaningful scope exists.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialPromptContext.RetriesRemaining">
            <summary>
            Gets the number of attempts remaining before the credential is blocked,
            when the protocol reports it; otherwise <c>null</c>.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialPromptContext.IsRetry">
            <summary>
            Gets a value indicating whether this request follows a rejected attempt.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialPromptContext.MinLengthCodePoints">
            <summary>
            Gets the minimum acceptable secret length, measured in Unicode code points.
            </summary>
            <remarks>
            Protocols that define their minimum over encoded bytes should set this only
            when every accepted code point encodes to one byte.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialPromptContext.MaxLengthBytes">
            <summary>
            Gets the maximum acceptable secret length, measured in encoded bytes.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialPromptContext.RequiresConfirmation">
            <summary>
            Gets a value indicating whether the implementation should ask for the
            secret twice and confirm the entries match, which is conventional when
            establishing a new secret.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions">
            <summary>
            Configuration options for credential input.
            </summary>
            <remarks>
            <para>
            Use the factory methods <see cref="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForPin"/>, <see cref="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForPuk"/>, <see cref="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForPassphrase"/>,
            or <see cref="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForHexKey(System.Int32)"/> to create pre-configured options for common credential types.
            </para>
            <para>
            For module-specific presets (FIDO2, OpenPGP, OATH), see the credential options classes
            in each module's <c>Credentials</c> namespace.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.Prompt">
            <summary>
            Gets or sets the prompt text displayed to the user.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ConfirmPrompt">
            <summary>
            Gets or sets the confirmation prompt text for credential confirmation.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.MinLength">
            <summary>
            Gets or sets the minimum allowed credential length.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.MaxLength">
            <summary>
            Gets or sets the maximum allowed credential length.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.MaskCharacter">
            <summary>
            Gets or sets the character used to mask input (default: '*').
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.CharacterFilter">
            <summary>
            Gets or sets a filter function that determines which characters are allowed.
            Returns <c>true</c> to accept the character, <c>false</c> to reject it.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.Encoding">
            <summary>
            Gets or sets the encoding used to convert characters to bytes.
            Defaults to UTF-8.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.IsHexMode">
            <summary>
            Gets or sets whether the input is expected in hexadecimal format.
            When <c>true</c>, input is parsed as hex and <see cref="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ExpectedByteLength"/>
            should be set to validate the result length.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ExpectedByteLength">
            <summary>
            Gets or sets the expected byte length when <see cref="P:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.IsHexMode"/> is <c>true</c>.
            A value of <c>null</c> means any length is accepted.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForPin">
            <summary>
            Creates options configured for PIN input (6-8 numeric digits).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForPuk">
            <summary>
            Creates options configured for PUK input (6-8 numeric digits).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForPassphrase">
            <summary>
            Creates options configured for passphrase input.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.CredentialReaderOptions.ForHexKey(System.Int32)">
            <summary>
            Creates options configured for hexadecimal key input.
            </summary>
            <param name="byteLength">Expected key length in bytes (e.g., 24 for 3DES key).</param>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.IConsoleInputSource">
            <summary>
            Abstraction for console input to enable unit testing.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.IConsoleInputSource.IsInteractive">
            <summary>
            Gets whether console input is available (not redirected from a file/pipe).
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.IConsoleInputSource.KeyAvailable">
            <summary>
            Gets a value indicating whether a key press is available to be read.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.IConsoleInputSource.ReadKey(System.Boolean)">
            <summary>
            Reads the next key from the console without displaying it.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.IConsoleInputSource.ReadLine">
            <summary>
            Reads a line of text from the console (fallback for non-interactive mode).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.IConsoleInputSource.Write(System.String)">
            <summary>
            Writes text to the console output.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.IConsoleInputSource.WriteLine(System.String)">
            <summary>
            Writes a line of text to the console output.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.RealConsoleInput">
            <summary>
            Real console input implementation that delegates to <see cref="T:System.Console"/>.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.MockConsoleInput">
            <summary>
            Mock console input for unit testing.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.ICredentialPrompt">
             <summary>
             Supplies secrets (PINs, passwords, keys) to SDK components on demand.
             </summary>
             <remarks>
             <para>
             Implementations decide how a secret is obtained: console input, a graphical
             dialog, a secret vault, or a test fake. The SDK calls this interface only
             when it needs a secret it was not given explicitly, so an application that
             passes secrets directly never needs an implementation.
             </para>
             <para>
             This is an SDK-to-application callback with protocol context and asynchronous cancellation.
             It is distinct from <see cref="T:Yubico.YubiKit.Core.Credentials.ISecureCredentialReader"/>, which is a synchronous,
             application-initiated terminal input helper with display and encoding options. An implementation
             may delegate to any credential acquisition mechanism, including a secure reader, provided it
             returns promptly without blocking the calling thread and honors the cancellation token.
             </para>
             <para><b>Contract</b></para>
             <list type="bullet">
             <item>
             Returning <c>null</c> means exactly one thing: the user declined. It never
             signals cancellation, an input error, or a retry request.
             </item>
             <item>
             The method must return a <see cref="T:System.Threading.Tasks.ValueTask`1"/> promptly, must not block the calling
             thread while obtaining the secret, and must honor the supplied cancellation token.
             Cancellation is reported by throwing <see cref="T:System.OperationCanceledException"/>.
             </item>
             <item>
             The returned <see cref="T:System.Buffers.IMemoryOwner`1"/> must expose a
             <see cref="P:System.Buffers.IMemoryOwner`1.Memory"/> sized <b>exactly</b> to the secret.
             Pool-rented buffers are frequently larger than requested, and the SDK
             transmits the whole of <c>Memory</c>; an over-sized buffer therefore sends
             trailing padding as part of the secret. Use
             <see cref="M:Yubico.YubiKit.Core.Utilities.DisposableArrayPoolBuffer.CreateFromSpan(System.ReadOnlySpan{System.Byte})"/>, which slices to the
             exact length, rather than handing back a raw rented buffer.
             </item>
             <item>
             The implementation owns the buffer until the returned <see cref="T:System.Threading.Tasks.ValueTask`1"/>
             completes successfully. At that point ownership transfers to the SDK. The implementation must
             not access or dispose the buffer after successful completion. A null, faulted, or cancelled
             result transfers no buffer ownership.
             </item>
             <item>
             Implementations must not retry credential verification internally. The SDK component using the
             prompt owns any retry policy so each authenticator submission is represented by a separate
             prompt invocation and context.
             </item>
             </list>
             <para><b>Example</b></para>
             <code>
             internal sealed class DialogPrompt : ICredentialPrompt
             {
                 public async ValueTask&lt;IMemoryOwner&lt;byte&gt;?&gt; RequestSecretAsync(
                     CredentialPromptContext context, CancellationToken cancellationToken)
                 {
                     var title = context.IsRetry
                         ? $"Incorrect PIN - {context.RetriesRemaining} attempts remaining"
                         : $"Enter PIN for {context.Scope}";
            
                     byte[]? entered = await ShowPinDialogAsync(title, cancellationToken);
                     if (entered is null)
                     {
                         return null;
                     }
            
                     try
                     {
                         return DisposableArrayPoolBuffer.CreateFromSpan(entered);
                     }
                     finally
                     {
                         System.Security.Cryptography.CryptographicOperations.ZeroMemory(entered);
                     }
                 }
             }
             </code>
             </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.ICredentialPrompt.RequestSecretAsync(Yubico.YubiKit.Core.Credentials.CredentialPromptContext,System.Threading.CancellationToken)">
            <summary>
            Requests a secret from the user or another source.
            </summary>
            <param name="context">Describes what is being requested and why.</param>
            <param name="cancellationToken">Token that the implementation must monitor for cancellation requests.</param>
            <returns>
            The secret bytes in a buffer whose <see cref="P:System.Buffers.IMemoryOwner`1.Memory"/> is
            sized exactly to the secret, or <c>null</c> if the user declined to supply one. Ownership
            transfers to the caller only when the returned task completes successfully with a non-null
            owner.
            </returns>
            <exception cref="T:System.OperationCanceledException">
            Thrown when cancellation is requested through <paramref name="cancellationToken"/>.
            </exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.ISecureCredentialReader">
            <summary>
            Provides secure credential input that never exposes sensitive data as strings.
            </summary>
            <remarks>
            <para>
            All credential data is returned as <see cref="T:System.Buffers.IMemoryOwner`1"/> which automatically
            zeros sensitive memory when disposed. Callers should use the <c>using</c> pattern
            to ensure credentials are cleared as soon as possible.
            </para>
            <para>
            This is a synchronous, application-initiated terminal input helper with display and encoding
            options. It is distinct from <see cref="T:Yubico.YubiKit.Core.Credentials.ICredentialPrompt"/>, which is an asynchronous
            SDK-to-application callback carrying protocol context for secrets requested during an operation.
            </para>
            <para>
            Example usage:
            <code>
            var reader = new ConsoleCredentialReader();
            using var credential = reader.ReadCredential(CredentialReaderOptions.ForPin());
            if (credential is not null)
            {
                // Use credential.Memory.Span to access the PIN bytes
                pivSession.VerifyPin(credential.Memory.Span);
            } // Memory is automatically zeroed here
            </code>
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.ISecureCredentialReader.ReadCredential(Yubico.YubiKit.Core.Credentials.CredentialReaderOptions,System.Threading.CancellationToken)">
            <summary>
            Reads a credential from the user with the specified options.
            </summary>
            <param name="options">Configuration for the credential input behavior.</param>
            <param name="cancellationToken">Token to monitor for cancellation requests.</param>
            <returns>
            An <see cref="T:System.Buffers.IMemoryOwner`1"/> containing the credential bytes, or <c>null</c>
            if the user cancelled the input (e.g., pressed Escape).
            </returns>
            <remarks>
            The returned memory owner automatically zeros its contents when disposed.
            Callers must dispose the result to ensure sensitive data is cleared.
            </remarks>
            <exception cref="T:System.OperationCanceledException">Thrown when cancellation is requested.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.ISecureCredentialReader.ReadCredentialWithConfirmation(Yubico.YubiKit.Core.Credentials.CredentialReaderOptions,System.Threading.CancellationToken)">
            <summary>
            Reads a credential with confirmation (user must enter it twice).
            </summary>
            <param name="options">Configuration for the credential input behavior.</param>
            <param name="cancellationToken">Token to monitor for cancellation requests.</param>
            <returns>
            An <see cref="T:System.Buffers.IMemoryOwner`1"/> containing the credential bytes if both entries
            matched, or <c>null</c> if the user cancelled or entries did not match.
            </returns>
            <remarks>
            <para>
            Uses timing-safe comparison to verify the credentials match.
            </para>
            <para>
            The first entry buffer is always zeroed before the second prompt,
            and both buffers are zeroed if they don't match.
            </para>
            </remarks>
            <exception cref="T:System.OperationCanceledException">Thrown when cancellation is requested.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.IUserPresencePrompt">
            <summary>
                Receives notifications when an SDK operation requires or may require physical user presence.
            </summary>
            <remarks>
                <para>
                    This callback is informational. Completing a notification means that the application has handled the
                    notification; it does not report that the user has interacted with the device and does not complete the
                    device operation.
                </para>
                <para>
                    The SDK retains the implementation supplied through session creation options for the session lifetime.
                    The caller owns the implementation and remains responsible for disposing it, if applicable.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.IUserPresencePrompt.OnUserPresenceRequestedAsync(Yubico.YubiKit.Core.Credentials.UserPresenceContext,System.Threading.CancellationToken)">
            <summary>Notifies the application that an operation requires or may require user presence.</summary>
            <param name="context">
                Describes the application, operation, scope, and basis for the notification, plus any application intent
                supplied through <see cref="M:Yubico.YubiKit.Core.Credentials.UserPresenceIntent.BeginScope(System.String)" />.
            </param>
            <param name="cancellationToken">Token that the implementation must monitor for cancellation requests.</param>
            <remarks>
                Implementations should present or update their user-presence indication and return without waiting for
                the physical interaction itself. The device operation determines whether presence was supplied. The SDK
                pairs this request with a resolution only after this callback completes successfully. If it throws, the
                SDK performs any protocol-safe cancellation, drain, or reset that is required and propagates the exception
                without calling <see cref="M:Yubico.YubiKit.Core.Credentials.IUserPresencePrompt.OnUserPresenceResolvedAsync(Yubico.YubiKit.Core.Credentials.UserPresenceContext,Yubico.YubiKit.Core.Credentials.UserPresenceOutcome,System.Threading.CancellationToken)" />.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.IUserPresencePrompt.OnUserPresenceResolvedAsync(Yubico.YubiKit.Core.Credentials.UserPresenceContext,Yubico.YubiKit.Core.Credentials.UserPresenceOutcome,System.Threading.CancellationToken)">
            <summary>Notifies the application that the corresponding user-presence request has ended.</summary>
            <param name="context">The context supplied with the request notification.</param>
            <param name="outcome">The terminal outcome of the operation associated with the notification.</param>
            <param name="cancellationToken">
                Token for the cleanup notification. The SDK always supplies <see cref="P:System.Threading.CancellationToken.None" /> so the
                implementation can clear any user interface it displayed after operation cancellation.
            </param>
            <remarks>
                The default implementation does nothing, allowing implementations interested only in the request
                notification to omit this method. If this callback throws after a successful device operation, its
                exception propagates. If an operation or cancellation exception is already being propagated, the SDK logs
                the resolution failure and preserves the primary exception.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.UserPresenceApplications">
            <summary>Application identifiers used by SDK user-presence notifications.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceApplications.Fido2">
            <summary>FIDO2 application.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceApplications.Piv">
            <summary>PIV application.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceApplications.Oath">
            <summary>OATH application.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceApplications.OpenPgp">
            <summary>OpenPGP application.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceApplications.YubiOtp">
            <summary>YubiOTP application.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceApplications.YubiHsmAuth">
            <summary>YubiHSM Auth application.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.UserPresenceBasis">
            <summary>Identifies why the SDK issued a user-presence notification.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceBasis.DeviceWaiting">
            <summary>
                The device or protocol has reported that it is currently waiting for physical user presence.
            </summary>
            <remarks>
                This value represents an observed in-flight wait, not a prediction based only on configured policy.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceBasis.PolicyRequires">
            <summary>
                The effective operation or credential policy requires user presence, but the device has not reported
                that it is currently waiting.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceBasis.PolicyMayRequire">
            <summary>
                The SDK cannot determine in advance whether the effective operation or credential policy will require
                user presence.
            </summary>
            <remarks>
                This value is advisory: it means neither that presence is definitely required nor that the device is
                currently waiting.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.UserPresenceContext">
            <summary>Describes one user-presence notification issued by an SDK operation.</summary>
            <remarks>
                This is a non-positional record so optional context can be added in later releases without breaking callers
                or implementations. Implementations should ignore properties they do not use.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Basis">
            <summary>Gets the reason the SDK issued the notification.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Application">
            <summary>
                Gets the SDK application or applet performing the operation. See <see cref="T:Yubico.YubiKit.Core.Credentials.UserPresenceApplications" />.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Operation">
            <summary>
                Gets a stable identifier for the SDK operation requesting presence, normally one of the constants in
                <see cref="T:Yubico.YubiKit.Core.Credentials.UserPresenceOperations" />, such as <see cref="F:Yubico.YubiKit.Core.Credentials.UserPresenceOperations.Ctap2.GetAssertion" />.
            </summary>
            <remarks>
                Values are unique across applications, so a prompt can switch on this property alone. They identify the
                SDK method, not localized display text, and are not always a single user-facing verb (for example,
                <see cref="F:Yubico.YubiKit.Core.Credentials.UserPresenceOperations.Piv.SignOrDecrypt" />). Always set on SDK-created contexts; may be null
                on caller-created contexts. Treat null or unknown values as a generic prompt.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Intent">
            <summary>
                Gets the application's description of why the user is performing the operation, such as
                <c>"approve the transfer"</c>, or <c>null</c> when none was supplied.
            </summary>
            <remarks>
                The SDK sets this from the innermost <see cref="M:Yubico.YubiKit.Core.Credentials.UserPresenceIntent.BeginScope(System.String)" /> active when the operation
                started. It is application-supplied display text, so it is excluded from <see cref="M:Yubico.YubiKit.Core.Credentials.UserPresenceContext.ToString" />. Show it
                alongside <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Operation" /> rather than instead of it, so the user can still spot a touch that does not
                match what they expected.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Scope">
            <summary>
                Gets an optional display-oriented description of the operation or object requiring presence, such as a
                relying-party identifier, credential label, or key slot.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Equals(Yubico.YubiKit.Core.Credentials.UserPresenceContext)">
            <summary>Compares notification contexts by reference identity.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceContext.GetHashCode">
            <summary>Returns an identity-based hash code for this notification context.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceContext.ToString">
            <summary>Formats the context without including <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Scope" /> or <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Intent" />.</summary>
            <remarks>
                <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Application" /> and <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Operation" /> are SDK identifiers on SDK-created contexts;
                caller-created contexts can carry arbitrary values and should not be assumed non-sensitive.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.UserPresenceIntent">
            <summary>
                Attaches the application's reason for an operation to the user-presence notifications it causes.
            </summary>
            <remarks>
                <para>
                    The SDK reports which operation is waiting for a touch in <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Operation" />. Only
                    the application knows why the user started it, such as "approve the transfer". Wrap the SDK call in a scope
                    and every notification that call raises carries the text in <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Intent" />:
                </para>
                <code>
                    using (UserPresenceIntent.BeginScope("approve the transfer"))
                    {
                        await client.GetAssertionAsync(requestOptions, cancellationToken: cancellationToken);
                    }
                </code>
                <para>
                    The scope follows the async flow of the code that opened it, like <c>Activity.Current</c>. Concurrent
                    operations in other flows do not see it, and code started from inside it, including <c>Task.Run</c>, does.
                    The SDK copies the intent into the context when the operation begins, so the prompt receives it regardless
                    of which thread the notification is raised on.
                </para>
                <para>
                    Scopes nest. The innermost undisposed scope replaces outer ones rather than being combined with them, so a
                    helper that opens its own scope overrides the caller's wording until it is disposed. Disposing a scope, in
                    any order and any number of times, removes only that scope, and a disposed scope is never reported again.
                    Work started inside a scope that begins its SDK operation after the scope is disposed, such as a
                    fire-and-forget task, gets the next outer undisposed scope, or no intent.
                </para>
                <para>
                    Always dispose the scope, normally with <c>using</c>. A scope that is never disposed stays active for the
                    rest of the async flow that opened it: in synchronous code or top-level statements that means every later
                    operation reports its intent. Inside an <c>async</c> method, the scope ends when that method returns.
                </para>
                <para>
                    Call <see cref="M:Yubico.YubiKit.Core.Credentials.UserPresenceIntent.BeginScope(System.String)" /> in the same method that awaits the SDK call, or in a synchronous helper. Do not
                    open it inside an <c>async</c> helper and return the scope to the caller: the returned object is still
                    undisposed, but the intent does not flow back out of the helper, so the caller's operation gets no intent.
                    This is standard <see cref="T:System.Threading.AsyncLocal`1" /> behavior.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceIntent.BeginScope(System.String)">
            <summary>
                Starts a scope whose <paramref name="intent" /> is attached to user-presence notifications raised by SDK
                operations started inside it.
            </summary>
            <param name="intent">
                Display text describing why the user is performing the operation, written as a lowercase verb phrase such as
                <c>"approve the transfer"</c> so it reads naturally after "Touch your YubiKey to". It is passed to the prompt
                unchanged and is never logged by the SDK.
            </param>
            <returns>An object that ends the scope when disposed.</returns>
            <exception cref="T:System.ArgumentException"><paramref name="intent" /> is empty or whitespace.</exception>
            <exception cref="T:System.ArgumentNullException"><paramref name="intent" /> is <c>null</c>.</exception>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceIntent.Current">
            <summary>Gets the intent of the innermost undisposed scope in the current async flow.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.UserPresenceNotification">
            <summary>
                Owns the request and resolution lifecycle for one SDK user-presence notification.
            </summary>
            <remarks>
                Enabled instances have one logical owner, belong to one operation, and are not thread-safe. They must not be
                shared between operations or called concurrently from independent execution flows. <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.None" /> is
                the immutable, shared no-op instance used when no prompt or context was supplied. A successful request is
                emitted at most once, and only that request can be resolved. A request callback exception propagates and
                terminally disables the handle without emitting resolution. A resolution callback exception propagates when
                there is no primary operation exception; otherwise it is logged and the primary exception is preserved.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.NotificationState">
            <summary>Tracks the lifecycle of an enabled, single-owner notification.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.NotificationState.Initial">
            <summary>No request or terminal resolution has been attempted.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.NotificationState.Requesting">
            <summary>The request callback is currently running.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.NotificationState.Requested">
            <summary>The request callback completed successfully and can be resolved.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.NotificationState.Terminal">
            <summary>The notification is terminal and cannot be requested or resolved again.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.Logger">
            <summary>Writes cleanup callback failures without adding a public logger dependency.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification._prompt">
            <summary>The application-owned callback, or <c>null</c> only for <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.None" />.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification._context">
            <summary>The context used for the successful request and its matching resolution.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Credentials.UserPresenceNotification._state">
            <summary>The current lifecycle state for an enabled instance.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.#ctor">
            <summary>Initializes the shared no-op notification.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.#ctor(Yubico.YubiKit.Core.Credentials.IUserPresencePrompt,Yubico.YubiKit.Core.Credentials.UserPresenceContext)">
            <summary>Initializes an enabled notification for one operation.</summary>
            <param name="prompt">The application-owned notification callback.</param>
            <param name="context">The initial operation context.</param>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.None">
            <summary>Gets the immutable shared no-op notification.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.IsEnabled">
            <summary>Gets whether this operation has an application callback and context.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.Create(Yubico.YubiKit.Core.Credentials.IUserPresencePrompt,Yubico.YubiKit.Core.Credentials.UserPresenceContext)">
            <summary>
                Creates an enabled per-operation notification when both inputs are present; otherwise returns
                <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.None" />.
            </summary>
            <param name="prompt">The optional application-owned notification callback.</param>
            <param name="context">The optional operation context.</param>
            <returns>An enabled per-operation notification, or <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.None" />.</returns>
            <remarks>
                Captures the active <see cref="T:Yubico.YubiKit.Core.Credentials.UserPresenceIntent" /> here, in the caller's async flow at the start of the
                operation, so the intent does not depend on where the request is later raised. An intent already set on
                <paramref name="context" /> is kept.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.RequestAsync(System.Threading.CancellationToken)">
            <summary>Requests user presence once using the context supplied to <see cref="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.Create(Yubico.YubiKit.Core.Credentials.IUserPresencePrompt,Yubico.YubiKit.Core.Credentials.UserPresenceContext)" />.</summary>
            <param name="cancellationToken">The operation cancellation token supplied to the callback.</param>
            <returns>A task representing the request callback.</returns>
            <remarks>
                A callback exception propagates, makes the handle terminal, and prevents a matching resolution callback.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.RequestAsync(Yubico.YubiKit.Core.Credentials.UserPresenceBasis,System.Threading.CancellationToken)">
            <summary>Requests user presence once, replacing the initial context basis before notification.</summary>
            <param name="basis">The stronger or more current basis observed at the request site.</param>
            <param name="cancellationToken">The operation cancellation token supplied to the callback.</param>
            <returns>A task representing the request callback.</returns>
            <remarks>
                A callback exception propagates, makes the handle terminal, and prevents a matching resolution callback.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.ResolveAsync(Yubico.YubiKit.Core.Credentials.UserPresenceOutcome,System.Exception)">
            <summary>Resolves a successfully requested notification once.</summary>
            <param name="outcome">The terminal operation outcome.</param>
            <param name="primaryException">
                The operation exception already being propagated, if any. A resolution failure is logged rather than
                replacing this exception.
            </param>
            <returns>A task representing the resolution callback.</returns>
            <remarks>
                The callback always receives <see cref="P:System.Threading.CancellationToken.None" />. Calling this before a successful
                request terminally disables the notification. Calling it again is a no-op, including after the first
                resolution callback throws.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Credentials.UserPresenceNotification.RequestCoreAsync(System.Nullable{Yubico.YubiKit.Core.Credentials.UserPresenceBasis},System.Threading.CancellationToken)">
            <summary>Runs the single request callback with an optional basis replacement.</summary>
            <param name="basis">The replacement basis, or <c>null</c> to preserve the initial context.</param>
            <param name="cancellationToken">The operation cancellation token supplied to the callback.</param>
            <returns>A task representing the request callback.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Credentials.UserPresenceOperations">
            <summary>Identifiers for the SDK operations that report <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Operation" />.</summary>
            <remarks>
                Operations are grouped by SDK operation surface. Each value is unique across all groups and has the form
                <c>Group.Method</c>, where <c>Method</c> is the public SDK method name without <c>Async</c>, so a
                prompt can switch on <see cref="P:Yubico.YubiKit.Core.Credentials.UserPresenceContext.Operation" /> alone. This is an open set: future
                releases may add values, so consumers should include a default branch.
                The group can differ from the application identifier; CTAP2 operations report the FIDO2 application.
            </remarks>
        </member>
