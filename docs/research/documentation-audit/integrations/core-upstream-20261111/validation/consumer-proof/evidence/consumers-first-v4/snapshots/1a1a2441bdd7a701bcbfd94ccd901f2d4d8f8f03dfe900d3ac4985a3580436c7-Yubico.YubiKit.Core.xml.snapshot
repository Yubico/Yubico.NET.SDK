            <summary>
                Gets the data part of the response.
            </summary>
            <value>
                The raw bytes not including the ending status word.
            </value>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.ToString">
            <summary>
                Prints SW1, SW2, and the length of the Data field in a formatted string.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduResponse.Clear">
            <summary>Clears the owned response bytes, invalidating all exposed byte views.</summary>
            <remarks>
            Constructors copy caller input. Clearing affects this response and every alias of its owned
            data, including status bytes, never the caller's source. Repeated clearing is harmless.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.IApduFormatter.Format(System.Byte,System.Byte,System.Byte,System.Byte,System.ReadOnlyMemory{System.Byte},System.Int32)">
            <summary>
                Formats an APDU into a freshly allocated, exclusively owned wire payload buffer.
            </summary>
            <remarks>
                Transmitters may zero the returned buffer after transmission because formatted APDUs can contain secrets.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.IApduFormatter.Format(Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduCommand)">
            <summary>
                Formats an APDU into a freshly allocated, exclusively owned wire payload buffer.
            </summary>
            <remarks>
                Transmitters may zero the returned buffer after transmission because formatted APDUs can contain secrets.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ISmartCardProtocol">
            <summary>
                Protocol interface for SmartCard communication.
            </summary>
            <remarks>
                Implementations admit one logical exchange at a time. An overlapping call throws
                <see cref="T:System.InvalidOperationException" /> immediately because parallel APDU streams would corrupt chained
                commands, chained responses, and SCP MAC chains. A token is checked before entry; an exchange already
                in flight runs to completion so no partial chained state is left on the card.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ISmartCardProtocol.TransmitAndReceiveAsync(Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduCommand,System.Boolean,System.Threading.CancellationToken)">
            <summary>
            Transmits an APDU command and returns the response.
            </summary>
            <param name="command">The APDU command to transmit.</param>
            <param name="throwOnError">
            When <c>true</c> (default), throws <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException"/> for non-success status words.
            When <c>false</c>, returns the response without throwing.
            </param>
            <param name="cancellationToken">Cancellation token.</param>
            <returns>The APDU response containing data and status word.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.PcscProtocol">
            <summary>
                APDU protocol over a single smart-card connection. Overlapping logical exchanges are refused —
                a smart card is a stateful sequential peer, so interleaved APDUs from two operations would corrupt
                each other's chained state.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.PcscProtocol.ExchangeGuard">
            <summary>
                The guard refusing overlapping logical exchanges on this protocol's connection. Shared with
                decorators that drive the same connection through their own processors (e.g. the SCP wrapper), so
                plain and wrapped traffic can never interleave.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.PcscProtocol.Dispose">
            <summary>
                Releases this protocol. The connection is NOT disposed: a protocol is a user of the connection it
                was handed, never its owner. Whoever created the connection disposes it.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.SmartCardMaxApduSizes.Neo">
            <summary>
                The max APDU command size for the YubiKey NEO
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.SmartCardMaxApduSizes.Yk4">
            <summary>
                The max APDU command size for the YubiKey 4 and greater
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.SmartCardMaxApduSizes.Yk43">
            <summary>
                The max APDU command size for the YubiKey 4.3 and greater
            </summary>
        </member>
