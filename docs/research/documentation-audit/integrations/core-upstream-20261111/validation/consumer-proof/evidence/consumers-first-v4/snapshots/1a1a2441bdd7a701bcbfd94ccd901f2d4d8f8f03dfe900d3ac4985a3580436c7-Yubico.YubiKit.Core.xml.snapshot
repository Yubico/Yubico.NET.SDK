            </summary>
            <value>
            A <see cref="P:Yubico.YubiKit.Core.Cryptography.RSAPublicKey.KeyInfo"/> object that describes the key's representation.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.RSAPublicKey.KeyType">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAPublicKey.ExportSubjectPublicKeyInfo">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.RSAPublicKey.CreateFromParameters(System.Security.Cryptography.RSAParameters)">
            <summary>
