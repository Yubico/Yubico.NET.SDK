    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-288.cs",
      "bytes": 1118,
      "sha256": "8fab13d956810097a9c7b71984e2e31e2f32a7aef322ff69a26ddc92504f8d45",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test288;\npublic sealed class DocumentationBody288\n{\n[SkippableTheory]\n[WithYubiKey(\n    MinFirmware = \"5.3.0\",                     // Only firmware >= 5.3.0\n    Capability = DeviceCapabilities.Piv,      // PIV enabled over USB OR NFC\n    RequireUsb = true                         // Independent USB availability requirement\n)]\npublic async Task MyTest(YubiKeyTestState state)\n{\n    var info = await state.Device.GetDeviceInfoAsync();\n    Assert.Equal(state.SerialNumber, info.SerialNumber);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-289.cs",
      "bytes": 1149,
      "sha256": "70f74c9b10eddb41647a0a24743781166a7f0841ab3fbbf45767d13e0d852443",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test289;\npublic sealed class DocumentationBody289\n{\n[SkippableTheory]\n[WithYubiKey(MinFirmware = \"5.0.0\")]\npublic async Task MyTest(YubiKeyTestState state) =>\n    await state.WithManagementAsync(async (mgmt, cachedDeviceInfo) =>\n    {\n        // mgmt = ManagementSession (already initialized)\n        // cachedDeviceInfo = shared test-state snapshot, not fresh helper-entry metadata\n        \n        var info = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(cachedDeviceInfo.SerialNumber, info.SerialNumber);\n    });\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Oath.IntegrationTests/EXT-204.cs",
      "bytes": 1447,
      "sha256": "98f1bbe00e355d6dd72211081ff39356fe839b426cbc0f8fb185c717859aaac8",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Oath;\nnamespace Audit20261111.DocExamples.External204;\npublic static class DocumentationExtensions\n{\npublic static async Task WithOathAsync(\n    this YubiKeyTestState state,\n    Func<OathSession, DeviceInfo, Task> action,\n    ScpKeyParameters? scpKeyParams = null,\n    CancellationToken cancellationToken = default)\n{\n    await using var connection = await state.Device.ConnectAsync<ISmartCardConnection>(cancellationToken);\n\n    await using var session = await OathSession.CreateAsync(\n        connection,\n        new SessionCreationOptions { ScpKeyParameters = scpKeyParams },\n        cancellationToken: cancellationToken);\n\n    await action(session, state.DeviceInfo);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Piv.IntegrationTests/FULL-375.cs",
      "bytes": 1074,
      "sha256": "94fcaceef54ca218e4b9d31d77ea48455529a1c4b35fff9510d7c420d76bb58e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Piv;\nnamespace Audit20261111.DocExamples.Test375;\npublic sealed class DocumentationBody375\n{\n[SkippableTheory]\n[WithYubiKey(Capability = DeviceCapabilities.Piv, MinFirmware = \"5.3.0\")]\npublic async Task GetMetadata_ReadOnly_Succeeds(YubiKeyTestState state)\n{\n    await using var session = await state.Device.CreatePivSessionAsync();\n    var metadata = await session.GetPinMetadataAsync();\n    Assert.InRange(metadata.RetriesRemaining, 0, metadata.TotalRetries);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/SecurityDomain.IntegrationTests/EXT-231.cs",
      "bytes": 1409,
      "sha256": "91de2389648e9ff4480216ff2a2f24e2b3bf72bc2f35a476a6065a9d3f17ce97",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain.IntegrationTests.TestExtensions;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External231;\npublic sealed class DocumentationBody\n{\n[SkippableTheory]\n[WithYubiKey(MinFirmware = \"5.3.0\", ConnectionType = ConnectionType.SmartCard)]\npublic async Task Scp03_AfterReset_ReturnsKeyInfo(YubiKeyTestState state)\n{\n    using var scpKeyParams = Scp03KeyParameters.Default;\n    await state.WithSecurityDomainSessionAsync(\n        resetBeforeUse: true,\n        async session =>\n        {\n            var keyInfo = await session.ListKeyInformationAsync();\n            Assert.NotEmpty(keyInfo);\n        },\n        scpKeyParams: scpKeyParams);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/SecurityDomain.IntegrationTests/FULL-302.cs",
      "bytes": 1405,
      "sha256": "154ce9459a9ef62eb9efbc0ecfb9b5acbec37c8a3533300690c1a91abbe404f2",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\nnamespace Audit20261111.DocExamples.Test302;\npublic sealed class DocumentationBody302\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.SmartCard, MinFirmware = \"5.4.3\")]\npublic async Task ListAfterReset_ContainsFactoryVersion(YubiKeyTestState state)\n{\n    using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(100));\n    CancellationToken ct = timeout.Token;\n    using var parameters = Scp03KeyParameters.Default;\n    await state.WithSecurityDomainSessionAsync(\n        resetBeforeUse: true,\n        async session =>\n        {\n            var keys = await session.ListKeyInformationAsync(ct);\n            Assert.Contains(keys, entry => entry.KeyReference.Kvn == 0xFF);\n        },\n        scpKeyParams: parameters,\n        cancellationToken: ct);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/SecurityDomain.IntegrationTests/FULL-303.cs",
      "bytes": 1969,
      "sha256": "a57bb44f26c3bfe797840f3e095f6cc5c782f53a2213d28f8677a395d984662a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\nnamespace Audit20261111.DocExamples.Test303;\npublic sealed class DocumentationBody303\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.SmartCard, MinFirmware = \"5.7.2\")]\npublic async Task GeneratedKey_IsListedInNextSession(YubiKeyTestState state)\n{\n    using var timeout = new CancellationTokenSource(TimeSpan.FromSeconds(100));\n    CancellationToken ct = timeout.Token;\n    using var parameters = Scp03KeyParameters.Default;\n    var keyRef = new KeyReference(ScpKid.SCP11b, 0x03);\n    try\n    {\n        await state.WithSecurityDomainSessionAsync(\n            resetBeforeUse: true,\n            async session => { await session.GenerateKeyAsync(keyRef, cancellationToken: ct); },\n            scpKeyParams: parameters,\n            cancellationToken: ct);\n\n        await state.WithSecurityDomainSessionAsync(\n            resetBeforeUse: false,\n            async session =>\n            {\n                var keys = await session.ListKeyInformationAsync(ct);\n                Assert.Contains(keys, entry => entry.KeyReference.Kid == keyRef.Kid &&\n                    entry.KeyReference.Kvn == keyRef.Kvn);\n            },\n            cancellationToken: ct);\n    }\n    finally\n    {\n        using var cleanup = new CancellationTokenSource(TimeSpan.FromSeconds(60));\n        await state.ResetSecurityDomainAsync(cleanup.Token);\n    }\n}\n}\n"
    },
    {
