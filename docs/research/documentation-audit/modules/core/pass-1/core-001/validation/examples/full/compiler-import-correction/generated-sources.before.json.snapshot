      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-061.cs",
      "bytes": 1359,
      "sha256": "d4a6c4b31a43961495a1ee225bfb8da7c97a7dd7cd90e061d1a15b06645fa1e2",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test61;\npublic sealed class DocumentationBody61\n{\n// \u2705 GOOD - Tests actual SCP handshake with real hardware\n[Fact]\npublic async Task CreateSession_WithSCP03_AuthenticatesAndCommunicates()\n{\n    var device = await YubiKeyManager.FindFirstAsync(cancellationToken: TestContext.Current.CancellationToken);\n    using var scpKeyParams = Scp03KeyParameters.Default;\n    await using var session = await device.CreateManagementSessionAsync(\n        new SessionCreationOptions { ScpKeyParameters = scpKeyParams },\n        cancellationToken: TestContext.Current.CancellationToken);\n\n    var deviceInfo = await session.GetDeviceInfoAsync(TestContext.Current.CancellationToken);\n    Assert.Equal(device.SerialNumber, deviceInfo.SerialNumber);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-133.cs",
      "bytes": 1773,
      "sha256": "167214466984d0579afacf62e59928c1536766c57d1e5fbd6ab36000716d4e2f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test133;\npublic sealed class DocumentationBody133\n{\n// One device row; state.ConnectionType may contain multiple flags.\n[SkippableTheory]\n[WithYubiKey]\npublic async Task DefaultSelection(YubiKeyTestState state)\n{\n    var info = await state.Device.GetDeviceInfoAsync();\n    Assert.Equal(state.SerialNumber, info.SerialNumber);\n}\n\n// One row whose device must expose SmartCard.\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.SmartCard)]\npublic async Task SmartCardOnly(YubiKeyTestState state)\n{\n    var info = await state.Device.GetDeviceInfoAsync();\n    Assert.Equal(state.SerialNumber, info.SerialNumber);\n}\n\n// Three separate rows, one for each requested connection type.\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.SmartCard)]\n[WithYubiKey(ConnectionType = ConnectionType.HidFido)]\n[WithYubiKey(ConnectionType = ConnectionType.HidOtp)]\npublic async Task EachManagementConnection(YubiKeyTestState state)\n{\n    // This demonstrates independent device-filter rows, not operation-transport coverage.\n    var info = await state.Device.GetDeviceInfoAsync();\n    Assert.Equal(state.SerialNumber, info.SerialNumber);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-134.cs",
      "bytes": 1005,
      "sha256": "3966f8b56915e6f025d08fa9671aabdfb7ceb73372c8a821bbb50e8b14f7ed70",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test134;\npublic sealed class DocumentationBody134\n{\n[SkippableTheory]\n[WithYubiKey]\npublic async Task GetDeviceInfo_DefaultManagementSelection(YubiKeyTestState state)\n{\n    await state.WithManagementAsync(async (mgmt, cachedDeviceInfo) =>\n    {\n        var deviceInfo = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(state.SerialNumber, deviceInfo.SerialNumber);\n    });\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-135.cs",
      "bytes": 1373,
      "sha256": "f86668df8d960d2e684b357299d9d66da41ac9e353cd27d7cbe70504dbc11eae",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test135;\npublic sealed class DocumentationBody135\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.SmartCard)]\n[WithYubiKey(ConnectionType = ConnectionType.HidFido)]\n[WithYubiKey(ConnectionType = ConnectionType.HidOtp)]\npublic async Task GetDeviceInfo_UsesRequestedManagementConnection(YubiKeyTestState state)\n{\n    Assert.True(state.ConnectionType is\n        ConnectionType.SmartCard or ConnectionType.HidFido or ConnectionType.HidOtp);\n\n    await state.WithManagementAsync(async (mgmt, _) =>\n    {\n        Assert.Equal(state.ConnectionType, mgmt.ConnectionType);\n\n        var info = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(state.SerialNumber, info.SerialNumber);\n    }, preferredConnection: state.ConnectionType);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-137.cs",
      "bytes": 1113,
      "sha256": "6da691242bd98475cbb752b1e2a21769be9e9c7a3ee3b74040346aa6fd1e6da9",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test137;\npublic sealed class DocumentationBody137\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.HidFido)]\npublic async Task ManagementOverFido_Works(YubiKeyTestState state)\n{\n    await state.WithManagementAsync(async (mgmt, _) =>\n    {\n        Assert.Equal(ConnectionType.HidFido, mgmt.ConnectionType);\n        var info = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(state.SerialNumber, info.SerialNumber);\n    }, preferredConnection: state.ConnectionType);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-138.cs",
      "bytes": 1358,
      "sha256": "52e074861e492231ad5be0cbb95538409df169a9686eae1abd17f1abf16ee8c7",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\n\nnamespace Audit20261111.DocExamples.Test138;\npublic class MyTests\n{\n    // Test requires hardware (device must be connected, but runs automatically)\n    [Fact]\n    [Trait(TestCategories.Category, TestCategories.RequiresHardware)]\n    public async Task FindAllAsync_ReturnsDevice() { }\n\n    // Test requires user to insert/remove device (cannot run in CI/agents)\n    [Fact]\n    [Trait(TestCategories.Category, TestCategories.RequiresUserPresence)]\n    [Trait(TestCategories.Category, TestCategories.Slow)]\n    public async Task WatchAsync_DetectsRemoval() { }\n\n    // Slow test with long delays\n    [Fact]\n    [Trait(TestCategories.Category, TestCategories.Slow)]\n    public async Task Performance_ManyOperations() { }\n}\n"
