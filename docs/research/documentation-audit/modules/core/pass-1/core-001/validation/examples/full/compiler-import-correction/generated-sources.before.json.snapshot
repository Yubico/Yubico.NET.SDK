      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body81\n{\ninternal static void CompileOnly(IEnumerable<string> items)\n{\n// \u2705 GOOD\nvar sb = new StringBuilder();\nforeach (var item in items) sb.Append(item);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-082.cs",
      "bytes": 1079,
      "sha256": "0528d138f593030ec9500141af5f60fb5cd18a627cfe8b2d364b6850a129cc1c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body82\n{\ninternal static void CompileOnly(string? nullableString)\n{\n// \u2705 GOOD\nstring value = nullableString ?? throw new ArgumentNullException(nameof(nullableString));\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-086.cs",
      "bytes": 933,
      "sha256": "1177daba1c0213f32c283bdce883a445103b5152b450a684202580ef60e9539b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body86\n{\npublic record ConnectionOptions(TimeSpan Timeout, int RetryCount);\n\npublic readonly struct StatusWord\n{\n    public StatusWord(byte sw1, byte sw2) => (SW1, SW2) = (sw1, sw2);\n    public byte SW1 { get; }\n    public byte SW2 { get; }\n    public ushort Value => (ushort)((SW1 << 8) | SW2);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-089.cs",
      "bytes": 950,
      "sha256": "b56466e7900d03e3c080f7545434349bbab79b1a81eaf9283c3db4cd05457bd9",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal sealed class Body89\n{\npublic void SetPin(ReadOnlySpan<byte> pin)\n{\n    if (pin.Length is < 6 or > 8)\n        throw new ArgumentException(\"PIN must be 6-8 bytes\", nameof(pin));\n\n    foreach (byte b in pin)\n        if (b is < 0x30 or > 0x39)\n            throw new ArgumentException(\"PIN must contain only digits\", nameof(pin));\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-092.cs",
      "bytes": 1354,
      "sha256": "8cc56ad7ba17a38f61ff67f70b7546718b6d77574ea2c9fd1d1cc62eefe2bdcc",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body92\n{\ninternal static async Task CompileOnly(Microsoft.Extensions.Logging.ILoggerFactory loggerFactory)\n{\n// No logging (default) - just use the SDK\nvar devices = await YubiKeyManager.FindAllAsync();\n\n// With logging - one line before using SDK\nYubiKitLogging.Configure(loggerFactory);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-093.cs",
      "bytes": 1033,
      "sha256": "653bb5f92b90635dce614662fd91a7d2c4372f6395e84ee6b671c8f43af277bd",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body93\n{\ninternal static async Task CompileOnly()\n{\nvar devices = await YubiKeyManager.FindAllAsync();\n// No logging output\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-094.cs",
      "bytes": 1419,
      "sha256": "0846933245fc573bc1c3961812e820e04e239f17071142e1d6b737827408281d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body94\n{\ninternal static void CompileOnly()\n{\n// Create your logger factory\nusing var loggerFactory = LoggerFactory.Create(builder =>\n{\n    builder.AddConsole();\n    builder.SetMinimumLevel(LogLevel.Debug);\n});\n\n// Configure YubiKit before using SDK\nYubiKitLogging.Configure(loggerFactory);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-095.cs",
      "bytes": 1517,
      "sha256": "9b0f1859e3aaf2b88e62dc5fed1e3d3a0e71de18bb94c11d96a9308e3d293cb1",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body95\n{\ninternal static async Task CompileOnly()\n{\nusing var host = Host.CreateDefaultBuilder()\n    .ConfigureLogging(logging =>\n    {\n        logging.AddConsole();\n        logging.SetMinimumLevel(LogLevel.Information);\n    })\n    .Build();\n\n// Explicit setup from the DI-provided ILoggerFactory\nYubiKitLogging.Configure(host.Services.GetRequiredService<ILoggerFactory>());\n\nawait host.StartAsync();\nvar devices = await YubiKeyManager.FindAllAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-096.cs",
      "bytes": 1324,
      "sha256": "2d6f9ad9c701c8e08ea8eaf98f6c7fd10f69984484c35b55a5f233c45548b89c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body96\n{\ninternal static void CompileOnly(string[] args)\n{\nvar builder = WebApplication.CreateBuilder(args);\n\n// ASP.NET Core already configures logging\n\nvar app = builder.Build();\n\nYubiKitLogging.Configure(app.Services.GetRequiredService<ILoggerFactory>());\n}\n\n}\n"
    },
