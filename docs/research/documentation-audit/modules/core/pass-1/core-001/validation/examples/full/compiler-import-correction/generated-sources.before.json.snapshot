      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-241.cs",
      "bytes": 1118,
      "sha256": "1bac5f2e252ca71c30973964d6810811f25ea6ff103dcd55539919693d8aca40",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External241;\npublic sealed class DocumentationBody\n{\n[SkippableTheory]\n[WithYubiKey]\npublic async Task CheckDeviceProperties(YubiKeyTestState state)\n{\n    await state.WithManagementAsync((mgmt, info) =>\n    {\n        Assert.True(info.SerialNumber > 0);\n        Assert.NotEqual(FormFactor.Unknown, info.FormFactor);\n    });\n}\n    \n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-242.cs",
      "bytes": 1272,
      "sha256": "45223354550c1a5556470d8e62109be407d54a6298dd7f95d79ab3705da23cbf",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External242;\npublic sealed class DocumentationBody\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.SmartCard)]\npublic async Task ReadMetadata_WithBorrowedConnection(YubiKeyTestState state)\n{\n    await state.WithConnectionAsync(async connection =>\n    {\n        await using var session = await ManagementSession.CreateAsync(connection);\n        var info = await session.GetDeviceInfoAsync();\n        Assert.Equal(state.SerialNumber, info.SerialNumber);\n    });\n}\n    \n}\n"
    },
