      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Core.UnitTests/FULL-211.cs",
      "bytes": 1112,
      "sha256": "c831150b9a796cfb77b54e7620ed95cb3b4c67ffde9db26abee71ce73af57a75",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Native;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.UnitTests.Protocols.SmartCard.Apdu.Fakes;\nnamespace Audit20261111.DocExamples.Test211;\npublic sealed class DocumentationBody211\n{\ninternal async Task CompileOnly()\n{\nusing var fakeConnection = new FakeSmartCardConnection();\n\n// Queue expected responses\nfakeConnection.EnqueueResponse(new byte[] { 0x90, 0x00 }); // Success\n\n// Create protocol with fake\nusing var protocol = new PcscProtocol(fakeConnection);\n\n// Test\nvar result = await protocol.SelectAsync(ApplicationIds.Piv, CancellationToken.None);\n\n// Verify commands sent\nAssert.Single(fakeConnection.TransmittedCommands);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Ctap2.IntegrationTests/FULL-012.cs",
      "bytes": 1332,
      "sha256": "03ac527261ef02acc7d820c1bc02c8cdaf6e1a2fb87c7f18b4afa5f0fb44e00b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.IntegrationTests.TestExtensions;\nnamespace Audit20261111.DocExamples.Test12;\npublic sealed class DocumentationBody12\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.HidFido)]\npublic async Task GetInfoAsync_Returns_Aaguid(YubiKeyTestState state)\n{\n    await using var session = await state.Device.CreateCtap2SessionAsync(\n        new SessionCreationOptions { PreferredConnectionType = ConnectionType.HidFido });\n    var info = await session.GetInfoAsync();\n    Assert.Equal(16, info.Aaguid.Length);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Ctap2.IntegrationTests/FULL-026.cs",
      "bytes": 2797,
      "sha256": "11a6f15142db2120248ef5dd72f0c0eabc61dea5072f0b4b2714c63107dc4d92",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.IntegrationTests.TestExtensions;\nnamespace Audit20261111.DocExamples.Test26;\npublic sealed class DocumentationBody26\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.HidFido)]\n[Trait(TestCategories.Category, TestCategories.RequiresUserPresence)]\npublic async Task MakeCredential_TouchRequired_Succeeds(YubiKeyTestState state)\n{\n    await state.WithCtap2SessionAsync(async session =>\n    {\n        using var protocol = new PinUvAuthProtocolV2(); // Test device must support V2.\n        using var clientPin = new ClientPin(session, protocol);\n        byte[]? token = null;\n        byte[]? authParam = null;\n        try\n        {\n            byte[] clientDataHash = RandomNumberGenerator.GetBytes(32); // Protocol demo, not client data.\n            var rp = new PublicKeyCredentialRpEntity(\"example.com\", \"Example\");\n            var user = new PublicKeyCredentialUserEntity(\n                RandomNumberGenerator.GetBytes(32), \"test@example.com\", \"Test\");\n            token = await clientPin.GetPinUvAuthTokenUsingPinAsync(\n                Ctap2TestStateExtensions.KnownTestPin,\n                PinUvAuthTokenPermissions.MakeCredential, rp.Id);\n            authParam = protocol.Authenticate(token, clientDataHash);\n            var options = new MakeCredentialOptions { ResidentKey = true };\n            options.WithPinUvAuth(authParam, protocol.Version); // uv absent.\n            var response = await session.MakeCredentialAsync(\n                clientDataHash, rp, user, [PublicKeyCredentialParameters.CreateES256()], options);\n            var attested = Assert.IsType<AttestedCredentialData>(response.AuthenticatorData.AttestedCredentialData);\n            Assert.False(attested.CredentialId.IsEmpty);\n        }\n        finally\n        {\n            if (token is not null) CryptographicOperations.ZeroMemory(token);\n            if (authParam is not null) CryptographicOperations.ZeroMemory(authParam);\n        }\n    }, preferredConnection: ConnectionType.HidFido);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Ctap2.IntegrationTests/FULL-027.cs",
      "bytes": 1380,
      "sha256": "fd16f812a587768c29de2667ec6db89d4a41c1542ac263b278fbc9f0df9cce06",
      "content": "using System.Text;\nusing System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.IntegrationTests.TestExtensions;\nnamespace Audit20261111.DocExamples.Test27;\npublic sealed class DocumentationBody27\n{\npublic async Task CompileOnly(ICtap2Session session)\n{\n// With an existing ICtap2Session session; only on a human-approved test device.\nusing var protocol = new PinUvAuthProtocolV2();\nusing var clientPin = new ClientPin(session, protocol);\nbyte[] pin = Encoding.UTF8.GetBytes(Ctap2TestStateExtensions.KnownTestPinString);\ntry\n{\n    await clientPin.SetPinAsync(pin);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n}\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Ctap2.UnitTests/FULL-010.cs",
      "bytes": 1308,
      "sha256": "f22177d79bba0a27dc71b7b1da42421486a87d20abf6f5fc415da9cead7efa2e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing NSubstitute;\nnamespace Audit20261111.DocExamples.Test10;\npublic sealed class DocumentationBody10\n{\n[Fact]\npublic void AuthenticatorInfo_Decode_ParsesVersions()\n{\n    // Partial parser fixture, not a conforming GetInfo envelope: the required AAGUID is absent.\n    var writer = new CborWriter(CborConformanceMode.Ctap2Canonical);\n    writer.WriteStartMap(1);\n    writer.WriteInt32(1);\n    writer.WriteStartArray(1);\n    writer.WriteTextString(\"FIDO_2_0\");\n    writer.WriteEndArray();\n    writer.WriteEndMap();\n    byte[] cborData = writer.Encode();\n    \n    // Act\n    var info = AuthenticatorInfo.Decode(cborData);\n    \n    // Assert\n    Assert.Contains(\"FIDO_2_0\", info.Versions);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Ctap2.UnitTests/FULL-011.cs",
      "bytes": 1849,
      "sha256": "8e0fa3425d3a3993e0c3e0500bb91ac138ea071d52a79a94e247c863a4aad35c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing NSubstitute;\nnamespace Audit20261111.DocExamples.Test11;\npublic sealed class DocumentationBody11\n{\n[Fact]\npublic async Task PinRetries_EncodesProtocolAndSubcommand()\n{\n    var session = Substitute.For<ICtap2Session>();\n    ReadOnlyMemory<byte> mockResponse = new byte[] { 0xA1, 0x03, 0x08 }; // {pinRetries: 8}\n    ReadOnlyMemory<byte> capturedRequest = default;\n    session.SendCborRequestAsync(\n        Arg.Do<ReadOnlyMemory<byte>>(value => capturedRequest = value),\n        Arg.Any<CancellationToken>()).Returns(mockResponse);\n    using var protocol = new PinUvAuthProtocolV2();\n    using var clientPin = new ClientPin(session, protocol);\n\n    var retries = await clientPin.GetPinRetriesAsync(TestContext.Current.CancellationToken);\n\n    Assert.Equal(8, retries.RetriesRemaining);\n    Assert.Equal(CtapCommand.ClientPin, capturedRequest.Span[0]);\n    var reader = new CborReader(capturedRequest.Slice(1), CborConformanceMode.Ctap2Canonical);\n    Assert.Equal(2, reader.ReadStartMap());\n    Assert.Equal(1, reader.ReadInt32());\n    Assert.Equal(protocol.Version, reader.ReadInt32());\n    Assert.Equal(2, reader.ReadInt32());\n    Assert.Equal(ClientPinSubCommand.GetRetries, reader.ReadInt32());\n    reader.ReadEndMap();\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Ctap2.UnitTests/FULL-030.cs",
      "bytes": 1413,
      "sha256": "dd8d848832f3e4857cac948de3ec95b97b726223f693245b259da695956bfcd0",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing NSubstitute;\nnamespace Audit20261111.DocExamples.Test30;\npublic sealed class DocumentationBody30\n{\n[Fact]\npublic void RegistrationExtensions_EncodePolicyAndHmacEnablement()\n{\n    var encoded = new ExtensionBuilder()\n        .WithCredProtect(CredProtectPolicy.UserVerificationRequired)\n        .WithHmacSecret()\n        .Build() ?? throw new InvalidOperationException(\"Expected extension bytes.\");\n    var reader = new CborReader(encoded, CborConformanceMode.Ctap2Canonical);\n    Assert.Equal(2, reader.ReadStartMap());\n    Assert.Equal(\"credProtect\", reader.ReadTextString());\n    Assert.Equal((int)CredProtectPolicy.UserVerificationRequired, reader.ReadInt32());\n    Assert.Equal(\"hmac-secret\", reader.ReadTextString());\n    Assert.True(reader.ReadBoolean());\n    reader.ReadEndMap();\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-206.cs",
      "bytes": 1838,
      "sha256": "b9ea9de1c145aa3418074fc6bf1e27f97049ef2a78ae86fe0242fb8d1a993a7e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\n    using System.Threading.Tasks;\n    using Yubico.YubiKit.Tests.Shared;\n    using Yubico.YubiKit.Tests.Shared.Infrastructure;\n    using Xunit;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External206;\n    public sealed class SerialRangeFilter : IYubiKeyFilter\n    {\n        public bool Matches(YubiKeyTestState device)\n        {\n            // Narrow the already authorized fixture list; never authorize production keys.\n            return device.SerialNumber > 10_000_000;\n        }\n\n        public string GetDescription()\n        {\n            return \"Dedicated test keys with SN > 10000000\";\n        }\n    }\n\n    public sealed class MetadataTests\n    {\n        [SkippableTheory]\n        [WithYubiKey(CustomFilter = typeof(SerialRangeFilter))]\n        public async Task ReadMetadata(YubiKeyTestState state)\n        {\n            await state.WithManagementAsync(async (session, cachedInfo) =>\n            {\n                var freshInfo = await session.GetDeviceInfoAsync();\n                Assert.Equal(cachedInfo.SerialNumber, freshInfo.SerialNumber);\n            });\n        }\n    }\n        \n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-210.cs",
      "bytes": 1344,
      "sha256": "550c39ddc8b408d6c66dc2d9e93bbd40d4763048c2d09061c95183aa34dfd3ab",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External210;\npublic sealed class DocumentationBody\n{\ninternal void CompileOnly(FilterCriteria criteria, int serialNumber)\n{\n    // Get all authorized devices\n    var devices = AuthorizedDevices.GetAll();\n    \n    // Get the first authorized device (throws if none available)\n    var device = AuthorizedDevices.GetFirstOrSkip();\n    \n    // Filter authorized devices\n    var filtered = AuthorizedDevices.GetFiltered(criteria);\n    \n    // Check if a specific device is authorized\n    var isAuthorized = AuthorizedDevices.IsAllowed(serialNumber);\n        \n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-215.cs",
      "bytes": 1823,
      "sha256": "d78599207517847dcf80c699b822d5f2dd30559c174fa6bc1832c4c414cac8a5",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External215;\npublic sealed class DocumentationBody\n{\n    // Single configuration\n    [SkippableTheory]\n    [WithYubiKey(MinFirmware = \"5.7.2\")]\n    public async Task ReadModernDevice(YubiKeyTestState device)\n    {\n        var info = await device.Device.GetDeviceInfoAsync();\n        Assert.Equal(device.SerialNumber, info.SerialNumber);\n    }\n\n    // Multiple configurations\n    [SkippableTheory]\n    [WithYubiKey(MinFirmware = \"5.0.0\")]\n    [WithYubiKey(FormFactor = FormFactor.UsbAKeychain)]\n    [WithYubiKey(CustomFilter = typeof(ProductionKeysOnly))]\n    public async Task ReadIndependentlyBoundRows(YubiKeyTestState device)\n    {\n        var info = await device.Device.GetDeviceInfoAsync();\n        Assert.Equal(device.SerialNumber, info.SerialNumber);\n    }\n\n    // Custom filter example\n    public class ProductionKeysOnly : IYubiKeyFilter\n    {\n        public bool Matches(YubiKeyTestState device) => device.SerialNumber > 10_000_000;\n        public string GetDescription() => \"Production keys (SN > 10000000)\";\n    }\n        \n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-216.cs",
      "bytes": 1366,
      "sha256": "bb98d6f7aa9d25ae2f9b617609187e995b7677029c1dd18541da23cd0061e66d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External216;\npublic sealed class DocumentationBody\n{\n    public class ProductionKeysOnly : IYubiKeyFilter\n    {\n        public bool Matches(YubiKeyTestState device) => device.SerialNumber > 10_000_000;\n        public string GetDescription() => \"Production keys (SN > 10000000)\";\n    }\n\n    [SkippableTheory]\n    [WithYubiKey(CustomFilter = typeof(ProductionKeysOnly))]\n    public async Task ReadSelectedRange(YubiKeyTestState device)\n    {\n        var info = await device.Device.GetDeviceInfoAsync();\n        Assert.Equal(device.SerialNumber, info.SerialNumber);\n    }\n        \n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-227.cs",
      "bytes": 1787,
      "sha256": "08a3a108d16687466d007a76fbde42fae2db89ad249c947eff53a85895b3f73b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External227;\npublic class MyIntegrationTests\n{\n    [SkippableTheory]\n    [WithYubiKey]\n    public async Task GetDeviceInfo_ReturnsValidData(YubiKeyTestState state)\n    {\n        await state.WithManagementAsync(async (mgmt, deviceInfo) =>\n        {\n            var info = await mgmt.GetDeviceInfoAsync();\n            Assert.Equal(state.SerialNumber, info.SerialNumber);\n        });\n    }\n\n    [SkippableTheory]\n    [WithYubiKey(MinFirmware = \"5.7.0\")]\n    public async Task ModernFeatures_RequireFirmware570(YubiKeyTestState state)\n    {\n        using var scpKeyParams = Scp03KeyParameters.Default;\n        await state.WithManagementAsync(async (mgmt, deviceInfo) =>\n        {\n            var fresh = await mgmt.GetDeviceInfoAsync();\n            Assert.Equal(deviceInfo.SerialNumber, fresh.SerialNumber);\n        }, scpKeyParams: scpKeyParams);\n    }\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/EXT-230.cs",
      "bytes": 1225,
      "sha256": "2f769fef653dd26fca4697945c5015e2f5ac681e654fa52f91c93486e460da2e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Xunit;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External230;\npublic sealed class DocumentationBody\n{\n[SkippableTheory]\n[WithYubiKey]\npublic async Task GetDeviceInfo_AllDevices_ReturnsValidData(YubiKeyTestState state)\n{\n    await state.WithManagementAsync(async (mgmt, cachedInfo) =>\n    {\n        var info = await mgmt.GetDeviceInfoAsync();\n\n        Assert.Equal(state.SerialNumber, info.SerialNumber);\n        Assert.Equal(cachedInfo.FirmwareVersion, info.FirmwareVersion);\n    });\n}\n}\n"
    },
