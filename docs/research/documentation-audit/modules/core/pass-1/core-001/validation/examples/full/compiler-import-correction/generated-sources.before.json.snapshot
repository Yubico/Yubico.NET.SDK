    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-103.cs",
      "bytes": 1368,
      "sha256": "b6454fd026d246ef716ae6c777eb8a2f69ab99679182ed871d089d53b71b1171",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body103\n{\ninternal static void CompileOnly(Microsoft.Extensions.Logging.ILogger _logger, int slotNumber, byte[] privateKey)\n{\n// \u2705 YES \u2014 metadata only\n_logger.LogDebug(\"PIN verification for slot {Slot}\", slotNumber);\n_logger.LogDebug(\"Key operation completed, length: {Length}\", privateKey.Length);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-107.cs",
      "bytes": 1560,
      "sha256": "69ebd8fee672c3b1cdbf5172dfb7c1fb2d95cb9356974dde103afffae24325d0",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body107\n{\ninternal static void CompileOnly(int actualLength, int pinLength, Action<Span<byte>> ProcessData)\n{\nbyte[] buffer = ArrayPool<byte>.Shared.Rent(4096);\ntry\n{\n    Span<byte> span = buffer.AsSpan(0, actualLength);\n    ProcessData(span);\n}\nfinally\n{\n    ArrayPool<byte>.Shared.Return(buffer);\n}\n\n// Zero sensitive data before returning\nbyte[] pinBuffer = ArrayPool<byte>.Shared.Rent(8);\ntry\n{\n    Span<byte> pin = pinBuffer.AsSpan(0, pinLength);\n    // Use for PIN operations\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pinBuffer.AsSpan(0, pinLength));\n    ArrayPool<byte>.Shared.Return(pinBuffer, clearArray: false); // already zeroed\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-109.cs",
      "bytes": 1058,
      "sha256": "0496dd3c757e5b1f45a6111199f7b5f05e3cf9225ac07aeec0d103f97b5e589d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body109\n{\ninternal static void CompileOnly(ReadOnlySpan<byte> someSpan, Action<ReadOnlySpan<byte>> ProcessData)\n{\n// \u2705 GOOD\nProcessData(someSpan);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-110.cs",
      "bytes": 1107,
      "sha256": "7170bf77bbf343bdcad6ccd94d21c9009a80175c1e2615b175734abdcc59018d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body110\n{\ninternal static void CompileOnly(byte[] data)\n{\n// \u2705 GOOD\nSpan<byte> result = stackalloc byte[data.Length];\nfor (int i = 0; i < data.Length; i++)\n    result[i] = (byte)(data[i] ^ 0xFF);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-111.cs",
      "bytes": 1125,
      "sha256": "9d12716e366372afe93768148b4d0d8d7152c87a76a079a10eda49a2434afc53",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body111\n{\ninternal static void CompileOnly(Action<byte[]> ProcessData)\n{\n// \u2705 GOOD\nbyte[] buffer = ArrayPool<byte>.Shared.Rent(1024);\ntry { ProcessData(buffer); }\nfinally { ArrayPool<byte>.Shared.Return(buffer); }\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-112.cs",
      "bytes": 1548,
      "sha256": "4139890ce17fd0e145a0bee67d2f0d7864959093bb05f6717fd5904532a3f4f3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Piv;\nusing System.Security.Cryptography;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body112\n{\nstatic async Task SendAsync(\n    Yubico.YubiKit.Core.Sessions.RawSmartCardSession session, CancellationToken cancellationToken)\n{\n    // Illustrative request bytes: choose a valid command/payload for the selected applet.\n    byte[] request = [0x01];\n    try\n    {\n        var command = new Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduCommand(\n            0x00, 0xCA, 0x00, 0x00, request);\n        var response = await session.TransmitAndReceiveAsync(\n            command, throwOnError: false, cancellationToken: cancellationToken);\n        try\n        {\n            Console.WriteLine($\"SW={response.SW:X4}, {response.Data.Length} bytes\");\n        }\n        finally\n        {\n            response.Clear();\n        }\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(request);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-113.cs",
      "bytes": 1104,
      "sha256": "69abedcf3b4bd07e4f1889380ac0ade3bf3b90dd31a0be71dcf57dc970f982fa",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body113\n{\ninternal static void CompileOnly(byte[] apduData)\n{\n// \u2705 GOOD\nReadOnlySpan<byte> apdu = apduData.AsSpan();\nReadOnlySpan<byte> header = apdu[..5];\nReadOnlySpan<byte> body = apdu[5..];\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-136.cs",
      "bytes": 1144,
      "sha256": "573564ca519c28802944723297739d7f88519b2971df47790cbe0860cbe3aee9",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body136\n{\ninternal static async Task CompileOnly()\n{\nvar devices = await YubiKeyManager.FindAllAsync(ConnectionType.Hid);\nvar fidoDevice = devices.FirstOrDefault(d => \n    d.DeviceId.Contains(\":0001\") || d.DeviceId.Contains(\":F1D0\"));\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-148.cs",
      "bytes": 1143,
      "sha256": "5a9d0b60842beecacfaa86b31887cdc90f2a624f77a4fab1eb96b5bde5aeb2b3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body148\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, ReadOnlyMemory<byte> pin)\n{\nawait using var piv = await yubiKey.CreatePivSessionAsync();\nawait piv.VerifyPinAsync(pin);\nvar info = await yubiKey.GetDeviceInfoAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-149.cs",
      "bytes": 1251,
      "sha256": "fa1575f5c9c372974cb1dbd67fd47569add2babf8d5b0a41acf25055b89724b5",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body149\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> pin)\n{\nawait using var connection = await device.ConnectAsync<ISmartCardConnection>();\n\nawait using (var piv = await PivSession.CreateAsync(connection))\n    await piv.VerifyPinAsync(pin);\n\nawait using var oath = await OathSession.CreateAsync(connection);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-151.cs",
      "bytes": 1786,
      "sha256": "417f3c9c859af134129c61721d2bd060ec6dd84fdc375f79c7080b1d5eb69dcc",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Devices;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body151\n{\ninternal static async Task CompileOnly()\n{\n// One IYubiKey per physical device, even when CCID + HID FIDO + HID OTP are all present.\nvar devices = await YubiKeyManager.FindAllAsync(interfaces: ConnectionType.All);\n\nforeach (var device in devices)\n{\n    Console.WriteLine($\"{device.DeviceId}: {device.AvailableConnections}\");\n\n    if (device.SupportsConnection(ConnectionType.SmartCard))\n    {\n        // This physical key exposes a smart card interface.\n    }\n}\n\n// Keep full composite slots, then select physical keys capable of FIDO.\nvar fidoCapable = devices.Where(key => key.SupportsConnection(ConnectionType.HidFido));\n\n// Or intentionally discover only FIDO interfaces; these YubiKeys have no CCID/OTP slots.\nvar fidoYubiKeys = await YubiKeyManager.FindAllAsync(interfaces: ConnectionType.HidFido);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-152.cs",
      "bytes": 1295,
      "sha256": "98c85d151da37e3e52a90a58a3ed08260a0baab34fc9268bc53f1f1887de4b45",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body152\n{\ninternal static async Task CompileOnly(Action<DeviceChange> Apply, CancellationToken cancellationToken)\n{\nawait using var monitor = await YubiKeyManager.CreateMonitorAsync(cancellationToken);\nawait foreach (var change in monitor.WatchAsync(cancellationToken))\n{\n    // DeviceAdded replay, SnapshotComplete (even if empty), then live DeviceChange records.\n    Apply(change);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-153.cs",
      "bytes": 1514,
      "sha256": "89712be2f90bfbf931a7a7f01b25f4e59078e51680da36702ccdbfb52cb3a5f3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core.Protocols.Fido.Hid;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body153\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using (var smartCard = await device.ConnectAsync<ISmartCardConnection>())\n{\n    // Use SmartCard, then dispose it before opening another interface.\n}\n\nawait using (var fido = await device.ConnectAsync<IFidoHidConnection>())\n{\n    // Use FIDO HID, then dispose it before opening another interface.\n}\n\nawait using (var otp = await device.ConnectAsync<IOtpHidConnection>())\n{\n    // Use OTP HID.\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-154.cs",
      "bytes": 1049,
      "sha256": "4db8a74e97d4d6beeed9303cf53806c8d2c1a3b45dc0408536291003f9278458",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body154\n{\ninternal static void CompileOnly(IYubiKey device)\n{\nDeviceInfo? lastKnown = device.CachedDeviceInfo; // No I/O or presence check.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-155.cs",
      "bytes": 1145,
      "sha256": "ab02609565919a98e768cc1659a6a1c8493b93b40226f6596312001824c81056",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body155\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nDeviceInfo info = await device.GetDeviceInfoAsync();\nint? serial = info.SerialNumber;\nFirmwareVersion firmware = info.FirmwareVersion;\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-156.cs",
      "bytes": 1515,
      "sha256": "a050afc5e50d1c0571f2d2a9d2310d95bda1899b2a5e9dd71857ba8643c8f730",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body156\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\n// Default order (no override): Management prefers SmartCard.\nawait using (var mgmt = await device.CreateManagementSessionAsync())\n{\n    var info = await mgmt.GetDeviceInfoAsync();\n    Console.WriteLine(info.FirmwareVersion);\n}\n\n// Explicit override: force HID OTP for this session.\nawait using (var otpMgmt = await device.CreateManagementSessionAsync(\n    new SessionCreationOptions { PreferredConnectionType = ConnectionType.HidOtp }))\n{\n    var info = await otpMgmt.GetDeviceInfoAsync();\n    Console.WriteLine(info.FirmwareVersion);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-157.cs",
      "bytes": 1344,
      "sha256": "022f2392b2f51e7c0b372579e68f7bcda87568a1f80dda32c4ce2e4410f9bc1d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body157\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> pin)\n{\nawait using var connection = await device.ConnectAsync<ISmartCardConnection>();\n\nawait using (var piv = await PivSession.CreateAsync(connection))\n    await piv.VerifyPinAsync(pin);\n\n// Same connection, next application. The PIV session's disposal released it, not closed it.\nawait using var oath = await OathSession.CreateAsync(connection);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-158.cs",
      "bytes": 1197,
      "sha256": "fd97285db5f5fdbcd48025462b35439462345a9b490d840966884a8c081f5371",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body158\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\nawait using PivSession piv = await yubiKey.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\nPinMetadata metadata = await piv.GetPinMetadataAsync(cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-159.cs",
      "bytes": 1595,
      "sha256": "1c1bd3e78a28167451437730fa41e0f06a63f4f4d330a4da68b70afc9bc5488a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body159\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, FirmwareVersion firmwareVersion, ReadOnlyMemory<byte> applicationId, byte cla, byte ins, byte p1, byte p2, ReadOnlyMemory<byte> commandData, CancellationToken cancellationToken)\n{\nawait using RawSmartCardSession raw =\n    await yubiKey.CreateRawSmartCardSessionAsync(cancellationToken);\n\n// Optional when the firmware version is known. Configure before the first APDU.\nraw.Configure(firmwareVersion);\n\nawait raw.SelectAsync(applicationId, cancellationToken);\nApduResponse response = await raw.TransmitAndReceiveAsync(\n    new ApduCommand(cla, ins, p1, p2, commandData),\n    throwOnError: false,\n    cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-160.cs",
      "bytes": 1729,
      "sha256": "8d5741da629fecd6a73ca2b805fa2fc943eb5e8cb12141ecde8ffc98854f8482",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body160\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, FirmwareVersion firmwareVersion, ReadOnlyMemory<byte> applicationId, ApduCommand command, CancellationToken cancellationToken)\n{\nawait using ISmartCardConnection connection =\n    await yubiKey.ConnectAsync<ISmartCardConnection>(cancellationToken);\n\nawait using (RawSmartCardSession raw =\n    await RawSmartCardSession.CreateAsync(connection, cancellationToken))\n{\n    raw.Configure(firmwareVersion);\n    await raw.SelectAsync(applicationId, cancellationToken);\n    await raw.TransmitAndReceiveAsync(command, cancellationToken: cancellationToken);\n}\n\n// RawSmartCardSession borrowed the connection, so it remains available for the next session.\nawait using PivSession piv = await PivSession.CreateAsync(connection, cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-161.cs",
      "bytes": 1290,
      "sha256": "0f45b39578ad72d69a7a183255981e46e304a32e5a64d74273e8b0c4fb9e22d7",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body161\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, byte ctapHidCommand, ReadOnlyMemory<byte> payload, CancellationToken cancellationToken)\n{\nawait using RawCtapHidSession raw =\n    await yubiKey.CreateRawCtapHidSessionAsync(cancellationToken);\n\nReadOnlyMemory<byte> response = await raw.SendAndReceiveAsync(\n    ctapHidCommand,\n    payload,\n    cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-162.cs",
      "bytes": 1286,
      "sha256": "cc56e2c841fd96245a3679bd85b6d0a29b70eaa8b0ef77db7bc005f6883a9c4e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body162\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, byte commandOrSlot, ReadOnlyMemory<byte> payload, CancellationToken cancellationToken)\n{\nawait using RawOtpHidSession raw =\n    await yubiKey.CreateRawOtpHidSessionAsync(cancellationToken);\n\nReadOnlyMemory<byte> response = await raw.SendAndReceiveAsync(\n    commandOrSlot,\n    payload,\n    cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-163.cs",
      "bytes": 1197,
      "sha256": "9ac4295aa3645a1282ca444778aff49a7774029dafc250e7677cf40b3fc2c45a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body163\n{\ninternal static void CompileOnly(ReadOnlyMemory<byte> response, int expectedLength)\n{\nif (response.Length < expectedLength + 2 ||\n    !ChecksumUtils.CheckCrc(response.Span, expectedLength + 2))\n{\n    throw new InvalidOperationException(\"OTP response CRC validation failed.\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-164.cs",
      "bytes": 2006,
      "sha256": "6f0b8a0eb495dfcba393def39250beaa9b0d6f1a502e4186d6c57686a709165a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body164\n{\nstatic async Task SendProtectedAsync(\n    Yubico.YubiKit.Core.Abstractions.IYubiKey yubiKey,\n    ScpKeyParameters scpParameters,\n    FirmwareVersion firmwareVersion,\n    ReadOnlyMemory<byte> applicationId,\n    ApduCommand command,\n    CancellationToken cancellationToken)\n{\n    await using ISmartCardConnection connection =\n        await yubiKey.ConnectAsync<ISmartCardConnection>(cancellationToken);\n    await using (var plain = await RawSmartCardSession.CreateAsync(connection, cancellationToken))\n    {\n        plain.Configure(firmwareVersion);\n        await plain.SelectAsync(applicationId, cancellationToken);\n    }\n\n    await using var secure = await RawSmartCardSession.CreateAsync(\n        connection, scpParameters, firmwareVersion, cancellationToken: cancellationToken);\n    ApduResponse response = await secure.TransmitAndReceiveAsync(\n        command, throwOnError: false, cancellationToken: cancellationToken);\n    try\n    {\n        Console.WriteLine($\"SW={response.SW:X4}, {response.Data.Length} bytes\");\n    }\n    finally\n    {\n        response.Clear();\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-165.cs",
      "bytes": 1240,
      "sha256": "1122f23bc89d441c2223a6f04fb59e818b26c11ec37bc97ddecc406788c4ff6e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body165\n{\ninternal static async Task CompileOnly(ISmartCardConnection connection, ReadOnlyMemory<byte> applicationId, CancellationToken cancellationToken)\n{\n// After\nawait using RawSmartCardSession raw = await RawSmartCardSession.CreateAsync(connection, cancellationToken);\nawait raw.SelectAsync(applicationId, cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-181.cs",
      "bytes": 1221,
      "sha256": "b4cf4a66becba3841688e749ba41e8503cb1bfe7bd9f0033ee49c091e6ca347e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing System;\nusing Yubico.YubiKit.Core.Devices;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body181\n{\ninternal static async Task CompileOnly()\n{\n// Find all connected YubiKeys\nvar devices = await YubiKeyManager.FindAllAsync();\nforeach (var device in devices)\n{\n    Console.WriteLine($\"Found YubiKey: {device.DeviceId} ({device.AvailableConnections})\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-182.cs",
      "bytes": 1562,
      "sha256": "8e808a422382883e0e156f320e856bcf1523647b3f1925faf6516df1c2a07f7f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body182\n{\ninternal static async Task CompileOnly()\n{\n// Find all devices\nvar allDevices = await YubiKeyManager.FindAllAsync();\n\n// Enumerate/probe only SmartCard interfaces (no HID slots are returned).\nvar smartCardDevices = await YubiKeyManager.FindAllAsync(ConnectionType.SmartCard);\n\n// Find only HID-connected devices (FIDO2, OTP)\nvar hidDevices = await YubiKeyManager.FindAllAsync(ConnectionType.Hid);\n\n// Find one device. The predicate is optional.\nvar firstDevice = await YubiKeyManager.FindFirstAsync();\nvar firstSmartCardDevice = await YubiKeyManager.FindFirstOrDefaultAsync(\n    device => device.SupportsConnection(ConnectionType.SmartCard));\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-183.cs",
      "bytes": 1948,
      "sha256": "088c9206766981a53fba1cf973951820fde0492432ae335a84a5d60a551bd35e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body183\n{\ninternal static async Task CompileOnly(int serial, CancellationToken cancellationToken)\n{\n// Every YubiKey reachable as a smart card (CCID); HID is never enumerated.\nvar smartCardYubiKeys = await YubiKeyManager.FindAllAsync(interfaces: ConnectionType.SmartCard, cancellationToken: cancellationToken);\n\n// Every YubiKey reachable over FIDO HID. HID descriptors are enumerated, but only FIDO interfaces are probed.\nvar fidoYubiKeys = await YubiKeyManager.FindAllAsync(interfaces: ConnectionType.HidFido, cancellationToken: cancellationToken);\n\n// Every YubiKey on every interface, still without publishing into a monitor feed.\nvar allYubiKeys = await YubiKeyManager.FindAllAsync(cancellationToken: cancellationToken);\n\n// Either family can discover the selected physical key. No OTP slots/protocol probes are admitted.\nvar selected = await YubiKeyManager.FindFirstAsync(\n    predicate: key => key.SerialNumber == serial,\n    interfaces: ConnectionType.SmartCard | ConnectionType.HidFido,\n    cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-184.cs",
      "bytes": 1277,
      "sha256": "d46da2015328e1287174bd8a845aa997ce5f44ad0b14556cd61009600368a232",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body184\n{\ninternal static async Task CompileOnly()\n{\nvar device = await YubiKeyManager.FindFirstAsync();\nif (device.CachedDeviceInfo is { } info)\n{\n    Console.WriteLine($\"Last observed firmware: {info.FirmwareVersion}\");\n    Console.WriteLine($\"Last observed USB capabilities: {info.UsbEnabled}\");\n}\nelse\n{\n    Console.WriteLine(\"Device metadata is unavailable.\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-185.cs",
      "bytes": 1575,
      "sha256": "5544058ddebbc86630cc61c2b8391416a3d63926943bbd2f24a6db67ff437e9e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core.Devices;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body185\n{\ninternal static async Task CompileOnly()\n{\nusing var stop = new CancellationTokenSource();\nvar ct = stop.Token; // Cancel from the application's shutdown path.\nawait foreach (var change in YubiKeyManager.WatchAsync(ct))\n{\n    Console.WriteLine(change switch\n    {\n        DeviceAdded added => $\"Connected: {added.Device.DeviceId}\",\n        DeviceRemoved removed => $\"Removed: {removed.Device.DeviceId}\",\n        DeviceUpdated updated => $\"Metadata changed: {updated.Device.DeviceId}\",\n        SnapshotComplete complete => $\"Initial snapshot ready at revision {complete.Revision}\",\n        _ => \"Unknown change\"\n    });\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-186.cs",
      "bytes": 1728,
      "sha256": "e8899825da4f11e8fe69c7b4368082e40e01e5c8f264e2358bebd1211c81ae66",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Devices;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body186\n{\ninternal static async Task CompileOnly()\n{\nusing var stop = new CancellationTokenSource();\nvar ct = stop.Token;\nvar devices = new HashSet<IYubiKey>(ReferenceEqualityComparer.Instance);\nvar loaded = false;\nConsole.WriteLine(\"Loading\u2026\");\nawait foreach (var change in YubiKeyManager.WatchAsync(ct))\n{\n    if (change is DeviceAdded added)\n        devices.Add(added.Device);\n    else if (change is DeviceRemoved removed)\n        devices.Remove(removed.Device);\n    else if (change is SnapshotComplete)\n        loaded = true;\n    // DeviceUpdated retains the object; render its updated CachedDeviceInfo below.\n    Console.WriteLine(!loaded ? \"Loading\u2026\" : devices.Count == 0 ? \"No YubiKeys connected\" : $\"{devices.Count} YubiKey(s)\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-187.cs",
      "bytes": 1488,
      "sha256": "80a5ce9195bf8d9aad3b4dbae89ebce23b4c920ee41a26325f5a7810a17c7e6a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.Extensions.Hosting;\nusing Yubico.YubiKit.Core.Devices;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body187\n{\ninternal static async Task CompileOnly(string[] args)\n{\nawait using var monitor = await YubiKeyManager.CreateMonitorAsync();\nvar builder = Host.CreateApplicationBuilder(args);\nbuilder.Services.AddSingleton(monitor); // Externally created instance: container does not own disposal.\nbuilder.Services.AddHostedService<MonitorLifetime>();\n// Register services that receive YubiKeyMonitor and call monitor.WatchAsync(theirStoppingToken).\nusing var host = builder.Build();\nawait host.RunAsync();\n\n\n}\nsealed class MonitorLifetime(YubiKeyMonitor monitor) : IHostedService\n{\n    public Task StartAsync(CancellationToken ct) => Task.CompletedTask;\n    public Task StopAsync(CancellationToken ct) => monitor.DisposeAsync().AsTask();\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-188.cs",
      "bytes": 969,
      "sha256": "e4ecb436efe21108c729acfe54fa145514b91d897692f8bbf6efa03febff7dba",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body188\n{\nstatic async Task WatchOnUiAsync(Action<DeviceChange> apply, CancellationToken ct)\n{\n    var ui = SynchronizationContext.Current\n        ?? throw new InvalidOperationException(\"Start watching from the UI thread.\");\n    await foreach (var change in YubiKeyManager.WatchAsync(ct))\n        ui.Post(_ => apply(change), null);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-189.cs",
      "bytes": 1321,
      "sha256": "96aa1c94800316f3ac84ef291ac197eb31d99b829bd9cb78929f70f57ecccf72",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body189\n{\ninternal static async Task CompileOnly(CancellationToken cancellationToken)\n{\ntry\n{\n    var devices = await YubiKeyManager.FindAllAsync(cancellationToken: cancellationToken);\n}\ncatch (OperationCanceledException)\n{\n    // Scan was cancelled\n}\ncatch (PlatformInteropException ex)\n{\n    // Platform API error (e.g., SmartCard service not running)\n    Console.WriteLine($\"Platform error: {ex.Message}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-192.cs",
      "bytes": 839,
      "sha256": "13987657eede358b8581b7323f5bef37b41008975bc2bb92f199938be58f3004",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body192\n{\npublic class MyService\n{\n    public async Task DoWork()\n    {\n        var devices = await YubiKeyManager.FindAllAsync();\n    }\n}\n\n// No DI registration needed - just use the static API directly\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-193.cs",
      "bytes": 2006,
      "sha256": "90d237c0b8e8bc310d784efa99237889b930c52482b2f4871c4ced440959db29",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing System.Security.Cryptography;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body193\n{\ninternal static void CompileOnly(ReadOnlyMemory<byte> responseData, ReadOnlyMemory<byte> certificateData)\n{\n// DecodeList returns a disposable collection whose Tlv buffers are cleared on dispose.\nusing var tlvs = TlvHelper.DecodeList(responseData);\nvar certificateTlv = tlvs.FirstOrDefault(t => t.Tag == 0x53);\n\n// TryFindValue returns a new buffer containing the matching value.\nif (TlvHelper.TryFindValue(0x53, responseData.Span, out var certificate))\n{\n    // Use certificate.Span. Clear certificate when its contents are sensitive.\n}\n\n// EncodeAndDisposeList is convenient for inline Tlv objects.\nMemory<byte> encodedData = TlvHelper.EncodeAndDisposeList(\n    new Tlv(0x5C, new byte[] { 0x5F, 0xC1, 0x02 }),\n    new Tlv(0x53, certificateData));\n\n// EncodeList leaves disposal to the caller.\nusing var tagList = new Tlv(0x5C, new byte[] { 0x5F, 0xC1, 0x02 });\nusing var certificateValue = new Tlv(0x53, certificateData);\nMemory<byte> explicitlyOwnedEncoding = TlvHelper.EncodeList([tagList, certificateValue]);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-194.cs",
      "bytes": 1256,
      "sha256": "6af6d39e9f5d69778b0ebc75407686b4c1d2a22dd74741be39970f9b1c73ad91",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body194\n{\ninternal static void CompileOnly(ReadOnlyMemory<byte> modulusBytes, ReadOnlyMemory<byte> exponentBytes)\n{\nMemory<byte> publicKeyBody = TlvHelper.EncodeAndDisposeList(\n    new Tlv(0x81, modulusBytes),\n    new Tlv(0x82, exponentBytes));\nMemory<byte> publicKeyTemplate = TlvHelper.EncodeAndDisposeList(\n    new Tlv(0x7F49, publicKeyBody));\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-195.cs",
      "bytes": 1592,
      "sha256": "b2ec48697a263918f0a8308675e0c53651f91d4a069a351588580b8cebd21fb6",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing System.Security.Cryptography;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body195\n{\ninternal static void CompileOnly(byte[] privateKeyBytes, Action<ReadOnlySpan<byte>> UseSensitiveEncoding)\n{\nMemory<byte> innerEncoding = Memory<byte>.Empty;\nMemory<byte> outerEncoding = Memory<byte>.Empty;\n\ntry\n{\n    innerEncoding = TlvHelper.EncodeAndDisposeList(\n        new Tlv(0x81, privateKeyBytes));\n    outerEncoding = TlvHelper.EncodeAndDisposeList(\n        new Tlv(0x7F49, innerEncoding));\n\n    UseSensitiveEncoding(outerEncoding.Span);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(outerEncoding.Span);\n    CryptographicOperations.ZeroMemory(innerEncoding.Span);\n    CryptographicOperations.ZeroMemory(privateKeyBytes);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-196.cs",
      "bytes": 1331,
      "sha256": "13610b0785577a65ae6a747f8ad593d0400769bdab425000926093ca93753567",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Cli.Shared.Output;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Piv;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body196\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\nvar options = new SessionCreationOptions\n{\n    UserPresencePrompt = ConsoleUserPresencePrompt.Instance\n};\n\nawait using PivSession session = await yubiKey.CreatePivSessionAsync(\n    options,\n    cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-197.cs",
      "bytes": 1140,
      "sha256": "15d463413edbef04eff9bf5e3ee49a7b51949cb6acd5f8eccf4ab6accbc6d5cf",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Piv;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body197\n{\nstatic async Task ReadAndVerifyPinAsync(\n    IPivSession session, ISecureCredentialReader reader, CancellationToken cancellationToken)\n{\n    using var credential = reader.ReadCredential(\n        CredentialReaderOptions.ForPin(), cancellationToken);\n    if (credential is null)\n        return;\n\n    await session.VerifyPinAsync(credential.Memory, cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-198.cs",
      "bytes": 1495,
      "sha256": "08e623f6288de56e436fae84613e4f2dccd4f924dcab3466a93be679057ec962",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core.Credentials;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body198\n{\ninternal static void CompileOnly(UserPresenceContext context)\n{\nstring message = context.Operation switch\n{\n    UserPresenceOperations.Ctap2.MakeCredential => \"Touch your YubiKey to create a passkey.\",\n    UserPresenceOperations.Ctap2.GetAssertion => \"Touch your YubiKey to sign in.\",\n    UserPresenceOperations.Piv.SignOrDecrypt => \"Touch your YubiKey for the PIV key operation.\",\n    _ when context.Application == UserPresenceApplications.Oath => \"Touch your YubiKey to generate a code.\",\n    _ => \"Touch your YubiKey to continue.\"\n};\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-199.cs",
      "bytes": 1314,
      "sha256": "bbf64de16d4e16dd4ce96632e597025973e7406228dc9991590cc3df58822465",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body199\n{\ninternal static async Task CompileOnly(Yubico.YubiKit.WebAuthn.Client.WebAuthnClient client, Yubico.YubiKit.WebAuthn.Client.Authentication.PublicKeyCredentialRequestOptions requestOptions, CancellationToken cancellationToken)\n{\nusing (UserPresenceIntent.BeginScope(\"approve the transfer of 500 EUR\"))\n{\n    await client.GetAssertionAsync(requestOptions, cancellationToken: cancellationToken);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-200.cs",
      "bytes": 1283,
      "sha256": "ae13b2e023174433e22ac5e509d745ef09e00e3d5597e6e146883df72a08dd2b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal sealed class Body200 : IUserPresencePrompt\n{\npublic ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken)\n{\n    string operation = context.Operation switch\n    {\n        UserPresenceOperations.Ctap2.GetAssertion => \"sign-in\",\n        UserPresenceOperations.Ctap2.MakeCredential => \"passkey registration\",\n        _ => \"key operation\"\n    };\n\n    // \"Touch your YubiKey to approve the transfer of 500 EUR (sign-in).\"\n    Console.WriteLine(context.Intent is { } intent\n        ? $\"Touch your YubiKey to {intent} ({operation}).\"\n        : $\"Touch your YubiKey to confirm the {operation}.\");\n    return default;\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-202.cs",
      "bytes": 1438,
      "sha256": "4876e593244a92c0585d2a8c1a0c7824cba9bc2ffbc31ac23be1046103c61418",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body202\n{\ninternal static void CompileOnly()\n{\nusing var loggerFactory = LoggerFactory.Create(builder =>\n{\n    builder.AddConsole();\n    builder.SetMinimumLevel(LogLevel.Information);\n});\nYubiKitLogging.Configure(loggerFactory);\n// Keep this outer scope alive through all SDK operations and resource disposal.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-209.cs",
      "bytes": 1507,
      "sha256": "fda6ee1d4871a63d081a9106e9889f46a5fc3933913debfd60565cf9d27a41cb",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body209\n{\ninternal static async Task CompileOnly(IPcscDevice reader, IYubiKey yubiKey, CancellationToken cancellationToken)\n{\n// SmartCard connection\nvar connectionFactory = new SmartCardConnectionFactory();\nawait using (var connection = await connectionFactory.CreateAsync(reader, cancellationToken))\n{\n    // Finish all borrowed SmartCard work before leaving this scope.\n}\n\n// Typed HID connection, after the SmartCard scope ends.\nawait using (var connection = await yubiKey.ConnectAsync<IFidoHidConnection>(cancellationToken))\n{\n    // Finish all borrowed FIDO work before leaving this scope.\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-213.cs",
      "bytes": 1392,
      "sha256": "11b748f67f2de56d21b865a8b1034702d3a78e10dc382bddd31be2d73e3ffd5b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body213\n{\ninternal static async Task CompileOnly(SmartCardConnectionFactory connectionFactory, IPcscDevice reader, FirmwareVersion firmwareVersion, CancellationToken ct)\n{\n// From a caller-owned connection\nawait using var connection = await connectionFactory.CreateAsync(reader, ct);\nawait using RawSmartCardSession raw = await RawSmartCardSession.CreateAsync(connection, ct);\n\n// Configure for firmware\nraw.Configure(firmwareVersion);\nawait raw.SelectAsync(ApplicationIds.Piv, ct);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-214.cs",
      "bytes": 1850,
      "sha256": "0584b1defd4c081829d35a69f3751a079eee4e276e7bc3a5c4f7875230f4b647",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body214\n{\ninternal static async Task CompileOnly(RawSmartCardSession raw, ReadOnlyMemory<byte> applicationId, byte InsVerify, byte[] pinnedPin, CancellationToken ct)\n{\n// Non-sensitive command \u2014 no zeroing needed\nvar command = new ApduCommand\n{\n    Cla = 0x00,\n    Ins = 0xA4,\n    P1 = 0x04,\n    P2 = 0x00,\n    Data = applicationId\n};\nvar responseData = await raw.TransmitAndReceiveAsync(command, cancellationToken: ct);\n\n// Separate sensitive-command fragment: caller clears the source even on failure.\n// ApduCommand is a readonly record struct: it stores a reference, not a clone.\ntry\n{\n    var verify = new ApduCommand(0x00, InsVerify, 0x00, 0x80, pinnedPin.AsMemory(0, 8));\n    var response = await raw.TransmitAndReceiveAsync(verify, throwOnError: false, cancellationToken: ct);\n    try { Console.WriteLine($\"SW={response.SW:X4}\"); }\n    finally { response.Clear(); }\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pinnedPin);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-215.cs",
      "bytes": 1320,
      "sha256": "17b82ce1ffebf5b1826271bce903a166497e617adc0bc27306563c76a7c846c4",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body215\n{\ninternal static async Task CompileOnly(RawSmartCardSession raw, ApduCommand command, CancellationToken ct)\n{\ntry\n{\n    var response = await raw.TransmitAndReceiveAsync(command, cancellationToken: ct);\n}\ncatch (ApduException ex) when (ex.SW == 0x6982)\n{\n    // Security status not satisfied - need to authenticate\n}\ncatch (ApduException ex) when (ex.SW == 0x6A82)\n{\n    // Application/file not found\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-218.cs",
      "bytes": 1558,
      "sha256": "d3b7896ea52f29b6cdb4c347fd786e705bbee8b7811a96a2ec5a9c47451f3d1b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Piv;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body218\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nConsole.WriteLine($\"Serial {device.SerialNumber}: {device.AvailableConnections}\");\n\nforeach (var each in await YubiKeyManager.FindAllAsync())\n{\n    Console.WriteLine($\"  {each.SerialNumber}: {each.AvailableConnections}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-219.cs",
      "bytes": 1260,
      "sha256": "5aeccd6a53af4b7aef85278e91fcbfefb416bb814688664e320ac0e1e79b1559",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body219\n{\ninternal static async Task CompileOnly(CancellationToken cancellationToken)\n{\nvar smartCardYubiKeys = await YubiKeyManager.FindAllAsync(interfaces: ConnectionType.SmartCard, cancellationToken: cancellationToken);\nvar fidoYubiKeys = await YubiKeyManager.FindAllAsync(interfaces: ConnectionType.HidFido, cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-220.cs",
      "bytes": 1122,
      "sha256": "00d40c95b55946a13987b7e66b59b9dfb1426736c205337966a3ef413a6eb124",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body220\n{\ninternal static void CompileOnly(IYubiKey device)\n{\nif (device.CachedDeviceInfo is { } info)\n{\n    Console.WriteLine($\"Last observed firmware: {info.FirmwareVersion}, form factor: {info.FormFactor}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-221.cs",
      "bytes": 1280,
      "sha256": "22961e0640d8573016d425730c76db73c3e246ff12f0040cdb66c95d9bfcfd67",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body221\n{\ninternal static async Task CompileOnly(int expectedSerialNumber, CancellationToken cancellationToken)\n{\n// After closing the competing client; expectedSerialNumber is the serial you want to find.\nIYubiKey? matchingDevice = await YubiKeyManager.FindFirstOrDefaultAsync(\n    key => key.SerialNumber == expectedSerialNumber, cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-222.cs",
      "bytes": 1109,
      "sha256": "b658f3adc23910ae3d96dcaa69f7f784020d8e09710e63dd1cb06daf72af6402",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body222\n{\ninternal static async Task CompileOnly()\n{\nSmartCardConnectionFactory.DefaultSharing = SmartCardSharing.ExclusiveWithSharedFallback;\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-223.cs",
      "bytes": 1286,
      "sha256": "1901d61d4f04627f0e0f79d7141154e8084c5b578d1218ca3af44705d6ab0b2f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body223\n{\ninternal static async Task CompileOnly(IPcscDevice reader, CancellationToken cancellationToken)\n{\n// Coordinate discovery/monitoring and all other connections to this key before opening directly.\nvar factory = new SmartCardConnectionFactory(SmartCardSharing.Shared);\nawait using ISmartCardConnection connection = await factory.CreateAsync(reader, cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-224.cs",
      "bytes": 1037,
      "sha256": "1c81b4765fdb750f153ab8debfeb64b0bfd69fe0f304bfa7c2b8253323ac2487",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body224\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var piv = await device.CreatePivSessionAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-225.cs",
      "bytes": 1154,
      "sha256": "711835e3a173d31de2aef71cef3944ecc4f0cd7e3ce9e0edb8138f29bbf15b6a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body225\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey first = await YubiKeyManager.FindFirstAsync();\nIYubiKey? smartCard = await YubiKeyManager.FindFirstOrDefaultAsync(\n    device => device.SupportsConnection(ConnectionType.SmartCard));\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-226.cs",
      "bytes": 1411,
      "sha256": "79103ace91d83db4f7f4974046c06a113d4ea19ae506c71460b91068f3c2a57c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body226\n{\ninternal static async Task CompileOnly()\n{\nawait foreach (DeviceChange change in YubiKeyManager.WatchAsync())\n{\n    Console.WriteLine(change switch\n    {\n        DeviceAdded added => $\"Added: serial {added.Device.SerialNumber}\",\n        DeviceRemoved removed => $\"Removed: serial {removed.Device.SerialNumber}\",\n        DeviceUpdated updated => $\"Updated: serial {updated.Device.SerialNumber}\",\n        SnapshotComplete => \"Initial snapshot complete\",\n        _ => \"Unknown change\"\n    });\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-227.cs",
      "bytes": 1738,
      "sha256": "dbba281c2ab0b7d6c813d84424994d68894f79deadb8aa4abeb4f4683db774f5",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body227\n{\ninternal static async Task CompileOnly(IYubiKey device, FirmwareVersion firmwareVersion, ReadOnlyMemory<byte> requestData)\n{\nawait using ISmartCardConnection connection = await device.ConnectAsync<ISmartCardConnection>();\nawait using RawSmartCardSession raw = await RawSmartCardSession.CreateAsync(connection);\n\n// firmwareVersion is the device's firmware, read via Management; it sets APDU formatting. Configure first.\nraw.Configure(firmwareVersion);\nawait raw.SelectAsync(ApplicationIds.Piv);\nApduResponse response = await raw.TransmitAndReceiveAsync(\n    new ApduCommand(0x00, 0xCB, 0x3F, 0xFF, requestData),\n    throwOnError: false);\n\ntry\n{\n    Console.WriteLine($\"SW={response.SW:X4}, {response.Data.Length} bytes\");\n    // Consume response.Data here before clearing its owner.\n}\nfinally\n{\n    response.Clear();\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-228.cs",
      "bytes": 1346,
      "sha256": "3208d5c8c3fbd7ce54afc2806b5cd4b07e94e78546d989328d37dfb2307d5833",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body228\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> commandBytes, CancellationToken cancellationToken)\n{\nawait using ISmartCardConnection connection = await device.ConnectAsync<ISmartCardConnection>();\n// Direct I/O takes a preformatted APDU: no applet selection or command chaining is added here.\nReadOnlyMemory<byte> reply = await connection.TransmitAndReceiveAsync(commandBytes, cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-229.cs",
      "bytes": 1368,
      "sha256": "8bb84b43e30c1dafcad667ffef680bf87ef5ca920c064837ce2e3e77a8f7c579",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body229\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using ISmartCardConnection connection = await device.ConnectAsync<ISmartCardConnection>();\nIDisposable transaction = await connection.BeginTransactionAsync();\ntry\n{\n    // Perform serialized raw operations on connection here.\n}\nfinally\n{\n    if (transaction is IAsyncDisposable asyncTransaction)\n        await asyncTransaction.DisposeAsync();\n    else\n        transaction.Dispose();\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-232.cs",
      "bytes": 1383,
      "sha256": "91fc617a3daabcc584c6918ad2ce5c831a42520b958ec897a924ec72e06773c7",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body232\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var fidoHidConnection = await device.ConnectAsync<IFidoHidConnection>(cancellationToken);\nawait using (var raw = await RawCtapHidSession.CreateAsync(fidoHidConnection, cancellationToken))\n{\n    // CTAP HID initialization is lazy, on the first raw exchange.\n}\nawait using var next = await RawCtapHidSession.CreateAsync(fidoHidConnection, cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-235.cs",
      "bytes": 1340,
      "sha256": "c2e96323203b8d7b9c950635b005bc65473d6e391216a165c221280adbc58e1c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body235\n{\ninternal static async Task CompileOnly(IYubiKey device, byte[] encKey, byte[] macKey, byte[] dekKey)\n{\nusing var scp = new Scp03KeyParameters(\n    KeyReference.Default, new StaticKeys(encKey, macKey, dekKey));\n\nawait using var session = await device.CreatePivSessionAsync(\n    new SessionCreationOptions { ScpKeyParameters = scp });\n// Perform supported PIV operations here. Session disposal precedes parameter disposal.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-236.cs",
      "bytes": 2259,
      "sha256": "f44c5949b4a8d04952cac4994370f7adbade748f650509f449be49e553f7e18b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core.Cryptography;\nusing static Yubico.YubiKit.Core.Cryptography.CryptographicDefinitions;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body236\n{\ninternal static void CompileOnly()\n{\nKeyInfo keyInfo = Keys.Get(KeyType.P256); // same instance as Keys.P256\nConsole.WriteLine(keyInfo.DisplayName); // P-256\nConsole.WriteLine(keyInfo.Curve?.FieldSizeBits); // 256\nConsole.WriteLine(keyInfo.Asn1?.AlgorithmOid); // 1.2.840.10045.2.1 (id-ecPublicKey)\nConsole.WriteLine(keyInfo.Asn1?.NamedCurveOid); // 1.2.840.10045.3.1.7\n\nCurveInfo curveInfo = Curves.GetByOid(\"1.2.840.10045.3.1.7\"); // named curves only\nforeach (KeyInfo construction in Keys.FindByCurve(curveInfo))\n    Console.WriteLine(construction.DisplayName); // a curve can have multiple concrete constructions\nforeach (AlgorithmInfo algorithmInfo in Algorithms.FindForKey(keyInfo))\n    Console.WriteLine(algorithmInfo.DisplayName); // multiple ECDSA choices, ECDH, ...\n\nif (Keys.TryGet((KeyType)999, out KeyInfo? unknown))\n    Console.WriteLine(unknown.DisplayName); // non-null on success\nbool found = Curves.TryGetByOid(\"1.2.3.4.5\", out _); // false\nvar matches = Algorithms.FindByOid(Oids.RsaPss); // generic + parameterized RSA-PSS\nCurveInfo? rsaCurve = Keys.Rsa2048.Curve; // null\nCurveInfo? aesCurve = Keys.Aes256.Curve; // null\nAsn1KeyInfo? aesAsn1 = Keys.Aes256.Asn1; // null; CBC is an operation, not a bare key\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-245.cs",
      "bytes": 1429,
      "sha256": "10ea653216c69289ab268147c9d76c259e92dadf956e57fa0c09933bba10aaf4",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full.Context245;\npublic static class IYubiKeyExtensions\n{\n    // C# 14 syntax: extension(Type param) defines extensions for Type\n    extension(IYubiKey yubiKey)\n    {\n        // Methods here extend IYubiKey\n        public async Task<DeviceInfo> GetDeviceInfoAsync(\n            SessionCreationOptions? options = null,\n            CancellationToken cancellationToken = default)\n        {\n            // 'yubiKey' parameter is implicitly the extension target\n            await using var mgmtSession = await yubiKey.CreateManagementSessionAsync(options, cancellationToken);\n            return await mgmtSession.GetDeviceInfoAsync(cancellationToken);\n        }\n    }\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-246.cs",
      "bytes": 993,
      "sha256": "08efd9fe3cccff3655c7423cb5f5618c8f0bc353f85ffc0038d032f24e1948a5",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body246\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\nvar deviceInfo = await yubiKey.GetDeviceInfoAsync(cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-247.cs",
      "bytes": 1179,
      "sha256": "b975cf94a3af9eb563768a4d56b7e224cf1e061b5b282453b39eddef6cb930f2",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body247\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\nawait using var connection = await yubiKey.ConnectAsync<ISmartCardConnection>(cancellationToken);\nawait using var mgmt = await ManagementSession.CreateAsync(connection, cancellationToken: cancellationToken);\nvar deviceInfo = await mgmt.GetDeviceInfoAsync(cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-248.cs",
      "bytes": 1166,
      "sha256": "006a00c6188eb7f278285e2bfc7e3966c1cf6ff6edcabc42196c70573bf189b5",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body248\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\nvar config = new DeviceConfig { UsbEnabled = DeviceCapabilities.Piv };\n\n// Extension handles everything\nawait yubiKey.SetDeviceConfigAsync(\n    config,\n    new SetDeviceConfigOptions\n    {\n        Reboot = true,\n    },\n    cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-249.cs",
      "bytes": 1302,
      "sha256": "ad16050485c7ccffea6b15168bb71e55c28caa0b86fafeccbb95bc4759f6b50f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body249\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\nvar config = new DeviceConfig { UsbEnabled = DeviceCapabilities.Piv };\nawait using var connection = await yubiKey.ConnectAsync<ISmartCardConnection>(cancellationToken);\nawait using var mgmt = await ManagementSession.CreateAsync(connection, cancellationToken: cancellationToken);\nawait mgmt.SetDeviceConfigAsync(\n    config,\n    new SetDeviceConfigOptions { Reboot = true },\n    cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-250.cs",
      "bytes": 1588,
      "sha256": "6c594a155101931cd6de94e4b2742828a92afababe05fae282579c3703398774",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body250\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\n// Requires a SmartCard-capable key configured with the supplied SCP03 keys.\nusing var scpParameters = Scp03KeyParameters.Default;\nawait using var mgmtSession = await yubiKey.CreateManagementSessionAsync(\n    new SessionCreationOptions\n    {\n        ProtocolConfiguration = customProtocolConfig,\n        ScpKeyParameters = scpParameters\n    },\n    cancellationToken: cancellationToken);\n\n// Multiple operations in same session\nvar info1 = await mgmtSession.GetDeviceInfoAsync(cancellationToken);\nvar info2 = await mgmtSession.GetDeviceInfoAsync(cancellationToken);\n// Session stays open for both calls\n\n// At scope end, the session is disposed before the caller-owned SCP parameters.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-251.cs",
      "bytes": 1524,
      "sha256": "c0d775cf0948a97022e06c3f9a722f1ac6129ddaf1377388ef28a21f114fc305",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body251\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey, CancellationToken cancellationToken)\n{\nawait using var mgmt = await yubiKey.CreateManagementSessionAsync(cancellationToken: cancellationToken);\nvar info = await mgmt.GetDeviceInfoAsync(cancellationToken);\nvar remaining = info.UsbEnabled & ~DeviceCapabilities.Otp;\nif ((remaining & info.UsbSupported) == DeviceCapabilities.None)\n{\n    throw new InvalidOperationException(\"Preserve a supported USB application.\");\n}\nawait mgmt.SetDeviceConfigAsync(\n    new DeviceConfig { UsbEnabled = remaining },\n    new SetDeviceConfigOptions { Reboot = true },\n    cancellationToken);\n// End this scope; rediscover the intended key and open a fresh connection after reboot.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-263.cs",
      "bytes": 1267,
      "sha256": "97171c7e1b6dac99e121001d5c9447d883400c213d2cf323f512270624699390",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body263\n{\ninternal static void CompileOnly()\n{\nvar config = new DeviceConfig\n{\n    UsbEnabled = DeviceCapabilities.Piv | DeviceCapabilities.Oath,\n    AutoEjectTimeout = 30,\n    DeviceFlags = DeviceFlags.TouchEject,\n    ChallengeResponseTimeout = 15\n};\n\n// The session serializes the configuration and clears the encoded buffer after transmission.\nawait session.SetDeviceConfigAsync(\n    config,\n    new SetDeviceConfigOptions { Reboot = true },\n    cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-264.cs",
      "bytes": 1347,
      "sha256": "482e1358c6f2aa51a9258a5f7e94229765127aae9e374a1e6fad29e786387628",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body264\n{\ninternal static void CompileOnly()\n{\n// Flags enum - use bitwise operations\nvar capabilities = DeviceCapabilities.Piv | DeviceCapabilities.Oath;\n\n// Check if specific capability is set\nbool hasPiv = (capabilities & DeviceCapabilities.Piv) != 0;\n\n// Add capability\ncapabilities |= DeviceCapabilities.Fido2;\n\n// Remove capability  \ncapabilities &= ~DeviceCapabilities.Otp;\n\n// Check multiple\nbool hasPivAndOath = (capabilities & (DeviceCapabilities.Piv | DeviceCapabilities.Oath)) \n    == (DeviceCapabilities.Piv | DeviceCapabilities.Oath);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-265.cs",
      "bytes": 1334,
      "sha256": "0c0c8cb9a5e1fb1d56452c62d8f81d36ca0c71ca7a0495e7831129a0fa4502f3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body265\n{\ninternal static async Task CompileOnly(IManagementSession mgmt)\n{\nvar info = await mgmt.GetDeviceInfoAsync();\n\n// Different version representations\nFirmwareVersion fw = info.FirmwareVersion;           // e.g., 5.7.2\nVersionQualifier qualifier = info.VersionQualifier;  // e.g., 5.7.2.beta.1\nstring versionName = info.VersionName;               // Display string\n\n// VersionQualifierType enum values:\n// - Final: Production release (5.7.2)\n// - Alpha: Alpha prerelease (5.7.2.alpha.1)\n// - Beta: Beta prerelease (5.7.2.beta.1)\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-268.cs",
      "bytes": 1105,
      "sha256": "640440bc719c19fd239545b8ba9a2f42d420cfd4108ac01f7a7cacd599c4a48f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body268\n{\ninternal static void CompileOnly()\n{\nusing var loggerFactory = LoggerFactory.Create(builder =>\n{\n    builder.SetMinimumLevel(LogLevel.Trace);\n    builder.AddConsole();\n});\n\nYubiKitLogging.LoggerFactory = loggerFactory;\n\nawait using var mgmt = await ManagementSession.CreateAsync(\n    connection);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-269.cs",
      "bytes": 1406,
      "sha256": "54d02521cede1f767885c72414983b86b745951564f3042d15a0bda7269c2425",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body269\n{\ninternal static async Task CompileOnly(CancellationToken cancellationToken)\n{\n// Find all connected YubiKeys\nvar devices = await YubiKeyManager.FindAllAsync(cancellationToken: cancellationToken);\nforeach (var device in devices)\n{\n    var info = await device.GetDeviceInfoAsync(cancellationToken: cancellationToken);\n    Console.WriteLine($\"Serial: {info.SerialNumber}\");\n    Console.WriteLine($\"Firmware: {info.FirmwareVersion}\");\n    Console.WriteLine($\"USB enabled: {info.UsbEnabled}\");\n}\n\n// Find specific device\nvar yubiKey = devices.SingleOrDefault(device => device.SerialNumber == 12345678);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-272.cs",
      "bytes": 1406,
      "sha256": "48595c3ec71fda288bba1ac4fbcf2770b68f22be3656bcc879861b768534bfcd",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\nusing System.Security.Cryptography;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body272\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using (var session = await device.CreateManagementSessionAsync())\n{\n    var info = await session.GetDeviceInfoAsync();\n    Console.WriteLine($\"Serial {info.SerialNumber}, firmware {info.FirmwareVersion}, {info.FormFactor}\");\n    Console.WriteLine($\"USB enabled: {info.UsbEnabled}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-273.cs",
      "bytes": 1118,
      "sha256": "684418aec827ea9eeba5890b69311816ec4311b817534ee99f8db78cc3fcaf8c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body273\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nvar info = await device.GetDeviceInfoAsync();\nbool pivOverUsb = (info.UsbSupported & DeviceCapabilities.Piv) != 0;\nbool oathEnabledOverNfc = (info.NfcEnabled & DeviceCapabilities.Oath) != 0;\nConsole.WriteLine($\"Configuration locked: {info.IsLocked}\");\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-274.cs",
      "bytes": 1588,
      "sha256": "f8bb68e0fcc69d7d03ac9f77d20a51b4ead989cff6de60513cac5393c83de602",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body274\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nvar info = await device.GetDeviceInfoAsync();\nvar requested = DeviceCapabilities.Piv | DeviceCapabilities.Oath;\nif ((info.UsbSupported & requested) != requested)\n{\n    throw new NotSupportedException(\"This key does not support both requested USB applications.\");\n}\nvar config = new DeviceConfig { UsbEnabled = requested };\n\nawait using (var session = await device.CreateManagementSessionAsync())\n{\n    await session.SetDeviceConfigAsync(config, new SetDeviceConfigOptions { Reboot = true });\n}\n\n// The session above is disposed. This pause is illustrative, not an enumeration guarantee.\nawait Task.Delay(TimeSpan.FromSeconds(3));\nvar rebooted = await YubiKeyManager.FindAllAsync(); // Every Find performs fresh discovery.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-275.cs",
      "bytes": 1269,
      "sha256": "6b5e194743cb7178e718baa7a72e6cc91dbd9b94f15be94c0df309038a897b0d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body275\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreateManagementSessionAsync();\nbyte[] lockCode = RandomNumberGenerator.GetBytes(16);\ntry\n{\n    // Persist lockCode in your secret store first. It cannot be recovered.\n    await session.SetDeviceConfigAsync(\n        new DeviceConfig(),\n        new SetDeviceConfigOptions { NewLockCode = lockCode });\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(lockCode);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-276.cs",
      "bytes": 1177,
      "sha256": "951a636156780d12fb584de8f054f32ab0e6f47fc0f40ed8b13b3c4f2a6ea3c4",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body276\n{\ninternal static async Task CompileOnly(IYubiKey device, byte[] currentLockCode)\n{\ntry\n{\n    await device.SetDeviceConfigAsync(\n        new DeviceConfig(),\n        new SetDeviceConfigOptions\n        {\n            CurrentLockCode = currentLockCode,\n            NewLockCode = new byte[16]\n        });\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(currentLockCode);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-277.cs",
      "bytes": 1151,
      "sha256": "8792b0201ee1969e3174eb6cc960680ee9bad693aa2d130fdda820230b75d5bd",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body277\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreateManagementSessionAsync(\n    new SessionCreationOptions { PreferredConnectionType = ConnectionType.SmartCard });\n\n// Destructive: the caller has confirmed Bio MPE applicability and application-data erasure.\nawait session.ResetDeviceAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-279.cs",
      "bytes": 1509,
      "sha256": "0053f893904fef78025d8ef9a7eef41902ab861b035e83e20fa08087ffc4e6ba",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Features;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Cli.Prompts;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body279\n{\ninternal static void CompileOnly()\n{\nbyte[]? lockCode = null;\ntry\n{\n    lockCode = LockCodePrompt.PromptForLockCode(\"Enter lock code\");\n    if (lockCode is null) return; // User cancelled\n    \n    // session is an initialized IManagementSession; ct is the caller's CancellationToken.\n    await session.SetDeviceConfigAsync(\n        new DeviceConfig { ChallengeResponseTimeout = 15 },\n        new SetDeviceConfigOptions { CurrentLockCode = lockCode }, ct);\n}\nfinally\n{\n    if (lockCode is not null)\n    {\n        CryptographicOperations.ZeroMemory(lockCode);\n    }\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-280.cs",
      "bytes": 1229,
      "sha256": "97227fb81e9518e84b139b4cb245b7a607d405f7e413d2b32eb08b7b097f4e0d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Features;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Cli.Prompts;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body280\n{\ninternal static async Task CompileOnly(IManagementSession session, CancellationToken ct)\n{\nvar result = await DeviceConfiguration.SetCapabilitiesAsync(\n    session,\n    Transport.Usb,\n    DeviceCapabilities.Piv | DeviceCapabilities.Fido2,\n    lockCode: null,\n    reboot: true,\n    ct);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-281.cs",
      "bytes": 1445,
      "sha256": "dea25ad8efa0506bc2ebae416e0d41d3006f07cc82cecdddc3b2b7b394334d23",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Features;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Cli.Prompts;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body281\n{\ninternal static async Task CompileOnly(IManagementSession session, Func<byte[]?> GetCurrentCode, Func<byte[]?> GetNewCode, CancellationToken ct)\n{\nbyte[]? current = null;\nbyte[]? newCode = null;\ntry\n{\n    current = GetCurrentCode();\n    newCode = GetNewCode();\n    await DeviceConfiguration.SetLockCodeAsync(session, current, newCode, ct);\n}\nfinally\n{\n    if (current is not null) CryptographicOperations.ZeroMemory(current);\n    if (newCode is not null) CryptographicOperations.ZeroMemory(newCode);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-282.cs",
      "bytes": 1481,
      "sha256": "260afe0f1c9804537e6f8f38851dec13363f4bea69dffb383216f59030a3cdbe",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Features;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Cli.Prompts;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body282\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using var connection = await device.ConnectAsync<ISmartCardConnection>(ct);\nawait using var session = await ManagementSession.CreateAsync(connection, cancellationToken: ct);\n\nvar result = await DeviceInfoQuery.GetDeviceInfoAsync(session, ct);\nif (result.Success && result.DeviceInfo.HasValue)\n{\n    var info = result.DeviceInfo.Value;\n    Console.WriteLine($\"Serial: {info.SerialNumber}\");\n    Console.WriteLine($\"Firmware: {info.FirmwareVersion}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-283.cs",
      "bytes": 1756,
      "sha256": "722e48f8507c89d04a4f8d1b5b96fb052698f1fa36b65a6ee3d863736cc02cb1",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Features;\nusing Yubico.YubiKit.Management.Examples.ManagementTool.Cli.Prompts;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body283\n{\ninternal static async Task CompileOnly(IManagementSession session, CancellationToken ct)\n{\n// Prerequisite: caller confirmed Bio MPE and authorized reset; session uses SmartCard.\n// Metadata below supplies the helper's firmware check, not a product-family check.\nvar infoResult = await DeviceInfoQuery.GetDeviceInfoAsync(session, ct);\nif (!infoResult.Success || !infoResult.DeviceInfo.HasValue)\n{\n    Console.WriteLine(\"Failed to get device info\");\n    return;\n}\n\n// Request reset; the helper returns failure results for operation exceptions.\nvar resetResult = await DeviceReset.ResetDeviceAsync(\n    session, \n    infoResult.DeviceInfo.Value, \n    ct);\n\nif (resetResult.Success)\n{\n    Console.WriteLine(\"Device reset successfully\");\n}\nelse\n{\n    Console.WriteLine($\"Reset failed: {resetResult.ErrorMessage}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-286.cs",
      "bytes": 1121,
      "sha256": "e0a96a7efada3e7a6a1514fa97f6098bf486119442c3d821b3a74ede057c4730",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body286\n{\ninternal static async Task CompileOnly(IManagementSession session)\n{\n    var info = await session.GetDeviceInfoAsync();\n    var config = new DeviceConfig { UsbEnabled = info.UsbEnabled & ~DeviceCapabilities.Otp };\n    await session.SetDeviceConfigAsync(config, new SetDeviceConfigOptions { Reboot = true });\n    \n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-287.cs",
      "bytes": 1322,
      "sha256": "8b984fa75ed607c323a9cef846302e3ed6d7135b967fbe611b364a3ee3d7e1fd",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Management;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body287\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var session = await device.CreateManagementSessionAsync(\n    new SessionCreationOptions { PreferredConnectionType = ConnectionType.SmartCard },\n    cancellationToken);\n\n// Destructive: confirm that FIDO/PIV data and the shared PIN may be removed.\nawait session.ResetDeviceAsync(cancellationToken);\n    \n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-292.cs",
      "bytes": 1307,
      "sha256": "938ea41f048b2987ff05736f0ee07b42f46bd85c8185dae4e7655c0d95a75609",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body292\n{\nconst byte ClaGlobalPlatform = 0x80;\n\n// Common instructions\nconst byte InsGetData = 0xCA;\nconst byte InsPutKey = 0xD8;\nconst byte InsInitializeUpdate = 0x50;\nconst byte InsExternalAuthenticate = 0x82;\nconst byte InsInternalAuthenticate = 0x88;\nconst byte InsDelete = 0xE4;\nconst byte InsGenerateKey = 0xF1;\nconst byte InsPerformSecurityOperation = 0x2A;\n\n// TLV tags for data encoding\nconst int TagKeyInformationTemplate = 0xE0;\nconst byte TagControlReference = 0xA6;\nconst byte TagKidKvn = 0x83;\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-293.cs",
      "bytes": 1203,
      "sha256": "8749bf9b7d64f34aad83291322288169ff331fcc814ebbe246e4a5c26246874b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body293\n{\ninternal static async Task CompileOnly(ISecurityDomainSession session, Microsoft.Extensions.Logging.ILogger logger, CancellationToken cancellationToken)\n{\nvar keyInfo = await session.ListKeyInformationAsync(cancellationToken);\nforeach (var entry in keyInfo)\n{\n    logger.LogDebug(\n        \"Key: KID={Kid:X2}, KVN={Kvn:X2}\",\n        entry.KeyReference.Kid,\n        entry.KeyReference.Kvn);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-296.cs",
      "bytes": 1377,
      "sha256": "95d3f0a3bce2c3ab6aac1916a1e17440b416733914d1197ec6e71641126cba14",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\nusing System.Security.Cryptography;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body296\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreateSecurityDomainSessionAsync();\n\nforeach (var keyInfo in await session.ListKeyInformationAsync())\n{\n    Console.WriteLine(keyInfo.KeyReference);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-297.cs",
      "bytes": 1175,
      "sha256": "e0c29a4e937fdadf8ff943b53b2f3d1b561004d4c5b45031969cc0f47d498754",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body297\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nusing var scpKeyParameters = Scp03KeyParameters.Default;\nawait using var session = await device.CreateSecurityDomainSessionAsync(\n    new SessionCreationOptions { ScpKeyParameters = scpKeyParameters });\n\nIReadOnlyList<Yubico.YubiKit.SecurityDomain.KeyInfo> keys = await session.ListKeyInformationAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-298.cs",
      "bytes": 1316,
      "sha256": "a8f000aaae78cc184377fd5d101566562f353e4a85264c8360eedac840a6e33e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body298\n{\ninternal static async Task CompileOnly(ISecurityDomainSession session)\n{\nbyte[] keyMaterial = RandomNumberGenerator.GetBytes(48);\ntry\n{\n    // Escrow keyMaterial before you send it: the device will not give it back.\n    using var newKeys = new StaticKeys(keyMaterial.AsSpan(0, 16), keyMaterial.AsSpan(16, 16), keyMaterial.AsSpan(32, 16));\n    await session.PutKeyAsync(new KeyReference(ScpKid.SCP03, Kvn: 0x02), newKeys, replaceKvn: 0);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(keyMaterial);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-299.cs",
      "bytes": 1039,
      "sha256": "26723539497f0446d5ea4898890f3a8b61f80bece3380862d420a3f9ba495772",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body299\n{\ninternal static async Task CompileOnly(ISecurityDomainSession session)\n{\nvar keyReference = new KeyReference(ScpKid.SCP11b, Kvn: 0x01);\nECPublicKey devicePublicKey = await session.GenerateKeyAsync(keyReference, replaceKvn: 0);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-300.cs",
      "bytes": 1468,
      "sha256": "666565e6ecb4d10074af64fee7e0286d9c4a1598ad236e7c860768c084b69891",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body300\n{\nstatic async Task<IReadOnlyList<Yubico.YubiKit.SecurityDomain.KeyInfo>> ReadWithScp11bAsync(\n    IYubiKey device, FirmwareVersion knownFirmware, KeyReference keyReference,\n    ECPublicKey trustedDevicePublicKey, CancellationToken cancellationToken)\n{\n    using var parameters = new Scp11KeyParameters(keyReference, trustedDevicePublicKey);\n    await using var session = await device.CreateSecurityDomainSessionAsync(\n        new SessionCreationOptions\n        {\n            FirmwareVersionOverride = knownFirmware,\n            ScpKeyParameters = parameters\n        }, cancellationToken);\n    return await session.ListKeyInformationAsync(cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-301.cs",
      "bytes": 973,
      "sha256": "08eba077b796dee5ff33081bc18e596976b24372e83619436ed31c492e540fdf",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.SecurityDomain;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body301\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreateSecurityDomainSessionAsync();\nawait session.ResetAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-310.cs",
      "bytes": 1571,
      "sha256": "f222e11c1e200582f9038726f676c333baf38e388c69926b0c2b06b282592e54",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\nusing System;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body310\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync(\n    predicate: key => key.SupportsConnection(ConnectionType.SmartCard));\nawait using var session = await device.CreateOathSessionAsync();\nIReadOnlyList<Credential> credentials = await session.ListCredentialsAsync();\nConsole.WriteLine(string.Join('\\n', credentials.Select(c => $\"{c.Issuer}:{c.Name} ({c.OathType})\")));\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-311.cs",
      "bytes": 1133,
      "sha256": "0d9091e62c0ae50937ab9edfbc484124e1fbe8fdb10b127e6c02681de4dc9116",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body311\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nusing var credentialData = CredentialData.ParseUri(\n    \"otpauth://totp/GitHub:user@example.com?secret=JBSWY3DPEHPK3PXP&issuer=GitHub\", requireTouch: false);\nawait using var session = await device.CreateOathSessionAsync();\nawait session.PutCredentialAsync(credentialData);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-312.cs",
      "bytes": 1352,
      "sha256": "7c65c4d666650152adf3742be8d94c70db3fad96f538a21df7ceb13f9f19a935",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body312\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nbyte[] seed = \"12345678901234567890\"u8.ToArray(); // Example seed only; obtain real input securely.\ntry\n{\n    using var credentialData = new CredentialData\n    {\n        Name = \"alice@example.com\",\n        OathType = OathType.Totp,\n        HashAlgorithm = OathHashAlgorithm.Sha1,\n        Secret = seed\n    };\n    await using var session = await device.CreateOathSessionAsync();\n    await session.PutCredentialAsync(credentialData);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(seed);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-313.cs",
      "bytes": 1320,
      "sha256": "05626dc8f86bdeaf80e23fa2a756210ab5e6adce9f5fcc8f537d859cf0259837",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body313\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreateOathSessionAsync();\nforeach ((Credential credential, Code? code) in await session.CalculateAllAsync())\n{\n    Console.WriteLine($\"{credential.Issuer}:{credential.Name} = {code?.Value ?? \"(not calculated)\"}\");\n}\n\nCredential hotp = (await session.ListCredentialsAsync()).First(c => c.OathType == OathType.Hotp);\nCode hotpCode = await session.CalculateCodeAsync(hotp);\nConsole.WriteLine($\"HOTP code {hotpCode.Value}\");\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-314.cs",
      "bytes": 1306,
      "sha256": "c7fc33d2f7d82b258fd03825e82e3b1f1c33b494c8ce46e6f40f8be74044e7fc",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body314\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nbyte[] password = Encoding.UTF8.GetBytes(\"correct horse battery staple\");\nbyte[] accessKey = [];\ntry\n{\n    await using var session = await device.CreateOathSessionAsync();\n    accessKey = session.DeriveKey(password);\n    await (session.IsLocked\n        ? session.ValidateAsync(accessKey)\n        : session.SetKeyAsync(accessKey));\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(password);\n    CryptographicOperations.ZeroMemory(accessKey);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-315.cs",
      "bytes": 1079,
      "sha256": "6ade93337e09f2796a73cb15527b01e7af314650fba3d088f600f136269efb5d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body315\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreateOathSessionAsync();\nCredential credential = (await session.ListCredentialsAsync()).First(c => c.Name == \"user@example.com\");\nawait session.DeleteCredentialAsync(credential);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-316.cs",
      "bytes": 1076,
      "sha256": "8db263588d37b140bd345a6b4a00dfa9a1eb54dfb19cc7cc1d0d2efd34d933bc",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body316\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-317.cs",
      "bytes": 1276,
      "sha256": "1d843e5a6b82c4ca98a536054921c5deda2beaad4b2ce642c286e6a38a111c8a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body317\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreateOathSessionAsync(\n    new SessionCreationOptions { UserPresencePrompt = new TouchPrompt() });\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-318.cs",
      "bytes": 1143,
      "sha256": "f95067c7dc0887fa77abccf292e13d287babce9c5d3a3f933373717a6f26ddc3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body318\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using (var reset = await device.CreateOathSessionAsync(cancellationToken: ct))\n{\n    await reset.ResetAsync(ct);\n}\nawait using var fresh = await device.CreateOathSessionAsync(cancellationToken: ct);\nvar credentials = await fresh.ListCredentialsAsync(ct);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-320.cs",
      "bytes": 1125,
      "sha256": "6984e18444bc6975b1e2ca78bb450813b0e540fc6ed662e25719ac6ffbfe305f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body320\n{\ninternal static void CompileOnly(IEnumerable<Credential> credentials)\n{\nvar displayOrder = credentials\n    .OrderBy(credential => credential.Issuer ?? credential.Name, StringComparer.OrdinalIgnoreCase)\n    .ThenBy(credential => credential.Name, StringComparer.OrdinalIgnoreCase)\n    .ThenBy(credential => credential);\n    \n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-323.cs",
      "bytes": 1201,
      "sha256": "6febb50da990f471a1720099656ab1242f2bd31ceb9fde037e5693e1d900957e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body323\n{\ninternal static async Task CompileOnly(ISmartCardConnection connection, byte[] key)\n{\ntry\n{\n    await using var session = await YubiOtpSession.CreateAsync(connection);\n    using var config = new HmacSha1SlotConfiguration(key);\n    await session.PutConfigurationAsync(Slot.Two, config);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(key);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-324.cs",
      "bytes": 1253,
      "sha256": "7b054fa247881648d6f47a4e0a56638574d389e115ec6648889a17f00567d495",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body324\n{\ninternal static async Task CompileOnly(IYubiOtpSession session, byte[] challenge)\n{\nReadOnlyMemory<byte> response = default;\ntry\n{\n    response = await session.CalculateHmacSha1Async(Slot.Two, challenge);\n    // Consume with the application's verifier.\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(challenge);\n    CryptographicOperations.ZeroMemory(MemoryMarshal.AsMemory(response).Span);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-325.cs",
      "bytes": 1004,
      "sha256": "e03d20a88af22129c506efd580f2ec2a948bad73c3dcf9c6105bc5293d259eed",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body325\n{\ninternal static void CompileOnly(IYubiOtpSession session)\n{\nvar state = session.GetConfigState();\nbool isConfigured = state.IsConfigured(Slot.One);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-328.cs",
      "bytes": 1579,
      "sha256": "d5fb7fbe7a93efe4cad9f1f7be7d8b535c55d59504fa58755c3f58891d297fb0",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\nusing System;\nusing System.Collections.Generic;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\nusing Yubico.YubiKit.YubiOtp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body328\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\n{\n    await using var session = await device.CreateYubiOtpSessionAsync();\n    ConfigState state = session.GetConfigState();\n    Console.WriteLine($\"OTP applet firmware {state.FirmwareVersion}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-329.cs",
      "bytes": 1310,
      "sha256": "5e98960e89ae99f0f883c7a836d69fba58cadc5862d0155e46ca8ed54a82d289",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body329\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\ntry\n{\n    await using var session = await device.CreateYubiOtpSessionAsync();\n    using var update = new UpdateConfiguration();\n    update.AppendCr();\n    update.FastTrigger();\n    update.PacingChar10();\n    await session.UpdateConfigurationAsync(\n        Slot.Two, update, accessCode: accessCode, currentAccessCode: accessCode);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(accessCode);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-330.cs",
      "bytes": 1475,
      "sha256": "cf778d8466cc9d3005a8658e253e29c9a844508353460dab9b9b00ae7b487491",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body330\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nbyte[] hmacKey = RandomNumberGenerator.GetBytes(20);\ntry\n{\n    // Securely enroll hmacKey with your verifier here as part of your application's provisioning.\n    await using var session = await device.CreateYubiOtpSessionAsync(\n        new SessionCreationOptions { PreferredConnectionType = ConnectionType.HidOtp });\n    using var config = new HmacSha1SlotConfiguration(hmacKey);\n    config.RequireTouch();\n    config.UseShortChallenge();\n    await session.PutConfigurationAsync(Slot.Two, config);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(hmacKey);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-331.cs",
      "bytes": 1404,
      "sha256": "3a6d53af3b07f55c1f082ad60002fe6140ed5fa08cfb2ca18b64612dd186588b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body331\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nbyte[] challenge = Encoding.UTF8.GetBytes(\"some-challenge\");\nReadOnlyMemory<byte> response = default;\ntry\n{\n    response = await device.CalculateHmacSha1Async(\n        Slot.Two, challenge,\n        new SessionCreationOptions { PreferredConnectionType = ConnectionType.HidOtp });\n    // Consume the response with your verifier here; do not log it.\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(challenge);\n    CryptographicOperations.ZeroMemory(MemoryMarshal.AsMemory(response).Span);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-332.cs",
      "bytes": 1842,
      "sha256": "1d584071671eb1b8370b8d54f249bd4ee2af8db4ef782db2d775246bfa3b46f2",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body332\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nbyte[] aesKey = [];\nbyte[] challenge = [];\nReadOnlyMemory<byte> ticket = default;\ntry\n{\n    aesKey = RandomNumberGenerator.GetBytes(16);\n    challenge = RandomNumberGenerator.GetBytes(6);\n    // Securely provision aesKey to the verifier here as part of your application's enrollment.\n    await using var session = await device.CreateYubiOtpSessionAsync(\n        new SessionCreationOptions { PreferredConnectionType = ConnectionType.HidOtp });\n    using var config = new YubicoOtpChallengeResponseSlotConfiguration(aesKey);\n    await session.PutConfigurationAsync(Slot.Two, config);\n    ticket = await session.CalculateYubicoOtpAsync(Slot.Two, challenge);\n    // Send the ticket to your verifier through your application's secure channel.\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(aesKey);\n    CryptographicOperations.ZeroMemory(challenge);\n    CryptographicOperations.ZeroMemory(MemoryMarshal.AsMemory(ticket).Span);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-333.cs",
      "bytes": 1173,
      "sha256": "9200bebfab133f9dca73784ba9a8c2db79689e82e6fbc015d0880198c9dfd599",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body333\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\n{\n    await using var session = await device.CreateYubiOtpSessionAsync();\n    using var config = new StaticPasswordSlotConfiguration(\"Correct-Horse-1\", KeyboardLayout.en_US);\n    config.AppendCr();\n    await session.PutConfigurationAsync(Slot.Two, config);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-334.cs",
      "bytes": 1071,
      "sha256": "df4043c5a0401554d8db3e4af608cb15890c4607aee998909f93eae59c05fe08",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body334\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\n{\n    await using var session = await device.CreateYubiOtpSessionAsync();\n    await session.SwapSlotsAsync();\n    await session.DeleteSlotAsync(Slot.Two);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-335.cs",
      "bytes": 1130,
      "sha256": "c232b7347bdf505089f3319cb47bc8bc191b4c40bc7d3cce3d11022da4ca5b9d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body335\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-336.cs",
      "bytes": 1521,
      "sha256": "1931daca671b2db143de890ead71156ef952de696ad5b2712fd3e0be4d7b2868",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiOtp;\nusing Yubico.YubiKit.Core.Transports.Hid.Keyboard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body336\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\ninternal static async Task CompileOnly(IYubiKey device)\n{\n{\n    await using var session = await device.CreateYubiOtpSessionAsync(\n        new SessionCreationOptions\n        {\n            PreferredConnectionType = ConnectionType.HidOtp,\n            UserPresencePrompt = new TouchPrompt()\n        });\n    // Calculate a challenge-response on this session using the cleanup pattern above.\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-341.cs",
      "bytes": 1367,
      "sha256": "c67f913e3facbfa3d063d824ef7c6c40d645e005eca0ae915e84ef8f03ad8f13",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiHsm;\nusing System.Security.Cryptography;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.YubiHsm;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body341\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreateHsmAuthSessionAsync();\nforeach (var credential in await session.ListCredentialsAsync())\n{\n    Console.WriteLine($\"{credential.Label}: {credential.Algorithm}, {credential.RetriesRemaining} retries\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-342.cs",
      "bytes": 1835,
      "sha256": "14ff10b875c85b0ba5a316d0f9cd7fe2ae5b45070cf4bfb419c583786c491d1f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiHsm;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body342\n{\nstatic async Task EnrollSymmetricAsync(\n    IYubiKey device,\n    ReadOnlyMemory<byte> managementKey,\n    ReadOnlyMemory<byte> credentialPassword,\n    string label,\n    ushort hsmAuthenticationKeyId,\n    Func<ushort, string, ReadOnlyMemory<byte>, ReadOnlyMemory<byte>, CancellationToken, Task> provisionHsmAsync,\n    CancellationToken cancellationToken)\n{\n    byte[] keyMaterial = RandomNumberGenerator.GetBytes(32);\n    try\n    {\n        await provisionHsmAsync(hsmAuthenticationKeyId, label,\n            keyMaterial.AsMemory(0, 16), keyMaterial.AsMemory(16, 16), cancellationToken);\n        await using var session = await device.CreateHsmAuthSessionAsync(\n            cancellationToken: cancellationToken);\n        await session.PutCredentialSymmetricAsync(managementKey, label,\n            keyMaterial.AsMemory(0, 16), keyMaterial.AsMemory(16, 16), credentialPassword,\n            touchRequired: true, cancellationToken: cancellationToken);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(keyMaterial);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-343.cs",
      "bytes": 2771,
      "sha256": "af0baa398d15929f2abc7ec8b8b6071aaaab9ebac9a4bdb36ef8c974708eedae",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiHsm;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body343\n{\ninterface ISymmetricHsmExchange : IAsyncDisposable\n{\n    Task<(byte[] HsmChallenge, byte[] CardCryptogram)> BeginAsync(\n        ushort authenticationKeyId, ReadOnlyMemory<byte> hostChallenge, CancellationToken cancellationToken);\n    Task AuthenticateAndUseAsync(SessionKeys keys, CancellationToken cancellationToken);\n}\n\nstatic async Task UseSymmetricHsmAsync(\n    IYubiKey device, string label, ushort hsmAuthenticationKeyId,\n    ReadOnlyMemory<byte> credentialPassword,\n    Func<CancellationToken, Task<ISymmetricHsmExchange>> openExchangeAsync,\n    CancellationToken cancellationToken)\n{\n    byte[] hostChallenge = RandomNumberGenerator.GetBytes(8);\n    byte[]? context = null;\n    byte[]? hsmChallenge = null;\n    byte[]? cardCryptogram = null;\n    try\n    {\n        context = new byte[16];\n        await using var exchange = await openExchangeAsync(cancellationToken);\n        (hsmChallenge, cardCryptogram) = await exchange.BeginAsync(\n            hsmAuthenticationKeyId, hostChallenge, cancellationToken);\n        if (hsmChallenge.Length != 8 || cardCryptogram.Length != 8)\n            throw new InvalidOperationException(\"Unexpected symmetric HSM handshake response.\");\n\n        hostChallenge.CopyTo(context, 0);\n        hsmChallenge.CopyTo(context, 8);\n        await using var session = await device.CreateHsmAuthSessionAsync(\n            cancellationToken: cancellationToken);\n        using var keys = await session.CalculateSessionKeysSymmetricAsync(\n            label, context, credentialPassword, cardCryptogram, cancellationToken);\n        await exchange.AuthenticateAndUseAsync(keys, cancellationToken);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(hostChallenge);\n        if (context is not null) CryptographicOperations.ZeroMemory(context);\n        if (hsmChallenge is not null) CryptographicOperations.ZeroMemory(hsmChallenge);\n        if (cardCryptogram is not null) CryptographicOperations.ZeroMemory(cardCryptogram);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-344.cs",
      "bytes": 1499,
      "sha256": "2fe0897e948b19061f8cd85446e33bdc65935e98fbca8c1824cefbfd0d293bd2",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiHsm;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body344\n{\nstatic async Task RotateManagementKeyAsync(\n    IYubiKey device, ReadOnlyMemory<byte> currentManagementKey,\n    Func<ReadOnlyMemory<byte>, CancellationToken, Task> persistRecoverableKeyAsync,\n    CancellationToken cancellationToken)\n{\n    byte[] replacement = RandomNumberGenerator.GetBytes(16);\n    try\n    {\n        await persistRecoverableKeyAsync(replacement, cancellationToken);\n        await using var session = await device.CreateHsmAuthSessionAsync(\n            cancellationToken: cancellationToken);\n        await session.PutManagementKeyAsync(currentManagementKey, replacement, cancellationToken);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(replacement);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-345.cs",
      "bytes": 1079,
      "sha256": "cccee970b60c831a104c7e13195459f6402e812b9dbaf0b98575dbba0c0a3bb8",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiHsm;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body345\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-346.cs",
      "bytes": 1300,
      "sha256": "bd7c000f61b9b3d0b66c7ae3c0315c3b652ccd1a1b414d05da20e4313997979d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.YubiHsm;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body346\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\ninternal static async Task CompileOnly(IYubiKey device)\n{\nvar options = new SessionCreationOptions { UserPresencePrompt = new TouchPrompt() };\nawait using var session = await device.CreateHsmAuthSessionAsync(options);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-351.cs",
      "bytes": 1543,
      "sha256": "607470c9fb7db943a00a032c3bfc97c2f750a6f3250c2e36d31eff608c09847c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\nusing System;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body351\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreateOpenPgpSessionAsync();\nApplicationRelatedData data = await session.GetApplicationRelatedDataAsync();\nConsole.WriteLine($\"Card {data.Aid.Version}, applet {session.FirmwareVersion}\");\nforeach (var entry in await session.ListKeyInformationAsync())\n{\n    Console.WriteLine($\"{entry.Key}: {entry.Value}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-352.cs",
      "bytes": 1410,
      "sha256": "28bbe6d44cfe700663357ee83ec9d8f3a5e50a067ed12d3bef60f83d97f0313a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body352\n{\nstatic async Task ChangeCredentialsAsync(\n    IYubiKey device, ReadOnlyMemory<byte> currentUserPin, ReadOnlyMemory<byte> newUserPin,\n    ReadOnlyMemory<byte> currentAdminPin, ReadOnlyMemory<byte> newAdminPin,\n    ReadOnlyMemory<byte> resetCode, CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.ChangePinAsync(currentUserPin, newUserPin, cancellationToken);\n    await session.ChangeAdminAsync(currentAdminPin, newAdminPin, cancellationToken);\n    await session.VerifyAdminAsync(newAdminPin, cancellationToken);\n    await session.SetResetCodeAsync(resetCode, cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-353.cs",
      "bytes": 1521,
      "sha256": "d3dea2ef650980d5b84754c421c730f11b323345598317796867e40719414867",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body353\n{\nstatic async Task RecoverWithResetCodeAsync(\n    IYubiKey device, ReadOnlyMemory<byte> resetCode, ReadOnlyMemory<byte> newUserPin,\n    CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.ResetPinUsingResetCodeAsync(resetCode, newUserPin, cancellationToken);\n}\n\nstatic async Task RecoverWithAdminAsync(\n    IYubiKey device, ReadOnlyMemory<byte> adminPin, ReadOnlyMemory<byte> newUserPin,\n    CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.VerifyAdminAsync(adminPin, cancellationToken);\n    await session.ResetPinUsingAdminAuthenticationAsync(newUserPin, cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-354.cs",
      "bytes": 2747,
      "sha256": "03329ed924a39ef81dfc7d9b40184f46dd0941cf6652d261037f95bf4787b853",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body354\n{\nstatic async Task ConfigureInitialKdfAsync(\n    IYubiKey device, ReadOnlyMemory<byte> currentAdminPin,\n    ReadOnlyMemory<byte> defaultUserPin, ReadOnlyMemory<byte> defaultAdminPin,\n    CancellationToken cancellationToken)\n{\n    byte[] saltUser = RandomNumberGenerator.GetBytes(8);\n    byte[] saltReset = RandomNumberGenerator.GetBytes(8);\n    byte[] saltAdmin = RandomNumberGenerator.GetBytes(8);\n    byte[] hashUser = [];\n    byte[] hashAdmin = [];\n    try\n    {\n        using var derivation = new KdfIterSaltedS2k\n        {\n            HashAlgorithm = KdfHashAlgorithm.Sha256, IterationCount = 100000,\n            SaltUser = saltUser, SaltReset = saltReset, SaltAdmin = saltAdmin\n        };\n        hashUser = derivation.Process(Pw.User, defaultUserPin.Span);\n        hashAdmin = derivation.Process(Pw.Admin, defaultAdminPin.Span);\n        using var configured = new KdfIterSaltedS2k\n        {\n            HashAlgorithm = KdfHashAlgorithm.Sha256, IterationCount = 100000,\n            SaltUser = saltUser, SaltReset = saltReset, SaltAdmin = saltAdmin,\n            InitialHashUser = hashUser, InitialHashAdmin = hashAdmin\n        };\n        await using (var provisioning = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken))\n        {\n            await provisioning.VerifyAdminAsync(currentAdminPin, cancellationToken);\n            await provisioning.SetKdfAsync(configured, cancellationToken);\n        }\n        await using var verification = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n        await verification.VerifyAdminAsync(defaultAdminPin, cancellationToken);\n        await verification.VerifyPinAsync(defaultUserPin, cancellationToken: cancellationToken);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(hashUser);\n        CryptographicOperations.ZeroMemory(hashAdmin);\n        CryptographicOperations.ZeroMemory(saltUser);\n        CryptographicOperations.ZeroMemory(saltReset);\n        CryptographicOperations.ZeroMemory(saltAdmin);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-355.cs",
      "bytes": 1171,
      "sha256": "eb9b990c27940c63bbc110c0481fc701787cd6101f0497b735090f715048a51f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body355\n{\nstatic void ShowKeyMetadata()\n{\n    KeyInfo keyInfo = CryptographicDefinitions.Keys.Ed25519;\n    OpenPgpKeyInfo? openPgpInfo = keyInfo.GetOpenPgpInfo();\n    Console.WriteLine(openPgpInfo?.CurveOid); // 1.3.6.1.4.1.11591.15.1 (OpenPGP)\n    Console.WriteLine(keyInfo.Asn1?.AlgorithmOid); // 1.3.101.112 (RFC 8410)\n    EcAttributes attributes = EcAttributes.Create(KeyRef.Sig, KeyType.Ed25519); // EdDSA, 0x16\n    Console.WriteLine(attributes.AlgorithmId);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-356.cs",
      "bytes": 1241,
      "sha256": "207f6b1d78f75a551951a4c0f13562351a7fef2ba69e1c8cb9e7139e97480c02",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body356\n{\nstatic async Task GenerateSigningKeyAsync(\n    IYubiKey device, ReadOnlyMemory<byte> adminPin, CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.VerifyAdminAsync(adminPin, cancellationToken);\n    await session.GenerateKeyAsync(KeyRef.Sig,\n        EcAttributes.Create(KeyRef.Sig, KeyType.P256), cancellationToken);\n    Console.WriteLine((await session.ListKeyInformationAsync(cancellationToken))[KeyRef.Sig]);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-357.cs",
      "bytes": 1188,
      "sha256": "c4591681db528cb891fba7f1e4ef404aa32e0e3ebe664386b4f687d94ea9c85b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body357\n{\nstatic async Task ImportRsaSigningKeyAsync(\n    IYubiKey device, ReadOnlyMemory<byte> adminPin, byte[] pkcs8Der,\n    CancellationToken cancellationToken)\n{\n    using var privateKey = RSAPrivateKey.CreateFromPkcs8(pkcs8Der);\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.VerifyAdminAsync(adminPin, cancellationToken);\n    await session.PutKeyAsync(KeyRef.Sig, privateKey, cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-358.cs",
      "bytes": 2467,
      "sha256": "728c98ce33e5665122790239e201f82da38e9a02308cac345dd17c9abfcf68ee",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body358\n{\nstatic ECParameters DecodeP256PublicKey(ReadOnlyMemory<byte> template)\n{\n    using var outer = Tlv.Create(template.Span);\n    if (outer.Tag != 0x7F49)\n        throw new CryptographicException(\"Expected a card public-key template.\");\n    var point = TlvHelper.DecodeDictionary(outer.Value.Span)[0x86];\n    if (point.Length != 65 || point.Span[0] != 0x04)\n        throw new CryptographicException(\"Expected an uncompressed P-256 point.\");\n    return new ECParameters\n    {\n        Curve = ECCurve.NamedCurves.nistP256,\n        Q = new ECPoint { X = point.Slice(1, 32).ToArray(), Y = point.Slice(33, 32).ToArray() }\n    };\n}\n\nstatic async Task<bool> SignAndVerifyP256Async(\n    IYubiKey device, ReadOnlyMemory<byte> userPin, ReadOnlyMemory<byte> message,\n    CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    var attributes = await session.GetAlgorithmAttributesAsync(KeyRef.Sig, cancellationToken);\n    if (attributes is not EcAttributes { KeyType: KeyType.P256 })\n        throw new InvalidOperationException(\"Provision a P-256 signing key first.\");\n    using var verifier = ECDsa.Create(DecodeP256PublicKey(\n        await session.GetPublicKeyAsync(KeyRef.Sig, cancellationToken)));\n    await session.VerifyPinAsync(userPin, cancellationToken: cancellationToken);\n    ReadOnlyMemory<byte> signature = await session.SignAsync(message, HashAlgorithmName.SHA256, cancellationToken);\n    try\n    {\n        return verifier.VerifyData(message.Span, signature.Span, HashAlgorithmName.SHA256,\n            DSASignatureFormat.Rfc3279DerSequence);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(MemoryMarshal.AsMemory(signature).Span);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-359.cs",
      "bytes": 1445,
      "sha256": "1074f069b13e080954c2d734b7e6a893b4a5273b06e60095a05888e0807e8e92",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body359\n{\nstatic async Task DecipherAndConsumeAsync(\n    IYubiKey device, ReadOnlyMemory<byte> userPin, ReadOnlyMemory<byte> rawCiphertextOrPoint,\n    Func<ReadOnlyMemory<byte>, CancellationToken, Task> consume,\n    CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.VerifyPinAsync(userPin, extended: true, cancellationToken: cancellationToken);\n    ReadOnlyMemory<byte> result = await session.DecryptAsync(rawCiphertextOrPoint, cancellationToken);\n    try\n    {\n        await consume(result, cancellationToken);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(MemoryMarshal.AsMemory(result).Span);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-360.cs",
      "bytes": 1451,
      "sha256": "f813a82dabebe96dd0ce1ce40aec69fb17cbf8eb0f2f8c744486cfca6b571f3f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body360\n{\nstatic async Task<byte[]> StoreAndReadCertificateAsync(\n    IYubiKey device, KeyRef slot, ReadOnlyMemory<byte> adminPin, ReadOnlyMemory<byte> certificateDer,\n    CancellationToken cancellationToken)\n{\n    using var certificate = X509CertificateLoader.LoadCertificate(certificateDer.Span);\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.VerifyAdminAsync(adminPin, cancellationToken);\n    await session.PutCertificateAsync(slot, certificate, cancellationToken);\n    using var readBack = await session.GetCertificateAsync(slot, cancellationToken);\n    return readBack?.RawData ?? throw new InvalidOperationException(\"Certificate was absent after writing.\");\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-361.cs",
      "bytes": 1192,
      "sha256": "535077437dbc1ceb5da93d2e831e9d31d6a253b532ec7bb1e4e94639f7260985",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body361\n{\nstatic async Task<byte[]> AttestGeneratedKeyAsync(\n    IYubiKey device, KeyRef slot, ReadOnlyMemory<byte> userPin, CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.VerifyPinAsync(userPin, extended: false, cancellationToken: cancellationToken);\n    using var attestation = await session.AttestKeyAsync(slot, cancellationToken);\n    return attestation.RawData;\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-362.cs",
      "bytes": 1262,
      "sha256": "c7868dfafee98555ce7d5c5c36a22efdcad98ef137647a107afbfbe4e4cd65e9",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body362\n{\nstatic async Task ConfigureSigningPolicyAsync(\n    IYubiKey device, ReadOnlyMemory<byte> adminPin, CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.VerifyAdminAsync(adminPin, cancellationToken);\n    await session.SetUifAsync(KeyRef.Sig, Uif.On, cancellationToken);\n    await session.SetSignaturePinPolicyAsync(PinPolicy.Always, cancellationToken);\n    Console.WriteLine(await session.GetUifAsync(KeyRef.Sig, cancellationToken));\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-363.cs",
      "bytes": 1074,
      "sha256": "f52f83ee777feddb02e9ae7de4cd32412f54a675a11f7696cf40410f67417cc1",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.OpenPgp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body363\n{\nstatic async Task<ApplicationRelatedData> ResetAndInspectAsync(\n    IYubiKey device, CancellationToken cancellationToken)\n{\n    await using var session = await device.CreateOpenPgpSessionAsync(cancellationToken: cancellationToken);\n    await session.ResetAsync(cancellationToken);\n    return await session.GetApplicationRelatedDataAsync(cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-370.cs",
      "bytes": 964,
      "sha256": "a9c28292ba6c49bb51632825779e724a6879e6bb3ded215fc2d7027326d41e5d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body370\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-371.cs",
      "bytes": 1067,
      "sha256": "bf9296db8e151d6f202b0690980b5b19b37fefe40a1b76ccf5a2b01cdfab597e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body371\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var connection = await device.ConnectAsync<ISmartCardConnection>(cancellationToken);\nawait using var session = await PivSession.CreateAsync(connection, cancellationToken: cancellationToken);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-373.cs",
      "bytes": 1412,
      "sha256": "4491543a03011430ae2293ceca7edac625161089d40b4a6b42bed845bc4c14b8",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body373\n{\nstatic async Task AuthenticateWithStoreAsync(\n    IPivSession session,\n    Action<Memory<byte>> loadManagementKey,\n    CancellationToken cancellationToken)\n{\n    // This example store contract supplies a 24-byte Triple-DES or AES-192 active key.\n    byte[] managementKey = ArrayPool<byte>.Shared.Rent(24);\n    try\n    {\n        loadManagementKey(managementKey.AsMemory(0, 24));\n        await session.AuthenticateAsync(managementKey.AsMemory(0, 24), cancellationToken);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(managementKey.AsSpan(0, 24));\n        ArrayPool<byte>.Shared.Return(managementKey, clearArray: true);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-378.cs",
      "bytes": 1374,
      "sha256": "7d8f2b091f1f59c9d82b4d89f4384622f471e71f5d2586db2df8025d740cb080",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Piv;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body378\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreatePivSessionAsync();\n\nint pinAttempts = await session.GetPinAttemptsAsync();\nConsole.WriteLine($\"PIN attempts remaining: {pinAttempts}\");\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-379.cs",
      "bytes": 1386,
      "sha256": "ea771febdfdfbbc7ddcd058828076718f080a7f55e41d6506f35e7d88b547402",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body379\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreatePivSessionAsync();\n\n// Evaluation only: this public factory value must match the key currently installed.\nbyte[] managementKey = PivSession.DefaultManagementKey.ToArray();\ntry\n{\n    await session.AuthenticateAsync(managementKey);\n    var keyOptions = new KeyCreationOptions { PinPolicy = PinPolicy.Once, TouchPolicy = TouchPolicy.Never };\n    IPublicKey publicKey = await session.GenerateKeyAsync(Slot.Authentication, KeyType.P256, keyOptions);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-380.cs",
      "bytes": 1223,
      "sha256": "45347e5b37157de2cce1c0b50441ab562b646b498b75ede1b145bd25bb3d8249",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body380\n{\ninternal static async Task CompileOnly(IPivSession session)\n{\nusing var certificate = X509CertificateLoader.LoadCertificateFromFile(\"authentication.cer\");\nawait session.StoreCertificateAsync(Slot.Authentication, certificate, CertificateCompression.Automatic);\nusing X509Certificate2? stored = await session.GetCertificateAsync(Slot.Authentication);\nif (stored is null)\n    throw new InvalidOperationException(\"The slot has no usable certificate data.\");\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-381.cs",
      "bytes": 1770,
      "sha256": "1afd686a2351051cb61a882007b5b8dfe0cda7fb66541f9834a1ec1d35c4acb5",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body381\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreatePivSessionAsync();\n\nbyte[] digest = [];\nMemory<byte> signature = Memory<byte>.Empty;\nbyte[] pin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    digest = SHA256.HashData(Encoding.UTF8.GetBytes(\"message to sign\"));\n    await session.VerifyPinAsync(pin);\n    var metadata = await session.GetSlotMetadataAsync(Slot.Authentication)\n        ?? throw new InvalidOperationException(\"Generate a P-256 key first.\");\n    using var verifier = metadata.GetECDsaPublicKey();\n    signature = await session.SignOrDecryptAsync(Slot.Authentication, KeyType.P256, digest);\n    if (!verifier.VerifyHash(digest, signature.Span, DSASignatureFormat.Rfc3279DerSequence))\n        throw new CryptographicException(\"The slot signature failed host verification.\");\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n    CryptographicOperations.ZeroMemory(digest);\n    CryptographicOperations.ZeroMemory(signature.Span);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-382.cs",
      "bytes": 1935,
      "sha256": "a1acaa39dce02aae65f6e0a05e0c490ffa03a9677185444666a0ef2376602886",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body382\n{\ninternal static async Task CompileOnly(IYubiKey device)\n{\nawait using var session = await device.CreatePivSessionAsync();\nusing var certificate = await session.GetCertificateAsync(Slot.KeyManagement)\n    ?? throw new InvalidOperationException(\"Provision a matching RSA certificate first.\");\nusing var rsa = certificate.GetRSAPublicKey()\n    ?? throw new InvalidOperationException(\"The certificate must contain an RSA public key.\");\nbyte[] expected = [];\nMemory<byte> plaintext = Memory<byte>.Empty;\nbyte[] pin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    expected = Encoding.UTF8.GetBytes(\"known plaintext\");\n    byte[] ciphertext = rsa.Encrypt(expected, RSAEncryptionPadding.OaepSHA256);\n    await session.VerifyPinAsync(pin);\n    plaintext = await session.DecryptAsync(Slot.KeyManagement, ciphertext, RSAEncryptionPadding.OaepSHA256);\n    if (!CryptographicOperations.FixedTimeEquals(expected, plaintext.Span))\n        throw new CryptographicException(\"Decryption returned unexpected plaintext.\");\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n    CryptographicOperations.ZeroMemory(expected);\n    CryptographicOperations.ZeroMemory(plaintext.Span);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-383.cs",
      "bytes": 2137,
      "sha256": "484d979cd4f81eda25c657b763bc077b8bc31311f68daa4d0ec0726e2bd9cd95",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body383\n{\nstatic async Task ProtectedAdministrationRoundTripAsync(\n    IYubiKey device,\n    ReadOnlyMemory<byte> pin,\n    ReadOnlyMemory<byte> activeManagementKey,\n    CancellationToken cancellationToken)\n{\n    await using (var setup = await device.CreatePivSessionAsync(cancellationToken: cancellationToken))\n    {\n        await setup.AuthenticateAsync(activeManagementKey, cancellationToken);\n        await setup.SetPinOnlyModeAsync(PinOnlyMode.PinProtected, pin, activeManagementKey, cancellationToken);\n    }\n\n    await using (var reopened = await device.CreatePivSessionAsync(cancellationToken: cancellationToken))\n    {\n        PinOnlyMode detected = await reopened.GetPinOnlyModeAsync(cancellationToken);\n        if (!detected.HasFlag(PinOnlyMode.PinProtected))\n            throw new InvalidOperationException(\"Inspect ADMIN DATA before continuing.\");\n        PinOnlyMode recovered = await reopened.RecoverPinOnlyModeAsync(pin, cancellationToken);\n        if (!recovered.HasFlag(PinOnlyMode.PinProtected) || !reopened.IsManagementKeyAuthenticated)\n            throw new InvalidOperationException(\"Use the backed-up active management key to recover access.\");\n\n        // Perform authorized administration here, then restore the type-appropriate public default.\n        await reopened.SetPinOnlyModeAsync(PinOnlyMode.None, pin, cancellationToken: cancellationToken);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-384.cs",
      "bytes": 1043,
      "sha256": "d9148849e155d03420015dfea1b1da17a3ea84f08588c918ae5a3e5cd0948ff3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body384\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-385.cs",
      "bytes": 1260,
      "sha256": "255fb4730e14b203d4b85dfff710b9b67e1ab63eade7cff0858157024d40c154",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body385\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\ninternal static async Task CompileOnly(IYubiKey device)\n{\nvar options = new SessionCreationOptions { UserPresencePrompt = new TouchPrompt() };\nawait using var session = await device.CreatePivSessionAsync(options);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-387.cs",
      "bytes": 1257,
      "sha256": "fc261060bff032c82248f158d1205a21392d39911ca5ba331b5f6084134e7fd8",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body387\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Attestation.GetAttestationAsync(\n    session, Slot.Authentication, ct);\n\nusing var attestCert = result.AttestationCertificate;\nusing var signerCert = result.IntermediateCertificate;\nif (result.Success && attestCert is not null)\n{\n    Console.WriteLine($\"Retrieved attestation: {attestCert.Subject}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-388.cs",
      "bytes": 1215,
      "sha256": "d0a0c0758f273bea8df12a674228f54b5fc479af5f71c9cd53c93f55a486abaf",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body388\n{\ninternal static async Task CompileOnly(IPivSession session, CancellationToken ct)\n{\nvar result = await Attestation.GetIntermediateCertificateAsync(session, ct);\n// This helper returns F9 in AttestationCertificate; IntermediateCertificate remains null.\nusing var f9Cert = result.AttestationCertificate;\nusing var additionalCert = result.IntermediateCertificate;\nif (result.Success && f9Cert is not null)\n{\n    Console.WriteLine(f9Cert.Subject);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-389.cs",
      "bytes": 1175,
      "sha256": "37163b7ddcef5e739146fa8aa67597c162b654a821f0d9f5729dda1d8784af6d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body389\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Certificates.GetCertificateAsync(session, Slot.Authentication, ct);\nusing var certificate = result.Certificate;\nif (result.Success && certificate is not null)\n{\n    Console.WriteLine($\"Subject: {certificate.Subject}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-390.cs",
      "bytes": 1276,
      "sha256": "c92853314b3ae18c83c0392da864a9f2d64d42d43b0ee5f35447a0986f6b7b49",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body390\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> managementKey, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar certData = await File.ReadAllBytesAsync(\"certificate.pem\", ct);\nvar result = await Certificates.ImportCertificateAsync(\n    session, Slot.Authentication, certData, compress: false, cancellationToken: ct);\nusing var certificate = result.Certificate;\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-391.cs",
      "bytes": 1235,
      "sha256": "2b6debf5832d08307b77d2e9b99ddbf732a3125f0b09c9e02e6495fa63d620b3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body391\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Certificates.ExportCertificatePemAsync(session, Slot.Authentication, ct);\nusing var certificate = result.Certificate;\nif (result.Success && certificate is not null)\n{\n    var pem = certificate.ExportCertificatePem();\n    await File.WriteAllTextAsync(\"certificate.pem\", pem, ct);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-392.cs",
      "bytes": 1113,
      "sha256": "030b2781fb8083d6686ecbd271069c77902ad1ed6acdc880ca859087873de23d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body392\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> managementKey, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar result = await Certificates.DeleteCertificateAsync(session, Slot.Authentication, ct);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-393.cs",
      "bytes": 1249,
      "sha256": "0e4957e301ce95c5821188b0c43e4c7ee260bdf764a838dd9fa157c9aadfcdc9",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body393\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> managementKey, ReadOnlyMemory<byte> pin, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Certificates.GenerateSelfSignedAsync(\n    session, Slot.Authentication, \"CN=Test User\", 365, ct);\nusing var certificate = result.Certificate;\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-394.cs",
      "bytes": 1325,
      "sha256": "a7f0da78ed76cd09dfeb212cc2fdca03def2b95ca686495f46107d4335be46c3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body394\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> pin, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.VerifyPinAsync(pin, ct); // Borrowed caller-owned PIN; required by the slot policy.\n\nvar result = await Certificates.GenerateCsrAsync(\n    session, Slot.Authentication, \"CN=Test User\", ct);\n\nusing var certificate = result.Certificate;\nif (result.Success && result.CsrPem is { } csrPem)\n{\n    await File.WriteAllTextAsync(\"request.csr\", csrPem, ct);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-395.cs",
      "bytes": 1353,
      "sha256": "efc73b032413dc615d2e1d5814670a4e39810d1b27ef01c8b4f1bc077c328555",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body395\n{\ninternal static async Task CompileOnly(IYubiKey device, IUserPresencePrompt userPresencePrompt, ReadOnlyMemory<byte> pin, ReadOnlyMemory<byte> encryptedBytes, CancellationToken ct)\n{\nvar options = new SessionCreationOptions { UserPresencePrompt = userPresencePrompt };\nawait using var session = await device.CreatePivSessionAsync(options, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Decryption.DecryptDataAsync(\n    session,\n    Slot.KeyManagement,\n    encryptedBytes,\n    cancellationToken: ct);\n\nif (result.Success)\n{\n    var plaintext = result.DecryptedData;\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-396.cs",
      "bytes": 1167,
      "sha256": "8e2df64b66405b49befd64b2cfee0b2f2ee5a4a572971171850f5a453c1d369a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body396\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await DeviceInfoQuery.GetPivRetryInfoAsync(session, ct);\nif (result.Success)\n{\n    Console.WriteLine($\"PIN retries: {result.PinRetriesRemaining}\");\n    Console.WriteLine($\"PUK retries: {result.PukRetriesRemaining}\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-397.cs",
      "bytes": 1333,
      "sha256": "9a94f81bed38573ed155710f84a299643cf08c8e0a903a80eed760e76c3acbb9",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body397\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> managementKey, CancellationToken ct)\n{\n// Requires an authorized target slot and a borrowed active managementKey buffer.\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar result = await KeyGeneration.GenerateKeyAsync(\n    session,\n    Slot.Authentication,\n    KeyType.P256,\n    PinPolicy.Once,\n    TouchPolicy.Cached,\n    ct);\n\nif (result.Success)\n{\n    var publicKeyBytes = result.PublicKey;\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-398.cs",
      "bytes": 1194,
      "sha256": "b56574005cf3cbd178023e2bc31df58a4f161bb8cf0ad6a0a08c20408653fbd3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body398\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar pin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    var result = await PinManagement.VerifyPinAsync(session, pin, ct);\n    if (result.Success)\n    {\n        Console.WriteLine(\"PIN verified\");\n    }\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-399.cs",
      "bytes": 1145,
      "sha256": "24f1bdcb18906fd86c6d30c2acfa7f190079741e8b3a6d98106c9c14bbc6f061",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body399\n{\ninternal static async Task CompileOnly(IPivSession session, CancellationToken ct)\n{\nvar oldPin = Encoding.UTF8.GetBytes(\"123456\");\nvar newPin = Encoding.UTF8.GetBytes(\"654321\");\ntry\n{\n    var result = await PinManagement.ChangePinAsync(session, oldPin, newPin, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(oldPin);\n    CryptographicOperations.ZeroMemory(newPin);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-400.cs",
      "bytes": 1139,
      "sha256": "38a952b3be32fd0a464f0d4891d217a0625ae225d35d8b17434c4ecaa534cc77",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body400\n{\ninternal static async Task CompileOnly(IPivSession session, CancellationToken ct)\n{\nvar puk = Encoding.UTF8.GetBytes(\"12345678\");\nvar newPin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    var result = await PinManagement.UnblockPinAsync(session, puk, newPin, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(puk);\n    CryptographicOperations.ZeroMemory(newPin);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-401.cs",
      "bytes": 1150,
      "sha256": "ceed78e08c6eb9feee77a775a648715be680daf5690e0831c5089302a4b596e6",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body401\n{\ninternal static async Task CompileOnly(IPivSession session, CancellationToken ct)\n{\n// Evaluation only: the session must use the 24-byte factory key with Triple-DES or AES-192.\nvar mgmtKey = PivSession.DefaultManagementKey.ToArray();\ntry\n{\n    var result = await PinManagement.AuthenticateAsync(session, mgmtKey, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(mgmtKey);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-402.cs",
      "bytes": 1375,
      "sha256": "747c3f0f3a7f3b53defa71dd500f4a512dea9cd8c081a9b36e958b3673192e66",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body402\n{\ninternal static async Task CompileOnly(IPivSession session, ReadOnlyMemory<byte> currentKey, ReadOnlyMemory<byte> newKey, CancellationToken ct)\n{\n// currentKey and newKey are caller-owned buffers; securely back up newKey before this task.\n// This example installs a 24-byte Triple-DES key on a compatible device.\nawait session.AuthenticateAsync(currentKey, ct);\nvar result = await PinManagement.ChangeManagementKeyAsync(\n    session, newKey, KeyType.TripleDes, requireTouch: false, cancellationToken: ct);\n// Keep the backup through fresh-session authentication; the caller clears both buffers in finally.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-403.cs",
      "bytes": 1289,
      "sha256": "4d7bb8edbd46a68d05722307cf58805ded7d5156feb4a86fabe4b2cb33ab1323",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body403\n{\ninternal static async Task CompileOnly(IYubiKey device, bool userConfirmedReset, CancellationToken ct)\n{\n// Requires an authorized reset decision; normal reset retains F9 material.\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\n// Ensure user confirms this destructive action\nif (userConfirmedReset)\n{\n    var result = await Reset.ResetPivApplicationAsync(session, ct);\n    if (result.Success)\n    {\n        Console.WriteLine(\"PIV application reset to factory defaults.\");\n    }\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-404.cs",
      "bytes": 1440,
      "sha256": "1412c79e7b4c0a1344a3e34206a557088caea14182995e8f25563035d79f813a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body404\n{\ninternal static async Task CompileOnly(IYubiKey device, IUserPresencePrompt userPresencePrompt, ReadOnlyMemory<byte> pin, ReadOnlyMemory<byte> dataBytes, CancellationToken ct)\n{\nvar options = new SessionCreationOptions { UserPresencePrompt = userPresencePrompt };\n// Requires an application-owned prompt, caller-owned PIN/data and a provisioned P-256/P-384 slot.\nawait using var session = await device.CreatePivSessionAsync(options, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Signing.SignDataAsync(\n    session, \n    Slot.Signature,\n    dataBytes,\n    HashAlgorithmName.SHA256,\n    ct);\n\nif (result.Success)\n{\n    var signature = result.Signature;\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-405.cs",
      "bytes": 1272,
      "sha256": "4c45d8308fe12150d8a531d32108d17ad74e3d5d7745c5f4b04291ede46d933c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body405\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await SlotInfoQuery.GetAllSlotsInfoAsync(session, ct);\ntry\n{\n    if (result.Success)\n    {\n        foreach (var slot in result.Slots)\n            Console.WriteLine($\"{slot.Name}: Key={slot.HasKey}, Cert={slot.HasCertificate}\");\n    }\n}\nfinally\n{\n    foreach (var slot in result.Slots)\n        slot.Certificate?.Dispose();\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-406.cs",
      "bytes": 1260,
      "sha256": "a66fd79a033e9dc1eb8ad34af884f090e23df4a1f4b024e6eb28426aed1aa47c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body406\n{\ninternal static async Task CompileOnly(IYubiKey device, ReadOnlyMemory<byte> originalData, ReadOnlyMemory<byte> signatureBytes, CancellationToken ct)\n{\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Verification.VerifySignatureAsync(\n    session,\n    Slot.Signature,\n    originalData,\n    signatureBytes,\n    HashAlgorithmName.SHA256,\n    ct);\n\nif (result.Success && result.IsValid)\n{\n    Console.WriteLine(\"Signature is valid!\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-409.cs",
      "bytes": 1286,
      "sha256": "6d1197c999dc9b80e2c80a1f52370f7ac9e05fec126a40918b96bc7bcc8627b5",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body409\n{\ninternal static async Task CompileOnly(IPivSession session)\n{\n// Requires an open session, firmware 5.3+ and a provisioned RSA slot.\nvar metadata = await session.GetSlotMetadataAsync(Slot.Authentication)\n    ?? throw new InvalidOperationException(\"Provision an RSA key first.\");\nusing var rsa = metadata.GetRsaPublicKey();\nbyte[] plaintext = \"example\"u8.ToArray();\ntry\n{\n    byte[] ciphertext = rsa.Encrypt(plaintext, RSAEncryptionPadding.OaepSHA256);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(plaintext);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-410.cs",
      "bytes": 1167,
      "sha256": "05c448c05e57eb162caf6bc3b9c30cb7fed7da8861caa5549054d8fbf226780d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body410\n{\ninternal static async Task CompileOnly(IPivSession session)\n{\n// Requires an open session, firmware 5.3+ and a provisioned P-256/P-384 slot.\nvar metadata = await session.GetSlotMetadataAsync(Slot.Authentication)\n    ?? throw new InvalidOperationException(\"Provision an EC key first.\");\nusing var ecdsa = metadata.GetECDsaPublicKey();\n// The host object is now available for signature verification.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-411.cs",
      "bytes": 1437,
      "sha256": "299d077a8024872f1e46df48356a066ede9f9549d4cf9524b6d16501225d7e5c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Piv.Examples.PivTool.PivExamples;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body411\n{\ninternal static async Task CompileOnly(IYubiKey key, ReadOnlyMemory<byte> pin, ReadOnlyMemory<byte> digest, CancellationToken ct)\n{\n    await using var piv = await key.CreatePivSessionAsync(cancellationToken: ct);\n    await piv.VerifyPinAsync(pin, ct);\n    try\n    {\n        await key.GetDeviceInfoAsync(cancellationToken: ct);\n        throw new InvalidOperationException(\"Expected the ownership guard to reject the second connection.\");\n    }\n    catch (ConnectionInUseException)\n    {\n        Memory<byte> signature = await piv.SignOrDecryptAsync(Slot.Authentication, KeyType.P256, digest, ct);\n        CryptographicOperations.ZeroMemory(signature.Span);\n    }\n    \n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-412.cs",
      "bytes": 1812,
      "sha256": "17a6120fa366ca2732bb9904510b4cbb974752e3ba3a5db2d719357af537e1e9",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body412\n{\n    // The caller supplies an open connection, an applet-specific header, and owned payload bytes.\n    // This helper borrows the connection and consumes the payload, clearing it even if creation fails.\n    static async Task<short> SendAndClearAsync(\n        Yubico.YubiKit.Core.Transports.SmartCard.ISmartCardConnection connection,\n        byte cla, byte ins, byte p1, byte p2, byte[] payload, CancellationToken ct)\n    {\n        try\n        {\n            await using var session = await Yubico.YubiKit.Core.Sessions.RawSmartCardSession.CreateAsync(connection, ct);\n            var command = new ApduCommand(cla, ins, p1, p2, payload);\n            var response = await session.TransmitAndReceiveAsync(command, throwOnError: false, cancellationToken: ct);\n            try\n            {\n                return response.SW; // Inspect status before clearing the response owner.\n            }\n            finally\n            {\n                response.Clear();\n            }\n        }\n        finally\n        {\n            System.Security.Cryptography.CryptographicOperations.ZeroMemory(payload);\n        }\n    }\n    \n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-413.cs",
      "bytes": 1452,
      "sha256": "a1786bce37727b1b546799c2f6e5add6420d87655ba756367142dcb132688b89",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body413\n{\nstatic async Task SelectPivAsync(IYubiKey device, CancellationToken cancellationToken)\n{\n    // Returning the connection itself exposes its ownership to the enclosing scope.\n    await using IConnection connection = await device.CreateSessionOverTransportAsync(\n        ConnectionType.SmartCard,\n        (opened, token) => Task.FromResult(opened),\n        cancellationToken);\n    await using RawSmartCardSession session = await RawSmartCardSession.CreateAsync(\n        (ISmartCardConnection)connection, cancellationToken);\n    await session.SelectAsync(ApplicationIds.Piv, cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-414.cs",
      "bytes": 985,
      "sha256": "cf8ed08052eca256053230fe6ea3b5c1e4ed5b16504b7afb94ab32c452037c40",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body414\n{\ninternal static async Task CompileOnly()\n{\n// Explicit compatibility opt-in, before any discovery or monitoring:\nSmartCardConnectionFactory.DefaultSharing = SmartCardSharing.ExclusiveWithSharedFallback;\nvar devices = await YubiKeyManager.FindAllAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-415.cs",
      "bytes": 1342,
      "sha256": "b9de50ef506bd98c0d8eb92e2c744307a916e661e2cb6b900cb798246d872bb3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body415\n{\nstatic async Task SelectPivSharedAsync(IPcscDevice reader, CancellationToken cancellationToken)\n{\n    // Coordinate discovery/monitoring and other connections before this direct open.\n    var factory = new SmartCardConnectionFactory(SmartCardSharing.Shared);\n    await using ISmartCardConnection connection = await factory.CreateAsync(reader, cancellationToken);\n    await using RawSmartCardSession session =\n        await RawSmartCardSession.CreateAsync(connection, cancellationToken);\n    await session.SelectAsync(ApplicationIds.Piv, cancellationToken);\n}\n}\n"
    },
