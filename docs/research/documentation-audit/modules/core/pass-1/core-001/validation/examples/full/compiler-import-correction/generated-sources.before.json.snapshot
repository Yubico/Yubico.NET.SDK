    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-241.cs",
      "bytes": 1057,
      "sha256": "76e096b28aa878c4fd440296bc80bdc1f185c38e53c5be61ba512c84a23e78fa",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test241;\npublic sealed class DocumentationBody241\n{\n[SkippableTheory]\n[WithYubiKey(\n    MinFirmware = \"5.3.0\",\n    Capability = DeviceCapabilities.Piv,\n    RequireUsb = true)]\npublic async Task ReadMetadata_ForMatchingKey(YubiKeyTestState state)\n{\n    await state.WithManagementAsync(async (mgmt, _) =>\n    {\n        var info = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(state.SerialNumber, info.SerialNumber);\n    });\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-242.cs",
      "bytes": 903,
      "sha256": "b07953f11c061900afb31888c933d78467c0d743774283190d2553fdeb4797f1",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test242;\npublic sealed class DocumentationBody242\n{\n[SkippableTheory]\n[WithYubiKey]\npublic async Task FirstMatchingKey_ReturnsSameSerial(YubiKeyTestState state)\n{\n    var info = await state.Device.GetDeviceInfoAsync();\n    Assert.Equal(state.SerialNumber, info.SerialNumber);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-243.cs",
      "bytes": 1122,
      "sha256": "d2084d45cd2992bc83d3686332be355cbe8432ec406d847360b72d18f51b5eb1",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test243;\npublic sealed class DocumentationBody243\n{\n[SkippableTheory]\n[WithYubiKey(FormFactor = FormFactor.UsbAKeychain)]\n[WithYubiKey(FormFactor = FormFactor.UsbCKeychain)]\n[WithYubiKey(FormFactor = FormFactor.UsbABiometricKeychain)]\npublic async Task MultiFormFactor_Test(YubiKeyTestState state)\n{\n    // Three independently bound rows; each row requires its attribute's form factor.\n    var info = await state.Device.GetDeviceInfoAsync();\n    Assert.Equal(state.FormFactor, info.FormFactor);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-244.cs",
      "bytes": 1235,
      "sha256": "061334440222e4d7921a0cc1ca258228d408315efcab8159aa9b0bb4892075d7",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test244;\npublic sealed class DocumentationBody244\n{\npublic void CompileOnly(YubiKeyTestState state)\n{\n    // Composable fragment inside a test receiving YubiKeyTestState state.\n    int? serial = state.SerialNumber;\n    FirmwareVersion fw = state.FirmwareVersion;\n    FormFactor form = state.FormFactor;\n    bool isUsb = state.IsUsbTransport;\n    bool isNfc = state.IsNfcTransport;\n    IYubiKey device = state.Device;\n    \n    // Capability checks\n    bool hasPiv = state.HasCapability(DeviceCapabilities.Piv);\n    \n    // Firmware version checks\n    bool isModern = state.FirmwareVersion.IsAtLeast(5, 3, 0);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-252.cs",
      "bytes": 1115,
      "sha256": "c1869edeffc021faf463619bd06cd772edfbd7c1b521857b07677ec98b595bc8",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test252;\npublic sealed class DocumentationBody252\n{\npublic async Task CompileOnly(YubiKeyTestState state)\n{\n// Session helper: automatic cleanup and cached device info.\nawait state.WithManagementAsync(async (mgmt, deviceInfo) =>\n{\n    var freshInfo = await mgmt.GetDeviceInfoAsync();\n    Assert.Equal(deviceInfo.SerialNumber, freshInfo.SerialNumber);\n});\n\n// A one-shot alternative, after the helper's session has been disposed:\nvar oneShotInfo = await state.Device.GetDeviceInfoAsync();\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-253.cs",
      "bytes": 1155,
      "sha256": "6046f4c809f891a4bb3457338d2bdd7ad071cb87dd36c1f9acf296968c7e6c5b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test253;\npublic sealed class DocumentationBody253\n{\n[SkippableTheory]\n[WithYubiKey(MinFirmware = \"5.0.0\")]\npublic async Task MyTest(YubiKeyTestState state) =>\n    await state.WithManagementAsync(async (mgmt, cachedDeviceInfo) =>\n    {\n        // mgmt = ManagementSession (already initialized)\n        // cachedDeviceInfo = shared test-state snapshot, not a query at helper entry\n        \n        var freshInfo = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(cachedDeviceInfo.SerialNumber, freshInfo.SerialNumber);\n    });\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-254.cs",
      "bytes": 1096,
      "sha256": "5b265795e2db6a1d5245632d02fca1c8ee15f82fea6c2fbdb151886c17278102",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test254;\npublic sealed class DocumentationBody254\n{\n[SkippableTheory]\n[WithYubiKey]\npublic async Task GetDeviceInfo_ReturnsValidData(YubiKeyTestState state) =>\n    await state.WithManagementAsync(async (mgmt, cachedInfo) =>\n    {\n        var info = await mgmt.GetDeviceInfoAsync();\n        \n        Assert.True(info.SerialNumber > 0);\n        Assert.Equal(state.SerialNumber, info.SerialNumber);\n        Assert.Equal(state.FirmwareVersion, info.FirmwareVersion);\n    });\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-255.cs",
      "bytes": 1291,
      "sha256": "ce96ff7e9f4823ffb25d76b75add839b4e734829064519f2e32ad5d079c5d7f6",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test255;\npublic sealed class DocumentationBody255\n{\n[SkippableTheory]\n[WithYubiKey(MinFirmware = \"5.7.0\")]\npublic async Task DeviceInfo_Firmware57Plus_HasVersionDisplay(YubiKeyTestState state) =>\n    await state.WithManagementAsync(async (mgmt, cachedInfo) =>\n    {\n        // This test only runs on firmware >= 5.7.0\n        Assert.True(state.FirmwareVersion.IsAtLeast(5, 7, 0));\n        \n        // Check the reported display value, not generic firmware feature support.\n        var info = await mgmt.GetDeviceInfoAsync();\n        Assert.False(string.IsNullOrWhiteSpace(info.VersionName));\n        Assert.Equal(cachedInfo.SerialNumber, info.SerialNumber);\n    });\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-256.cs",
      "bytes": 1281,
      "sha256": "2fc267efcb1078ae2fb385e0842bb4a05dc148ef697ada24c8c3dd3a1d984b40",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test256;\npublic sealed class DocumentationBody256\n{\n[SkippableTheory]\n[WithYubiKey(FormFactor = FormFactor.UsbABiometricKeychain)]\npublic async Task BioFormFactor_MetadataMatchesCache(YubiKeyTestState state)\n{\n    Assert.Equal(FormFactor.UsbABiometricKeychain, state.FormFactor);\n    \n    await state.WithManagementAsync(async (mgmt, cachedInfo) =>\n    {\n        var info = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(FormFactor.UsbABiometricKeychain, info.FormFactor);\n        \n        // Metadata checks only; this does not exercise biometric operations or prove MPE eligibility.\n        Assert.True(info.FirmwareVersion.Major >= 5);\n    });\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-257.cs",
      "bytes": 1269,
      "sha256": "e22c68c0797eee38860d98ac0b24704bfa11dca003fa28f6571a372f534fa9b8",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test257;\npublic sealed class DocumentationBody257\n{\n[SkippableTheory]\n[WithYubiKey(Capability = DeviceCapabilities.Piv)]\npublic async Task PivCapability_EnabledDevices_Accessible(YubiKeyTestState state)\n{\n    Assert.True(state.HasCapability(DeviceCapabilities.Piv));\n    \n    await state.WithManagementAsync(async (mgmt, cachedInfo) =>\n    {\n        var info = await mgmt.GetDeviceInfoAsync();\n        \n        // Verify PIV is enabled on USB or NFC\n        bool pivEnabled = (info.UsbEnabled & DeviceCapabilities.Piv) != 0 ||\n                         (info.NfcEnabled & DeviceCapabilities.Piv) != 0;\n        Assert.True(pivEnabled);\n    });\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-258.cs",
      "bytes": 1474,
      "sha256": "7f39bfa277f7d505f64fe21fea50f9bbb04058d2855a10d6eeddd2f50c16548d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test258;\npublic sealed class DocumentationBody258\n{\n[SkippableTheory]\n[WithYubiKey(\n    MinFirmware = \"5.0.0\",\n    RequireUsb = true,\n    Capability = DeviceCapabilities.Piv)]\npublic async Task AdvancedFiltering_ModernUsbPiv_Works(YubiKeyTestState state)\n{\n    // Multiple requirements enforced by attribute:\n    Assert.True(state.FirmwareVersion.IsAtLeast(5, 0, 0));\n    Assert.True(state.IsUsbTransport);\n    Assert.True(state.HasCapability(DeviceCapabilities.Piv));\n    \n    await state.WithManagementAsync(async (mgmt, cachedInfo) =>\n    {\n        var info = await mgmt.GetDeviceInfoAsync();\n        \n        // RequireUsb and Capability are independent: PIV may be enabled over USB OR NFC.\n        Assert.True(info.FirmwareVersion.Major >= 5);\n        Assert.True(((info.UsbEnabled | info.NfcEnabled) & DeviceCapabilities.Piv) != 0);\n    });\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-259.cs",
      "bytes": 1858,
      "sha256": "89f11aa6b35f5e3e0997d78c3ab7630ee493567c48e709b0339265a64b6c87d4",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test259;\npublic sealed class DocumentationBody259\n{\n[SkippableTheory]\n[WithYubiKey(ConnectionType = ConnectionType.SmartCard, MinFirmware = \"5.0.0\")]\npublic async Task AutoEject_PersistsAndRestorationIsAttempted(YubiKeyTestState state)\n{\n    await using var mgmt = await state.Device.CreateManagementSessionAsync(\n        new SessionCreationOptions { PreferredConnectionType = ConnectionType.SmartCard });\n    var original = await mgmt.GetDeviceInfoAsync();\n    Assert.False(original.IsLocked); // Example prerequisite: unlocked dedicated test key.\n    Assert.InRange(original.AutoEjectTimeout, (ushort)0, (ushort)3600); // Must be restorable through this SDK.\n    ushort changed = original.AutoEjectTimeout == 30 ? (ushort)31 : (ushort)30;\n    try\n    {\n        await mgmt.SetDeviceConfigAsync(new DeviceConfig { AutoEjectTimeout = changed });\n        var persisted = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(changed, persisted.AutoEjectTimeout);\n    }\n    finally\n    {\n        await mgmt.SetDeviceConfigAsync(new DeviceConfig { AutoEjectTimeout = original.AutoEjectTimeout });\n        var restored = await mgmt.GetDeviceInfoAsync();\n        Assert.Equal(original.AutoEjectTimeout, restored.AutoEjectTimeout);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-260.cs",
      "bytes": 1217,
      "sha256": "c5d8127df281d281cb706d0cd261194eb1d604f6c80e90cd8503d9db26ad40ce",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test260;\npublic sealed class DocumentationBody260\n{\npublic async Task CompileOnly(YubiKeyTestState state)\n{\nawait state.WithManagementAsync(async (mgmt, cachedDeviceInfo) =>\n{\n    // cachedDeviceInfo comes from shared device initialization, not helper entry.\n    // Use it instead of re-querying if data hasn't changed\n    \n    var serial = cachedDeviceInfo.SerialNumber; // \u2705 Fast\n    \n    // Only query again if testing consistency\n    var freshInfo = await mgmt.GetDeviceInfoAsync(); // \u26a0\ufe0f APDU overhead\n    Assert.Equal(cachedDeviceInfo.SerialNumber, freshInfo.SerialNumber);\n});\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-261.cs",
      "bytes": 1045,
      "sha256": "9dfab861dc1e610b9a4be22396b979d2bc065d49eb93ef3d713a430fd9939804",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test261;\npublic sealed class DocumentationBody261\n{\npublic async Task CompileOnly(YubiKeyTestState state)\n{\nawait state.WithManagementAsync(async (mgmt, info) =>\n{\n    // Multiple operations in one session\n    var info1 = await mgmt.GetDeviceInfoAsync();\n    var info2 = await mgmt.GetDeviceInfoAsync();\n    var info3 = await mgmt.GetDeviceInfoAsync();\n    \n    // More efficient than creating 3 separate sessions\n});\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/injections/Management.IntegrationTests/FULL-262.cs",
      "bytes": 899,
      "sha256": "e1c15de3c16e5fa2c31a03d9fd2f5320de55e18e9e4f8f15c50b84b692a10f13",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.Linq;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Xunit;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Tests.Shared;\nusing Yubico.YubiKit.Tests.Shared.Infrastructure;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.Test262;\npublic sealed class DocumentationBody262\n{\npublic async Task CompileOnly(ManagementSession mgmt)\n{\nvar info1 = await mgmt.GetDeviceInfoAsync();\nvar info2 = await mgmt.GetDeviceInfoAsync();\nAssert.Equal(info1.SerialNumber, info2.SerialNumber); // Value comparison\n}\n}\n"
