      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-047.cs",
      "bytes": 1716,
      "sha256": "ec0a44f8d068534f23cd55575e0930fc74368595143835769657129a3c63111c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\nusing Yubico.YubiKit.WebAuthn.Extensions.PreviewSign;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body47\n{\ninternal static WebAuthnClient CompileOnly(ICtap2Session ctap2Session, WebAuthnOrigin origin)\n{\nreturn // After\nnew WebAuthnClient(\n    ctap2Session,\n    origin,\n    new WebAuthnClientOptions\n    {\n        RpIdValidator = (requestOrigin, rpId) =>\n            requestOrigin.StringValue == \"https://example.com\" && rpId == \"example.com\"\n    });\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-049.cs",
      "bytes": 1456,
      "sha256": "182d8a274d5b5d1807a1853acae4b1154d26b564815acadd4a6f147b4595683b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body49\n{\n// \u2705 BEST - Small, immutable, value semantics\npublic readonly struct StatusWord\n{\n    public StatusWord(byte sw1, byte sw2) => (SW1, SW2) = (sw1, sw2);\n    \n    public byte SW1 { get; }\n    public byte SW2 { get; }\n    public ushort Value => (ushort)((SW1 << 8) | SW2);\n    \n    public bool IsSuccess => Value == 0x9000;\n}\n\n// \u2705 GOOD - Wraps small data\npublic readonly struct SlotNumber\n{\n    public SlotNumber(byte value) => Value = value;\n    public byte Value { get; }\n}\n\n// \u2705 GOOD - Protocol metadata\npublic readonly struct ApduHeader\n{\n    public ApduHeader(byte cla, byte ins, byte p1, byte p2)\n    {\n        CLA = cla;\n        INS = ins;\n        P1 = p1;\n        P2 = p2;\n    }\n    \n    public byte CLA { get; }\n    public byte INS { get; }\n    public byte P1 { get; }\n    public byte P2 { get; }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-053.cs",
      "bytes": 2535,
      "sha256": "e4beac1ea8a1cf2d71752c0ac01e50d3ca159dfead5e28879e13a1100a294e20",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body53\n{\n// \u2705 BEST - Small, immutable, value semantics\npublic readonly struct StatusWord\n{\n    public StatusWord(byte sw1, byte sw2) => (SW1, SW2) = (sw1, sw2);\n    \n    public byte SW1 { get; }\n    public byte SW2 { get; }\n    public ushort Value => (ushort)((SW1 << 8) | SW2);\n    \n    public bool IsSuccess => Value == 0x9000;\n}\n\n// \u2705 GOOD - Wraps small data\npublic readonly struct SlotNumber\n{\n    public SlotNumber(byte value) => Value = value;\n    public byte Value { get; }\n}\n\n// \u2705 GOOD - Protocol metadata\npublic readonly struct ApduHeader\n{\n    public ApduHeader(byte cla, byte ins, byte p1, byte p2)\n    {\n        CLA = cla;\n        INS = ins;\n        P1 = p1;\n        P2 = p2;\n    }\n    \n    public byte CLA { get; }\n    public byte INS { get; }\n    public byte P1 { get; }\n    public byte P2 { get; }\n}\n// \u2705 CommandApdu - Use readonly struct if small OR class if contains byte[]\n// Option A: Small header-only commands\npublic readonly struct CommandApduHeader\n{\n    public CommandApduHeader(byte cla, byte ins, byte p1, byte p2)\n    {\n        CLA = cla; INS = ins; P1 = p1; P2 = p2;\n    }\n    \n    public byte CLA { get; }\n    public byte INS { get; }\n    public byte P1 { get; }\n    public byte P2 { get; }\n}\n\n// Option B: Full APDU with data - use class (contains byte array)\npublic sealed class CommandApdu\n{\n    private readonly ReadOnlyMemory<byte> _data;\n    \n    public CommandApdu(ReadOnlySpan<byte> data)\n    {\n        _data = data.ToArray();\n    }\n    \n    public ReadOnlySpan<byte> AsSpan() => _data.Span;\n}\n\n// \u2705 ResponseApdu - Class (contains byte array)\npublic sealed class ResponseApdu\n{\n    private readonly ReadOnlyMemory<byte> _data;\n    \n    public ResponseApdu(ReadOnlySpan<byte> data)\n    {\n        _data = data.ToArray();\n    }\n    \n    public ReadOnlySpan<byte> Data => _data.Span[..^2];\n    public StatusWord SW => new(_data.Span[^2], _data.Span[^1]);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-066.cs",
      "bytes": 1176,
      "sha256": "f96c36e5045a4d19ac8fab1f00e508df64953b14920188a584c42f017188884e",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Devices;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body66\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nConsole.WriteLine($\"Serial {device.SerialNumber}: {device.AvailableConnections}\");\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-067.cs",
      "bytes": 1520,
      "sha256": "5d09adb03dee6b94d4fc25b12dda3db085336a3187569c9bc10d8c0defa0bddc",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body67\n{\ninternal static void CompileOnly(ReadOnlySpan<byte> inputData, ReadOnlySpan<byte> key, ReadOnlySpan<byte> data, Span<byte> plaintext, ReadOnlySpan<byte> iv, Span<byte> ciphertext)\n{\n// Hashing\nSpan<byte> hash = stackalloc byte[32];\nSHA256.HashData(inputData, hash);\n\n// HMAC\nSpan<byte> hmac = stackalloc byte[32];\nHMACSHA256.HashData(key, data, hmac);\n\n// Random\nSpan<byte> random = stackalloc byte[16];\nRandomNumberGenerator.Fill(random);\n\n// AES\nusing var aes = Aes.Create();\naes.EncryptCbc(plaintext, iv, ciphertext, PaddingMode.PKCS7);\naes.DecryptCbc(ciphertext, iv, plaintext, PaddingMode.PKCS7);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-068.cs",
      "bytes": 1075,
      "sha256": "bad13e2b6cb603ca0d12883257c61b23c209a7abd6f56794070666cfbf5931fb",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body68\n{\ninternal static void CompileOnly(ReadOnlySpan<byte> data)\n{\n// \u2705 NEW - zero allocation\nSpan<byte> hash = stackalloc byte[32];\nSHA256.HashData(data, hash);\n}\n\n}\n"
    },
