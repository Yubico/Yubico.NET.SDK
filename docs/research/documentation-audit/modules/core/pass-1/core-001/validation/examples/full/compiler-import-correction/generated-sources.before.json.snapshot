      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body98\n{\ninternal static void CompileOnly(string[] args)\n{\nusing var host = Host.CreateDefaultBuilder(args)  // Loads appsettings.json\n    .Build();\n\nYubiKitLogging.Configure(host.Services.GetRequiredService<ILoggerFactory>());\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-099.cs",
      "bytes": 1546,
      "sha256": "4c6479aeb33d37fbf86c433a64d653c1aa3da745c7c5d519fd9bcc8ed156bbfa",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Apdu;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Transports.Hid;\nusing Yubico.YubiKit.Management;\nusing Yubico.YubiKit.Piv;\nusing Yubico.YubiKit.Oath;\nusing Microsoft.Extensions.Logging;\nusing Microsoft.Extensions.Hosting;\nusing Microsoft.Extensions.DependencyInjection;\nusing Microsoft.AspNetCore.Builder;\nusing Serilog;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body99\n{\ninternal static void CompileOnly()\n{\nLog.Logger = new LoggerConfiguration()\n    .MinimumLevel.Debug()\n    .MinimumLevel.Override(\"Yubico.YubiKit\", Serilog.Events.LogEventLevel.Verbose)\n    .WriteTo.Console()\n    .WriteTo.File(\"yubikit.log\", rollingInterval: RollingInterval.Day)\n    .CreateLogger();\n\nusing var host = Host.CreateDefaultBuilder()\n    .UseSerilog()\n    .Build();\n\nYubiKitLogging.Configure(host.Services.GetRequiredService<ILoggerFactory>());\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-100.cs",
      "bytes": 1072,
      "sha256": "dde67527e4b0fa9783d03a973e3e4cb75b196d476d796c8ca2844e9d7668b129",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Piv;\nusing Microsoft.Extensions.Logging;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Devices;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body100\n{\nstatic async Task DiscoverWithTemporaryLoggingAsync(\n    ILoggerFactory loggerFactory, CancellationToken cancellationToken)\n{\n    using var _ = YubiKitLogging.UseTemporary(loggerFactory);\n    await YubiKeyManager.FindAllAsync(cancellationToken: cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-101.cs",
