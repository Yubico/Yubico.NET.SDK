    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-081.cs",
      "bytes": 959,
      "sha256": "764b77e2da59194c77b76d4493213dd92d625f85228a485f59faf4204850fde0",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Devices;\nnamespace Audit20261111.DocExamples.External81;\ninternal static class Body\n{\ninternal static async Task CompileOnly(CancellationToken cancellationToken)\n{\nvar devices = await YubiKeyManager.FindAllAsync(\n    ConnectionType.All,\n    cancellationToken: cancellationToken);\nvar device = devices.First();\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-083.cs",
      "bytes": 1186,
      "sha256": "f5922156e681df5b30455e08be9a8414b6eb8e0855c31c28983136fdb9048ff2",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Management;\nnamespace Audit20261111.DocExamples.External83;\ninternal static class Body\n{\ninternal static async Task CompileOnly(CancellationToken cancellationToken)\n{\nvar device = await YubiKeyManager.FindFirstAsync(cancellationToken: cancellationToken);\nawait using var session = await device.CreateManagementSessionAsync(\n    cancellationToken: cancellationToken);\n\nvar info = await session.GetDeviceInfoAsync(cancellationToken);\nConsole.WriteLine(info.SerialNumber);\nConsole.WriteLine(info.VersionName);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-085.cs",
      "bytes": 922,
      "sha256": "73fb777a8099f5f60c4609a4e53bf22898fec62d4b7d69bbd0db90dc7749ae55",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Piv;\nnamespace Audit20261111.DocExamples.External85;\ninternal static class Body\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var piv = await device.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-087.cs",
      "bytes": 1557,
      "sha256": "2f3911ca63c3f177a5ab010dfea471bc5d008bbbf11f030f02f367f970f6293c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing System.Security.Cryptography;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\nnamespace Audit20261111.DocExamples.External87;\ninternal static class Body\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var piv = await device.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\n\n// Evaluation only: the installed active key must be this 24-byte factory value.\nbyte[] managementKey = PivSession.DefaultManagementKey.ToArray();\ntry\n{\n    await piv.AuthenticateAsync(managementKey, cancellationToken);\n\n    var publicKey = await piv.GenerateKeyAsync(\n        Slot.Authentication,\n        KeyType.P256,\n        new KeyCreationOptions\n        {\n            PinPolicy = PinPolicy.Default,\n            TouchPolicy = TouchPolicy.Default\n        },\n        cancellationToken);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey);\n}\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-089.cs",
      "bytes": 932,
      "sha256": "adb0c3c80d5cb98f9361e6ef0ac1f58dc18b0cbfe7cd0e04c30d06a3edcff804",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2;\nnamespace Audit20261111.DocExamples.External89;\ninternal static class Body\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nvar info = await device.GetCtap2InfoAsync(cancellationToken: cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-090.cs",
      "bytes": 983,
      "sha256": "687d77382b08e377cd433ff33b7eb58f3b6688be03843705f2e99f7f11ef71af",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Ctap2;\nnamespace Audit20261111.DocExamples.External90;\ninternal static class Body\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var fido = await device.CreateCtap2SessionAsync(\n    cancellationToken: cancellationToken);\n\nvar info = await fido.GetInfoAsync(cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-092.cs",
      "bytes": 1264,
      "sha256": "e2831fbabf124a8f1a20c4949b85cf5dc5ca300be2ec708e744ed976763d777b",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Oath;\nnamespace Audit20261111.DocExamples.External92;\ninternal static class Body\n{\ninternal static async Task CompileOnly(IYubiKey device, CancellationToken cancellationToken)\n{\nawait using var oath = await device.CreateOathSessionAsync(\n    cancellationToken: cancellationToken);\n\nusing var credentialData = CredentialData.ParseUri(\n    \"otpauth://totp/Yubico:alice@example.com?secret=JBSWY3DPEHPK3PXP&issuer=Yubico&algorithm=SHA1&digits=6&period=30\");\n\nawait oath.PutCredentialAsync(credentialData, cancellationToken: cancellationToken);\nvar codes = await oath.CalculateAllAsync(cancellationToken: cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-093.cs",
      "bytes": 1016,
      "sha256": "19cf6e25fe19bfcf87b52099bb2d18dee74be763a2c081d542fa237f67bfa53a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nnamespace Audit20261111.DocExamples.External93;\ninternal static class Body\n{\ninternal static async Task CompileOnly(Yubico.YubiKit.Oath.CredentialData credentialData)\n{\nbyte[] copy = credentialData.Secret.ToArray();\ntry\n{\n    // Pass copy to the array-only consumer; await completion before clearing it.\n}\nfinally\n{\n    System.Security.Cryptography.CryptographicOperations.ZeroMemory(copy);\n}\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-095.cs",
      "bytes": 2005,
      "sha256": "8e9e16180e86a02ea11e0b5d4155a6168cc09446e50a0c3e2b5e089b4c25c5af",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing System;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.YubiOtp;\nnamespace Audit20261111.DocExamples.External95;\ninternal static class Body\n{\ninternal static async Task CompileOnly(IYubiKey device, byte[] hmacKey, byte[] challenge, CancellationToken cancellationToken)\n{\nReadOnlyMemory<byte> response = default;\ntry\n{\n    await using var otp = await device.CreateYubiOtpSessionAsync(\n        new SessionCreationOptions { PreferredConnectionType = ConnectionType.HidOtp },\n        cancellationToken);\n    using var config = new HmacSha1SlotConfiguration(hmacKey);\n    config.UseShortChallenge();\n\n    await otp.PutConfigurationAsync(\n        Slot.Two,\n        config,\n        cancellationToken: cancellationToken);\n\n    response = await otp.CalculateHmacSha1Async(\n        Slot.Two,\n        challenge,\n        cancellationToken);\n    // Consume the caller-owned response with your verifier; do not log it.\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(hmacKey);\n    CryptographicOperations.ZeroMemory(challenge);\n    // This is the documented caller-owned SDK output, not arbitrary borrowed read-only memory.\n    CryptographicOperations.ZeroMemory(MemoryMarshal.AsMemory(response).Span);\n}\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-097.cs",
      "bytes": 1272,
      "sha256": "8196e90039e4c7a8511bac33472d99ffcb6c9c65b8b50774fa299c93173a6339",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Piv;\nnamespace Audit20261111.DocExamples.External97;\ninternal static class Body\n{\nstatic async Task EnableProtectedAdministrationAsync(\n    IYubiKey device,\n    ReadOnlyMemory<byte> pin,\n    ReadOnlyMemory<byte> activeManagementKey,\n    CancellationToken cancellationToken)\n{\n    await using var piv = await device.CreatePivSessionAsync(cancellationToken: cancellationToken);\n    await piv.AuthenticateAsync(activeManagementKey, cancellationToken);\n    await piv.SetPinOnlyModeAsync(\n        PinOnlyMode.PinProtected,\n        pin,\n        activeManagementKey,\n        cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/EXT-099.cs",
      "bytes": 1518,
      "sha256": "bf6f62ddb797020e7ec68c4035cd699e787b47bfd1efdad12dc6f66d4b414f30",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing System;\nusing System.Security.Cryptography;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Oath;\nnamespace Audit20261111.DocExamples.External99;\ninternal static class Body\n{\nstatic async Task ReadCodesAsync(\n    IYubiKey device,\n    byte[] ownedPassword,\n    CancellationToken cancellationToken)\n{\n    try\n    {\n        await using var oath = await device.CreateOathSessionAsync(\n            cancellationToken: cancellationToken);\n\n        var codes = await oath.AuthenticateAndRetryAsync(\n            ct => oath.CalculateAllAsync(cancellationToken: ct),\n            _ => Task.FromResult<ReadOnlyMemory<byte>>(ownedPassword),\n            cancellationToken);\n        Console.WriteLine($\"Returned {codes.Count} credential entries.\");\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(ownedPassword);\n    }\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-002.cs",
      "bytes": 1172,
      "sha256": "88e838aedf4b9e1ec2f04519487294532911e23a2e51c94400973027512d5348",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body2\n{\ninternal static async Task CompileOnly(IYubiKey yubiKey)\n{\n// With IYubiKey yubiKey in an async method; this factory owns the opened connection.\nawait using var session = await yubiKey.CreateCtap2SessionAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-003.cs",
      "bytes": 1343,
      "sha256": "cd5084bac6cac38d36bd6a6f4aad31c6fbb01c73a8c1d946cee37f9c24574321",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body3\n{\ninternal static async Task CompileOnly(ICtap2Session session)\n{\n// Get authenticator capabilities\nvar info = await session.GetInfoAsync();\n\n// Check versions\nbool ctap2_1 = info.Versions.Contains(\"FIDO_2_1\");\n\n// Check supported extensions\nbool hasHmacSecret = info.Extensions.Contains(\"hmac-secret\");\n\n// Check options\nbool hasRk = info.Options.TryGetValue(\"rk\", out var rk) && rk;\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-004.cs",
      "bytes": 2466,
      "sha256": "ea4fc078cf31dcaf0aee80111590fe921f6018aa451a8631d280eccbcf7390d6",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body4\n{\ninternal static async Task CompileOnly(ICtap2Session session, byte[] pin, string rpId, byte[] clientDataHash, MakeCredentialOptions options, PublicKeyCredentialRpEntity rp, PublicKeyCredentialUserEntity user, CancellationToken cancellationToken)\n{\n// Fragment: session, byte[] pin, string rpId, byte[32] clientDataHash,\n// MakeCredentialOptions options, RP/user entities and CancellationToken cancellationToken are supplied.\n// Requires mutually supported protocol 2; this constructor does not negotiate it.\nusing var protocol = new PinUvAuthProtocolV2();\nusing var clientPin = new ClientPin(session, protocol);\n\n// Get PIN token with permissions. rpId is required for MakeCredential/GetAssertion permissions.\nbyte[]? pinToken = null;\nbyte[]? authParam = null;\ntry\n{\n    pinToken = await clientPin.GetPinUvAuthTokenUsingPinAsync(\n        pin,\n        PinUvAuthTokenPermissions.MakeCredential,\n        rpId,\n        cancellationToken);\n\n    // Authenticate command\n    authParam = protocol.Authenticate(pinToken, clientDataHash);\n    options.WithPinUvAuth(authParam, protocol.Version);\n    // Keep options.UserVerification null; even uv:false is mutually exclusive with token auth.\n    await session.MakeCredentialAsync(\n        clientDataHash, rp, user, [PublicKeyCredentialParameters.CreateES256()], options,\n        cancellationToken);\n}\nfinally\n{\n    if (pinToken is not null) CryptographicOperations.ZeroMemory(pinToken);\n    if (authParam is not null) CryptographicOperations.ZeroMemory(authParam);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-005.cs",
      "bytes": 1841,
      "sha256": "142535a904772c13a7e9df99900ad064ac278269a01efaa6a9f210b2d7508133",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body5\n{\ninternal static void CompileOnly(ReadOnlyMemory<byte> blobData, IPinUvAuthProtocol protocol, byte[] sharedSecret, IReadOnlyDictionary<int, object?> keyAgreement, byte[] salt1, byte[] salt2)\n{\n// Builder fragment: ReadOnlyMemory<byte> blobData and the hmac-secret inputs below are caller-supplied.\n// Build extensions for MakeCredential\nvar extensions = new ExtensionBuilder()\n    .WithCredProtect(CredProtectPolicy.UserVerificationRequired)\n    .WithCredBlob(blobData)\n    .Build();\n\nvar options = new MakeCredentialOptions\n{\n    Extensions = extensions,\n    ResidentKey = true\n};\n\n// For GetAssertion: encrypted salts under the shared secret from key agreement\n// protocol/sharedSecret/keyAgreement and 32-byte salt1/salt2 belong to the caller.\nvar assertionExtensions = new ExtensionBuilder()\n    .WithHmacSecret(protocol, sharedSecret, keyAgreement, salt1, salt2)\n    .Build();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-006.cs",
      "bytes": 1844,
      "sha256": "442bd8ef7c87a3aba7391be9ac0b531cd3e1b8a4649c244a35b9cfe3bb5725a4",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body6\n{\ninternal static async Task CompileOnly(Ctap2Session session, IPinUvAuthProtocol protocol, ReadOnlyMemory<byte> pinToken, ReadOnlyMemory<byte> rpIdHash, PublicKeyCredentialDescriptor credentialId)\n{\n// With live session/protocol, authorized borrowed pinToken, returned RP hash and descriptor credentialId.\nusing var credMgmt = new CredentialManagement(session, protocol, pinToken);\n\n// Get credential metadata\nvar metadata = await credMgmt.GetCredentialsMetadataAsync();\n\n// Enumerate RPs. ReportedTotal is copied from the first response and can be null.\nvar rpResult = await credMgmt.EnumerateRelyingPartiesAsync();\nvar rps = rpResult.RelyingParties;\n\n// Enumerate credentials for an RP\nusing var credentialResult = await credMgmt.EnumerateCredentialsAsync(rpIdHash);\nvar creds = credentialResult.Credentials;\n\n// Delete credential\nawait credMgmt.DeleteCredentialAsync(credentialId);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-007.cs",
      "bytes": 1273,
      "sha256": "0af58964364d79ba5ec7cc4c10ce235d553b83375954653a2b6592c919e95a9c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body7\n{\ninternal static async Task CompileOnly(ICtap2Session session, IPinUvAuthProtocol protocol)\n{\nvar request = CtapRequestBuilder.Create(CtapCommand.ClientPin)\n    .WithInt(1, protocol.Version)\n    .WithInt(2, ClientPinSubCommand.GetRetries)\n    .Build();\n\nvar response = await session.SendCborRequestAsync(request);\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-008.cs",
      "bytes": 1286,
      "sha256": "6c830793ad2ee91b5c9d288a5054a97371a994b5518f71e2d852a6922cd6a1f2",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body8\n{\ninternal static void CompileOnly(byte[] pinBytes)\n{\n// With byte[] pinBytes supplied by the caller, in a synchronous method.\nSpan<byte> pinHash = stackalloc byte[32];\ntry\n{\n    SHA256.HashData(pinBytes, pinHash);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pinHash);\n    CryptographicOperations.ZeroMemory(pinBytes);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-009.cs",
      "bytes": 1129,
      "sha256": "b05d6d30df0c2804e821ae68047bd909b09dd26a454a2c24107f4c53d071729f",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body9\n{\ninternal static void CompileOnly()\n{\nusing var protocol = new PinUvAuthProtocolV2();\n// Dispose() only marks the instance disposed; it holds no key material to release.\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-014.cs",
      "bytes": 1563,
      "sha256": "65e1c896276f0d4ce0bd2ab886c53e108cf526b44ea6e633928e8b9f1d3d23e3",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body14\n{\npublic static readonly Feature FeatureFido2 = new(\"FIDO2\", 5, 0, 0);\npublic static readonly Feature FeatureBioEnrollment = new(\"Bio Enrollment\", 5, 2, 0);\npublic static readonly Feature FeatureCredentialManagement = new(\"Credential Management\", 5, 2, 0);\npublic static readonly Feature FeatureHmacSecretMc = new(\"hmac-secret-mc\", 5, 4, 0);\npublic static readonly Feature FeatureAuthenticatorConfig = new(\"Authenticator Config\", 5, 4, 0);\npublic static readonly Feature FeatureCredBlob = new(\"credBlob\", 5, 5, 0);\npublic static readonly Feature FeatureEncIdentifier = new(\"Encrypted Identifier\", 5, 7, 0);\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-015.cs",
      "bytes": 1190,
      "sha256": "c27323c3042a492d08b52648d02806bd24fec8d17465d40b857bfb58113d2d57",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body15\n{\ninternal static void CompileOnly(FirmwareVersion firmwareVersion)\n{\nif (!Ctap2Session.FeatureBioEnrollment.IsSupportedByFirmware(firmwareVersion))\n{\n    throw new NotSupportedException(\"Bio enrollment requires firmware 5.2+\");\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-017.cs",
      "bytes": 1586,
      "sha256": "bd722a0e6bbfef166d4471b4bd0264e082fb57c7a5b062ab46641a4c0b5c6e8d",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing System.Security.Cryptography;\nusing System.Text;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body17\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreateCtap2SessionAsync();\n\nvar info = await session.GetInfoAsync();\nConsole.WriteLine($\"CTAP versions: {string.Join(\", \", info.Versions)}\");\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-018.cs",
      "bytes": 1790,
      "sha256": "adb96153bc07dc286defb1257b850a74d57048a92b05d2c05e1c8c049c88b593",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body18\n{\ninternal static async Task CompileOnly(ICtap2Session session)\n{\nbyte[] registrationHash = RandomNumberGenerator.GetBytes(32); // Demo only, not collected client data.\nvar rp = new PublicKeyCredentialRpEntity(\"example.com\", \"Example Corp\");\nvar user = new PublicKeyCredentialUserEntity(\n    RandomNumberGenerator.GetBytes(32), \"user@example.com\", \"Example User\");\n\nvar response = await session.MakeCredentialAsync(\n    registrationHash, rp, user, [PublicKeyCredentialParameters.CreateES256()],\n    new MakeCredentialOptions { ResidentKey = false });\nvar attested = response.AuthenticatorData.AttestedCredentialData\n    ?? throw new InvalidOperationException(\"No attested credential data was returned.\");\nReadOnlyMemory<byte> credentialId = attested.CredentialId;\nReadOnlyMemory<byte> publicKeyCbor = attested.CredentialPublicKey;\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-019.cs",
      "bytes": 1414,
      "sha256": "4c009bc2bb2832ec2643da40d09f75234af808614d95c81e5a91e91f8545b732",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body19\n{\ninternal static async Task CompileOnly(ICtap2Session session, ReadOnlyMemory<byte> credentialId)\n{\nbyte[] authenticationHash = RandomNumberGenerator.GetBytes(32); // A separate demo ceremony.\nvar assertion = await session.GetAssertionAsync(\"example.com\", authenticationHash,\n    new GetAssertionOptions { AllowList = [new PublicKeyCredentialDescriptor(credentialId)] });\nConsole.WriteLine($\"Signature: {Convert.ToHexString(assertion.Signature.Span)}\");\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-020.cs",
      "bytes": 1463,
      "sha256": "464267adb8720db80b3c35b0ecb5578ddcf8633ac45e88c8f8ced206460d3ab7",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body20\n{\ninternal static async Task CompileOnly(ICtap2Session session, byte[] authenticationHash)\n{\n// Alternative to the allow-list assertion above, not an additional use of its ceremony hash.\nvar first = await session.GetAssertionAsync(\"example.com\", authenticationHash, new GetAssertionOptions());\nvar assertions = new List<GetAssertionResponse> { first };\nint total = first.NumberOfCredentials ?? 1;\nfor (int index = 1; index < total; index++)\n{\n    assertions.Add(await session.GetNextAssertionAsync());\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-021.cs",
      "bytes": 1419,
      "sha256": "741f2fc335b60dd5b5b8e5ef001720df7da0dddcdfce17a22cb1afa6dbce59d7",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body21\n{\ninternal static async Task CompileOnly(CredentialManagement credentialManagement, ReadOnlyMemory<byte> rpIdHash)\n{\n// Existing helper and hash supplied by the caller; see the authorization prerequisites below.\nusing var credentialResult = await credentialManagement.EnumerateCredentialsAsync(rpIdHash);\nforeach (StoredCredentialInfo credential in credentialResult.Credentials)\n{\n    Console.WriteLine(Convert.ToHexString(credential.CredentialId.Id.Span));\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-022.cs",
      "bytes": 3233,
      "sha256": "67bf2346e3a147f9ede8c22a11a2f2b4939fbef9876035c0296482db410b3e40",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body22\n{\ninternal static async Task CompileOnly(ICtap2Session session, PublicKeyCredentialRpEntity rp, PublicKeyCredentialUserEntity user)\n{\nbyte[] pin = Encoding.UTF8.GetBytes(\"123456\");\nbyte[]? pinToken = null;\nbyte[]? authParam = null;\ntry\n{\n    using var protocol = new PinUvAuthProtocolV2();\n    using var clientPin = new ClientPin(session, protocol);\n    byte[] pinRegistrationHash = RandomNumberGenerator.GetBytes(32); // Separate demo creation.\n    byte[] pinAuthenticationHash = RandomNumberGenerator.GetBytes(32); // Separate demo assertion.\n    pinToken = await clientPin.GetPinUvAuthTokenUsingPinAsync(\n        pin, PinUvAuthTokenPermissions.MakeCredential, \"example.com\");\n    var options = new MakeCredentialOptions\n    {\n        ResidentKey = true,\n        Extensions = new ExtensionBuilder().WithCredProtect(CredProtectPolicy.UserVerificationRequired).Build()\n    };\n    authParam = protocol.Authenticate(pinToken, pinRegistrationHash);\n    options.WithPinUvAuth(authParam, protocol.Version); // uv remains absent.\n    var created = await session.MakeCredentialAsync(\n        pinRegistrationHash, rp, user, [PublicKeyCredentialParameters.CreateES256()], options);\n    var createdData = created.AuthenticatorData.AttestedCredentialData\n        ?? throw new InvalidOperationException(\"No attested credential data was returned.\");\n\n    // The first token requested only MakeCredential permission. Authorize the separate assertion.\n    CryptographicOperations.ZeroMemory(authParam);\n    CryptographicOperations.ZeroMemory(pinToken);\n    pinToken = await clientPin.GetPinUvAuthTokenUsingPinAsync(\n        pin, PinUvAuthTokenPermissions.GetAssertion, \"example.com\");\n    authParam = protocol.Authenticate(pinToken, pinAuthenticationHash);\n    var assertionOptions = new GetAssertionOptions\n    {\n        AllowList = [new PublicKeyCredentialDescriptor(createdData.CredentialId)]\n    };\n    assertionOptions.WithPinUvAuth(authParam, protocol.Version);\n    var verified = await session.GetAssertionAsync(\"example.com\", pinAuthenticationHash, assertionOptions);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n    if (pinToken is not null) CryptographicOperations.ZeroMemory(pinToken);\n    if (authParam is not null) CryptographicOperations.ZeroMemory(authParam);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-023.cs",
      "bytes": 1235,
      "sha256": "ff5592784faa00983c835344f7c6e69f0cbe1cf0ba343a5ccd611b0c30976e9c",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body23\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-024.cs",
      "bytes": 1530,
      "sha256": "41e22f9ffafaed594016e0f9782d9d625f14e90e7a37e5dd56b7ffcad0fbf194",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body24\n{\nsealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\ninternal static async Task CompileOnly(IYubiKey device)\n{\n// Replace the original session factory above; do not open a second session while it is live.\nawait using var session = await device.CreateCtap2SessionAsync(\n    new SessionCreationOptions { UserPresencePrompt = new TouchPrompt() });\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-029.cs",
      "bytes": 1434,
      "sha256": "ed1be8514e7fb579e32139f06439ce7e0c212d007a21baf18435dca42b0774c0",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body29\n{\ninternal static void CompileOnly()\n{\n// Partial parser fixture (backend status already stripped), not a conforming GetInfo response.\n// Required AAGUID is absent; current decoder accepts this incomplete envelope.\nvar writer = new CborWriter(CborConformanceMode.Ctap2Canonical);\nwriter.WriteStartMap(1);\nwriter.WriteInt32(1);\nwriter.WriteStartArray(1);\nwriter.WriteTextString(\"FIDO_2_0\");\nwriter.WriteEndArray();\nwriter.WriteEndMap();\nbyte[] mockResponse = writer.Encode();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-033.cs",
      "bytes": 3294,
      "sha256": "f7bd955a693ce793ea261550a4fa79ae0e5064159c40e151136414d8c61b2247",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\nusing Yubico.YubiKit.WebAuthn.Extensions.PreviewSign;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body33\n{\ninternal static async Task CompileOnly(ICtap2Session ctap2Session, WebAuthnOrigin origin, ICredentialPrompt myCredentialPrompt, byte[] userId, byte[] registrationChallenge, byte[] authenticationChallenge, RegistrationExtensionInputs registrationExtensions, AuthenticationExtensionInputs authenticationExtensions)\n{\n// Alternative 1: transfer an existing CTAP2 session on successful construction.\n// The application owns RP validity and authorization of each origin/RP pair.\n// WebAuthnClientOptions and its RpIdValidator are required. CredentialPrompt remains optional.\nawait using var client = new WebAuthnClient(\n    ctap2Session,\n    origin,\n    new WebAuthnClientOptions\n    {\n        RpIdValidator = (requestOrigin, rpId) =>\n            requestOrigin.StringValue == \"https://example.com\" && rpId == \"example.com\",\n        CredentialPrompt = myCredentialPrompt,\n        MaxPromptAttempts = 3\n    });\n\n// Registration\nvar createOptions = new PublicKeyCredentialCreationOptions\n{\n    Rp = new PublicKeyCredentialRpEntity(\"example.com\", \"Example\"),\n    User = new PublicKeyCredentialUserEntity(userId, \"user@example.com\", \"User\"),\n    Challenge = registrationChallenge,\n    PubKeyCredParams = [CoseAlgorithm.Es256],\n    Extensions = registrationExtensions\n};\n\n// Pass pinBytes to supply a PIN directly, or leave it null to use the configured prompt.\nvar credential = await client.MakeCredentialAsync(createOptions, pinBytes: null);\n\n// Authentication\nvar requestOptions = new PublicKeyCredentialRequestOptions\n{\n    Challenge = authenticationChallenge,\n    RpId = \"example.com\",\n    AllowCredentials = [new PublicKeyCredentialDescriptor(credential.CredentialId)],\n    Extensions = authenticationExtensions\n};\n\nvar matches = await client.GetAssertionAsync(requestOptions, pinBytes: null);\nif (matches.Count == 0)\n    return; // Normal no-match path; no response to submit.\nvar assertion = await matches[0].SelectAsync();\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-034.cs",
      "bytes": 2187,
      "sha256": "3b2efbbe9a13d24664b1d1de26efed1837069b9e127cf0507762827f8a663054",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\nusing Yubico.YubiKit.WebAuthn.Extensions.PreviewSign;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body34\n{\ninternal sealed class ApplicationRpValidationService(Func<WebAuthnOrigin, string, bool> validate)\n{ public bool IsRpValidForOrigin(WebAuthnOrigin origin, string rpId) => validate(origin, rpId); }\ninternal static async Task CompileOnly(IYubiKey yubiKey, WebAuthnOrigin origin, ApplicationRpValidationService rpValidationService, ICredentialPrompt myCredentialPrompt, ScpKeyParameters scpKeyParameters)\n{\nawait using var client = await yubiKey.CreateWebAuthnClientAsync(\n    origin,\n    clientOptions: new WebAuthnClientOptions\n    {\n        RpIdValidator = rpValidationService.IsRpValidForOrigin,\n        CredentialPrompt = myCredentialPrompt\n    },\n    sessionOptions: new SessionCreationOptions\n    {\n        PreferredConnectionType = ConnectionType.SmartCard,\n        ScpKeyParameters = scpKeyParameters\n    });\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-035.cs",
      "bytes": 1551,
      "sha256": "7c20fa62f53044ec17b32fa146c980ac7e353b9f42feaf1e26c7a5488907112a",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\nusing Yubico.YubiKit.WebAuthn.Extensions.PreviewSign;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body35\n{\npublic interface ICredentialPrompt\n{\n    ValueTask<IMemoryOwner<byte>?> RequestSecretAsync(\n        CredentialPromptContext context,\n        CancellationToken cancellationToken);\n}\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-036.cs",
      "bytes": 2293,
      "sha256": "a6504a1a6b30afdde9fae555d36e60ab0330375ebdb5a6059baf22114e957631",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\nusing Yubico.YubiKit.WebAuthn.Extensions.PreviewSign;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body36\n{\ninternal static void CompileOnly(GeneratedSigningKey generatedKey, ReadOnlyMemory<byte> toBeSigned, ReadOnlyMemory<byte> algorithmSpecificAdditionalArgs, ReadOnlyMemory<byte> credentialId)\n{\n// Registration: request a generated signing key.\nvar registrationExtensions = new RegistrationExtensionInputs(\n    PreviewSign: PreviewSignRegistrationInput.GenerateKey(CoseAlgorithm.Es256));\n\n// Authentication: provide keyHandle, algorithm-specific tbs, and optional raw additionalArgs.\nvar signingParams = new PreviewSignSigningParams(\n    keyHandle: generatedKey.KeyHandle,\n    tbs: toBeSigned,\n    additionalArgs: algorithmSpecificAdditionalArgs);\n\nvar authenticationExtensions = new AuthenticationExtensionInputs(\n    PreviewSign: PreviewSignAuthenticationInput.CreateSignByCredential(\n        new Dictionary<ReadOnlyMemory<byte>, PreviewSignSigningParams>\n        {\n            [credentialId] = signingParams\n        }));\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-040.cs",
      "bytes": 4665,
      "sha256": "16e420e2712e1abb2cdf89f9a802cd88fa64d1201b67bc1706896bc6c49369df",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\nusing Yubico.YubiKit.WebAuthn.Extensions.PreviewSign;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\nusing System.Buffers;\nusing System.Security.Cryptography;\nusing System.Text;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Utilities;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body40\n{\ninternal static async Task CompileOnly()\n{\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nif (!WebAuthnOrigin.TryParse(\"https://example.com\", out var origin))\n    throw new InvalidOperationException(\"The origin is not supported.\");\n\n// A complete, deliberately narrow allowlist: this origin may use exactly this known-valid RP ID.\nvar clientOptions = new WebAuthnClientOptions\n{\n    RpIdValidator = (requestOrigin, rpId) =>\n        requestOrigin.StringValue == \"https://example.com\" && rpId == \"example.com\"\n};\nawait using var client = await device.CreateWebAuthnClientAsync(origin, clientOptions);\n\n// Local demo inputs only. Production options and user handles come from the RP.\nvar registrationOptions = new PublicKeyCredentialCreationOptions\n{\n    Challenge = RandomNumberGenerator.GetBytes(32),\n    Rp = new PublicKeyCredentialRpEntity(\"example.com\", \"Example Corp\"),\n    User = new PublicKeyCredentialUserEntity(RandomNumberGenerator.GetBytes(16), \"user@example.com\", \"Example User\"),\n    PubKeyCredParams = [CoseAlgorithm.Es256],\n    ResidentKey = ResidentKeyPreference.Required,\n    UserVerification = UserVerificationPreference.Required,\n    Extensions = new RegistrationExtensionInputs(CredProps: new CredPropsInput())\n};\nbyte[] demoPin = Encoding.UTF8.GetBytes(\"11234567\"); // Dedicated demo key's existing PIN; never embed a production PIN.\ntry\n{\n    var registration = await client.MakeCredentialAsync(registrationOptions, pinBytes: demoPin);\n\n    // Keep the original result: do not register again just to obtain metadata.\n    string[] transportNames = [.. registration.Transports.Select(transport => transport.Value)];\n    bool? residentKey = registration.ClientExtensionResults?.CredProps?.ResidentKey;\n    Console.WriteLine($\"Created a credential; discoverable: {residentKey}.\");\n\n    var requestOptions = new PublicKeyCredentialRequestOptions\n    {\n        Challenge = RandomNumberGenerator.GetBytes(32), // A separate challenge for this demo assertion.\n        RpId = \"example.com\",\n        AllowCredentials = [new PublicKeyCredentialDescriptor(registration.CredentialId)],\n        UserVerification = UserVerificationPreference.Required\n    };\n    var matches = await client.GetAssertionAsync(requestOptions, pinBytes: demoPin);\n    if (matches.Count == 0)\n    {\n        Console.WriteLine(\"No matching credential was returned.\");\n        return;\n    }\n\n    // This single-entry allow-list demo needs no account picker.\n    var assertion = await matches[0].SelectAsync();\n    Console.WriteLine(\"Retrieved an assertion; RP verification is still required.\");\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(demoPin);\n}\n}\n\n}\n"
    },
    {
      "path": "/home/rupicola/Code/y/Yubico.Yubikit.NET/docs/research/documentation-audit/modules/core/pass-1/core-001/validation/examples/full/host/src/FULL-041.cs",
      "bytes": 1891,
      "sha256": "8646107f178a081762de6d69cf58489bd550bd410c3c28a34f676bcdc9a7c388",
      "content": "using System;\nusing System.Buffers;\nusing System.Collections.Generic;\nusing System.IO;\nusing System.Linq;\nusing System.Runtime.InteropServices;\nusing System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing System.Threading;\nusing System.Threading.Tasks;\nusing Yubico.YubiKit.Core;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Core.Transports.SmartCard;\nusing Yubico.YubiKit.Core.Utilities;\nusing System.Formats.Cbor;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Cbor;\nusing Yubico.YubiKit.Ctap2.Cose;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.CredentialManagement;\nusing Yubico.YubiKit.Ctap2.Ctap;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\nusing Yubico.YubiKit.WebAuthn;\nusing Yubico.YubiKit.WebAuthn.Client;\nusing Yubico.YubiKit.WebAuthn.Client.Authentication;\nusing Yubico.YubiKit.WebAuthn.Client.Registration;\nusing Yubico.YubiKit.WebAuthn.Extensions;\nusing Yubico.YubiKit.WebAuthn.Extensions.Inputs;\nusing Yubico.YubiKit.WebAuthn.Preferences;\nusing Yubico.YubiKit.WebAuthn.Extensions.PreviewSign;\nusing Yubico.YubiKit.Core.Protocols.SmartCard.Scp;\n\nnamespace Audit20261111.DocExamples.Full;\ninternal static class Body41\n{\ninternal sealed class PinPrompt(Func<CredentialPromptContext, CancellationToken, Task<byte[]>> readPin) : ICredentialPrompt\n{\n    public async ValueTask<IMemoryOwner<byte>?> RequestSecretAsync(\n        CredentialPromptContext context, CancellationToken cancellationToken)\n    {\n        byte[] pin = await readPin(context, cancellationToken);\n        try { return DisposableArrayPoolBuffer.CreateFromSpan(pin); }   // exactly sized; ownership transfers\n        finally { CryptographicOperations.ZeroMemory(pin); }\n    }\n}\n}\n"
    },
