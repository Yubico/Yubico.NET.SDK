<Project>
  <Import Project="$(DocExamplesRoot)/Directory.Build.targets" />
  <PropertyGroup Condition="'$(MSBuildProjectFullPath)' == '$(DocExamplesSelectedProject)'">
    <ProvideCommandLineArgs>true</ProvideCommandLineArgs>
    <SkipCompilerExecution>false</SkipCompilerExecution>
    <UseSharedCompilation>false</UseSharedCompilation>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectFullPath)' == '$(DocExamplesSelectedProject)' and '$(DocExamplesInjectionFiles)' != ''">
    <Compile Include="$(DocExamplesInjectionFiles)" />
  </ItemGroup>
  <Target Name="DocExamplesFullBefore" BeforeTargets="CoreCompile"
          DependsOnTargets="GenerateSourceLinkFile;_SetEmbeddedFilesFromSourceControlManagerUntrackedFiles"
          Condition="'$(MSBuildProjectFullPath)' == '$(DocExamplesSelectedProject)'">
    <WriteLinesToFile File="$(DocExamplesCapture)/sources.txt" Lines="@(Compile->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/references.txt" Lines="@(ReferencePathWithRefAssemblies->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/analyzers.txt" Lines="@(Analyzer->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/configs.txt" Lines="@(EditorConfigFiles->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/other.txt" Lines="$(SourceLink);@(EmbeddedFiles->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/policy.txt" Lines="Project=$(MSBuildProjectFullPath);SDK=$(NETCoreSdkVersion);SDKPath=$(MSBuildSDKsPath);Version=$(Version);TFM=$(TargetFramework);Configuration=$(Configuration);WarningsAsErrors=$(TreatWarningsAsErrors);Analyzers=$(RunAnalyzersDuringBuild);AnalysisMode=$(AnalysisMode);AnalysisLevel=$(AnalysisLevel);SkipCompiler=$(SkipCompilerExecution);SharedCompiler=$(UseSharedCompilation);ProvideArgs=$(ProvideCommandLineArgs);Assets=$(ProjectAssetsFile);TargetPath=$(TargetPath);SourceLink=$(SourceLink);GenerateProgramFile=$(GenerateProgramFile);GeneratedProgramFile=$(GeneratedProgramFile);NuGetPackageRoot=$(NuGetPackageRoot);Language=$(Language)" Overwrite="true" />
    <Exec Command="python3 -B &quot;$(DocExamplesFullCaptureScript)&quot; before &quot;$(DocExamplesCapture)&quot;" />
  </Target>
  <Target Name="DocExamplesFullCompiler" AfterTargets="CoreCompile"
          Condition="'$(MSBuildProjectFullPath)' == '$(DocExamplesSelectedProject)'">
    <WriteLinesToFile File="$(DocExamplesCapture)/csc.txt" Lines="@(CscCommandLineArgs)" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/sources-actual.txt" Lines="@(Compile->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/references-actual.txt" Lines="@(ReferencePathWithRefAssemblies->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/analyzers-actual.txt" Lines="@(Analyzer->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/configs-actual.txt" Lines="@(EditorConfigFiles->'%(FullPath)')" Overwrite="true" />
    <WriteLinesToFile File="$(DocExamplesCapture)/other-actual.txt" Lines="$(SourceLink);@(EmbeddedFiles->'%(FullPath)')" Overwrite="true" />
    <Exec Command="python3 -B &quot;$(DocExamplesFullCaptureScript)&quot; compiler &quot;$(DocExamplesCapture)&quot;" />
  </Target>
  <Target Name="DocExamplesFullFinish" AfterTargets="Build"
          Condition="'$(MSBuildProjectFullPath)' == '$(DocExamplesSelectedProject)'">
    <Exec Command="python3 -B &quot;$(DocExamplesFullCaptureScript)&quot; finish &quot;$(DocExamplesCapture)&quot;" />
  </Target>
</Project>
