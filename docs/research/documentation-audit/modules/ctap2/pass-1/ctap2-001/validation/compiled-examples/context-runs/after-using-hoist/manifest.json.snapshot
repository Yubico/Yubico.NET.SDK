    {
      "name": "shared-intent-callback",
      "context": "consumer-lib",
      "source": "shared-intent-callback/complete.cs",
      "source_sha256": "3e6cdd44e2cf13dc71008c649e1ed43d90b15917390e5d40f39da7f5178c74e6",
