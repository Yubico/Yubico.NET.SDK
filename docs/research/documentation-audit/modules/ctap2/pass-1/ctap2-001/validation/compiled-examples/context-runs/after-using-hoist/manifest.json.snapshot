      "opening_line": 42,
      "closing_line": 59,
      "extracted_text": "using System.Security.Cryptography;\nusing System.Text;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreateCtap2SessionAsync();\n\nvar info = await session.GetInfoAsync();\nConsole.WriteLine($\"CTAP versions: {string.Join(\", \", info.Versions)}\");\n",
      "extracted_sha256": "359878ebe2147dc0cd389baf7baef3a5f7030cdffc5a46a8096adddc590c3e97",
      "verbatim_text": "```csharp\nusing System.Security.Cryptography;\nusing System.Text;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Ctap2;\nusing Yubico.YubiKit.Ctap2.Credentials;\nusing Yubico.YubiKit.Ctap2.Extensions;\nusing Yubico.YubiKit.Ctap2.Pin;\n\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreateCtap2SessionAsync();\n\nvar info = await session.GetInfoAsync();\nConsole.WriteLine($\"CTAP versions: {string.Join(\", \", info.Versions)}\");\n```\n",
      "document_sha256": "2d41ea0fb0c4477355680cc6f271e7277a4f108b6012986a230aadf3d3df1225",
