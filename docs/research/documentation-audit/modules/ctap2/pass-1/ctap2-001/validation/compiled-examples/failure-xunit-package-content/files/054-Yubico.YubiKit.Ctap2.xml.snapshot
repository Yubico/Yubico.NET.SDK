            <param name="RawCbor">Encoded input bytes; direct construction borrows them, while Decode supplies a copy.</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseOtherKey.#ctor(System.Int32,Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm,System.ReadOnlyMemory{System.Byte})">
            <summary>
