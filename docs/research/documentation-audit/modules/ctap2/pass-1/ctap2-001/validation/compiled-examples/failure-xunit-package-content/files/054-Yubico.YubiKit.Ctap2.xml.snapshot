        <member name="T:Yubico.YubiKit.Ctap2.CtapException">
            <summary>
            Exception thrown when a CTAP command fails.
            </summary>
            <remarks>Nonzero wire CTAP statuses are preserved without normalization. Backends also use
            Other for an empty response, and public constructors accept caller-supplied statuses.
            Transport/CTAPHID errors, APDU failures, SDK validation, callbacks and model decoding have
            different exception origins. This exception is not a rollback or no-side-effects guarantee.</remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.CtapException.Status">
            <summary>
            Gets the received, synthesized or caller-supplied CTAP status code.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.CtapException.#ctor(Yubico.YubiKit.Ctap2.CtapStatus)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Ctap2.CtapException"/> class.
            </summary>
            <param name="status">The CTAP status code.</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.CtapException.#ctor(Yubico.YubiKit.Ctap2.CtapStatus,System.String)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Ctap2.CtapException"/> class.
            </summary>
            <param name="status">The CTAP status code.</param>
            <param name="message">The error message.</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.CtapException.#ctor(Yubico.YubiKit.Ctap2.CtapStatus,System.String,System.Exception)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Ctap2.CtapException"/> class.
            </summary>
            <param name="status">The CTAP status code.</param>
            <param name="message">The error message.</param>
            <param name="innerException">The inner exception.</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.CtapException.ThrowIfError(Yubico.YubiKit.Ctap2.CtapStatus)">
            <summary>
            Throws a <see cref="T:Yubico.YubiKit.Ctap2.CtapException"/> if the status is not <see cref="F:Yubico.YubiKit.Ctap2.CtapStatus.Success"/>.
            </summary>
            <param name="status">The status to check.</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.CtapException.ThrowIfError(System.Byte)">
            <summary>
            Throws a <see cref="T:Yubico.YubiKit.Ctap2.CtapException"/> if the status is not <see cref="F:Yubico.YubiKit.Ctap2.CtapStatus.Success"/>.
            </summary>
            <param name="status">The status byte to check.</param>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.CtapStatus">
            <summary>
            CTAP2 status codes per FIDO Alliance specifications.
            </summary>
            <remarks>
            <para>
            Includes CTAP2.1 statuses and retained legacy identifiers. The meaning of some values differs
            by revision; enum membership does not establish that every revision assigns that status.
            These values do not collapse CTAPHID transport errors into CTAP CBOR response statuses.
            </para>
            <para>
            CTAP 2.1: https://fidoalliance.org/specs/fido-v2.1-ps-20210615/fido-client-to-authenticator-protocol-v2.1-ps-errata-20220621.html#error-responses
            </para>
            <para>
            CTAP2.0 legacy statuses: https://fidoalliance.org/specs/fido-v2.0-ps-20190130/fido-client-to-authenticator-protocol-v2.0-ps-20190130.html#error-responses
            </para>
            <para>
            CTAP2.2 Review Draft, October 3, 2024: https://fidoalliance.org/specs/fido-v2.2-rd-20241003/fido-client-to-authenticator-protocol-v2.2-rd-20241003.html#error-responses
            CTAP2.3 Proposed Standard, February 26, 2026: https://fidoalliance.org/specs/fido-v2.3-ps-20260226/fido-client-to-authenticator-protocol-v2.3-ps-20260226.html#error-responses
            </para>
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.CtapStatus.Success">
            <summary>
            Indicates successful response.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.CtapStatus.InvalidCommand">
