            <summary>
            Creates a new credential parameters instance.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.PublicKeyCredentialParameters.#ctor(Yubico.YubiKit.Core.Cryptography.Cose.CoseAlgorithmIdentifier)">
            <summary>
            Creates a new credential parameters instance with the specified algorithm.
            </summary>
            <param name="algorithm">The COSE algorithm identifier.</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.PublicKeyCredentialParameters.CreateES256">
            <summary>
            Creates ES256 credential parameters.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.PublicKeyCredentialParameters.CreateRS256">
            <summary>
            Creates RS256 credential parameters.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.PublicKeyCredentialParameters.CreateEdDSA">
            <summary>
            Creates EdDSA credential parameters.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.PublicKeyCredentialParameters.Encode(System.Formats.Cbor.CborWriter)">
            <summary>
            Encodes this parameters object as CBOR.
            </summary>
            <param name="writer">The CBOR writer.</param>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Backend.HidBackend">
            <summary>
            FIDO backend that communicates over FIDO HID (CTAPHID_CBOR command).
            </summary>
            <remarks>Uses a borrowed protocol. HID keep-alive status 0x02 can request a device-wait
            notification; the backend resolves the operation from the drained CTAP status before typed
            decoding. Completed means CTAP success, not verified presence, UV or RP authentication.
            Only an untransferred response is cleared here; a successful returned view has no cleanup owner.</remarks>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Backend.ICtap2Backend">
            <summary>
            Abstraction for FIDO transport backends (SmartCard CCID or FIDO HID).
            </summary>
            <remarks>
            This allows Ctap2Session to be transport-agnostic while supporting both
            SmartCard (CCID) and FIDO HID (CTAPHID) communication.
            Backends borrow protocols; the session manages their lifecycle. CTAP status handling and
            notification resolution precede transfer of the response view, not model or RP verification.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Backend.ICtap2Backend.SendCborAsync(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Credentials.UserPresenceNotification,System.Threading.CancellationToken)">
            <summary>
            Sends a CTAP CBOR command and receives the response.
            </summary>
            <param name="request">The serialized CTAP request (command byte + CBOR payload).</param>
            <param name="userPresenceNotification">The non-null notification handle for this operation.</param>
            <param name="cancellationToken">Cancellation token.</param>
            <returns>The response data (status byte has already been validated).</returns>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Backend.SmartCardBackend">
            <summary>
            FIDO backend that communicates over SmartCard (CCID) transport using ISO 7816-4 APDUs.
            </summary>
            <remarks>Uses a borrowed protocol. With no in-flight presence signal, an operation's supplied
            policy notification is requested before transmission. Resolution uses CTAP status before typed
            decoding, not verified UP/UV or RP success. Only an untransferred response is cleared here.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Backend.SmartCardBackend.SelectApplicationAsync(System.Threading.CancellationToken)">
            <summary>
            Selects the FIDO2 application.
            </summary>
            <remarks>Any SELECT ApduException is currently wrapped as NotSupportedException with its
            original inner exception. The wrapper alone does not prove the FIDO AID was absent.</remarks>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintModality">
            <summary>
            Fingerprint modality constants per CTAP2.1 specification.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintModality.Fingerprint">
            <summary>
            Fingerprint sensor type (0x01).
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus">
            <summary>
            Fingerprint capture feedback as currently modeled by the SDK.
            </summary>
            <remarks>
            Values 0x00-0x0A match CTAP 2.1 (2022-06-21 errata), Section 6.7.
            The final three member names do not match that standard table; consult their remarks
            rather than treating their names as standardized device feedback.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.Good">
            <summary>
            Good sample captured (0x00).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooHigh">
            <summary>
            Sample too high on sensor (0x01).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooLow">
            <summary>
            Sample too low on sensor (0x02).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooLeft">
            <summary>
            Sample too left on sensor (0x03).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooRight">
            <summary>
            Sample too right on sensor (0x04).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooFast">
            <summary>
            Finger moved too fast (0x05).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooSlow">
            <summary>
            Finger moved too slow (0x06).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.PoorQuality">
            <summary>
            Poor quality sample (0x07).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooSkewed">
            <summary>
            Sample too skewed (0x08).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.TooShort">
            <summary>
            Sample too short (0x09).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.MergeFailure">
            <summary>
            Merge failure (0x0A).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.StorageFull">
            <summary>
            Local member for feedback value 0x0B.
            </summary>
            <remarks>The standard means fingerprint already exists, not storage full.</remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.NoUserActivity">
            <summary>
            Local member for feedback value 0x0C.
            </summary>
            <remarks>The cited standard leaves 0x0C unused; no-user-activity is 0x0D.</remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSampleStatus.NoUserPresence">
            <summary>
            Local member for feedback value 0x0D.
            </summary>
            <remarks>The standard means no touch/swipe activity. No finger-lift transition is 0x0E.</remarks>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSensorInfo">
            <summary>
            Information about the fingerprint sensor capabilities.
            </summary>
            <remarks>
            Models selected sensor response fields. CTAP 2.1 (2022-06-21 errata), Section 6.7.3,
            also supplies maxTemplateFriendlyName at key 8, which is available only through RawData
            here. The current helper's sensor request omits the required subcommand. A decoded
            object does not establish complete or valid standard sensor-info exchange.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSensorInfo.RawData">
            <summary>
            Gets the complete original CBOR-encoded authenticator response.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSensorInfo.FingerprintKind">
            <summary>
            Gets the decoded fingerprint kind, defaulting to Touch when key 2 is missing.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSensorInfo.MaxCaptureSamplesRequiredForEnroll">
            <summary>
            Gets the maximum number of samples required for enrollment.
            </summary>
            <remarks>
            This reports the maximum good samples, not a limit on total capture attempts:
            rejected captures may not count. Missing key 3 currently defaults to zero, so zero
            is not evidence that no samples are required. This decoder does not validate field presence.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSensorInfo.MaxTemplateCount">
            <summary>
            Gets the optional integer this decoder interprets as maximum template count at key 4.
            </summary>
            <remarks>CTAP 2.1 Section 6.7.3 does not define this sensor field. No original vendor
            definition establishes its meaning or availability; it is not qualified capacity information.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintSensorInfo.Decode(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes a FingerprintSensorInfo from a CBOR response.
            </summary>
            <param name="data">The CBOR-encoded response data.</param>
            <returns>The decoded sensor info.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintKind">
            <summary>
            Fingerprint sensor kind.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintKind.Touch">
            <summary>
            Touch sensor - finger placed on sensor (0x01).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintKind.Swipe">
            <summary>
            Swipe sensor - finger swiped across sensor (0x02).
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentSampleResult">
            <summary>
            Result of a fingerprint enrollment capture sample operation.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentSampleResult.RawData">
            <summary>
            Gets the complete original CBOR-encoded authenticator response.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentSampleResult.TemplateId">
            <summary>
            Gets the template ID decoded from key 4, or empty memory if it is absent.
            </summary>
            <remarks>Retain the begin-response ID separately. CTAP 2.1 Section 6.7.4 does not
            require next-sample responses to repeat it; this decoder does not preserve earlier IDs.</remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentSampleResult.LastSampleStatus">
            <summary>
            Gets decoded sample feedback, defaulting to Good when key 5 is missing.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentSampleResult.RemainingSamples">
            <summary>
            Gets the number of remaining samples needed to complete enrollment.
            </summary>
            <remarks>
            In a valid sample response, zero reports completion. This decoder also defaults
            missing key 6 to zero and does not validate operation-specific required fields.
            The value is device feedback, not a verified persistence result or an SDK sample budget.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentSampleResult.IsComplete">
            <summary>
            Gets whether RemainingSamples equals zero, including its missing-field default.
            </summary>
            <remarks>An empty map currently produces true; this property alone is not proof of successful enrollment.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentSampleResult.Decode(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes an EnrollmentSampleResult from a CBOR response.
            </summary>
            <param name="data">The CBOR-encoded response data.</param>
            <returns>The decoded enrollment result.</returns>
            <remarks>
            Copies the complete borrowed response and reads keys 4/5/6. Missing fields retain
            empty ID, Good status and zero remaining count; required-field validation is absent.
            These defaults must not be treated as valid standard operation responses.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.TemplateInfo">
            <summary>
            Metadata identifying and naming an enrolled fingerprint, not biometric template sample bytes.
            </summary>
            <remarks>
            The current decoder reads a flat map with ID/name at keys 4/7. CTAP 2.1 (2022-06-21 errata),
            Section 6.7, instead defines nested TemplateInfo with required ID key 1 and optional name
            key 2, inside the inventory's key-7 array. This decoder does not implement that schema.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.TemplateInfo.TemplateId">
            <summary>
            Gets the unique identifier of this template.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.TemplateInfo.FriendlyName">
            <summary>
            Gets the friendly name of this template, if set.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.TemplateInfo.SampleCount">
            <summary>
            Gets the optional integer locally interpreted as a sample count at key 8.
            </summary>
            <remarks>
            No original vendor definition establishes this interpretation. Standard envelope
            key 8 is maxTemplateFriendlyName, not sample count, and nested TemplateInfo has no such field.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.TemplateInfo.Decode(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes a TemplateInfo from a CBOR response.
            </summary>
            <param name="data">The CBOR-encoded response data.</param>
            <returns>The decoded template info.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.TemplateInfo.DecodeFromReader(System.Formats.Cbor.CborReader)">
            <summary>
            Decodes a TemplateInfo from an existing CBOR reader.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentEnumerationResult">
            <summary>
            Result from enumerating enrolled fingerprint templates.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentEnumerationResult.Templates">
            <summary>
            Gets the list of enrolled templates.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentEnumerationResult.Decode(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes an EnrollmentEnumerationResult from a CBOR response.
            </summary>
            <param name="data">The CBOR-encoded response data.</param>
            <returns>The decoded enumeration result containing the first template.</returns>
            <remarks>
            Wraps one flat decoded TemplateInfo. This does not parse the all-template array
            required by CTAP 2.1 Section 6.7.6, and is not a complete standard inventory decoder.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.EnrollmentEnumerationResult.FromTemplates(System.Collections.Generic.IReadOnlyList{Yubico.YubiKit.Ctap2.BioEnrollment.TemplateInfo})">
            <summary>
            Creates an enumeration result from a list of templates.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand">
            <summary>
            Local biometric subcommand constants used by the current helper.
            </summary>
            <remarks>
            <para>
            CTAP 2.1 (2022-06-21 errata), Section 6.7, defines begin/next/cancel/enumerate/rename/remove
            as 1/2/3/4/5/6 and sensor info as 7. The constants below do not match those standard values.
            Their presence is not evidence of an interoperable standard or vendor command profile.
            </para>
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.GetFingerprintSensorInfo">
            <summary>
            Local sensor-info value 0x01; the standard assigns 0x07 (not used by the current sensor request).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.EnrollBegin">
            <summary>
            Local begin value 0x02; the standard assigns 0x01.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.EnrollCaptureNextSample">
            <summary>
            Local continuation value 0x03; the standard assigns 0x02.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.EnrollCancel">
            <summary>
            Local cancellation value 0x04; the standard assigns 0x03.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.EnumerateEnrollments">
            <summary>
            Local enumeration value 0x05; the standard assigns 0x04.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.SetFriendlyName">
            <summary>
            Local rename value 0x06; the standard assigns 0x05.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.RemoveEnrollment">
            <summary>
            Local removal value 0x07; the standard assigns 0x06.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.BioEnrollment.BioEnrollmentSubCommand.GetTemplateInfo">
            <summary>
            Unused local template-info value 0x08.
            </summary>
            <remarks>
            No corresponding subcommand is defined in the cited CTAP revision, and no
            original vendor definition establishes this value's meaning or support.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment">
            <summary>
            Provides operations for biometric (fingerprint) enrollment on a CTAP2 authenticator.
            </summary>
            <remarks>
            <para>
            Standard enrollment requires fingerprint hardware, bioEnroll option presence and a
            token with <see cref="F:Yubico.YubiKit.Ctap2.Pin.PinUvAuthTokenPermissions.BioEnrollment"/> permission. A false
            bioEnroll value means supported with no templates, not unsupported. Acquiring this
            permission through built-in UV additionally requires uvBioEnroll support. The helper
            does not negotiate command/protocol support, obtain tokens or check their permissions/expiry.
            </para>
            <para>
            The current standard-command path does not match CTAP 2.1 (2022-06-21 errata),
            Section 6.7: its enrollment/administration subcommands are shifted by one, its sensor
            request omits subCommand=7, and authenticated messages omit the modality byte. Explicit
            timeouts are encoded at top-level key 6 instead of parameter-map key 3. The inventory
            decoder also expects a flat template rather than the standard template array. These
            limitations prevent treating this helper as a complete interoperable standard enrollment
            workflow. Selecting the prototype command is not an established workaround for these defects.
            </para>
            <para>
            Capture requires the user to place or swipe a finger on the sensor; inventory, rename,
            removal and enrollment cancellation do not themselves require a capture. Calls route
            through generic CBOR exchange and do not provide operation-specific SDK presence
            notifications. No local interaction deadline or automatic enrollment cancellation is
            implemented. The SDK's firmware threshold alone does not establish hardware or wire support.
            </para>
            <para>
            This helper borrows the session, protocol and token memory. Keep both objects alive
            and the token unchanged through awaited calls, then clear caller-owned token bytes
            with CryptographicOperations.ZeroMemory, including on failure. Unlike ClientPin, this
            helper does not dispose the protocol. It does not comprehensively clear encoded
            requests or authentication-tag copies. Cancellation or failure is not device rollback.
            </para>
            <para>
            For a valid enrollment response, retain the template ID from begin independently
            of later results. Continue captures using that same ID until the device reports zero
            remaining samples, an unrecoverable error occurs or the user cancels. The current decoder
            defaults missing fields, so IsComplete alone is not proof of successful enrollment.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.#ctor(Yubico.YubiKit.Ctap2.ICtap2Session,Yubico.YubiKit.Ctap2.Pin.IPinUvAuthProtocol,System.ReadOnlyMemory{System.Byte},System.Boolean)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment"/> class.
            </summary>
            <param name="session">The borrowed CTAP2 session to use for communication.</param>
            <param name="protocol">The borrowed, authenticator-supported PIN/UV auth protocol.</param>
            <param name="pinUvAuthToken">Borrowed token bytes with bio enrollment permission for
            the standard command; the caller owns their lifetime and clearing.</param>
            <param name="usePreviewCommand">
            Selects prototype command 0x40 when true, standard 0x09 otherwise, without negotiation.
            CTAP 2.1 (2022-06-21 errata), Section 6.12, forbids prototype use when bioEnroll is
            present and specifies FIDO_2_1_PRE/preview feature detection. Preview authorization
            differs from permission-based standard authorization; this switch does not validate
            the prototype payload format or make the standard-path limitations disappear.
            </param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.GetFingerprintSensorInfoAsync(System.Threading.CancellationToken)">
            <summary>
            Gets information about the fingerprint sensor.
            </summary>
            <param name="cancellationToken">The cancellation token.</param>
            <returns>Information about the fingerprint sensor capabilities.</returns>
            <remarks>
            No capture or token authentication is requested. The current request sends modality
            only, omitting subCommand=7 required by CTAP 2.1 Section 6.7.3. Decoded defaults are
            not proof that a sensor-info response contained the required fields.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.EnrollBeginAsync(System.Nullable{System.Int32},System.Threading.CancellationToken)">
            <summary>
            Begins a new fingerprint enrollment.
            </summary>
            <param name="timeout">
            Optional interaction timeout in milliseconds. Null omits it; no SDK ten-second
            default or host deadline is set. Explicit values currently use the wrong standard
            field (top-level key 6), rather than subCommandParams key 3.
            </param>
            <param name="cancellationToken">The cancellation token.</param>
            <returns>The result of the first enrollment capture.</returns>
            <remarks>
            <para>
            Sends the helper's begin request and decodes the first sample feedback. The
            standard begin operation captures a sample and cancels any unfinished enrollment
            (CTAP 2.1 Section 6.7.4), but the current subcommand/transcript/timeout limitations
            described on this class apply; successful standard enrollment is not guaranteed.
            </para>
            <para>
            Retain the begin TemplateId for every <see cref="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.EnrollCaptureNextSampleAsync(System.ReadOnlyMemory{System.Byte},System.Nullable{System.Int32},System.Threading.CancellationToken)"/> call.
            Standard next responses need not repeat it. Use sample status and remaining count
            as device feedback, not a fixed SDK capture budget. Stop on unrecoverable error or
            user cancellation; missing response fields can currently produce IsComplete=true.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.EnrollCaptureNextSampleAsync(System.ReadOnlyMemory{System.Byte},System.Nullable{System.Int32},System.Threading.CancellationToken)">
            <summary>
            Captures the next sample for an ongoing fingerprint enrollment.
            </summary>
            <param name="templateId">The template ID from the EnrollBegin response.</param>
            <param name="timeout">
            Optional interaction timeout in milliseconds. Null omits it; explicit values
            currently use top-level key 6 instead of the standard parameter-map key 3.
            </param>
            <param name="cancellationToken">The cancellation token.</param>
            <returns>The result of this capture, including remaining samples.</returns>
            <remarks>
            <para>
            Retain and reuse the ID from begin, not this result's potentially empty TemplateId.
            A standard capture requires sensor interaction and reports status/remaining count
            (CTAP 2.1 Section 6.7.4). The current subcommand/transcript/timeout limitations apply;
            IsComplete is only a decoded-count projection, not independently verified persistence.
            </para>
            <para>
            If the sample quality is poor (LastSampleStatus != Good), the sample may
            not count and RemainingSamples may not decrease.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.EnrollCancelAsync(System.Threading.CancellationToken)">
            <summary>
            Cancels an ongoing fingerprint enrollment.
            </summary>
            <param name="cancellationToken">The cancellation token.</param>
            <remarks>
            Intended to send cancelCurrentEnrollment without sensor capture or authentication.
            The current helper sends subcommand 4 rather than standard 3 (CTAP 2.1 Section 6.7.5).
            This is distinct from cancelling a .NET wait or CTAPHID exchange. Cancellation tokens
            do not automatically call this method, and its completion is not a rollback guarantee.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.EnumerateEnrollmentsAsync(System.Threading.CancellationToken)">
            <summary>
            Requests enrollment inventory and decodes the helper's current flat-template shape.
            </summary>
            <param name="cancellationToken">The cancellation token.</param>
            <returns>At most one flat decoded template, or an empty list for InvalidCommand.</returns>
            <remarks>
            No sensor capture is needed. CTAP 2.1 Section 6.7.6 instead returns a key-7 array
            of nested templates (ID key 1, name key 2); this decoder does not handle that shape.
            The standard no-enrollment status is InvalidOption, not InvalidCommand. Because this
            helper converts InvalidCommand to an empty list, emptiness is not evidence of an
            empty device inventory. The class's request/transcript limitations also apply.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.SetFriendlyNameAsync(System.ReadOnlyMemory{System.Byte},System.String,System.Threading.CancellationToken)">
            <summary>
            Sets a friendly name for an enrolled fingerprint template.
            </summary>
            <param name="templateId">The opaque template ID to rename, not fingerprint template bytes.</param>
            <param name="friendlyName">The nonblank friendly name to set. The device's advertised
            UTF-8 byte limit applies; CTAP 2.1 Section 6.7.7 recommends at most the lesser of 64
            bytes and maxTemplateFriendlyName. This helper only checks null/blank locally.</param>
            <param name="cancellationToken">The cancellation token.</param>
            <remarks>
            No sensor capture is needed. The current subcommand and missing-modality
            authentication transcript do not match CTAP 2.1 Section 6.7.7; see the class limitations.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.BioEnrollment.FingerprintBioEnrollment.RemoveEnrollmentAsync(System.ReadOnlyMemory{System.Byte},System.Threading.CancellationToken)">
            <summary>
            Removes an enrolled fingerprint template.
            </summary>
            <param name="templateId">The opaque template ID to remove, not fingerprint template bytes.</param>
            <param name="cancellationToken">The cancellation token.</param>
            <remarks>
            No sensor capture is needed. The standard operation permanently removes the template
            and returns InvalidOption for an unknown ID (CTAP 2.1 Section 6.7.8). This helper's
            subcommand and authentication transcript do not match that operation; see the class
            limitations. A failed call does not establish unchanged device state.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cbor.AaguidConverter">
            <summary>
            Helper for converting between big-endian AAGUID bytes and .NET Guid.
            </summary>
            <remarks>
            CTAP2/WebAuthn encode AAGUIDs in network byte order. The default Guid byte APIs instead use
            little-endian order for the first 4-byte, 2-byte and 2-byte components, leaving the last eight
            bytes unchanged. This serialization convention is independent of native machine byte order.
            This implementation applies the required component reversal only on little-endian hosts;
            on a big-endian host it leaves those components in the wrong byte convention.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.AaguidConverter.FromBigEndianBytes(System.ReadOnlySpan{System.Byte})">
            <summary>
            Converts a big-endian AAGUID byte array to a .NET Guid.
            </summary>
            <param name="bigEndianBytes">Exactly 16 big-endian AAGUID bytes; borrowed, copied and left unchanged.</param>
            <returns>The corresponding Guid.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.AaguidConverter.ToBigEndianBytes(System.Guid)">
            <summary>
            Produces an AAGUID byte array from a .NET Guid.
            </summary>
            <param name="guid">The Guid to convert.</param>
            <returns>A newly allocated, caller-owned 16-byte array; network-order conversion has the
            host limitation described in the class remarks.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cbor.CoseKeyWriter">
            <summary>
            Shared helper for writing COSE_Key maps to CBOR.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CoseKeyWriter.WriteCoseKey(System.Formats.Cbor.CborWriter,System.Collections.Generic.IReadOnlyDictionary{System.Int32,System.Object})">
            <summary>
            Writes a COSE_Key dictionary with numerically sorted insertion keys.
            </summary>
            <remarks>
            Numeric order is not canonical encoded-key order. A Ctap2Canonical writer automatically sorts
            the closed map by encoding; this helper's sorting alone does not supply canonicalization.
            </remarks>
            <param name="writer">The CBOR writer.</param>
            <param name="coseKey">The COSE key as a dictionary of integer keys to values.</param>
            <exception cref="T:System.InvalidOperationException">If an unsupported value type is encountered.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cbor.Ctap2SessionRequestEncoding">
            <summary>
            Encodes credential requests; session validation and client/RP ceremony duties are separate.
            </summary>
            <remarks>
            Nullable booleans preserve omission versus explicit false. Auth bytes and uv are encoded
            independently: callers must omit uv with pinUvAuthParam and select a supported matching protocol.
            The version-2 fallback is only an encoding default. Inputs are borrowed during synchronous Build;
            the returned command-prefixed array is a new copy that its caller must clear when sensitive.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.Ctap2SessionRequestEncoding.ThrowIfDuplicateCredentialParameters(System.Collections.Generic.IReadOnlyList{Yubico.YubiKit.Ctap2.PublicKeyCredentialParameters},System.String)">
            <summary>
            CTAP 2.1-2.3 §6.1 pubKeyCredParams: "The array is ordered from most preferred to least preferred
            and MUST NOT include duplicate entries." The requirement is on the platform, so the SDK enforces it.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder">
            <summary>
            Fluent builder for constructing CTAP2 requests with canonical CBOR encoding.
            </summary>
            <remarks>
            <para>
            CTAP2 requires deterministic CBOR encoding per specification:
            https://fidoalliance.org/specs/fido-v2.1-ps-20210615/fido-client-to-authenticator-protocol-v2.1-ps-errata-20220621.html#ctap2-canonical-cbor-encoding-form
            </para>
            <para>
            Reusing a key replaces its previous value. Byte-string and encoded-value methods immediately
            retain private copies; this builder has no disposal or clearing API, and replacing a value does
            not clear its old copy. Callbacks run on each Build, not when added, and must write one complete value.
            Keep captured storage valid until the last Build. For sensitive bytes, WithValue can write
            directly without the WithBytes input clone, but does not guarantee all writer storage is cleared.
            </para>
            <para>
            The Ctap2Canonical writer automatically sorts map key encodings when each map is completed.
            Parameter insertion here is numerically sorted, which is not generally canonical encoded-key
            order for mixed positive/negative keys. Writer canonicalization does not validate command schema,
            authorization, CTAP's nesting limit or the authenticator's maximum message size.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.Create(System.Byte)">
            <summary>
            Creates a new builder for the specified CTAP command.
            </summary>
            <param name="command">The CTAP command byte.</param>
            <returns>A new builder instance.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithInt(System.Int32,System.Int32)">
            <summary>
            Adds an integer parameter.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="value">The integer value.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithUInt(System.Int32,System.UInt32)">
            <summary>
            Adds an unsigned integer parameter.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="value">The unsigned integer value.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithBytes(System.Int32,System.ReadOnlySpan{System.Byte})">
            <summary>
            Immediately copies and retains a byte-string parameter for subsequent builds.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="value">The byte array value.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithBytes(System.Int32,System.ReadOnlyMemory{System.Byte})">
            <summary>
            Immediately copies and retains a byte-string parameter from memory for subsequent builds.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="value">The memory value.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithString(System.Int32,System.String)">
            <summary>
            Adds a string parameter.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="value">The string value.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithBool(System.Int32,System.Boolean)">
            <summary>
            Adds a boolean parameter.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="value">The boolean value.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithValue(System.Int32,System.Action{System.Formats.Cbor.CborWriter})">
            <summary>
            Adds a parameter using a caller-provided CBOR writer callback.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="writeValue">Action invoked on each Build to write one complete CBOR value.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithMap(System.Int32,System.Action{System.Formats.Cbor.CborWriter})">
            <summary>
            Adds a CBOR map parameter.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="writeMap">Deferred action that writes the complete map, including start/end markers.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithArray(System.Int32,System.Action{System.Formats.Cbor.CborWriter})">
            <summary>
            Adds a CBOR array parameter.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="writeArray">Deferred action that writes the complete array, including start/end markers.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.WithEncodedValue(System.Int32,System.ReadOnlyMemory{System.Byte})">
            <summary>
            Immediately copies and retains a pre-encoded CBOR value for subsequent builds.
            </summary>
            <param name="key">The CBOR map key.</param>
            <param name="encodedValue">The pre-encoded CBOR bytes.</param>
            <returns>This builder for chaining.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.Build">
            <summary>
            Builds the CTAP request as a byte array.
            </summary>
            <remarks>Each call returns a new caller-owned command-prefixed array. Clear it when it contains
            secrets and is no longer needed. Only the Encode intermediate copy is cleared here, not
            retained inputs, captured callback storage, the returned array or all writer-internal storage.</remarks>
            <returns>The serialized CTAP request (command byte + CBOR payload).</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapRequestBuilder.BuildAsMemory">
            <summary>
            Builds a new CTAP request array and returns its read-only view.
            </summary>
            <remarks>This is the same allocation/ownership as Build, not a borrowed-input view or a
            disposable owner. Read-only access does not automatically clear secret bytes.</remarks>
            <returns>The serialized CTAP request.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser">
            <summary>
            Utility class for parsing CTAP2 CBOR responses.
            Provides common deserialization patterns to reduce duplication across response models.
            </summary>
            <remarks>Optional readers inspect the current encoded value, not whether a map key was absent.
            The consuming model decides which fields are required and whether null/undefined is permitted.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadIntKeyMap(System.Formats.Cbor.CborReader,System.Action{System.Int32,System.Formats.Cbor.CborReader})">
            <summary>
            Reads a CBOR map with integer keys and invokes the handler for each key-value pair.
            </summary>
            <remarks>
            This is the most common pattern in CTAP2 responses where maps use integer keys
            (e.g., 0x01, 0x02, etc.) to identify fields.
            </remarks>
            <param name="reader">The CBOR reader positioned at the start of a map.</param>
            <param name="fieldHandler">
            Action invoked for each field. Parameters are (key, reader).
            The handler must consume exactly one complete value, using SkipValue for an unknown key.
            </param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadTextKeyMap(System.Formats.Cbor.CborReader,System.Action{System.String,System.Formats.Cbor.CborReader})">
            <summary>
            Reads a CBOR map with text (string) keys and invokes the handler for each key-value pair.
            </summary>
            <remarks>
            Used for extension outputs and other maps that use string keys (e.g., "hmac-secret").
            </remarks>
            <param name="reader">The CBOR reader positioned at the start of a map.</param>
            <param name="fieldHandler">
            Action invoked for each field. Parameters are (key, reader).
            The handler must consume exactly one complete value, using SkipValue for an unknown key.
            </param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ToNullableMemory(System.Byte[])">
            <summary>
            Converts a nullable byte array to nullable ReadOnlyMemory.
            </summary>
            <param name="data">The byte array to convert, or null.</param>
            <returns>A view of the same array without copying or transferring ownership; null for null
            input and a present empty view for an empty array.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadArray(System.Formats.Cbor.CborReader,System.Action{System.Formats.Cbor.CborReader})">
            <summary>
            Reads a CBOR array and invokes the handler for each element.
            </summary>
            <param name="reader">The CBOR reader positioned at the start of an array.</param>
            <param name="elementHandler">
            Action invoked for each element. The handler should read exactly one value from the reader.
            </param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadArrayAsList``1(System.Formats.Cbor.CborReader,System.Func{System.Formats.Cbor.CborReader,``0})">
            <summary>
            Reads a CBOR array and returns a list of parsed elements.
            </summary>
            <typeparam name="T">The type of elements to parse.</typeparam>
            <param name="reader">The CBOR reader positioned at the start of an array.</param>
            <param name="elementParser">
            Function that parses a single element from the reader and returns it.
            </param>
            <returns>A list of parsed elements.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadOptionalInt32(System.Formats.Cbor.CborReader)">
            <summary>
            Reads the current integer value, consuming CBOR null or undefined as null.
            </summary>
            <param name="reader">The CBOR reader.</param>
            <returns>The integer value, or null if the value is null/undefined.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadOptionalBoolean(System.Formats.Cbor.CborReader)">
            <summary>
            Reads the current boolean value, consuming CBOR null or undefined as null.
            </summary>
            <param name="reader">The CBOR reader.</param>
            <returns>The boolean value, or null if the value is null/undefined.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadOptionalByteString(System.Formats.Cbor.CborReader)">
            <summary>
            Reads the current byte string, consuming CBOR null or undefined as null.
            </summary>
            <param name="reader">The CBOR reader.</param>
            <returns>The byte array, or null if the value is null/undefined.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cbor.CtapResponseParser.ReadOptionalTextString(System.Formats.Cbor.CborReader)">
            <summary>
            Reads the current text string, consuming CBOR null or undefined as null.
            </summary>
            <param name="reader">The CBOR reader.</param>
            <returns>The text string, or null if the value is null/undefined.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Config.AuthenticatorConfig">
            <summary>
            Provides operations for configuring CTAP2 authenticator settings.
            </summary>
            <remarks>
            <para>
            Authenticator configuration allows modifying authenticator behavior such as
            enabling enterprise attestation, toggling the always-UV requirement, and
            setting minimum PIN length policies.
            </para>
            <para>
            This helper always sends authentication using the supplied protocol and token with
            <see cref="F:Yubico.YubiKit.Ctap2.Pin.PinUvAuthTokenPermissions.AuthenticatorConfig"/> permission. CTAP 2.1
            (2022-06-21 errata), Section 6.11, also permits configuration without authorization
            in specified unprotected-device states; this helper does not expose that route.
            Acquiring the permission through built-in UV requires configured UV, pinUvAuthToken
            and uvAcfg support, not just an authenticatorConfig capability advertisement.
            </para>
            <para>
            Read fresh GetInfo before choosing an operation: authnrCfg=true advertises command
            support, while individual subcommands can still be unsupported. Check ep, alwaysUv
            or setMinPINLength as appropriate. The helper does not query or enforce capabilities
            or firmware thresholds. The SDK's firmware feature metadata is not qualified support
            for every setting on every model. Read GetInfo again after success to inspect results.
            </para>
            <para>
            The helper borrows the session, protocol and token memory; unlike ClientPin it does
            not dispose the protocol. Keep both objects alive and token bytes unchanged through
            awaited calls, then clear the caller-owned token with CryptographicOperations.ZeroMemory,
            including on failure. No token acquisition, refresh, permission or expiry validation is
            performed locally. Request and authentication-tag copies are not comprehensively cleared
            by this helper. Device changes persist beyond the helper's lifetime; failure or
            cancellation is not rollback, and the helper performs no verification read or restoration.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Config.AuthenticatorConfig.#ctor(Yubico.YubiKit.Ctap2.ICtap2Session,Yubico.YubiKit.Ctap2.Pin.IPinUvAuthProtocol,System.ReadOnlyMemory{System.Byte})">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Ctap2.Config.AuthenticatorConfig"/> class.
            </summary>
            <param name="session">The borrowed CTAP2 session to use for communication.</param>
            <param name="protocol">The borrowed, authenticator-supported PIN/UV auth protocol.</param>
            <param name="pinUvAuthToken">Borrowed token bytes with authenticator config permission;
            the caller owns their lifetime and clearing.</param>
            <exception cref="T:System.ArgumentNullException">Thrown when session or protocol is null.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Config.AuthenticatorConfig.EnableEnterpriseAttestationAsync(System.Threading.CancellationToken)">
            <summary>
            Enables enterprise attestation on the authenticator.
            </summary>
            <param name="cancellationToken">The cancellation token.</param>
            <remarks>
            <para>
            Enables the device feature; it does not itself create a credential or return a
            certificate. An eligible MakeCredential request must separately request enterprise
            attestation, with the appropriate platform/RP policy and device provisioning.
            </para>
            <para>
            Presence of ep advertises support; false means supported but disabled. Enabling is
            idempotent under CTAP 2.1 (2022-06-21 errata), Section 6.11.1. Read fresh GetInfo after
            success to check ep. This helper has no disable method. The standard FIDO reset
            disables enterprise attestation (Section 7.1.3), but also invalidates credentials;
            do not use it as routine configuration rollback.
            </para>
            </remarks>
            <exception cref="T:Yubico.YubiKit.Ctap2.CtapException">Thrown when the operation fails.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Config.AuthenticatorConfig.ToggleAlwaysUvAsync(System.Threading.CancellationToken)">
            <summary>
            Toggles the alwaysUv setting on the authenticator.
            </summary>
            <param name="cancellationToken">The cancellation token.</param>
            <remarks>
            <para>
            alwaysUv concerns credential creation and authentication, not every protocol
            operation or metadata query (CTAP 2.1, 2022-06-21 errata, Section 7.2.3). Its
            presence indicates support and its Boolean value is the current enabled state.
            </para>
            <para>
            This toggles state rather than setting a requested value. Read fresh GetInfo before
            deciding to toggle and again after success. The device can refuse disabling with
            OperationDenied (Section 6.11.2); support does not guarantee both directions work.
            Enabling can also disable makeCredUvNotRqd. If a sent command's outcome is unknown,
            reconcile the current state before another toggle: blindly repeating it can invert
            the intended result. No automatic retry or rollback is provided.
            </para>
            </remarks>
            <exception cref="T:Yubico.YubiKit.Ctap2.CtapException">Thrown when the operation fails.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Config.AuthenticatorConfig.SetMinPinLengthAsync(System.Int32,System.Collections.Generic.IReadOnlyList{System.String},System.Boolean,System.Threading.CancellationToken)">
            <summary>
            Sets the minimum PIN length required by the authenticator.
            </summary>
            <param name="newMinPinLength">The new ClientPIN minimum in Unicode code points.
            This helper accepts 4-63; device policy and UTF-8 PIN-byte limits apply separately.</param>
            <param name="rpIds">Optional replacement mutable list of RP IDs allowed to receive
            minPinLength extension output. Null and empty lists are omitted, not requests to clear the list.</param>
            <param name="forceChangePin">If true, request a PIN change before PIN-token acquisition.
            False is omitted, not an explicit request to clear forcePINChange.</param>
            <param name="cancellationToken">The cancellation token.</param>
            <remarks>
            <para>
            The new minimum PIN length must be greater than or equal to the
            current minimum PIN length. The authenticator enforces this during
            PIN set and PIN change operations.
            </para>
            <para>
            Under CTAP 2.1 (2022-06-21 errata), Section 6.11.4, forceChangePin=true, or an
            existing PIN shorter than the new minimum, sets forcePINChange. This does not
            erase the current PIN: use it for ChangePin to satisfy policy. PIN-token acquisition
            is blocked until a successful change. In this revision, legacy getPinToken (0x05)
            returns PinInvalid (Section 6.5.5.7.1); permission-based PIN-token acquisition (0x09)
            returns PinPolicyViolation (Section 6.5.5.7.2). Forcing a change
            when no PIN is set produces PinNotSet. A false argument does not prevent a higher
            minimum from forcing a change.
            </para>
            <para>
            Check setMinPINLength support, and minPinLength extension support before supplying
            RP IDs. A nonempty list replaces previously added mutable recipients and is combined
            with any immutable preconfigured list; it is not an append-only grant. Device storage
            limits still apply. This helper always sends a numeric minimum and cannot express
            a policy-only request with the length omitted. It does not change RP account policy
            or verify extension output; read fresh GetInfo after success to inspect minimum/force state.
            </para>
            </remarks>
            <exception cref="T:System.ArgumentOutOfRangeException">
            Thrown when <paramref name="newMinPinLength"/> is less than 4 or greater than 63.
            </exception>
            <exception cref="T:Yubico.YubiKit.Ctap2.CtapException">Thrown when the operation fails.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Config.ConfigSubCommand">
            <summary>
            CTAP2.1 authenticatorConfig sub-commands.
            </summary>
            <remarks>
            <para>
            See CTAP 2.1 (2022-06-21 errata), Section 6.11, authenticatorConfig (0x0D).
            The active helper uses only subcommands 1-3. The unused constants 4 and 5 below do not
            match subcommands defined in that revision and must not be used as standard identifiers.
            </para>
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Config.ConfigSubCommand.EnableEnterpriseAttestation">
            <summary>
            Enable enterprise attestation (0x01).
            </summary>
            <remarks>
            Enables the authenticator to return enterprise attestation during
            credential creation when requested. Requires ep option support.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Config.ConfigSubCommand.ToggleAlwaysUv">
            <summary>
            Toggle always require UV (0x02).
            </summary>
            <remarks>
            Toggles the alwaysUv option for credential creation/authentication.
            Disabling can be refused; read fresh GetInfo to reconcile state.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Config.ConfigSubCommand.SetMinPinLength">
            <summary>
            Set minimum PIN length (0x03).
            </summary>
            <remarks>
            Sets the ClientPIN minimum in Unicode code points and optionally its RP reporting list/force-change policy.
            The new value must be greater than or equal to the current value.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Config.ConfigSubCommand.VendorPrototype">
            <summary>
            Unused local prototype constant (0x04), not the standard vendorPrototype identifier.
            </summary>
            <remarks>
            CTAP 2.1 (2022-06-21 errata), Section 6.11.3, assigns vendorPrototype=0xFF.
            No vendor wire definition is established for this local value.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Config.ConfigSubCommand.SetMinPinLengthRpIds">
            <summary>
            Unused local minimum-PIN/RP-list constant (0x05).
            </summary>
            <remarks>
            The cited CTAP 2.1 revision defines RP IDs as parameters of subcommand 3,
            not a separate subcommand 5. AuthenticatorConfig uses that standard parameter map.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm">
            <summary>
            COSE algorithm identifier.
            </summary>
            <param name="Value">The COSE algorithm integer value.</param>
            <remarks>
            This is a value type carrier for COSE algorithm identifiers. Unlike an enum,
            it can represent unknown algorithm values. See
            <see href="https://www.iana.org/assignments/cose/cose.xhtml">COSE Algorithm Registry</see>.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.#ctor(System.Int32)">
            <summary>
            COSE algorithm identifier.
            </summary>
            <param name="Value">The COSE algorithm integer value.</param>
            <remarks>
            This is a value type carrier for COSE algorithm identifiers. Unlike an enum,
            it can represent unknown algorithm values. See
            <see href="https://www.iana.org/assignments/cose/cose.xhtml">COSE Algorithm Registry</see>.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Value">
            <summary>The COSE algorithm integer value.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Es256">
            <summary>
            ES256: ECDSA with SHA-256; the WebAuthn credential-key profile uses P-256.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.EdDsa">
            <summary>
            Generic EdDSA identifier (-8); the WebAuthn credential-key profile uses Ed25519.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Esp256">
            <summary>
            ESP256: ECDSA using P-256 and SHA-256 (-9), not ES256K/secp256k1 (-47).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Es384">
            <summary>
            ES384: ECDSA with SHA-384; the WebAuthn credential-key profile uses P-384.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Rs256">
            <summary>
            RSASSA-PKCS1-v1_5 with SHA-256.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Esp256SplitArkgPlaceholder">
            <summary>
            ESP256 split-key ARKG placeholder for the previewSign extension.
            </summary>
            <remarks>
            <para>
            <b>WARNING -- EXPERIMENTAL --</b> ARKG previewSign identifiers are not ready for production use and must
            not be treated as production cryptographic guidance.
            </para>
            <para>
            This is the wire-level COSE algorithm identifier for the ARKG-P256-ESP256 signing operation,
            written under key 3 of a <c>COSE_Sign_Args</c> map (previewSign authentication request).
            Do NOT confuse with the seed-key COSE-key alg identifier <c>-65700</c>
            used by this SDK's experimental seed-key profile, which lives at a different protocol layer.
            </para>
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.ArkgP256">
            <summary>
            ARKG-P256-ESP256 signing-operation algorithm identifier (alias of
            <see cref="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Esp256SplitArkgPlaceholder"/>; value <c>-65539</c>).
            </summary>
            <remarks>
            <para>
            <b>WARNING -- EXPERIMENTAL --</b> ARKG previewSign helpers and identifiers are not ready for production use
            and must not be treated as production cryptographic guidance.
            </para>
            <para>
            Intent-revealing alias for the experimental signing-operation placeholder. Its value is identical
            to <see cref="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Esp256SplitArkgPlaceholder"/>; the alias does not make the identifier standardized
            or promise a stable future wire profile.
            </para>
            <para>
            Wire value: <c>-65539</c>. This is the request-side signing algorithm and goes on the wire
            at <c>COSE_Sign_Args</c> key 3. It is NOT the seed-key COSE-key alg (which is <c>-65700</c>
            in this SDK's experimental seed-key profile).
            </para>
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.ArkgP256SeedKey">
            <summary>
            ARKG-P256 seed-key COSE algorithm identifier (value <c>-65700</c>).
            </summary>
            <remarks>
            <para>
            <b>WARNING -- EXPERIMENTAL --</b> ARKG previewSign seed-key handling is not ready for production use and
            must not be treated as production cryptographic guidance.
            </para>
            <para>
            This is the seed-key COSE-key <c>alg</c> parameter (key 3) identifying an ARKG-P256
            placeholder key structure emitted by this SDK, not a registered standard seed-key profile.
            It marks a COSE_Key as containing BL at -1 and KEM at -2 instead of ordinary EC2 parameters.
            See <see cref="T:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey"/> for the byte-string-wrapped nested-map encoding and draft differences.
            </para>
            <para>
            Do NOT confuse with the signing-operation algorithm <see cref="F:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.ArkgP256"/> (<c>-65539</c>),
            which is written in <c>COSE_Sign_Args</c> key 3 during previewSign authentication requests.
            The two constants live at different protocol layers and are NOT interchangeable.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.IsKnown">
            <summary>
            Gets whether this SDK recognizes the integer, including its experimental placeholders.
            </summary>
            <remarks>This does not establish registry status, algorithm implementation, device availability or production approval.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.Other(System.Int32)">
            <summary>
            Creates a COSE algorithm from an arbitrary integer value.
            </summary>
            <param name="value">The COSE algorithm value.</param>
            <returns>A <see cref="T:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm"/> with the specified value.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm.ToString">
            <summary>
            Returns the algorithm name if known, otherwise "COSE(value)".
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey">
            <summary>
            ARKG-P256 seed-key COSE_Key variant (alg -65700).
            </summary>
            <remarks>
            <para>
            <b>WARNING -- EXPERIMENTAL --</b> ARKG previewSign seed-key support is not ready for production use and
            must not be treated as production cryptographic guidance.
            </para>
            <para>
            The experimental SDK profile carries blinding and KEM public keys for offline key derivation.
            Unlike ordinary EC2 curve/coordinate parameters, -1 and -2 contain byte strings whose contents
            are encoded COSE EC2 maps. The decoder also accepts direct nested maps through CoseKey.Decode.
            </para>
            <para>
            SDK-emitted wire profile (not a claim of draft or vendor conformance):
            - kty (1) = 2 (EC2 family)
            - alg (3) = -65700 (ARKG-P256 seed-key marker)
            - -1 = pkBl as a byte string containing an EC2/P-256 COSE map
            - -2 = pkKem as a byte string containing an EC2/P-256 COSE map
            - -3 = derived-key algorithm (e.g., -9 for Esp256)
            </para>
            <para>
            draft-bradleylundberg-cfrg-arkg-10 §5.1 agrees on BL=-1/KEM=-2 and illustrates derived ESP256=-9;
            §§5.1/5.2/8.3 explicitly specify the ARKG-P256 seed algorithm placeholder -65700. The SDK's outer
            kty=2 and byte-string wrappers differ from the draft's kty placeholder -65537 and direct maps.
            The SDK also requires an integer derived algorithm; the draft's dkalg is optional and permits
            int/tstr. These agreements do not establish full-profile interoperability. The Internet-Draft is
            work in progress, with stated expiry 31 August 2026, not production cryptographic authority.
            </para>
            <para>
            Decode dispatches on alg=-65700 before outer kty, then requires nested EC2 carriers and coordinates
            no longer than 32 bytes. It does not check nested curve=1 or point validity. Coordinates, including
            short/empty values, are left-padded into 04 || X[32] || Y[32] for downstream helpers; that SEC1 layout
            is not proof of a valid P-256 point. Direct construction borrows both points and does not enforce
            the algorithm marker or point shape; keep supplied storage unchanged during use.
            </para>
            </remarks>
            <param name="Algorithm">Seed marker for this profile (ArkgP256SeedKey=-65700); construction does not enforce it.</param>
            <param name="DerivedKeyAlgorithm">Algorithm for the derived signing key (e.g., Esp256 = -9).</param>
            <param name="KemPublicKey">KEM public key as 65-byte SEC1 uncompressed point.</param>
            <param name="BlPublicKey">Blinding public key as 65-byte SEC1 uncompressed point.</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.#ctor(Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm,Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm,System.ReadOnlyMemory{System.Byte},System.ReadOnlyMemory{System.Byte})">
            <summary>
            ARKG-P256 seed-key COSE_Key variant (alg -65700).
            </summary>
            <remarks>
            <para>
            <b>WARNING -- EXPERIMENTAL --</b> ARKG previewSign seed-key support is not ready for production use and
            must not be treated as production cryptographic guidance.
            </para>
            <para>
            The experimental SDK profile carries blinding and KEM public keys for offline key derivation.
            Unlike ordinary EC2 curve/coordinate parameters, -1 and -2 contain byte strings whose contents
            are encoded COSE EC2 maps. The decoder also accepts direct nested maps through CoseKey.Decode.
            </para>
            <para>
            SDK-emitted wire profile (not a claim of draft or vendor conformance):
            - kty (1) = 2 (EC2 family)
            - alg (3) = -65700 (ARKG-P256 seed-key marker)
            - -1 = pkBl as a byte string containing an EC2/P-256 COSE map
            - -2 = pkKem as a byte string containing an EC2/P-256 COSE map
            - -3 = derived-key algorithm (e.g., -9 for Esp256)
            </para>
            <para>
            draft-bradleylundberg-cfrg-arkg-10 §5.1 agrees on BL=-1/KEM=-2 and illustrates derived ESP256=-9;
            §§5.1/5.2/8.3 explicitly specify the ARKG-P256 seed algorithm placeholder -65700. The SDK's outer
            kty=2 and byte-string wrappers differ from the draft's kty placeholder -65537 and direct maps.
            The SDK also requires an integer derived algorithm; the draft's dkalg is optional and permits
            int/tstr. These agreements do not establish full-profile interoperability. The Internet-Draft is
            work in progress, with stated expiry 31 August 2026, not production cryptographic authority.
            </para>
            <para>
            Decode dispatches on alg=-65700 before outer kty, then requires nested EC2 carriers and coordinates
            no longer than 32 bytes. It does not check nested curve=1 or point validity. Coordinates, including
            short/empty values, are left-padded into 04 || X[32] || Y[32] for downstream helpers; that SEC1 layout
            is not proof of a valid P-256 point. Direct construction borrows both points and does not enforce
            the algorithm marker or point shape; keep supplied storage unchanged during use.
            </para>
            </remarks>
            <param name="Algorithm">Seed marker for this profile (ArkgP256SeedKey=-65700); construction does not enforce it.</param>
            <param name="DerivedKeyAlgorithm">Algorithm for the derived signing key (e.g., Esp256 = -9).</param>
            <param name="KemPublicKey">KEM public key as 65-byte SEC1 uncompressed point.</param>
            <param name="BlPublicKey">Blinding public key as 65-byte SEC1 uncompressed point.</param>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.DerivedKeyAlgorithm">
            <summary>Algorithm for the derived signing key (e.g., Esp256 = -9).</summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.KemPublicKey">
            <summary>KEM public key as 65-byte SEC1 uncompressed point.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.BlPublicKey">
            <summary>Blinding public key as 65-byte SEC1 uncompressed point.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.KeyType">
            <summary>
            Gets the COSE key type (kty = 2, EC2 family).
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.Algorithm">
            <summary>
            Gets the supplied seed-key algorithm identifier; this profile uses -65700.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.Decode(System.Collections.Generic.Dictionary{System.Int32,System.Object},Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm)">
            <summary>
            Decodes an ARKG-P256 seed-key from CBOR parameters.
            </summary>
            <param name="parameters">Decoded COSE_Key map parameters.</param>
            <param name="seedKeyAlgorithm">Seed-key COSE algorithm (must be -65700).</param>
            <returns>A <see cref="T:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey"/> instance.</returns>
            <exception cref="T:System.InvalidOperationException">
            A required parameter is missing, a nested key is not an EC2 carrier, or coordinates exceed 32 bytes.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.ReconstructSec1Uncompressed(Yubico.YubiKit.Ctap2.Cose.CoseEc2Key,System.String)">
            <summary>
            Reconstructs a 65-byte SEC1 uncompressed point from a CoseEc2Key.
            </summary>
            <param name="ec2">The EC2 key containing x and y coordinates.</param>
            <param name="keyName">Key name for error messages (e.g., "KEM", "BL").</param>
            <returns>65-byte array: 0x04 || x (32 bytes) || y (32 bytes).</returns>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.Encode">
            <summary>
            Encodes this ARKG-P256 seed-key to CBOR bytes.
            </summary>
            <returns>A new byte array containing the encoded COSE map with byte-string-wrapped EC2 key maps.</returns>
            <remarks>
            Emits kty=2, the supplied alg, -1=bstr(encoded BL map), -2=bstr(encoded KEM map), and
            -3=derivedAlg. Nested maps use EC2/P-256/ES256 labels; the outer profile expects alg=-65700.
            SEC1 length/prefix are checked during encoding, but mathematical point validity is not.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseArkgP256SeedKey.Sec1ToCoseEc2(System.ReadOnlySpan{System.Byte},Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm)">
            <summary>
            Converts a 65-byte SEC1 uncompressed point to a CoseEc2Key.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cose.CoseKey">
            <summary>
            COSE_Key base type representing cryptographic public keys.
            </summary>
            <remarks>
            See <see href="https://datatracker.ietf.org/doc/html/rfc8152#section-7">
            COSE Key Objects</see>.
            <para>
            These are public-key data carriers, not mathematical validators or trusted-algorithm selectors.
            Direct construction retains supplied byte memory. Decode materializes modeled byte strings and
            copies CoseOtherKey raw input; modeled encoders write new arrays and omit unmodeled parameters.
            Unknown identifiers remain representable without implying protocol or cryptographic validity.
            PIN/UV key agreement has its own required EC2/P-256/alg=-25 structure; these generic carriers are
            not a substitute for that security-critical validation.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseKey.KeyType">
            <summary>
            Gets the COSE key type (kty parameter, label 1).
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Ctap2.Cose.CoseKey.Algorithm">
            <summary>
            Gets the COSE algorithm identifier (alg parameter, label 3).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseKey.Decode(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes a COSE_Key from CBOR-encoded bytes.
            </summary>
            <param name="coseEncoded">CBOR-encoded COSE_Key.</param>
            <returns>A modeled key, an algorithm-selected experimental ARKG seed, or an opaque other-key carrier.</returns>
            <remarks>
            Requires int32 kty/alg and the modeled parameter types for EC2, OKP and RSA. Unknown labels are
            skipped for modeled keys; Other preserves a copy of the complete supplied bytes. Canonical CBOR
            checks do not establish curve/algorithm compatibility, coordinate/point validity or complete
            envelope consumption; there is no remaining-byte check after the map.
            </remarks>
            <exception cref="T:System.Formats.Cbor.CborContentException">The reader rejects malformed or noncanonical CBOR.</exception>
            <exception cref="T:System.InvalidOperationException">A required modeled parameter is missing or has an unsupported representation.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseKey.Encode">
            <summary>
            Encodes this COSE_Key to CBOR bytes.
            </summary>
            <returns>CBOR-encoded bytes.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Ctap2.Cose.CoseEc2Key">
            <summary>
            EC2 (Elliptic Curve) COSE key.
            </summary>
            <param name="Algorithm">COSE algorithm identifier.</param>
            <param name="Curve">Curve identifier (crv, label -1).</param>
            <param name="X">Borrowed X-coordinate bytes (label -2); construction does not validate points.</param>
            <param name="Y">Borrowed Y-coordinate bytes (label -3).</param>
        </member>
        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseEc2Key.#ctor(Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm,System.Int32,System.ReadOnlyMemory{System.Byte},System.ReadOnlyMemory{System.Byte})">
            <summary>
