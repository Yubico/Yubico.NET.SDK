        <member name="M:Yubico.YubiKit.Ctap2.Cose.CoseRsaKey.#ctor(Yubico.YubiKit.Ctap2.Cose.CoseAlgorithm,System.ReadOnlyMemory{System.Byte},System.ReadOnlyMemory{System.Byte})">
            <summary>
