        <member name="P:Yubico.YubiKit.Ctap2.CredentialManagement.StoredCredentialInfo.RawData">
            <summary>
            Gets the complete original CBOR-encoded authenticator response.
            </summary>
            <remarks>
            This view is valid until this instance is disposed. Copy it before disposal if it must be
            retained; the caller must clear any retained secret-bearing copy when finished, including on failure.
            Disposal clears only the private response copy owned by this instance; it does not
            clear the buffer passed to <see cref="M:Yubico.YubiKit.Ctap2.CredentialManagement.StoredCredentialInfo.Decode(System.ReadOnlyMemory{System.Byte})"/> or transport buffers.
            </remarks>
            <exception cref="T:System.ObjectDisposedException">The instance has been disposed.</exception>
        </member>
