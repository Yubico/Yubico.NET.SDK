        <member name="T:Yubico.YubiKit.Core.Protocols.Otp.Hid.OtpHidTouchTimeoutException">
            <summary>
                Identifies the OTP HID timeout that occurs only after the device reports an active user-touch wait.
            </summary>
            <remarks>
                This internal distinction lets the YubiOTP applet classify confirmed touch expiration separately from
                transport and device-readiness timeouts while preserving compatibility with <see cref="T:System.TimeoutException" />
                catches.
            </remarks>
        </member>
