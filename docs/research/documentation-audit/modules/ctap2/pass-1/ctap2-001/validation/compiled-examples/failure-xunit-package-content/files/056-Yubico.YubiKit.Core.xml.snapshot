            <returns>The response data from the YubiKey (including CRC if present).</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.Otp.Hid.IOtpHidProtocol.SendAndReceiveAsync(System.Byte,System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Credentials.UserPresenceNotification,System.Threading.CancellationToken)">
