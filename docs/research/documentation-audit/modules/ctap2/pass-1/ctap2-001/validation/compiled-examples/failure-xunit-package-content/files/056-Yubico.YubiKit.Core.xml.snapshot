        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ArkgPrimitives">
            <summary>
            Factory for the default <see cref="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives"/> implementation.
            </summary>
            <remarks>
            This factory creates instances of the platform-specific ARKG-P256
            cryptographic primitives implementation. The default implementation
            uses OpenSSL via P/Invoke through the Yubico.NativeShims library.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitives.Create">
            <summary>
            Creates the OpenSSL-backed ARKG primitives instance.
            </summary>
            <returns>
            An <see cref="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives"/> implementation that performs
            ARKG-P256 operations using OpenSSL.
            </returns>
            <remarks>
            <para>
            This method returns a new instance on each call. The implementation
            is stateless and thread-safe.
            </para>
            <para>
            For testing or custom implementations, applications can replace the
            default factory by setting the <c>ArkgPrimitivesCreator</c> property
            in <see cref="T:Yubico.YubiKit.Core.Cryptography.CryptographyProviders"/>.
            </para>
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl">
            <summary>
            OpenSSL-backed implementation of <see cref="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives"/> for ARKG-P256.
            </summary>
            <remarks>
            Provides the security-critical primitives required by the ARKG-P256
            algorithm: on-curve point validation, ECDH shared-secret computation,
            and the full draft-bradleylundberg-cfrg-arkg-09 derivation. Point math
            goes through Yubico.NativeShims (OpenSSL); scalar reduction uses
            <see cref="T:System.Numerics.BigInteger"/>.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl.IsPointOnCurve(System.ReadOnlySpan{System.Byte})">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl.ComputeEcdhSharedSecret(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ArkgPrimitivesOpenSsl.Derive(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <inheritdoc />
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder">
            <summary>
            A class that converts ASN.1 DER encoded private keys to parameters and values.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreatePrivateKey(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/> from a PKCS#8
            ASN.1 DER-encoded private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            A new disposable private-key object that owns its decoded key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">Thrown if privateKey does not match expected format.</exception>
            <exception cref="T:System.InvalidOperationException">Thrown if the algorithm is not supported</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreateCurve25519Key(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey"/> from a PKCS#8
            ASN.1 DER-encoded private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            A new disposable private-key object that owns its decoded key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">Thrown if privateKey does not match expected format.</exception>
            <exception cref="T:System.ArgumentException">Thrown if the algorithm is not <see cref="F:Yubico.YubiKit.Core.Cryptography.Oids.X25519"/> or 
            <see cref="F:Yubico.YubiKit.Core.Cryptography.Oids.Ed25519"/></exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.GetCurve25519PrivateKeyData(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes a Curve25519 private value and its key type from a PKCS#8 private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            A caller-owned 32-byte private-value array and the decoded key type. The caller must clear
            the returned array when it is no longer needed.
            </returns>
            <exception cref="T:System.ArgumentException">The algorithm is not X25519 or Ed25519.</exception>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The private-key encoding or length is invalid.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreateECParameters(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes elliptic-curve parameters from a PKCS#8 private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            Parameters containing caller-owned arrays. The caller must clear <see cref="F:System.Security.Cryptography.ECParameters.D"/>
            when the parameters are no longer needed.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The private-key encoding is invalid.</exception>
            <exception cref="T:System.InvalidOperationException">The algorithm or curve is unsupported.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyDecoder.CreateRSAParameters(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Decodes RSA parameters from a PKCS#8 private key.
            </summary>
            <param name="pkcs8EncodedKey">
            The borrowed ASN.1 DER-encoded private key. This method does not modify or clear the input.
            </param>
            <returns>
            Parameters containing caller-owned arrays. The caller must clear the private parameter
            arrays when they are no longer needed.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The private-key encoding is invalid.</exception>
            <exception cref="T:System.InvalidOperationException">The algorithm is unsupported.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder">
            <summary>
            A class that converts private key parameters to ASN.1 DER encoding.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.ReadOnlyMemory{System.Byte},System.Nullable{System.ReadOnlyMemory{System.Byte}},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Converts a private key and its corresponding public point to ASN.1 DER encoded format.
            </summary>
            <param name="privateKey">The private key as a byte array.</param>
            <param name="publicPoint">The public key point as a byte array (optional).</param>
            <param name="keyType">The type of the key.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key.</returns>
            <remarks>
            Unlike <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.Security.Cryptography.ECParameters)"/>, the EC branch here does not length-check
            <paramref name="privateKey"/> against the curve. It takes raw values rather than a structure
            that names its own curve, and Curve25519 — the only key types any production caller reaches
            this overload with — is checked exactly in <c>EncodeCurve25519Key</c>. The EC branch is
            exercised only by tests today; if a production caller appears, it should be brought under
            the same scalar check as the <see cref="T:System.Security.Cryptography.ECParameters"/> path.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Converts a private key and key type to ASN.1 DER encoded format in PKCS#8 structure.
            </summary>
            <param name="privateKey">The private key as a byte array.</param>
            <param name="keyType">The type of the key.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key in PKCS#8 format.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.Security.Cryptography.RSAParameters)">
            <summary>
            Converts RSA private key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The RSA parameters including private key values.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key in PKCS#8 format.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeToPkcs8(System.Security.Cryptography.ECParameters)">
            <summary>
            Converts EC private key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The EC parameters including private key value.</param>
            <returns>A byte array containing the ASN.1 DER encoded private key in PKCS#8 format.</returns>
            <exception cref="T:System.ArgumentException">
            The private key parameter D is null or is not the curve's coordinate size, the curve is not
            one of P-256, P-384 or P-521, or the public point is half supplied (exactly one of
            <c>Q.X</c> and <c>Q.Y</c> is null).
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPrivateKeyEncoder.EncodeECKey(System.ReadOnlyMemory{System.Byte},System.String,System.Nullable{System.ReadOnlyMemory{System.Byte}})">
            <summary>
            Creates an EC private key encoded in ASN.1 DER format.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyDecoder">
            <summary>
