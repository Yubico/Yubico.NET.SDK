        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager.FindFirstAsync(System.Func{Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Boolean},System.Threading.CancellationToken)">
