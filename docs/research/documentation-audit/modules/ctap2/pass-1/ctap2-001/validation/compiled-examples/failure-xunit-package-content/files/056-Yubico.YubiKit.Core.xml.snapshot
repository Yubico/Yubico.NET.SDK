        </member>
        <member name="M:Yubico.YubiKit.Core.Protocols.Fido.Hid.IFidoHidProtocol.SendCommandAsync(System.Byte,System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Credentials.UserPresenceNotification,System.Threading.CancellationToken)">
