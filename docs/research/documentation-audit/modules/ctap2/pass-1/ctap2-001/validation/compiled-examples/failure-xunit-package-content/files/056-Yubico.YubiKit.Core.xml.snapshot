            <summary>
            Clears the buffers containing private key data.
            </summary>
            <remarks>Callers should not use the key after clearing it.</remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IPrivateKeyExtensions">
            <summary>
            Extension methods for <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/> to provide type-safe casting operations.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IPrivateKeyExtensions.Cast``1(Yubico.YubiKit.Core.Cryptography.IPrivateKey)">
            <summary>
            Safely casts an <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/> instance to a specific derived type.
            </summary>
            <typeparam name="T">The target type that implements <see cref="T:Yubico.YubiKit.Core.Cryptography.IPrivateKey"/>.</typeparam>
            <param name="key">The private key instance to cast.</param>
            <returns>The private key cast to the specified type <typeparamref name="T"/>.</returns>
            <exception cref="T:System.InvalidCastException">
            Thrown when the <paramref name="key"/> cannot be cast to type <typeparamref name="T"/>.
            The exception message includes both the source and target type names for debugging.
            </exception>
            <example>
            <code>
            IPrivateKey genericKey = GetPrivateKey();
            RsaPrivateKey rsaKey = genericKey.Cast&lt;RsaPrivateKey&gt;();
            // throws InvalidCastException if genericKey is not an RsaPrivateKey
            </code>
            </example>
            <remarks>
            This method provides a more explicit alternative to direct casting with clearer error messages.
            Prefer this over unsafe casting operations when type safety is critical for cryptographic operations.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IPublicKey">
            <summary>
            Defines the contract for cryptographic public keys.
            </summary>
            <remarks>
            This interface extends <see cref="T:Yubico.YubiKit.Core.Cryptography.IKeyBase"/> to include public key-specific operations
            for X.509 SubjectPublicKeyInfo export.
            <para>
            Concrete implementations include <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey"/>, <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPublicKey"/> and <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PublicKey"/>, each providing
            algorithm-specific public key handling and export mechanisms.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IPublicKey.ExportSubjectPublicKeyInfo">
