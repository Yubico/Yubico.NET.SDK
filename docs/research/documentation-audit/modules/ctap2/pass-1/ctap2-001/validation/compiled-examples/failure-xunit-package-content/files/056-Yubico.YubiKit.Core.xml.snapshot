        <member name="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey">
            <summary>
            Represents the parameters for an Elliptic Curve (EC) private key.
            </summary>
            <remarks>
            This class encapsulates the parameters specific to EC private keys
            and provides factory methods for creating instances from EC parameters
            or DER-encoded data.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.Parameters">
            <summary>
            Gets the Elliptic Curve parameters associated with this instance.
            </summary>
            <value>
            An <see cref="T:System.Security.Cryptography.ECParameters"/> structure containing the curve parameters, key, and other
            cryptographic elements needed for EC operations. The array fields are owned by this
            object, must not be modified or cleared by the caller, and are cleared when the object is
            disposed.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.KeyDefinition">
            <summary>
            Gets the key definition associated with this EC private key.
            </summary>
            <value>
            A <see cref="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.KeyDefinition"/> object that describes the key's properties, including its type and length.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.KeyType">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.#ctor(System.Security.Cryptography.ECParameters,System.Action{System.Security.Cryptography.ECParameters})">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> class.
            It is a wrapper for the <see cref="T:System.Security.Cryptography.ECParameters"/> class.
            </summary>
            <remarks>
            This constructor is used to create an instance from a <see cref="T:System.Security.Cryptography.ECParameters"/> object. It will deep copy
            the parameters from the ECParameters object.
            </remarks>
            <param name="parameters">The EC parameters.</param>
            <param name="parametersCopied">An optional internal observation hook.</param>
            <exception cref="T:System.ArgumentException">Thrown when parameters do not contain D value.</exception>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
                Thrown when <c>Q</c> is present and is not <c>d·G</c> on the curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.ExportPkcs8PrivateKey">
            <inheritdoc/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.Clear">
            <inheritdoc/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromPkcs8(System.ReadOnlyMemory{System.Byte})">
            <summary>
            Creates a new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from a DER-encoded private key.
            </summary>
            <param name="encodedKey">
            The borrowed DER-encoded private key. This method copies the decoded key material and
            does not modify or clear the input.
            </param>
            <returns>
            A new disposable key that owns and clears its copied private-key material.
            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
            Thrown if the private key is invalid.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromParameters(System.Security.Cryptography.ECParameters)">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from the given <paramref name="parameters"/>.
            </summary>
            <param name="parameters">
            The borrowed parameters to copy. The caller retains ownership of every input array and
            remains responsible for clearing sensitive arrays.
            </param>
            <returns>A new disposable key that owns and clears its copied private-key material.</returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
                <paramref name="parameters"/> carries a <c>Q</c> that is not <c>d·G</c> on the curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromEcdh(System.Security.Cryptography.ECDiffieHellman)">
            <summary>
            Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from an <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance.
            </summary>
            <param name="ecdh">
            The borrowed <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance containing the private key. This
            method does not dispose it.
            </param>
            <returns>A new disposable key that owns and clears its copied private-key material.</returns>
            <remarks>
            This method exports the private key parameters from the <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance
            and creates a new <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> wrapper. This is useful when working with ephemeral
            keys generated via <see cref="M:System.Security.Cryptography.ECDiffieHellman.Create(System.Security.Cryptography.ECCurve)"/> for protocols like SCP11.
            </remarks>
            <exception cref="T:System.ArgumentNullException">Thrown if <paramref name="ecdh"/> is null.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromValue(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Creates a new instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/> from the given
            <paramref name="privateValue"/> and <paramref name="keyType"/>.
            </summary>
            <remarks>
            <para>
            The <paramref name="privateValue"/> is taken as the raw private key data (scalar value). The
            public point is derived from it by the .NET runtime, and the copies this SDK makes on the way
            are cleared.
            </para>
            <para>
            On macOS the runtime's own derivation keeps a copy of the scalar that it does not clear. This
            is a runtime behaviour, not one the SDK can reach. Supplying the public point yourself through
            <see cref="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.CreateFromParameters(System.Security.Cryptography.ECParameters)"/> does not avoid it, because the SDK checks that the point
            belongs to the scalar by signing with the same runtime path.
            </para>
            </remarks>
            <param name="privateValue">
            The borrowed raw private value to copy. The caller retains ownership and remains
            responsible for clearing the input.
            </param>
            <param name="keyType">The type of key this is.</param>
            <returns>A new disposable key that owns and clears its copied private-key material.</returns>
            <exception cref="T:System.ArgumentException">
            Thrown if the key type is not a valid EC key.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPrivateKey.ToECDiffieHellman">
            <summary>
            Converts this EC private key to an <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance for use in key agreement operations.
            </summary>
            <returns>An <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance initialized with this key's parameters.</returns>
            <remarks>
            This method creates a new <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance from the stored EC parameters.
            The returned instance can be used for ECDH key agreement operations, such as those used in
            SCP11 (Secure Channel Protocol 11).
            <para>
            The caller is responsible for disposing the returned <see cref="T:System.Security.Cryptography.ECDiffieHellman"/> instance
            to ensure proper cleanup of cryptographic resources.
            </para>
            </remarks>
            <exception cref="T:System.ObjectDisposedException">Thrown if this instance has been disposed.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey">
            <summary>
                Represents an Elliptic Curve (EC) public key.
            </summary>
            <remarks>
                This class encapsulates EC public key parameters and provides cryptographic operations
                for NIST elliptic curves and provides factory methods for creating instances from EC parameters or DER-encoded
                data.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.#ctor(System.Security.Cryptography.ECParameters)">
            <summary>
                Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> class.
                It is a wrapper for the <see cref="T:System.Security.Cryptography.ECParameters" /> class.
            </summary>
            <remarks>
                This constructor is used to create an instance from a <see cref="T:System.Security.Cryptography.ECParameters" /> object.
                It will deep copy the parameters from the <see cref="T:System.Security.Cryptography.ECParameters" /> object.
            </remarks>
            <param name="parameters">The EC parameters containing the public key data.</param>
            <exception cref="T:System.ArgumentException">Thrown when the parameters contain private key data (D value).</exception>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.Parameters">
            <summary>
                Gets the Elliptic Curve parameters associated with this instance.
            </summary>
            <value>
                An <see cref="T:System.Security.Cryptography.ECParameters" /> structure containing the curve parameters, key, and other
                cryptographic elements needed for EC operations.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.KeyDefinition">
            <summary>
                Gets the key definition associated with this EC public key.
            </summary>
            <value>
                A <see cref="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.KeyDefinition" /> object that describes the key's properties, including its type and length.
            </value>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.PublicPoint">
            <summary>
                Gets the bytes representing the public key coordinates.
            </summary>
            <returns>A <see cref="T:System.ReadOnlyMemory`1" /> containing the public key bytes with the format 0x04 || X || Y.</returns>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.ECPublicKey.KeyType">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.ExportSubjectPublicKeyInfo">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromParameters(System.Security.Cryptography.ECParameters)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from the given <paramref name="parameters" />.
            </summary>
            <param name="parameters">The parameters to create the key from.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromEcdh(System.Security.Cryptography.ECDiffieHellman)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from an <see cref="T:System.Security.Cryptography.ECDiffieHellman" /> instance.
            </summary>
            <param name="ecdh">The ECDiffieHellman instance containing the public key.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
            <remarks>
                This method extracts the public key from the <see cref="T:System.Security.Cryptography.ECDiffieHellman" /> instance
                and creates a new <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> wrapper. This is useful when working with ephemeral
                keys generated via <see cref="M:System.Security.Cryptography.ECDiffieHellman.Create(System.Security.Cryptography.ECCurve)" /> for protocols like SCP11.
            </remarks>
            <exception cref="T:System.ArgumentNullException">Thrown if <paramref name="ecdh" /> is null.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromEcdh(System.Security.Cryptography.ECDiffieHellmanPublicKey)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from an <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> instance.
            </summary>
            <param name="publicKey">The ECDiffieHellmanPublicKey instance.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
            <remarks>
                This method exports the public key parameters from the <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> instance
                and creates a new <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> wrapper. This is useful when receiving public keys
                from key agreement operations or certificate imports.
            </remarks>
            <exception cref="T:System.ArgumentNullException">Thrown if <paramref name="publicKey" /> is null.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromValue(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from the given
                <paramref name="publicPoint" /> and <paramref name="keyType" />.
            </summary>
            <param name="publicPoint">The raw public key data, formatted as an uncompressed point (0x04 || X || Y).</param>
            <param name="keyType">The type of key this is.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" />.</returns>
            <exception cref="T:System.ArgumentException">
                Thrown if the key type is not a valid EC key.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.CreateFromSubjectPublicKeyInfo(System.ReadOnlyMemory{System.Byte})">
            <summary>
                Creates an instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPublicKey" /> from a DER-encoded SubjectPublicKeyInfo.
            </summary>
            <param name="subjectPublicKeyInfo">The DER-encoded SubjectPublicKeyInfo.</param>
            <returns>An instance of <see cref="T:Yubico.YubiKit.Core.Cryptography.IPublicKey" />.</returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
                Thrown if the subjectPublicKeyInfo is invalid.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ECPublicKey.ToECDiffieHellmanPublicKey">
            <summary>
                Converts this EC public key to an <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> for use in key agreement operations.
            </summary>
            <returns>An <see cref="T:System.Security.Cryptography.ECDiffieHellmanPublicKey" /> instance that can be used with <see cref="T:System.Security.Cryptography.ECDiffieHellman" />.</returns>
            <remarks>
                This method creates a new <see cref="T:System.Security.Cryptography.ECDiffieHellman" /> instance from the stored EC parameters
                and returns its public key. This is useful for ECDH key agreement operations such as those
                used in SCP11 (Secure Channel Protocol 11).
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives">
            <summary>
            Defines cryptographic primitives required for ARKG-P256 operations.
            </summary>
            <remarks>
            This interface abstracts platform-specific implementations of
            elliptic curve operations needed for Asynchronous Remote Key Generation.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives.IsPointOnCurve(System.ReadOnlySpan{System.Byte})">
            <summary>
            Verifies that an elliptic curve point lies on the P-256 curve.
            </summary>
            <param name="point">The point to verify, in uncompressed SEC1 format.</param>
            <returns><c>true</c> if the point is on the curve; otherwise, <c>false</c>.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives.ComputeEcdhSharedSecret(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <summary>
            Computes an ECDH shared secret using a private scalar and public point.
            </summary>
            <param name="privateScalar">The private scalar value.</param>
            <param name="publicPoint">The public point in uncompressed SEC1 format.</param>
            <returns>The computed shared secret.</returns>
            <remarks>
            The returned array is owned by the caller and should be zeroed after use via
            <see cref="M:System.Security.Cryptography.CryptographicOperations.ZeroMemory(System.Span{System.Byte})"/>.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.IArkgPrimitives.Derive(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte})">
            <summary>
            Derives a public key and ARKG key handle using the ARKG-P256 algorithm.
            </summary>
            <remarks>
            <para>
            This method implements the ARKG-P256 key derivation algorithm as specified
            in the previewSign WebAuthn extension. Given the blinding and KEM public
            keys from the YubiKey, along with application-provided input keying material
            and context, it derives a new public key.
            </para>
            <para>
            The derived public key can be used to verify signatures produced by the
            YubiKey when called with the corresponding ARKG key handle and context.
            The ARKG key handle returned by this method must be provided to the
            YubiKey during signing operations.
            </para>
            <para>
            The context string allows multiple independent public keys to be derived
            from the same generated key material. Each unique context produces a
            unique derived key pair.
            </para>
            </remarks>
            <param name="pkBl">The blinding public key in uncompressed SEC1 format.</param>
            <param name="pkKem">The KEM public key in uncompressed SEC1 format.</param>
            <param name="ikm">Input keying material for HKDF derivation.</param>
            <param name="ctx">Context string for domain separation.</param>
            <returns>
            A tuple containing the derived public key (in uncompressed SEC1 format)
            and the ARKG key handle (to be passed to the YubiKey during signing).
            Both returned arrays are owned by the caller and should be zeroed after use.
            </returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.ICmacPrimitives">
            <summary>
            Provides replaceable cipher-based message authentication code operations.
