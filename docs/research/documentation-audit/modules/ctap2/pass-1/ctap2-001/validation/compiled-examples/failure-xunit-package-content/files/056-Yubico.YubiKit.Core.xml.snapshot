            This is not a secure authenticated encryption scheme.
            </remarks>
            <param name="encryptionKey">16-byte AES128 key</param>
            <param name="plaintext">16-byte input block</param>
            <returns>The 16-byte AES128 ciphertext</returns>
        </member>
