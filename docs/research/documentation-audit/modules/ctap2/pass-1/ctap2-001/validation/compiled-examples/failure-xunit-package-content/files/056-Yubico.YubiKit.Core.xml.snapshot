        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager.FindFirstOrDefaultAsync(System.Func{Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Boolean},System.Threading.CancellationToken)">
            <inheritdoc cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindFirstOrDefaultAsync(System.Func{Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Boolean},System.Threading.CancellationToken)" />
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager.StartMonitoring">
            <summary>
            Starts monitoring for YubiKey device changes using the default interval.
