        <member name="T:Yubico.YubiKit.Core.Cryptography.PrivateKey">
            <summary>
            Abstract base class for private key implementations.
            </summary>
            <remarks>
            This class implements the standard .NET disposal pattern to ensure secure cleanup
            of sensitive cryptographic material and provides disposal state checking for derived classes.
            <para>
            Concrete implementations include <see cref="T:Yubico.YubiKit.Core.Cryptography.ECPrivateKey"/>, <see cref="T:Yubico.YubiKit.Core.Cryptography.RSAPrivateKey"/> and <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey"/>,
            each providing algorithm-specific key handling and cryptographic operations.
            </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Cryptography.PrivateKey.KeyType">
            <inheritdoc /> 
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.ExportPkcs8PrivateKey">
            <inheritdoc />
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.Clear">
            <inheritdoc /> 
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.Dispose">
            <summary>
            Clears the private key data and disposes the object
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKey.ThrowIfDisposed">
            <summary>
            Throws an <see cref="T:System.ObjectDisposedException"/> if this instance has been disposed.
            </summary>
            <exception cref="T:System.ObjectDisposedException">
            Thrown when this method is called after the object has been disposed.
            </exception>
            <remarks>
            This method should be called at the beginning of all public methods and properties
            in derived classes to prevent operations on disposed cryptographic key material.
            The exception message includes the concrete type name for debugging purposes.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.PrivateKeyConsistency">
            <summary>
                Checks that the public and private components of a key belong together before the SDK wraps
                them. The YubiKey derives its own public key from the private material it is sent, so a wrapper
                that reported an unrelated public component would describe a key the device never had.
            </summary>
            <remarks>
                <para>
                    References: RFC 8017 §3.1 (λ(n)), §3.2 (private key representation and e·d ≡ 1 mod λ(n)),
                    Appendix A.1.2 (CRT components); SEC 1 v2 §3.2.2 / FIPS 186-5 §6.2.1 (Q = d·G).
                </para>
                <para>
                    <see cref="T:Yubico.YubiKit.Core.Cryptography.Curve25519PrivateKey" /> needs no counterpart here: it holds no public value and the
                    decoder rejects a PKCS#8 v2 <c>publicKey</c> field, so it can never carry an unchecked one.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKeyConsistency.ThrowIfPublicPointDoesNotMatch(System.Security.Cryptography.ECParameters@)">
            <summary>
                Verifies that <c>Q = d·G</c> by signing a fixed digest with the key as supplied and verifying
                with a public-only key built from the same <c>Q</c>. A signature made with <c>d</c> verifies
                under <c>Q</c> only if they match; an off-curve <c>Q</c> fails the same way. No D-only key is
                ever imported, so no public point is derived by the runtime.
            </summary>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The point does not match the scalar, or is invalid.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.PrivateKeyConsistency.ThrowIfInconsistent(System.Security.Cryptography.RSAParameters@)">
            <summary>
                Verifies the RSA relations of RFC 8017 §3.1, §3.2 and Appendix A.1.2:
                <c>n = p·q</c>, <c>dP = d mod (p−1)</c>, <c>dQ = d mod (q−1)</c>, <c>qInv·q ≡ 1 (mod p)</c> and
                <c>e·d ≡ 1 (mod lcm(p−1, q−1))</c>.
            </summary>
            <remarks>
                Uses <see cref="T:System.Numerics.BigInteger" />, which is neither constant-time nor zeroable. The private values
                already exist in the caller-supplied managed arrays, so this adds no exposure the import does not
                already have.
            </remarks>
            <exception cref="T:System.Security.Cryptography.CryptographicException">A component is missing or a relation does not hold.</exception>
        </member>
