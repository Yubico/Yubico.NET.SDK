            <param name="context">The derivation context.</param>
            <param name="lengthBits">The desired key length in bits.</param>
            <param name="output">The output buffer (must be at least lengthBits/8 bytes).</param>
        </member>
        <member name="T:Yubico.YubiKit.Core.ServiceLocator">
            <summary>
                ONLY FOR TESTING, DONT USE IN PRODUCTION CODE.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Sessions.ApplicationIds">
            <summary>
            Provides application identifiers used to select YubiKey applets.
            </summary>
            <remarks>
            Each read returns a fresh copy. Returning one shared buffer would be cheaper, but
            <see cref="M:System.Runtime.InteropServices.MemoryMarshal.TryGetArray``1(System.ReadOnlyMemory{``0},System.ArraySegment{``0}@)" /> recovers the array behind a
            <see cref="T:System.ReadOnlyMemory`1" />, so a shared buffer could be written through from anywhere in the
            process and would corrupt applet selection for every session afterwards. These are read once per
            session open, immediately before device input and output, so the copy is not worth avoiding.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.Management">
            <summary>Gets the application identifier that selects the YubiKey Management applet.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.Otp">
            <summary>Gets the application identifier that selects the YubiKey OTP applet.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.FidoU2f">
            <summary>
            Gets the FIDO application identifier under its U2F-era interoperability name. This is the same
            AID as <see cref="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.Fido" />, not a separate applet, and is not used by the SDK's own sessions.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.Fido">
            <summary>Gets the application identifier that selects the shared FIDO applet for CTAP1/U2F and CTAP2.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.Oath">
            <summary>Gets the application identifier that selects the OATH applet.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.OpenPgp">
            <summary>Gets the application identifier that selects the OpenPGP card applet.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.Piv">
            <summary>Gets the application identifier that selects the PIV applet.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.YubiHsmAuth">
            <summary>Gets the application identifier that selects the YubiHSM Auth applet.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationIds.SecurityDomain">
            <summary>Gets the application identifier that selects the Security Domain applet.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Sessions.ApplicationSession">
            <summary>
                Base class for applet and raw sessions that attach to one opened YubiKey connection.
            </summary>
            <remarks>
                <para>
                    One connection admits one live session. A direct session factory borrows its caller's connection;
                    only an <c>IYubiKey.Create*SessionAsync</c> convenience entry point can transfer ownership of a
                    hidden connection to the returned session.
                </para>
                <para>
                    Protocol construction and initialization are internal SDK seams. External derived classes cannot
                    inject or replace Core protocol implementations; compose over a public raw session for low-level work.
                </para>
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationSession.Connection">
            <summary>
                The connection this session runs over. Unless an <c>IYubiKey.Create*SessionAsync</c> entry point
                transferred ownership, the session borrows it: disposing the session detaches the session but never
                disposes a caller-created connection.
            </summary>
            <remarks>
                After healthy idle or sequential use, the borrowed connection can host the next session. Detaching
                is ownership bookkeeping, not proof that connection or device state is reusable. A failed partial
                exchange, a failed OTP reset, or disposal that begins while a FIDO HID exchange is active on the
                built-in macOS connection can leave the connection unusable; the terminal wake used for that disposal
                may do so even when the exchange finishes concurrently with it. After such uncertainty, dispose and
                reopen the connection. Disposal does not always end the connection: a SmartCard disposal drains an
                admitted exchange, and a successful drained exchange leaves the borrowed connection reusable.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.#ctor(Yubico.YubiKit.Core.Abstractions.IConnection)">
            <summary>
                Records the connection this session will run over. Does NOT bind the session to it — see
                <see cref="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.Construct``1(Yubico.YubiKit.Core.Abstractions.IConnection,System.Func{``0})" />, which binds once construction has actually succeeded.
            </summary>
            <param name="connection">The connection the session will run over.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.#ctor(Yubico.YubiKit.Core.Abstractions.IConnection,Yubico.YubiKit.Core.Credentials.IUserPresencePrompt)">
            <summary>
                Records the connection and caller-owned user-presence notification service this session will use.
            </summary>
            <param name="connection">The connection the session will run over.</param>
            <param name="userPresencePrompt">
                The optional notification service to retain for the session lifetime. The session does not dispose it.
            </param>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.ApplicationSession.IsUserPresenceNotificationEnabled">
            <summary>Gets whether this session retained a user-presence prompt.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.CreateUserPresenceNotification(Yubico.YubiKit.Core.Credentials.UserPresenceContext)">
            <summary>Creates the non-null notification handle for one operation.</summary>
            <param name="context">The optional policy context determined by the applet session.</param>
            <returns>An enabled per-operation handle, or the shared no-op handle.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.RunWithUserPresenceNotificationAsync``1(Yubico.YubiKit.Core.Credentials.UserPresenceNotification,System.Func{System.Threading.CancellationToken,System.Threading.Tasks.Task{``0}},System.Threading.CancellationToken)">
            <summary>Runs an ordinary operation with request, outcome mapping, and terminal resolution.</summary>
            <typeparam name="TResult">
                The operation result type. An operation that creates caller-owned sensitive data or immutable secret
                material must resolve <paramref name="notification" /> before transferring or materializing that result,
                and must clear any owned intermediate data if resolution fails.
            </typeparam>
            <param name="notification">The non-null per-operation notification handle.</param>
            <param name="operation">The operation to run after the request callback succeeds.</param>
            <param name="cancellationToken">The operation cancellation token.</param>
            <returns>The operation result.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.RunWithUserPresenceResolutionAsync``1(Yubico.YubiKit.Core.Credentials.UserPresenceNotification,System.Func{System.Threading.CancellationToken,System.Threading.Tasks.Task{``0}},System.Threading.CancellationToken)">
            <summary>
                Runs an operation that owns request timing while this method owns outcome mapping and terminal resolution.
            </summary>
            <typeparam name="TResult">
                The operation result type. An operation that creates caller-owned sensitive data or immutable secret
                material must resolve <paramref name="notification" /> before transferring or materializing that result,
                and must clear any owned intermediate data if resolution fails.
            </typeparam>
            <param name="notification">The non-null per-operation notification handle.</param>
            <param name="operation">The operation that may request at its transport boundary.</param>
            <param name="cancellationToken">The operation cancellation token.</param>
            <returns>The operation result.</returns>
            <remarks>
                This method provides fallback resolution for failure and cancellation paths. It cannot reclaim a result
                already produced by <paramref name="operation" /> if the terminal callback then fails, so the result's
                producing owner must explicitly resolve successful sensitive operations before ownership transfer.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.Construct``1(Yubico.YubiKit.Core.Abstractions.IConnection,System.Func{``0})">
            <summary>
                Constructs a session and binds it to its connection, enforcing one live session per connection.
            </summary>
            <remarks>
                <para>
                    Binding deliberately happens here rather than in the constructor. A constructor that binds and
                    then throws leaves nothing to unbind it: the object never finishes construction, so no
                    <c>using</c>, <c>finally</c> or factory <c>catch</c> can reach it, and the connection is
                    refused forever by a session that does not exist. Binding after <paramref name="create" />
                    returns makes that state unrepresentable.
                </para>
                <para>
                    It must NOT move later still — into initialization — because derived
                    <c>InitializeAsync</c> implementations issue their applet SELECT before calling
                    <see cref="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.ConfigureProtocolAsync(Yubico.YubiKit.Core.Abstractions.IProtocol,Yubico.YubiKit.Core.Devices.FirmwareVersion,System.Nullable{Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ProtocolConfiguration},Yubico.YubiKit.Core.Protocols.SmartCard.Scp.ScpKeyParameters,System.Threading.CancellationToken)" />. Binding there would refuse the second session only after
                    the first session's state had already been destroyed, which is the damage this guard exists to
                    prevent. Construction performs no wire I/O, so here is the last safe point.
                </para>
                <para>
                    On refusal the constructed session is disposed and the exception propagates. Disposal cannot
                    disturb the incumbent: <see cref="M:Yubico.YubiKit.Core.Sessions.ConnectionSessionGuard.Detach(Yubico.YubiKit.Core.Abstractions.IConnection,System.Object)" /> only clears the slot when
                    the disposing session is the recorded holder, and this one never became it.
                </para>
            </remarks>
            <exception cref="T:Yubico.YubiKit.Core.Devices.ConnectionInUseException">The connection already has a live session.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.ValidatePreferredConnectionType(Yubico.YubiKit.Core.Abstractions.IConnection,Yubico.YubiKit.Core.Sessions.SessionCreationOptions)">
            <summary>
                Validates the connection-type assertion supplied to a direct session factory.
            </summary>
            <param name="connection">The caller-owned connection.</param>
            <param name="options">Optional session creation settings.</param>
            <exception cref="T:System.ArgumentException">
                <see cref="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.PreferredConnectionType" /> does not match the connection.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.OwnConnection">
            <summary>
                Transfers ownership of <see cref="P:Yubico.YubiKit.Core.Sessions.ApplicationSession.Connection" /> to this session, so disposing the session also
                disposes the connection.
            </summary>
            <remarks>
                Only the code that CREATED the connection may call this, and only the convenience
                <c>IYubiKey.Create&lt;App&gt;SessionAsync</c> entry points do: they open a connection the caller
                never sees, so the session they return is the only thing that can close it. A caller who opened the
                connection keeps ownership and this is never called.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.DisposeAfterInitializationFailure">
            <summary>
                Releases resources owned by a session whose asynchronous factory failed. Disposal failures
                are logged and suppressed so the initialization exception remains the primary failure.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.Dispose">
            <summary>Closes operation admission, drains an admitted exchange, and releases session resources.</summary>
            <remarks>
                This synchronous path blocks while an admitted exchange finishes. Prefer <see cref="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.DisposeAsync" />
                for asynchronous callers, and never invoke synchronous disposal from inside the operation being drained.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.DisposeAsync">
            <summary>
                Closes operation admission, asynchronously drains an admitted exchange, and releases session resources.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.ReleaseConnection">
            <summary>Detaches from the connection, and disposes it only if this session was given ownership.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.ReleaseConnectionAsync">
            <inheritdoc cref="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.ReleaseConnection" />
        </member>
        <member name="T:Yubico.YubiKit.Core.Sessions.ConnectionSessionGuard">
            <summary>
                Which session, if any, is live on a given connection. One connection hosts one session at a time.
            </summary>
            <remarks>
                <para>
                    This is the connection-scoped half of the ownership contract; the interface-scoped half lives in
                    <see cref="T:Yubico.YubiKit.Core.Devices.DeviceConnectionRegistry" />. The interface lease cannot see this case: one connection,
                    opened once, handed to two sessions. Each session opens with its own applet SELECT, which on a CCID
                    interface deselects whatever the other session was using.
                </para>
                <para>
                    Enforced at binding, before any wire operation, which is what canonical yubikit does — Rust makes a
                    second session a compile error by taking the connection by value; Python's base <c>Session</c> stores
                    itself on the connection at construction. Refusal happens on the call that would cause the damage,
                    not on the victim's next operation.
                </para>
                <para>
                    Keyed by connection identity in a <see cref="T:System.Runtime.CompilerServices.ConditionalWeakTable`2" /> rather than by a
                    field on the connection: <see cref="T:Yubico.YubiKit.Core.Abstractions.IConnection" /> is a public interface with caller-provided
                    implementations, so the guard must work without asking implementers to carry state. Entries die with
                    the connection.
                </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ConnectionSessionGuard.Attach(Yubico.YubiKit.Core.Abstractions.IConnection,System.Object)">
            <summary>
                Binds <paramref name="session" /> to <paramref name="connection" /> as its live session.
            </summary>
            <exception cref="T:Yubico.YubiKit.Core.Devices.ConnectionInUseException">The connection already has a live session.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ConnectionSessionGuard.IsHolder(Yubico.YubiKit.Core.Abstractions.IConnection,System.Object)">
            <summary>
                Whether <paramref name="session" /> is the live session recorded for <paramref name="connection" />.
            </summary>
            <remarks>
                Used to catch a session that never went through <see cref="M:Yubico.YubiKit.Core.Sessions.ApplicationSession.Construct``1(Yubico.YubiKit.Core.Abstractions.IConnection,System.Func{``0})" />.
                Because binding is no longer automatic in the constructor, an unbound session would otherwise run
                completely unguarded — a silent loss of the one-session-per-connection rule.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.ConnectionSessionGuard.Detach(Yubico.YubiKit.Core.Abstractions.IConnection,System.Object)">
            <summary>
                Releases <paramref name="session" />'s claim, if it still holds one. Idempotent, and a no-op when a
                different session now holds the connection.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Sessions.RawCtapHidSession">
            <summary>Provides guarded, application-agnostic CTAP HID logical exchanges.</summary>
            <remarks>
                The session supplies channel initialization, framing, continuation, keep-alive handling, final-command
                correlation, and CTAPHID error rejection, but no CTAP2 or WebAuthn operation semantics. It borrows a
                directly supplied connection. Direct connection <c>SendAsync</c>/<c>ReceiveAsync</c> calls bypass the
                session's overlap guard.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawCtapHidSession.CreateAsync(Yubico.YubiKit.Core.Protocols.Fido.Hid.IFidoHidConnection,System.Threading.CancellationToken)">
            <summary>Creates a raw FIDO HID session that borrows <paramref name="connection" />.</summary>
            <remarks>CTAP HID channel initialization is deferred until the first operation.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawCtapHidSession.SendAndReceiveAsync(System.Byte,System.ReadOnlyMemory{System.Byte},System.Threading.CancellationToken)">
            <summary>Sends one caller-defined CTAP HID command and returns its correlated response payload.</summary>
            <remarks>
                SDK-owned outgoing packet copies are cleared after use; caller-owned <paramref name="payload" /> is not
                modified. Returned memory remains live after return and is caller-owned for sensitive-data handling.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Sessions.RawOtpHidSession">
            <summary>Provides guarded, application-agnostic OTP HID logical exchanges.</summary>
            <remarks>
                The session supplies feature-report framing, sequencing, polling, and outbound CRC generation, but no OTP
                applet or slot-configuration semantics. Inbound CRC is command-specific and is not validated. It borrows a
                directly supplied connection. Direct connection <c>SendAsync</c>/<c>ReceiveAsync</c> calls bypass the
                session's overlap guard.
                After an interrupted frame, the protocol attempts one abort before allowing reuse. If the abort or
                response-completion reset fails, this session refuses further exchanges. Dispose the session and reopen
                its connection; creating another session over the same borrowed connection is not a recovery procedure.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawOtpHidSession.CreateAsync(Yubico.YubiKit.Core.Transports.Hid.IOtpHidConnection,System.Threading.CancellationToken)">
            <summary>Creates a raw OTP HID session that borrows <paramref name="connection" />.</summary>
            <remarks>OTP status initialization is deferred until the first operation.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawOtpHidSession.SendAndReceiveAsync(System.Byte,System.ReadOnlyMemory{System.Byte},System.Threading.CancellationToken)">
            <summary>Sends one caller-defined command or slot byte and returns the unvalidated response payload.</summary>
            <remarks>
                For a command with a known response length, the caller can validate inbound CRC with
                <see cref="M:Yubico.YubiKit.Core.Protocols.Otp.Hid.ChecksumUtils.CheckCrc(System.ReadOnlySpan{System.Byte},System.Int32)" /> over <c>expectedLength + 2</c> bytes.
                SDK-owned outgoing buffers are cleared after use; caller-owned <paramref name="payload" /> is not
                modified. Returned memory remains live after return and is caller-owned for sensitive-data handling.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Sessions.RawSmartCardSession">
            <summary>
                Provides guarded, application-agnostic APDU exchanges over one SmartCard connection.
            </summary>
            <remarks>
                Creation performs no application selection or applet feature checks. The session borrows a connection
                passed to <see cref="M:Yubico.YubiKit.Core.Sessions.RawSmartCardSession.CreateAsync(Yubico.YubiKit.Core.Transports.SmartCard.ISmartCardConnection,System.Threading.CancellationToken)" />; an
                <see cref="T:Yubico.YubiKit.Core.Abstractions.IYubiKey" /> convenience factory owns its hidden connection. Operations refuse overlap,
                while direct <see cref="M:Yubico.YubiKit.Core.Transports.SmartCard.ISmartCardConnection.TransmitAndReceiveAsync(System.ReadOnlyMemory{System.Byte},System.Threading.CancellationToken)" /> calls bypass that guard.
                If a command or response continuation fails, this session refuses further exchanges without replaying them.
                Dispose and reopen the connection before continuing; disposing a borrowed session alone does not recover it.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawSmartCardSession.CreateAsync(Yubico.YubiKit.Core.Transports.SmartCard.ISmartCardConnection,System.Threading.CancellationToken)">
            <summary>Creates a raw APDU session that borrows <paramref name="connection" />.</summary>
            <remarks>No APDU is transmitted and no application is selected during creation.</remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawSmartCardSession.CreateAsync(Yubico.YubiKit.Core.Transports.SmartCard.ISmartCardConnection,Yubico.YubiKit.Core.Protocols.SmartCard.Scp.ScpKeyParameters,Yubico.YubiKit.Core.Devices.FirmwareVersion,System.Nullable{Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ProtocolConfiguration},System.Threading.CancellationToken)">
            <summary>Creates a configured raw APDU session and establishes SCP.</summary>
            <remarks>
                APDU framing is configured before the secure channel is established. The session borrows
                <paramref name="connection" />. Dispose <paramref name="scpKeyParameters" /> according to its
                ownership contract.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawSmartCardSession.SelectAsync(System.ReadOnlyMemory{System.Byte},System.Threading.CancellationToken)">
            <summary>Selects exactly the supplied application identifier.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawSmartCardSession.TransmitAndReceiveAsync(Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduCommand,System.Boolean,System.Threading.CancellationToken)">
            <summary>Transmits one complete APDU logical exchange.</summary>
            <param name="command">The caller-defined APDU.</param>
            <param name="throwOnError">
                Whether a non-success status word throws <see cref="T:Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ApduException" />. When <see langword="false" />,
                the returned response preserves both data and status bytes.
            </param>
            <param name="cancellationToken">Cancellation checked before the stateful exchange is admitted.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.RawSmartCardSession.Configure(Yubico.YubiKit.Core.Devices.FirmwareVersion,System.Nullable{Yubico.YubiKit.Core.Protocols.SmartCard.Apdu.ProtocolConfiguration})">
            <summary>Configures APDU formatting for a known device firmware version.</summary>
            <remarks>
                This does not apply applet capability or feature gates. SCP sessions must provide configuration during
                creation and cannot be reconfigured after the secure channel is established.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Sessions.SessionCreationOptions">
            <summary>
                Configures cross-cutting behavior when an application session is created.
            </summary>
            <remarks>
                Factories snapshot these values when called and do not retain this object. Sessions retain the referenced
                <see cref="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.UserPresencePrompt" /> for their lifetime without taking ownership of it. The caller retains
                ownership and disposal responsibility for both that service and <see cref="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.ScpKeyParameters" />.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.ProtocolConfiguration">
            <summary>Gets optional protocol configuration overrides.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.ScpKeyParameters">
            <summary>
                Gets optional Secure Channel Protocol key parameters. The parameters are borrowed for initialization;
                the caller retains ownership and disposal responsibility.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.PreferredConnectionType">
            <summary>
                Gets the connection type selected from a device factory or required by a direct connection factory.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.FirmwareVersionOverride">
            <summary>
                Gets an explicit override for the effective firmware version used to configure the protocol and
                evaluate feature support after required applet initialization exchanges complete. Security Domain
                is the exception: it cannot detect firmware, so this value is its only exact version source and
                directly controls feature gates; without it, that session conservatively assumes version 5.3.0.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.UserPresencePrompt">
            <summary>
                Gets the optional service notified while session operations require or may require physical user
                presence.
            </summary>
            <remarks>
                A session retains the referenced service for its lifetime. The SDK does not own or dispose it.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Sessions.SessionCreationOptions.WithPreferredConnectionType(Yubico.YubiKit.Core.Devices.ConnectionType)">
            <summary>
                Creates a copy with the specified preferred connection type.
            </summary>
            <param name="connectionType">The preferred connection type for the copy.</param>
            <returns>A new instance containing the copied settings and specified preferred connection type.</returns>
            <remarks>
                This method is the single place that must be updated when a property is added to this type.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo">
            <summary>
            Raw HID descriptor information as reported by the operating system.
            Contains the actual Usage Page and Usage values from the HID report descriptor.
            </summary>
            <remarks>
            These values follow the HID Usage Tables specification (USB-IF).
            Do not use these values directly for business logic - use <see cref="T:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceType"/> instead.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo.UsagePage">
            <summary>
            HID Usage Page value from descriptor (e.g., 0x01 for Generic Desktop, 0xF1D0 for FIDO).
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo.Usage">
            <summary>
            HID Usage value from descriptor (e.g., 0x06 for Keyboard, 0x01 for U2F Device).
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo.DevicePath">
            <summary>
            Device path or identifier.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo.VendorId">
            <summary>
            Vendor ID (e.g., 0x1050 for Yubico).
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo.ProductId">
            <summary>
            Product ID.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidDeviceChangeKind">
            <summary>
            Describes the type of HID topology change reported by a platform listener.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidDeviceChangeKind.Unknown">
            <summary>
            The listener could not classify the HID topology change.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidDeviceChangeKind.Added">
            <summary>
            A HID interface was added.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidDeviceChangeKind.Removed">
            <summary>
            A HID interface was removed.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener">
            <summary>
            Abstract base class for platform-specific HID device listeners.
            Monitors for HID device arrival and removal events using OS-level notifications.
            </summary>
            <remarks>
            Listeners do not auto-start. Call <see cref="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Start"/> after setting up <see cref="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.DeviceEvent"/>
            callback. The listener establishes baseline state during <see cref="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Start"/> to avoid
            duplicate events for devices already present.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.DeviceEvent">
            <summary>
            Callback invoked when a HID listener observes a topology change.
            </summary>
            <remarks>
            The callback receives a diagnostic rescan hint only. It must not be treated as
            authoritative YubiKey arrival or removal state.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Status">
            <summary>
            Gets the current status of the listener.
            </summary>
            <remarks>
            The status is written by platform listener threads and may be read from any thread;
            reads and writes use volatile semantics. It is diagnostic state, not a synchronization
            primitive.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Start">
            <summary>
            Starts the listener. Establishes baseline of currently connected devices,
            then begins monitoring for changes. Only fires events for subsequent changes.
            </summary>
            <remarks>
            This method should be called after setting <see cref="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.DeviceEvent"/> callback.
            Calling Start() on an already started listener has no effect.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Stop">
            <summary>
            Stops the listener and releases monitoring resources.
            </summary>
            <remarks>
            <para>
            After calling Stop(), the listener can be restarted by calling <see cref="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Start"/> again.
            Calling Stop() on an already stopped listener has no effect.
            </para>
            <para>
            Do not call <see cref="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Stop"/> or <see cref="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Dispose"/> from within the
            <see cref="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.DeviceEvent"/> callback. Platform implementations wait for their native
            registration or listener thread to drain before returning, so stopping from inside the
            callback can deadlock or stall for the full disposal timeout.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Create">
            <summary>
            Creates a platform-specific HID device listener.
            </summary>
            <returns>A <see cref="T:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener"/> appropriate for the current operating system.</returns>
            <exception cref="T:System.PlatformNotSupportedException">
            Thrown when the current platform is not supported.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.OnDeviceEvent(Yubico.YubiKit.Core.Transports.Hid.HidDeviceRescanHint)">
            <summary>
            Signals that a device event has occurred.
            </summary>
            <param name="hint">The diagnostic rescan hint to pass to subscribers.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Dispose(System.Boolean)">
            <summary>
            Disposes of the listener and releases all resources.
            </summary>
            <param name="disposing">True if called from Dispose(), false if from finalizer.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Dispose">
            <inheritdoc />
            <remarks>
            Do not call from within the <see cref="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.DeviceEvent"/> callback; see <see cref="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceListener.Stop"/>.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidDeviceRescanHint">
            <summary>
            Diagnostic information from a HID listener indicating that device discovery should be rescanned.
            </summary>
            <remarks>
            HID listener hints are not authoritative physical-device state. Consumers that need YubiKey
            arrivals and removals should use <c>YubiKeyManager.WatchAsync</c>, which emits only
            after a repository rescan and diff.
            </remarks>
            <param name="ChangeKind">The platform-reported HID topology change.</param>
            <param name="PlatformDeviceId">A platform-specific diagnostic identifier when available.</param>
            <param name="DevicePath">A platform-specific path when available.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidDeviceRescanHint.#ctor(Yubico.YubiKit.Core.Transports.Hid.HidDeviceChangeKind,System.String,System.String)">
            <summary>
            Diagnostic information from a HID listener indicating that device discovery should be rescanned.
            </summary>
            <remarks>
            HID listener hints are not authoritative physical-device state. Consumers that need YubiKey
            arrivals and removals should use <c>YubiKeyManager.WatchAsync</c>, which emits only
            after a repository rescan and diff.
            </remarks>
            <param name="ChangeKind">The platform-reported HID topology change.</param>
            <param name="PlatformDeviceId">A platform-specific diagnostic identifier when available.</param>
            <param name="DevicePath">A platform-specific path when available.</param>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceRescanHint.ChangeKind">
            <summary>The platform-reported HID topology change.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceRescanHint.PlatformDeviceId">
            <summary>A platform-specific diagnostic identifier when available.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceRescanHint.DevicePath">
            <summary>A platform-specific path when available.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidDeviceRescanHint.Unknown">
            <summary>
            Gets a generic rescan hint for a HID topology change whose details are unknown.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceClassifier">
            <summary>
            Classifies HID devices based on their descriptor information.
            Contains the authoritative mapping from HID UsagePage+Usage to YubiKey interface types.
            </summary>
            <remarks>
            This is the single source of truth for determining YubiKey interface types from raw HID descriptors.
            All UsagePage and Usage validation logic is centralized here.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceClassifier.Classify(Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo)">
            <summary>
            Determines the YubiKey interface type from HID descriptor information.
            </summary>
            <param name="descriptorInfo">Raw HID descriptor data.</param>
            <returns>The classified interface type, or <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceType.Unknown"/> if not recognized.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceClassifier.IsSupported(Yubico.YubiKit.Core.Transports.Hid.HidDescriptorInfo)">
            <summary>
            Checks if the HID descriptor represents a supported YubiKey interface.
            </summary>
            <param name="descriptorInfo">Raw HID descriptor data.</param>
            <returns><c>true</c> if the interface is supported; otherwise, <c>false</c>.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceClassifier.GetReportType(Yubico.YubiKit.Core.Transports.Hid.HidInterfaceType)">
            <summary>
            Gets the expected report communication method for an interface type.
            </summary>
            <param name="interfaceType">The YubiKey HID interface type.</param>
            <returns>The HID report type to use for communication.</returns>
            <exception cref="T:System.ArgumentException">Thrown when the interface type is not supported.</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceType">
            <summary>
            Represents the type of YubiKey HID interface.
            This is determined from the HID descriptor UsagePage and Usage combination.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceType.Unknown">
            <summary>
            Unknown or unsupported HID interface type.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceType.Fido">
            <summary>
            FIDO/U2F interface using CTAPHID protocol.
            Uses I/O reports (64-byte packets).
            Requires UsagePage=0xF1D0 (FIDO Alliance) and Usage=0x01 (U2F Device).
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidInterfaceType.Otp">
            <summary>
            OTP/YubiOTP interface using keyboard emulation.
            Uses feature reports (8-byte packets).
            Requires UsagePage=0x01 (Generic Desktop) and Usage=0x06 (Keyboard).
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidReportItem">
            <summary>
            One decoded HID report-descriptor short item.
            </summary>
            <param name="Type">The item type: <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeMain"/>,
            <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeGlobal"/>, or
            <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeLocal"/> (or the reserved value 3).</param>
            <param name="Tag">The item tag, distinguishing items within a type (for example, Usage Page,
            Report Size, Input).</param>
            <param name="Value">The little-endian item value. Zero for a zero-size item.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidReportItem.#ctor(System.Int32,System.Int32,System.UInt32)">
            <summary>
            One decoded HID report-descriptor short item.
            </summary>
            <param name="Type">The item type: <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeMain"/>,
            <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeGlobal"/>, or
            <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeLocal"/> (or the reserved value 3).</param>
            <param name="Tag">The item tag, distinguishing items within a type (for example, Usage Page,
            Report Size, Input).</param>
            <param name="Value">The little-endian item value. Zero for a zero-size item.</param>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidReportItem.Type">
            <summary>The item type: <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeMain"/>,
            <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeGlobal"/>, or
            <see cref="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeLocal"/> (or the reserved value 3).</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidReportItem.Tag">
            <summary>The item tag, distinguishing items within a type (for example, Usage Page,
            Report Size, Input).</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.HidReportItem.Value">
            <summary>The little-endian item value. Zero for a zero-size item.</summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader">
            <summary>
            Platform-neutral walker over a HID report descriptor's short-item byte stream, per the HID
            specification's short-item encoding (prefix byte: bits 0-1 = size, bits 2-3 = type, bits 4-7
            = tag).
            </summary>
            <remarks>
            HID long items (prefix 0xFE) have no standard tags in HID 1.11. Complete long items are skipped
            without being surfaced. A truncated long-item header or payload ends iteration.
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeMain">
            <summary>
            Main item type (bits 2-3 of the prefix byte == 0). Examples: Input, Output, Collection.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeGlobal">
            <summary>
            Global item type (bits 2-3 of the prefix byte == 1). Examples: Usage Page, Report Size,
            Report Count.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TypeLocal">
            <summary>
            Local item type (bits 2-3 of the prefix byte == 2). Examples: Usage.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.LongItemPrefix">
            <summary>
            The reserved prefix byte identifying a HID long item: <c>0xFE</c>, followed by
            <c>bDataSize</c>, <c>bLongItemTag</c>, and <c>bDataSize</c> bytes of data.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.HidReportDescriptorReader.TryReadItem(System.ReadOnlySpan{System.Byte},System.Int32@,Yubico.YubiKit.Core.Transports.Hid.HidReportItem@)">
            <summary>
            Reads the next short item from <paramref name="descriptor"/>, advancing
            <paramref name="position"/> past it.
            </summary>
            <param name="descriptor">The raw HID report descriptor bytes.</param>
            <param name="position">The read cursor. On success, it is advanced past any skipped long
            items and the decoded short item. Its value is unspecified when this method returns
            <see langword="false"/>.</param>
            <param name="item">The decoded item, when this method returns <see langword="true"/>.</param>
            <returns><see langword="true"/> if an item was read; <see langword="false"/> once the
            descriptor is exhausted or the trailing item is truncated.</returns>
            <remarks>
            A truncated short item (fewer bytes remaining than its prefix declares) terminates the
            walk rather than being clamped or skipped.
            An item declaring a size of zero still advances the cursor by its prefix byte and yields a
            <see cref="P:Yubico.YubiKit.Core.Transports.Hid.HidReportItem.Value"/> of zero.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.HidReportType">
            <summary>
            Type of HID report used for communication.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidReportType.InputOutput">
            <summary>
            Input/Output reports (used for FIDO).
            Typically 64-byte packets for CTAPHID protocol.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Transports.Hid.HidReportType.Feature">
            <summary>
            Feature reports (used for OTP).
            Typically 8-byte packets for YubiOTP protocol.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.IHidConnection.SetReport(System.Byte[])">
            <summary>Sends a report through this synchronous connection.</summary>
            <remarks>
                The caller owns <paramref name="report" />. Its contents are valid only until this method returns;
                the caller may clear or reuse the array immediately afterward. An implementation that needs the
                report after returning must copy it before returning.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.IHidInterface">
            <summary>
            Represents an operating-system-exposed HID interface, not a physical YubiKey.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.IHidInterface.DescriptorInfo">
            <summary>
            Raw HID descriptor information as reported by the operating system.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.IHidInterface.InterfaceType">
            <summary>
            The classified YubiKey HID interface type.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.IHidInterface.ConnectToFeatureReports">
            <summary>
            Establishes an active connection to the HID interface for the transmittal of data through feature reports.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.IHidInterface.ConnectToIOReports">
            <summary>
            Establishes an active connection to the HID interface for the transmittal of data through I/O reports.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.IOtpHidConnection">
            <summary>
            A HID keyboard connection to a YubiKey using feature reports (8-byte reports).
            Used for OTP/YubiOTP and Management over OTP interface.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.IOtpHidConnection.FeatureReportSize">
            <summary>
            Size of feature reports for OTP protocol (always 8 bytes).
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.IOtpHidConnection.SendAsync(System.ReadOnlyMemory{System.Byte},System.Threading.CancellationToken)">
            <summary>
            Sends an 8-byte feature report to the YubiKey.
            </summary>
            <remarks>
                This Tier 2 method bypasses <see cref="T:Yubico.YubiKit.Core.Sessions.ApplicationSession" />,
                <c>ConnectionSessionGuard</c>, and <c>ExchangeGuard</c>. The caller owns OTP report
                framing, sequencing, polling, CRC, concurrency exclusion, and recovery. Do not interleave it with a live
                session or another raw operation; dispose and reopen when state is uncertain.
                Keep borrowed <paramref name="report" /> memory valid until the returned task is terminal;
                only then zero sensitive caller-owned input. This applies to every implementation, even though
                built-in macOS output copies the report. Built-in macOS rejects cancellation before native dispatch;
                after dispatch output may succeed, and the task waits for native completion and resource drain.
                Cancellation alone does not make a raw connection reusable.
            </remarks>
            <param name="report">The report data (must be 8 bytes).</param>
            <param name="cancellationToken">Cancellation token.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.Transports.Hid.IOtpHidConnection.ReceiveAsync(System.Threading.CancellationToken)">
            <summary>
            Receives an 8-byte feature report from the YubiKey.
            </summary>
            <remarks>
                This Tier 2 method bypasses <see cref="T:Yubico.YubiKit.Core.Sessions.ApplicationSession" />,
                <c>ConnectionSessionGuard</c>, and <c>ExchangeGuard</c>. Pair receives with the
                caller's own serialized send state. Built-in macOS OTP rejects cancellation before native dispatch;
                afterward a read may succeed, and the task waits for native completion and resource drain. Await the
                task before another operation. Cancellation alone does not make a raw connection reusable; after
                interruption or interleaving, dispose and reopen it, awaiting disposal for native drain.
            </remarks>
            <param name="cancellationToken">Cancellation token.</param>
            <returns>The received report (8 bytes).</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Transports.Hid.Keyboard.HidCodeTranslator">
            <summary>
                Represents an abstract keyboard's HID code map. Able to convert to and
                from characters and their corresponding HID code.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Transports.Hid.Keyboard.HidCodeTranslator.Item(System.Char)">
