            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager.FindAllAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Boolean,System.Threading.CancellationToken)">
