        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.ICmacPrimitives.CmacInit(System.ReadOnlySpan{System.Byte})">
            <summary>Initializes a CMAC operation with <paramref name="keyData"/>.</summary>
        </member>
