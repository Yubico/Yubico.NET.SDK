            </returns>
            <exception cref="T:System.Security.Cryptography.CryptographicException">Thrown if public key does not match expected format.</exception>
            <exception cref="T:System.InvalidOperationException">Thrown if the algorithm is not supported</exception>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder">
            <summary>
            A class that converts public key parameters to ASN.1 DER encoding.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.ReadOnlyMemory{System.Byte},Yubico.YubiKit.Core.Cryptography.KeyType)">
            <summary>
            Converts a public point and key type to ASN.1 DER encoded format.
            </summary>
            <param name="publicPoint">The public key point as a byte array.</param>
            <param name="keyType">The type of the key.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.ReadOnlyMemory{System.Byte},System.ReadOnlyMemory{System.Byte})">
            <summary>
            Converts an RSA public key from modulus and exponent to ASN.1 DER encoded format.
            </summary>
            <param name="modulus">The modulus of the RSA key as a byte array.</param>
            <param name="exponent">The exponent of the RSA key as a byte array.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.Security.Cryptography.RSAParameters)">
            <summary>
            Converts RSA public key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The RSA public key parameters.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnPublicKeyEncoder.EncodeToSubjectPublicKeyInfo(System.Security.Cryptography.ECParameters)">
            <summary>
            Converts EC public key parameters to ASN.1 DER encoded format.
            </summary>
            <param name="parameters">The EC public key parameters.</param>
            <returns>A byte array containing the ASN.1 DER encoded public key.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Cryptography.EcPointDefect">
            <summary>
            Why an EC point failed <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.InspectUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.Int32)"/>.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.None">
            <summary>The point is a well-formed uncompressed point for the curve.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.Empty">
            <summary>The point has no octets at all, so there is no format prefix to inspect.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.NotUncompressed">
            <summary>The point does not start with the 0x04 uncompressed-format prefix.</summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Cryptography.EcPointDefect.WrongLength">
            <summary>The point is not exactly <c>1 + 2 * coordinateSize</c> octets long.</summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.InspectUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.Int32)">
            <summary>
            The single authority on the shape of an EC point in this SDK: an uncompressed point is
            <c>0x04 || X || Y</c> with both coordinates exactly the curve's coordinate size.
            </summary>
            <remarks>
            <para>This mirrors the strictness of the Rust <c>yubikit</c> crate. Compressed and hybrid
            point formats are deliberately rejected rather than decompressed. Callers translate the
            result into the exception type their layer owes: <see cref="T:System.Security.Cryptography.CryptographicException"/> for
            malformed encoded key data, and <see cref="T:System.ArgumentException"/> for bad caller-supplied
            input.</para>
            <para>That split governs <em>point shape</em> only. Whether a curve is supported at all is
            each decoder's own concern and each rejects it before reaching this file:
            <c>AsnPublicKeyDecoder</c> throws <see cref="T:System.NotSupportedException"/> and
            <c>AsnPrivateKeyDecoder</c> throws <see cref="T:System.InvalidOperationException"/>. The
            <see cref="T:System.Security.Cryptography.CryptographicException"/> that <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetDecodedCoordinateSize(System.String)"/> raises for
            an unsupported curve is therefore a defensive backstop, not a taxonomy this file imposes on
            its callers.</para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.ValidateDecodedEcPoint(System.ReadOnlySpan{System.Byte},System.String)">
            <summary>
            Validates an EC point that was read out of an encoded key. Malformed encoded data is a
            <see cref="T:System.Security.Cryptography.CryptographicException"/>, never an argument exception.
            </summary>
            <exception cref="T:System.Security.Cryptography.CryptographicException">
            The point is not a valid uncompressed point, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.ValidateEcPointArgument(System.ReadOnlySpan{System.Byte},System.String,System.String)">
            <summary>
            Validates an EC point supplied by a caller of an encoder. Bad caller input is an
            <see cref="T:System.ArgumentException"/>, never a <see cref="T:System.Security.Cryptography.CryptographicException"/>.
            </summary>
            <exception cref="T:System.ArgumentException">
            The point is not a valid uncompressed point, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.BuildUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.ReadOnlySpan{System.Byte},System.String,System.String)">
            <summary>
            Builds the uncompressed point <c>0x04 || X || Y</c> for the named curve, rejecting
            coordinates that are not exactly the curve's coordinate size.
            </summary>
            <remarks>
            Checking each coordinate separately is stricter than checking the assembled point, because
            an oversized X paired with an undersized Y produces a correctly sized but silently wrong point.
            </remarks>
            <exception cref="T:System.ArgumentException">
            A coordinate does not match the curve, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.ValidateEcPrivateScalarArgument(System.ReadOnlySpan{System.Byte},System.String,System.String)">
            <summary>
            Validates a caller-supplied EC private scalar against the curve it will be encoded under,
            and in doing so gates the curve OID itself before it is written into an
            <c>id-ecPublicKey</c> AlgorithmIdentifier.
            </summary>
            <remarks>
            The scalar of an RFC 5915 <c>ECPrivateKey</c> is a fixed-width, left-padded integer of the
            curve's coordinate size. Any other width contradicts the curve parameter sitting in the same
            structure. The message reports lengths only: the value being rejected is key material.
            </remarks>
            <exception cref="T:System.ArgumentException">
            The scalar does not match the curve, or the curve is not a supported prime curve.
            </exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetDecodedCoordinateSize(System.String)">
            <summary>
            Resolves the coordinate size of an EC point read out of encoded key data.
            </summary>
            <remarks>
            Both decoders reject an unsupported curve before calling in here, each with its own
            exception type, so the throwing branch is a backstop that no production caller reaches. See
            the remarks on <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.InspectUncompressedEcPoint(System.ReadOnlySpan{System.Byte},System.Int32)"/>.
            </remarks>
            <exception cref="T:System.Security.Cryptography.CryptographicException">The curve is not a supported prime curve.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetCoordinateSizeArgument(System.String,System.String)">
            <summary>
            Resolves the coordinate size for a curve OID supplied by a caller of an encoder.
            </summary>
            <exception cref="T:System.ArgumentException">The curve is not a supported prime curve.</exception>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.TryGetCoordinateSize(System.String,System.Int32@)">
            <summary>
            Resolves the coordinate size of one of the EC prime curves this SDK supports.
            </summary>
            <remarks>
            The curve gate is <see cref="M:Yubico.YubiKit.Core.Cryptography.Oids.IsECDsaCurve(System.String)"/>, not
            <see cref="M:Yubico.YubiKit.Core.Cryptography.KeyDefinitions.GetByOid(System.String)"/>.
            <c>GetByOid</c> resolves any algorithm or curve OID it knows, including X25519, Ed25519, AES
            and Triple DES, and several of those have a 32-byte definition. Sizing an EC point against
            one of them would let a non-EC algorithm's key material through a point-shape check and then
            be emitted as an <c>id-ecPublicKey</c> key whose curve parameter is not a curve.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetOwnedIntegerContentOctets(System.ReadOnlySpan{System.Byte})">
            <summary>
            Returns a newly allocated buffer containing the minimal positive ASN.1 INTEGER content octets.
            </summary>
            <remarks>
            Unlike <see cref="M:Yubico.YubiKit.Core.Cryptography.AsnUtilities.GetIntegerBytes(System.Span{System.Byte})"/>, this method never aliases the input.
            The caller owns the returned buffer and is responsible for zeroing it when it contains
            sensitive material.
            </remarks>
        </member>
