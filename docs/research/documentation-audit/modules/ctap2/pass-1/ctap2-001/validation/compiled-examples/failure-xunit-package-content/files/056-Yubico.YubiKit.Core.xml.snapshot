            <summary>
            Stops monitoring for YubiKey device changes.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager.DisposeAsync">
            <summary>
            Disposes all resources with correct ordering.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager.Create">
            <summary>
            Creates a new <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager"/> instance without requiring dependency injection.
            </summary>
            <returns>A new instance of <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager"/>.</returns>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService">
            <summary>
            Service responsible for device discovery and monitoring lifecycle.
            </summary>
            <remarks>
            <para>
            This service owns the device listeners (HID and SmartCard) and coordinates
            with <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository"/> to update the device cache.
            It has no cache of its own - all state is maintained in the repository.
            Uses a single-reader channel to serialize listener ingress and debounce redundant scans.
            </para>
            <para>
            Lifecycle races are handled with epoch-gated publication: each monitoring
            epoch is a <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration"/> captured once by the loop, manual
            rescans, and listener callbacks. Every publication acquires the shared,
            never-disposed <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._publishGate"/> and is admitted only if its
            generation is still current and the service is not disposed; superseded
            snapshots are discarded. Lifecycle operations swap <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._current"/>
            under <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._publishLock"/>; <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.StartMonitoring(System.TimeSpan)"/> and
            <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.StopMonitoring"/> never touch the publication gate at all, and
            <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.DisposeAsync"/> only attempts a bounded drain of it. A stalled
            publication therefore cannot block start or stop, and can delay dispose by
            no more than the shutdown timeout. An abandoned generation is unreachable
            garbage that can no longer publish stale truth.
            A publication already admitted when disposal times out its bounded drain may
            complete after <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.DisposeAsync"/> returns. If the manager has
            disposed the repository by then, the publication is discarded rather than
            emitted, so no device event escapes a disposed manager. This is a documented
            contract, not an accident.
            </para>
            </remarks>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.ThrottleInterval">
            <summary>
            Quiet period after the last listener hint before a coalesced repository rescan runs.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MaxCoalesceInterval">
            <summary>
            Maximum time listener hints may be coalesced before forcing a repository rescan.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.DefaultShutdownTimeout">
            <summary>
            Default maximum time <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.StopMonitoring"/> and <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.DisposeAsync"/>
            wait for the monitoring loop and in-flight publications before abandoning them.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.PublishGateAcquiredForTest">
            <summary>
            Test seam: invoked after <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._publishGate"/> is acquired and before
            the admission check, so tests can pin admission atomicity deterministically.
            Never set in production.
            </summary>
        </member>
        <member name="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.PublishAdmittedForTest">
            <summary>
            Test seam: invoked after a snapshot passes admission and before
            <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.UpdateCache(System.Collections.Generic.IEnumerable{Yubico.YubiKit.Core.Abstractions.IYubiKey})"/> runs, while <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._publishGate"/> is
            still held. Never set in production.
            </summary>
            <remarks>
            This is the window a blocking device-event subscriber used to occupy. Delivery is now
            asynchronous fan-out into per-watcher buffers, so no consumer can hold a publication in flight
            any more - which is the point of the design, and also why the lifecycle tests that must hold one
            need a seam instead.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.#ctor(Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository,Yubico.YubiKit.Core.Devices.IFindYubiKeys)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService"/> class.
            </summary>
            <param name="repository">The device repository to update on scans.</param>
            <param name="findYubiKeys">The device discovery service.</param>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.IsMonitoring">
            <summary>
            Gets a value indicating whether device monitoring is currently active.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.RescanAsync(System.Threading.CancellationToken)">
            <summary>
            Performs a single device scan and updates the repository.
            </summary>
            <param name="cancellationToken">Token to cancel the operation.</param>
            <returns>A task representing the async operation.</returns>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.PublishSnapshotAsync(Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration,System.Collections.Generic.IReadOnlyList{Yubico.YubiKit.Core.Abstractions.IYubiKey},System.Threading.CancellationToken)">
            <summary>
            Publishes a device snapshot under the shared publication gate. Admission is
            the linearization point: a snapshot publishes iff its generation is current
            and the service undisposed at admission; superseded snapshots are discarded.
            A publication admitted while current may complete after a concurrent swap,
            but the successor's first publication is serialized strictly after it, so
            newer truth always lands last.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.StartMonitoring(System.TimeSpan)">
            <summary>
            Starts continuous monitoring for device changes.
            </summary>
            <param name="interval">The polling interval between scans when no events occur.</param>
            <remarks>
            <para>
            Monitoring is event-driven with interval-based fallback. When device events
            occur (via HID or SmartCard listeners), a rescan is triggered immediately
            with coalescing to avoid redundant scans.
            </para>
            <para>
            Calling this while monitoring is already running is a no-op, <b>including when
            <paramref name="interval"/> differs from the running one</b>. The new interval is
            ignored rather than applied, and no error is raised. Stop monitoring and start it
            again to change the interval. This is a deliberate contract, not an oversight: a
            silent partial application would be worse than either extreme, and throwing would
            make an idempotent start unsafe to call defensively.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.TryStartHidListener(Yubico.YubiKit.Core.Devices.DeviceMonitorSignal)">
            <summary>
            Starts the HID device-change listener on a best-effort basis. Returns the
            started listener, or <see langword="null"/> if it could not start; in that
            case HID changes are still detected by the interval fallback rescan.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.TryStartSmartCardListener(Yubico.YubiKit.Core.Devices.DeviceMonitorSignal)">
            <summary>
            Starts the SmartCard device-change listener on a best-effort basis. Returns
            the started listener, or <see langword="null"/> if it could not start; in
            that case SmartCard changes are still detected by the interval fallback
            rescan. A missing or stopped PC/SC service is the common non-fatal cause.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.StopMonitoring">
            <summary>
            Stops monitoring for device changes.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.RetireCurrentGeneration(System.Boolean)">
            <summary>
            Retires the current generation: cancels it, completes its signal, and swaps it out of
            <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._current"/> so nothing it still does can pass admission.
            </summary>
            <remarks>
            <para>
            The swap is the load-bearing half, not the cancellation. A retired generation that is still
            reachable through <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._current"/> passes the admission check in
            <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.PublishSnapshotAsync(Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration,System.Collections.Generic.IReadOnlyList{Yubico.YubiKit.Core.Abstractions.IYubiKey},System.Threading.CancellationToken)"/>, so a manual rescan that captured it can publish stale truth
            after it was retired. Cancelling its token does not prevent that: <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.RescanAsync(System.Threading.CancellationToken)"/>
            waits on the caller's token, not the generation's.
            </para>
            <para>
            There is exactly one retirement path on purpose. The restart-after-loop-death branch in
            <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.StartMonitoring(System.TimeSpan)"/> previously carried its own copy that cancelled and completed but
            never swapped, leaving the dead generation current across listener teardown and startup - a far
            wider window than the one here. A second "retire a generation" mechanism is precisely the
            re-merge that <c>src/Core/CLAUDE.md</c> warns against; keep it single.
            </para>
            <para>
            <paramref name="disposing"/> clears the slot outright. Every other caller installs a fresh
            generation so manual rescans keep working after a plain stop or a restart.
            </para>
            <para>
            <b>Precondition: the caller must hold <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._monitorLock"/>.</b> This reads
            <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._current"/> before taking <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._publishLock"/> to write it, which is only safe
            because every write to <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._current"/> after construction happens under
            <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._monitorLock"/>. Without that, the read and the write could straddle a concurrent swap
            and this would retire one generation while replacing a different one.
            </para>
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitoringLoopAsync(System.TimeSpan,Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration,System.Threading.CancellationToken)">
            <summary>
            Internal monitoring loop that processes listener events using a
            <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.ThrottleInterval"/> quiet period capped by
            <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MaxCoalesceInterval"/>, plus interval fallback scans.
            The loop captures its generation once and never re-reads
            <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService._current"/>; once superseded, its publications fail admission.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.WaitForDebounceQuietPeriodAsync(Yubico.YubiKit.Core.Devices.DeviceMonitorSignal,System.Threading.CancellationToken)">
            <summary>
            Waits for listener hints to stay quiet for <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.ThrottleInterval"/>,
            forcing a rescan once the coalescing round reaches
            <see cref="F:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MaxCoalesceInterval"/>.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.TeardownListeners">
            <summary>
            Tears down device listeners. Signal completion is handled where the
            owning generation is retired, not here.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.DisposeAsync">
            <summary>
            Stops monitoring, tears down listeners, and bounded-drains any in-flight publication.
            Idempotent.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration">
            <summary>
            One monitoring epoch. The loop, manual rescans, and listener callbacks all
            capture this reference once; a generation's identity is that reference, so
            a torn gate/generation pairing is impossible by construction. Gates are
            never disposed - an abandoned generation is unreachable garbage that can
            wedge nothing outside itself.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration.Id">
            <summary>Monotonic identifier, used for logging only.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration.ScanGate">
            <summary>Serializes scan+publish sequences within this generation. Never disposed.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration.Signal">
            <summary>Capacity-one wake-up signal for this generation's loop.</summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService.MonitorGeneration.Cts">
            <summary>
                Cancellation source for this generation's loop. Never disposed, like the gates:
                an abandoned generation is unreachable garbage. It holds no timer (nothing calls
                <c>CancelAfter</c>) and every linked source derived from it is disposed by its own
                <c>using</c>, so disposal would reclaim nothing while reintroducing the question
                "is it safe to dispose this yet?" that the epoch model exists to eliminate.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.DeviceMonitorSignal">
            <summary>
                Capacity-one occurrence signal for monitor wake-ups. Listener payloads are logged at ingress and are
                intentionally not queued because the consumer only needs to know that at least one rescan is pending.
            </summary>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository">
            <summary>
            Pure cache repository for YubiKey devices with diff-based change detection.
            </summary>
            <remarks>
            This class maintains a thread-safe cache of discovered devices and emits
            <see cref="T:Yubico.YubiKit.Core.DeviceEvent"/>s when the cache is updated via <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.UpdateCache(System.Collections.Generic.IEnumerable{Yubico.YubiKit.Core.Abstractions.IYubiKey})"/>.
            It has no discovery capability - that responsibility belongs to
            <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyDeviceMonitorService"/>.
            The repository owns the <see cref="T:Yubico.YubiKit.Core.Devices.DeviceEventHub"/> that backs <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.WatchAsync(System.Threading.CancellationToken)"/>.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.WatchAsync(System.Threading.CancellationToken)">
            <summary>
            Async sequence of device change events (added/removed).
            </summary>
            <param name="cancellationToken">Cancels this enumeration only.</param>
            <remarks>
            Subscription is lazy, and each enumeration owns an independent bounded buffer. Cancellation and
            overflow terminate only the affected enumeration; repository disposal ends every active
            enumeration normally. Delivery is asynchronous, so no consumer can block or interrupt
            <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.UpdateCache(System.Collections.Generic.IEnumerable{Yubico.YubiKit.Core.Abstractions.IYubiKey})"/>.
            </remarks>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.WatcherCount">
            <summary>
            Number of live <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.WatchAsync(System.Threading.CancellationToken)"/> subscriptions. Diagnostic observability for the
            lazy-subscription contract.
            </summary>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.HasData">
            <summary>
            Indicates whether the cache holds the result of a completed scan.
            </summary>
            <remarks>
            This is a cache-validity flag, not a count. A scan that legitimately found no devices sets it,
            so <see langword="true"/> with an empty <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.GetAll(Yubico.YubiKit.Core.Devices.ConnectionType)"/> means "scanned, nothing attached"
            rather than "never scanned" - which is exactly the distinction
            <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceManager.FindAllAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Boolean,System.Threading.CancellationToken)"/> needs to avoid rescanning on every call when no
            key is plugged in. It returns to <see langword="false"/> on <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.Dispose"/>, which
            discards the cache it describes.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.GetAll(Yubico.YubiKit.Core.Devices.ConnectionType)">
            <summary>
            Gets all cached devices, optionally filtered by connection type.
            </summary>
            <param name="type">The connection type to filter by, or <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.All"/> for all devices. <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Hid"/> includes HID FIDO and HID OTP devices.</param>
            <returns>A read-only list of cached devices matching the filter.</returns>
            <remarks>
            This is a synchronous operation that returns only cached data.
            It does not trigger device discovery.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.UpdateCache(System.Collections.Generic.IEnumerable{Yubico.YubiKit.Core.Abstractions.IYubiKey})">
            <summary>
            Updates the cache with a new set of discovered devices.
            </summary>
            <param name="devices">The complete set of currently connected devices.</param>
            <remarks>
            This method performs a diff between the current cache and the new set,
            emitting <see cref="T:Yubico.YubiKit.Core.DeviceEvent"/>s for added and removed devices.
            Publication is asynchronous fan-out into per-watcher buffers, so this method never runs
            consumer code and cannot be blocked or interrupted by a watcher.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.Dispose">
            <summary>
            Ends every active <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.WatchAsync(System.Threading.CancellationToken)"/> enumeration normally, clears the cache, and resets
            <see cref="P:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.HasData"/> so the discarded cache is no longer reported as valid. Idempotent.
            </summary>
            <remarks>
            The disposed flag is set before the cache is emptied, so a concurrent <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyDeviceRepository.UpdateCache(System.Collections.Generic.IEnumerable{Yubico.YubiKit.Core.Abstractions.IYubiKey})"/>
            either completes in full beforehand or is rejected outright. There is no instant at which the
            repository is live and emptied, which is what stops a late publication from diffing an attached
            device against an empty cache and reporting it as newly added.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.Devices.YubiKeyManager">
             <summary>
             Provides a static API for discovering and monitoring YubiKey devices.
             </summary>
             <remarks>
             <para>
             <see cref="T:Yubico.YubiKit.Core.Devices.YubiKeyManager"/> is a static-only API - no dependency injection is required.
             Simply call the static methods directly to discover and monitor devices.
             </para>
             <para><strong>Thread Safety:</strong> All methods are thread-safe and can be called from any thread.</para>
             <para><strong>Threading:</strong> Publication never runs consumer code — <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/>
             enqueues into a per-watcher buffer, so nothing in the <c>await foreach</c> body executes on the
             device-monitoring path. The thread that resumes each iteration is not guaranteed: an already-buffered
             event can complete <c>MoveNextAsync</c> synchronously on the calling thread, while an awaited one
             resumes on a thread-pool thread. UI applications must therefore marshal explicitly rather than relying
             on either behaviour.</para>
             <para><strong>Testing Pattern:</strong> Call <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.ShutdownAsync(System.Threading.CancellationToken)"/> in test cleanup (e.g., xUnit
             <c>DisposeAsync</c> or <c>IAsyncLifetime.DisposeAsync</c>) to reset static state between tests.</para>
             <para><strong>Caching Behavior:</strong> By default, <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(System.Threading.CancellationToken)"/>
             returns cached results after the first call. Use <c>forceRescan: true</c> to always perform a fresh
             device scan, or call <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.ShutdownAsync(System.Threading.CancellationToken)"/> to clear the cache.</para>
             </remarks>
             <example>
             <para><strong>Simple Device Discovery:</strong></para>
             <code>
             using System;
             using Yubico.YubiKit.Core;
             using Yubico.YubiKit.Core.Devices;
            
             var devices = await YubiKeyManager.FindAllAsync();
             foreach (var device in devices)
             {
                 Console.WriteLine($"Found: {device.DeviceId} ({device.AvailableConnections})");
             }
             </code>
             <para><strong>Force Fresh Scan:</strong></para>
             <code>
             var devices = await YubiKeyManager.FindAllAsync(forceRescan: true);
             </code>
             <para><strong>Device Monitoring:</strong></para>
             <code>
             YubiKeyManager.StartMonitoring();
            
             await foreach (var e in YubiKeyManager.WatchAsync())
             {
                 Console.WriteLine($"{e.Action}: {e.Device.DeviceId} ({e.Device.AvailableConnections})");
             }
             </code>
             <para>
             <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/> is the only device-change stream. Several watchers can run at once: each
             enumeration is independent, with its own buffer, and one watcher's cancellation or overflow does
             not disturb another.
             </para>
             </example>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.EnsureManager">
            <summary>
            Ensures the manager exists, creating it lazily if needed.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring">
            <summary>
            Starts monitoring for YubiKey device changes using the default interval (5 seconds).
            </summary>
            <remarks>
            <para>This method is idempotent - calling it when monitoring is already active has no effect.</para>
            <para>Device listeners are set up to detect hardware events and trigger immediate scans.</para>
            </remarks>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring(System.TimeSpan)"/>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StopMonitoring"/>
            <seealso cref="P:Yubico.YubiKit.Core.Devices.YubiKeyManager.IsMonitoring"/>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring(System.TimeSpan)">
            <summary>
            Starts monitoring for YubiKey device changes using the specified interval.
            </summary>
            <param name="interval">The interval between device scans. Must be positive.</param>
            <exception cref="T:System.ArgumentOutOfRangeException">Thrown when interval is zero or negative.</exception>
            <remarks>
            <para>This method is idempotent - calling it when monitoring is already active has no effect.</para>
            <para>Device listeners are set up to detect hardware events and trigger immediate scans,
            in addition to the periodic interval-based scans.</para>
            </remarks>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StopMonitoring"/>
            <seealso cref="P:Yubico.YubiKit.Core.Devices.YubiKeyManager.IsMonitoring"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StopMonitoring">
            <summary>
            Stops monitoring for YubiKey device changes.
            </summary>
            <remarks>
            <para>This method is idempotent - calling it when monitoring is not active has no effect.</para>
            <para>Waits up to 10 seconds for the monitoring loop to stop. A scan already dispatched to
            native enumeration may continue after this method returns; the stop timeout does not cancel
            native work or prove it has drained.</para>
            <para>Device listeners are disposed and events will no longer be emitted to <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/>
            consumers until <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/> is called again.</para>
            </remarks>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/>
            <seealso cref="P:Yubico.YubiKit.Core.Devices.YubiKeyManager.IsMonitoring"/>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.ShutdownAsync(System.Threading.CancellationToken)"/>
        </member>
        <member name="P:Yubico.YubiKit.Core.Devices.YubiKeyManager.IsMonitoring">
            <summary>
            Gets a value indicating whether device monitoring is currently active.
            </summary>
            <value><see langword="true"/> if monitoring is active; otherwise, <see langword="false"/>.</value>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StopMonitoring"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)">
             <summary>
             Gets an async sequence of device events (arrivals and removals), consumed with
             <c>await foreach</c>. This is the only device-change stream.
             </summary>
             <param name="cancellationToken">Cancels enumeration.</param>
             <returns>A sequence that ends normally when the SDK shuts down.</returns>
             <exception cref="T:System.OperationCanceledException">
             Thrown from enumeration when <paramref name="cancellationToken"/> is canceled.
             </exception>
             <exception cref="T:System.InvalidOperationException">
             Thrown from enumeration when a new event arrives while the consumer's 256-event buffer is
             full. Re-enumerate and resynchronize via <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(System.Threading.CancellationToken)"/>.
             </exception>
             <remarks>
             <para>Events only flow while monitoring is active (see <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/>).</para>
             <para><strong>Subscription starts on first enumeration, not when this method is called.</strong>
             Begin the <c>await foreach</c> before performing an action expected to produce an event —
             events raised between calling this method and entering the loop are not observed. In practice
             this means iterating directly, as in the example below, rather than storing the sequence and
             enumerating it later.</para>
             <para>Each enumeration gets an independent bounded buffer, so concurrent watchers do not
             interfere and a slow consumer cannot stall device monitoring. Overflow faults only the
             affected enumeration.</para>
             <para><strong>Physical-device semantics:</strong> A composite key normally appears as one event,
             but ambiguous evidence can conservatively publish one physical key as multiple devices. For an
             uninterrupted presence with unchanged interface and connection sets and no contradictory known
             serial, the repository retains the object originally published in <see cref="F:Yubico.YubiKit.Core.DeviceAction.Added"/>
             so its <see cref="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.DeviceId"/> correlates with the eventual
             <see cref="F:Yubico.YubiKit.Core.DeviceAction.Removed"/> event.</para>
             </remarks>
             <example>
             <para><strong>Wait for the next YubiKey to be inserted, with a timeout:</strong></para>
             <code>
             using var cts = new CancellationTokenSource(TimeSpan.FromSeconds(30));
             YubiKeyManager.StartMonitoring();
            
             try
             {
                 await foreach (var e in YubiKeyManager.WatchAsync(cts.Token))
                 {
                     if (e.Action == DeviceAction.Added)
                     {
                         Console.WriteLine($"Inserted: {e.Device.DeviceId}");
                         break;
                     }
                 }
             }
             catch (OperationCanceledException) when (cts.IsCancellationRequested)
             {
                 Console.WriteLine("Timed out waiting for a YubiKey.");
             }
             </code>
             </example>
             <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.ShutdownAsync(System.Threading.CancellationToken)">
            <summary>
            Shuts down all YubiKeyManager resources asynchronously.
            </summary>
            <param name="cancellationToken">Cancellation token to cancel the shutdown operation.</param>
            <returns>A task representing the async shutdown operation.</returns>
            <exception cref="T:System.OperationCanceledException">Thrown when the cancellation token is triggered.</exception>
            <remarks>
            <para>This method stops monitoring if active, clears the internal device cache,
            and disposes managed monitoring resources. It is idempotent. Monitor shutdown waits up to
            10 seconds; if a scan does not finish within that bound, shutdown can return while the old
            scan is still running. Its late result cannot publish into the disposed manager, but this
            return is not proof that native enumeration has finished.</para>
            <para><strong>Testing Pattern:</strong> Call this in test cleanup to reset static state:</para>
            <code>
            public async ValueTask DisposeAsync()
            {
                await YubiKeyManager.ShutdownAsync();
            }
            </code>
            <para>After shutdown, <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(System.Threading.CancellationToken)"/> will perform a fresh scan,
            and <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/> can be called again to resume monitoring.</para>
            </remarks>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.Shutdown"/>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StopMonitoring"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.Shutdown">
            <summary>
            Shuts down all YubiKeyManager resources synchronously.
            </summary>
            <remarks>
            <para>This is a convenience wrapper around <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.ShutdownAsync(System.Threading.CancellationToken)"/>.</para>
            <para>For async contexts, prefer the async version to avoid blocking. A bounded monitor stop
            may abandon an in-flight native scan; return is not proof that all native work ended.</para>
            </remarks>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.ShutdownAsync(System.Threading.CancellationToken)"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(System.Threading.CancellationToken)">
            <summary>
            Finds all connected YubiKey devices using the static API (no DI required).
            </summary>
            <param name="cancellationToken">Cancellation token to cancel the scan.</param>
            <returns>A read-only list of discovered YubiKey devices, or an empty list if none found.</returns>
            <exception cref="T:System.OperationCanceledException">Thrown when the cancellation token is triggered.</exception>
            <exception cref="T:Yubico.YubiKit.Core.PlatformInteropException">Thrown when the platform API fails.</exception>
            <remarks>
            <para>This method returns cached results after the first call. Use the overload with
            <c>forceRescan: true</c> to always perform a fresh device scan.</para>
            <para>This method scans both SmartCard (PCSC) and HID transports.</para>
            <para>Results normally contain one <see cref="T:Yubico.YubiKit.Core.Abstractions.IYubiKey"/> per physical key, but ambiguous discovery
            evidence can conservatively split one key into multiple results. See the device-discovery guarantees
            documentation for the exact platform bounds.</para>
            <para><strong>Race Condition Note:</strong> Results may be stale if devices connect or
            disconnect during the scan. For real-time tracking, use <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/>
            with <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/>.</para>
            </remarks>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Boolean,System.Threading.CancellationToken)"/>
            <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(Yubico.YubiKit.Core.Devices.ConnectionType,System.Boolean,System.Threading.CancellationToken)">
             <summary>
             Finds all connected YubiKey devices, with options for connection type and rescan behavior.
             </summary>
             <param name="type">The connection type to filter by. <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.Hid"/> includes both HID FIDO and HID OTP devices. Default is <see cref="F:Yubico.YubiKit.Core.Devices.ConnectionType.All"/>.</param>
             <param name="forceRescan">
             If <c>true</c>, always performs a fresh device scan.
             If <c>false</c> (default), returns cached results unless cache is empty.
             </param>
             <param name="cancellationToken">Cancellation token to cancel the scan.</param>
             <returns>A read-only list of discovered YubiKey devices matching the filter, or an empty list if none found.</returns>
             <exception cref="T:System.OperationCanceledException">Thrown when the cancellation token is triggered.</exception>
             <exception cref="T:Yubico.YubiKit.Core.PlatformInteropException">Thrown when the platform API fails.</exception>
             <remarks>
             <para><strong>Caching:</strong> When <paramref name="forceRescan"/> is <c>false</c>:
             <list type="bullet">
               <item>First call: Performs a fresh scan and caches results</item>
               <item>Subsequent calls: Returns cached results</item>
               <item>While monitoring: Returns cached results (monitoring keeps cache fresh)</item>
             </list>
             </para>
             <para><strong>Identity:</strong> For an uninterrupted presence with unchanged physical interfaces and
             <see cref="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.AvailableConnections"/>, the cached object retains the <see cref="P:Yubico.YubiKit.Core.Abstractions.IYubiKey.DeviceId"/>
             that was originally published unless a fresh known serial proves that different hardware now occupies
             the same interfaces. A connection-set change or proven substitution is republished as removal followed
             by addition. A newly
             constructed object from a fresh scan can have a different evidence-tier-derived ID before repository
             reconciliation; do not use independently obtained scan objects as durable physical-identity records.</para>
             <para><strong>Physical-device bounds:</strong> One result per physical key is the common case, not an
             unconditional promise. When topology, serial, and PID evidence cannot safely correlate interfaces,
             discovery publishes conservative splits rather than risk merging different keys.</para>
             <para><strong>Race Condition Note:</strong> Results may be stale if devices connect or
             disconnect during the scan. For real-time tracking, use <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/>
             with <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.StartMonitoring"/>.</para>
             </remarks>
             <example>
             <code>
             // Simple usage - returns cached results
             var devices = await YubiKeyManager.FindAllAsync();
            
             // Force a fresh scan
             var freshDevices = await YubiKeyManager.FindAllAsync(forceRescan: true);
            
             // Filter by connection type
             var smartCardDevices = await YubiKeyManager.FindAllAsync(ConnectionType.SmartCard);
            
             // Both options
             var freshSmartCard = await YubiKeyManager.FindAllAsync(
                 ConnectionType.SmartCard,
                 forceRescan: true);
             </code>
             </example>
             <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(System.Threading.CancellationToken)"/>
             <seealso cref="T:Yubico.YubiKit.Core.Devices.ConnectionType"/>
             <seealso cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.WatchAsync(System.Threading.CancellationToken)"/>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindFirstAsync(System.Func{Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Boolean},System.Threading.CancellationToken)">
            <summary>
            Finds the first connected YubiKey that satisfies an optional predicate.
            </summary>
            <param name="predicate">An optional predicate used to select a device.</param>
            <param name="cancellationToken">Cancellation token to cancel discovery.</param>
            <returns>The first matching YubiKey.</returns>
            <exception cref="T:System.InvalidOperationException">Thrown when no matching YubiKey is connected.</exception>
            <remarks>
            This method is a one-shot query over <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(System.Threading.CancellationToken)"/>. It does not
            wait for insertion, and discovery ordering is not stable. It inherits the caching and cancellation
            behavior of <c>FindAllAsync</c>: the token is passed to discovery, while a cached result may complete
            without observing cancellation. Discovery and predicate exceptions are propagated unchanged.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindFirstOrDefaultAsync(System.Func{Yubico.YubiKit.Core.Abstractions.IYubiKey,System.Boolean},System.Threading.CancellationToken)">
            <summary>
            Finds the first connected YubiKey that satisfies an optional predicate, or returns
            <see langword="null"/> when none matches.
            </summary>
            <param name="predicate">An optional predicate used to select a device.</param>
            <param name="cancellationToken">Cancellation token to cancel discovery.</param>
            <returns>The first matching YubiKey, or <see langword="null"/> when none matches.</returns>
            <remarks>
            This method is a one-shot query over <see cref="M:Yubico.YubiKit.Core.Devices.YubiKeyManager.FindAllAsync(System.Threading.CancellationToken)"/>. It does not
            wait for insertion, and discovery ordering is not stable. It inherits the caching and cancellation
            behavior of <c>FindAllAsync</c>: the token is passed to discovery, while a cached result may complete
            without observing cancellation. Discovery and predicate exceptions are propagated unchanged.
            </remarks>
        </member>
        <member name="T:Yubico.YubiKit.Core.PlatformInteropException">
            <summary>
            Exception thrown when a platform interop (P/Invoke) operation fails.
            </summary>
            <remarks>
            This exception wraps platform-specific errors from native API calls (PC/SC, HID, etc.)
            and provides context about what operation failed.
            </remarks>
        </member>
        <member name="M:Yubico.YubiKit.Core.PlatformInteropException.#ctor">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.PlatformInteropException"/> class.
            </summary>
        </member>
        <member name="M:Yubico.YubiKit.Core.PlatformInteropException.#ctor(System.String)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.PlatformInteropException"/> class with a specified error message.
            </summary>
            <param name="message">The error message that explains the reason for the exception.</param>
        </member>
        <member name="M:Yubico.YubiKit.Core.PlatformInteropException.#ctor(System.String,System.Exception)">
            <summary>
            Initializes a new instance of the <see cref="T:Yubico.YubiKit.Core.PlatformInteropException"/> class with a specified error message
            and a reference to the inner exception that is the cause of this exception.
            </summary>
            <param name="message">The error message that explains the reason for the exception.</param>
            <param name="innerException">The exception that is the cause of the current exception.</param>
        </member>
