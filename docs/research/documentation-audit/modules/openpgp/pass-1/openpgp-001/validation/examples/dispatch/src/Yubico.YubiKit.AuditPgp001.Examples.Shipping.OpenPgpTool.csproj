<Project DefaultTargets="Build">
  <!-- Build traversal only, not a C# host. The unmodified shipping SDK project
       imports its own canonical props/targets and compiles all real sample files.
       This prefix-qualified filename makes the toolchain's OpenPgpTool selector work
       without editing toolchain discovery or adding a reduced sample project. -->
  <PropertyGroup>
    <RepositoryRoot>$([MSBuild]::GetDirectoryNameOfFileAbove('$(MSBuildThisFileDirectory)', 'toolchain.cs'))</RepositoryRoot>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <ShippingOpenPgpToolProject>$(RepositoryRoot)/src/OpenPgp/examples/OpenPgpTool/OpenPgpTool.csproj</ShippingOpenPgpToolProject>
  </PropertyGroup>
  <Target Name="Restore">
    <MSBuild Projects="$(ShippingOpenPgpToolProject)" Targets="Restore" BuildInParallel="false" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="Clean">
    <MSBuild Projects="$(ShippingOpenPgpToolProject)" Targets="Clean" BuildInParallel="false" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="Build">
    <MSBuild Projects="$(ShippingOpenPgpToolProject)" Targets="Build" BuildInParallel="false" Properties="Configuration=$(Configuration)" />
  </Target>
  <Target Name="Rebuild">
    <MSBuild Projects="$(ShippingOpenPgpToolProject)" Targets="Rebuild" BuildInParallel="false" Properties="Configuration=$(Configuration)" />
  </Target>
</Project>
