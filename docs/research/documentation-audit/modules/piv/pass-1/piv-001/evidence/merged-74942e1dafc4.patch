+            PivManagementKeyType.Aes128 => 16,
+            PivManagementKeyType.Aes192 => 24,
+            PivManagementKeyType.Aes256 => 32,
+            _ => throw new ArgumentException($"Unsupported key type: {keyType}", nameof(keyType))
