    {
      "id": "fence:src/Piv/README.md:1",
      "path": "src/Piv/README.md",
      "ordinal": 1,
      "exact_body_sha256": "74716490a0a242972fe228090ba3a51c426652f62de606c37d62f470687fc2f9",
      "editor_normalized_sha256": "74716490a0a242972fe228090ba3a51c426652f62de606c37d62f470687fc2f9",
      "body": "dotnet nuget add source https://yubico.github.io/Yubico.NET.SDK/alpha/index.json -n yubikit-alpha\ndotnet add package Yubico.YubiKit.Piv --prerelease\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:1",
        "status": "non-csharp",
        "reason": "Complete shell command example retained; command/device execution stays separately authorized."
      }
    },
    {
      "id": "fence:src/Piv/README.md:2",
      "path": "src/Piv/README.md",
      "ordinal": 2,
      "exact_body_sha256": "207b4faf9f255923887b5bd96189d155c974fb304bbf836a2de307d6754e942d",
      "editor_normalized_sha256": "207b4faf9f255923887b5bd96189d155c974fb304bbf836a2de307d6754e942d",
      "body": "using System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Piv;\n\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreatePivSessionAsync();\n\nint pinAttempts = await session.GetPinAttemptsAsync();\nConsole.WriteLine($\"PIN attempts remaining: {pinAttempts}\");\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:2",
        "status": "compile",
        "group": "readme-discovery",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/README.md:3",
      "path": "src/Piv/README.md",
      "ordinal": 3,
      "exact_body_sha256": "5984cd4646d56a9960eec8f0bf2ed5dc825b6d45b12bc441af0391c270d35315",
      "editor_normalized_sha256": "5984cd4646d56a9960eec8f0bf2ed5dc825b6d45b12bc441af0391c270d35315",
      "body": "await using var session = await device.CreatePivSessionAsync();\n\n// Evaluation only: this public factory value must match the key currently installed.\nbyte[] managementKey = PivSession.DefaultManagementKey.ToArray();\ntry\n{\n    await session.AuthenticateAsync(managementKey);\n    var keyOptions = new KeyCreationOptions { PinPolicy = PinPolicy.Once, TouchPolicy = TouchPolicy.Never };\n    IPublicKey publicKey = await session.GenerateKeyAsync(Slot.Authentication, KeyType.P256, keyOptions);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey);\n}\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:3",
        "status": "compile",
        "group": "readme-generation",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/README.md:4",
      "path": "src/Piv/README.md",
      "ordinal": 4,
      "exact_body_sha256": "399e078e67ea215e2a7b8278156501559f2aab4c983769bee1161bf7e617130a",
      "editor_normalized_sha256": "399e078e67ea215e2a7b8278156501559f2aab4c983769bee1161bf7e617130a",
      "body": "using var certificate = X509CertificateLoader.LoadCertificateFromFile(\"authentication.cer\");\nawait session.StoreCertificateAsync(Slot.Authentication, certificate, CertificateCompression.Automatic);\nusing X509Certificate2? stored = await session.GetCertificateAsync(Slot.Authentication);\nif (stored is null)\n    throw new InvalidOperationException(\"The slot has no usable certificate data.\");\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:4",
        "status": "compile",
        "group": "readme-certificate",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/README.md:5",
      "path": "src/Piv/README.md",
      "ordinal": 5,
      "exact_body_sha256": "57f26da810500d5e15a7819c3e013e9df37043f9bf7179bc0509e69df70a3200",
      "editor_normalized_sha256": "57f26da810500d5e15a7819c3e013e9df37043f9bf7179bc0509e69df70a3200",
      "body": "await using var session = await device.CreatePivSessionAsync();\n\nbyte[] pin = Encoding.UTF8.GetBytes(\"123456\");\nbyte[] digest = SHA256.HashData(Encoding.UTF8.GetBytes(\"message to sign\"));\nMemory<byte> signature = Memory<byte>.Empty;\ntry\n{\n    await session.VerifyPinAsync(pin);\n    var metadata = await session.GetSlotMetadataAsync(Slot.Authentication)\n        ?? throw new InvalidOperationException(\"Generate a P-256 key first.\");\n    using var verifier = metadata.GetECDsaPublicKey();\n    signature = await session.SignOrDecryptAsync(Slot.Authentication, KeyType.P256, digest);\n    if (!verifier.VerifyHash(digest, signature.Span, DSASignatureFormat.Rfc3279DerSequence))\n        throw new CryptographicException(\"The slot signature failed host verification.\");\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n    CryptographicOperations.ZeroMemory(digest);\n    CryptographicOperations.ZeroMemory(signature.Span);\n}\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:5",
        "status": "compile",
        "group": "readme-host-signature",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/README.md:6",
      "path": "src/Piv/README.md",
      "ordinal": 6,
      "exact_body_sha256": "f85f61978e9c320e64f928f66fb671e28faa2feeb09a51863f63cd92b342d573",
      "editor_normalized_sha256": "f85f61978e9c320e64f928f66fb671e28faa2feeb09a51863f63cd92b342d573",
      "body": "await using var session = await device.CreatePivSessionAsync();\nusing var certificate = await session.GetCertificateAsync(Slot.KeyManagement)\n    ?? throw new InvalidOperationException(\"Provision a matching RSA certificate first.\");\nusing var rsa = certificate.GetRSAPublicKey()\n    ?? throw new InvalidOperationException(\"The certificate must contain an RSA public key.\");\nbyte[] pin = Encoding.UTF8.GetBytes(\"123456\");\nbyte[] expected = Encoding.UTF8.GetBytes(\"known plaintext\");\nMemory<byte> plaintext = Memory<byte>.Empty;\ntry\n{\n    byte[] ciphertext = rsa.Encrypt(expected, RSAEncryptionPadding.OaepSHA256);\n    await session.VerifyPinAsync(pin);\n    plaintext = await session.DecryptAsync(Slot.KeyManagement, ciphertext, RSAEncryptionPadding.OaepSHA256);\n    if (!CryptographicOperations.FixedTimeEquals(expected, plaintext.Span))\n        throw new CryptographicException(\"Decryption returned unexpected plaintext.\");\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n    CryptographicOperations.ZeroMemory(expected);\n    CryptographicOperations.ZeroMemory(plaintext.Span);\n}\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:6",
        "status": "compile",
        "group": "readme-known-plaintext",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/README.md:7",
      "path": "src/Piv/README.md",
      "ordinal": 7,
      "exact_body_sha256": "2339fa6f1c979845e14b4fd8c8c949effb1f7bf146d33bc224771773567570cd",
      "editor_normalized_sha256": "2339fa6f1c979845e14b4fd8c8c949effb1f7bf146d33bc224771773567570cd",
      "body": "static async Task ProtectedAdministrationRoundTripAsync(\n    IYubiKey device,\n    ReadOnlyMemory<byte> pin,\n    ReadOnlyMemory<byte> activeManagementKey,\n    CancellationToken cancellationToken)\n{\n    await using (var setup = await device.CreatePivSessionAsync(cancellationToken: cancellationToken))\n    {\n        await setup.AuthenticateAsync(activeManagementKey, cancellationToken);\n        await setup.SetPinOnlyModeAsync(PinOnlyMode.PinProtected, pin, activeManagementKey, cancellationToken);\n    }\n\n    await using (var reopened = await device.CreatePivSessionAsync(cancellationToken: cancellationToken))\n    {\n        PinOnlyMode detected = await reopened.GetPinOnlyModeAsync(cancellationToken);\n        if (!detected.HasFlag(PinOnlyMode.PinProtected))\n            throw new InvalidOperationException(\"Inspect ADMIN DATA before continuing.\");\n        PinOnlyMode recovered = await reopened.RecoverPinOnlyModeAsync(pin, cancellationToken);\n        if (!recovered.HasFlag(PinOnlyMode.PinProtected) || !reopened.IsManagementKeyAuthenticated)\n            throw new InvalidOperationException(\"Use the backed-up active management key to recover access.\");\n\n        // Perform authorized administration here, then restore the type-appropriate public default.\n        await reopened.SetPinOnlyModeAsync(PinOnlyMode.None, pin, cancellationToken: cancellationToken);\n    }\n}\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:7",
        "status": "compile",
        "group": "readme-protected-roundtrip",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/README.md:8",
      "path": "src/Piv/README.md",
      "ordinal": 8,
      "exact_body_sha256": "ca8fe727d322c778aabf304fd3260fb21de2c9619067f783b11892536be2b6ae",
      "editor_normalized_sha256": "ca8fe727d322c778aabf304fd3260fb21de2c9619067f783b11892536be2b6ae",
      "body": "sealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:8",
        "status": "compile",
        "group": "readme-touch-callback",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/README.md:9",
      "path": "src/Piv/README.md",
      "ordinal": 9,
      "exact_body_sha256": "f0255a5d67fbf9956f2e67a1a9b16be868f0b2bb985edd5e8c0f231bba31d2f1",
      "editor_normalized_sha256": "f0255a5d67fbf9956f2e67a1a9b16be868f0b2bb985edd5e8c0f231bba31d2f1",
      "body": "var options = new SessionCreationOptions { UserPresencePrompt = new TouchPrompt() };\nawait using var session = await device.CreatePivSessionAsync(options);\n",
      "disposition": {
        "id": "fence:src/Piv/README.md:9",
        "status": "compile",
        "group": "readme-touch-callback",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
