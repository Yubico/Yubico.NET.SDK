    {
      "id": "fence:src/Piv/CLAUDE.md:2",
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 2,
      "exact_body_sha256": "e700a69044060c5758652c2fa9760bd10c840c2f3f2f23c5365078fe7cb47d14",
      "editor_normalized_sha256": "e700a69044060c5758652c2fa9760bd10c840c2f3f2f23c5365078fe7cb47d14",
      "body": "await using var connection = await device.ConnectAsync<ISmartCardConnection>(cancellationToken);\nawait using var session = await PivSession.CreateAsync(connection, cancellationToken: cancellationToken);\n",
      "disposition": {
        "id": "fence:src/Piv/CLAUDE.md:2",
        "status": "compile",
        "group": "factory-borrowed-connection",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/CLAUDE.md:3",
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 3,
      "exact_body_sha256": "7edf983d15f3e18d72c798ae92b24b900c16a476643d4c8615e9031c58059c93",
      "editor_normalized_sha256": "7edf983d15f3e18d72c798ae92b24b900c16a476643d4c8615e9031c58059c93",
      "body": "PivSession public method\n  -> validate arguments and session state\n  -> ensure feature support when firmware-gated\n  -> call one shallow internal protocol helper\n  -> helper builds visible APDU/TLV payload\n  -> transmit through Core SmartCard protocol\n  -> parse response\n  -> zero sensitive source/intermediate buffers in finally\n",
      "disposition": {
        "id": "fence:src/Piv/CLAUDE.md:3",
        "status": "non-executable",
        "reason": "Protocol-flow diagram retained as explanatory structure."
      }
    },
    {
      "id": "fence:src/Piv/CLAUDE.md:4",
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 4,
      "exact_body_sha256": "83cdf478ae14d6ba3440ab3626acdb2a5b41afc9d148e37f3757121e75429259",
      "editor_normalized_sha256": "83cdf478ae14d6ba3440ab3626acdb2a5b41afc9d148e37f3757121e75429259",
      "body": "static async Task AuthenticateWithStoreAsync(\n    IPivSession session,\n    Action<Memory<byte>> loadManagementKey,\n    CancellationToken cancellationToken)\n{\n    // This example store contract supplies a 24-byte Triple-DES or AES-192 active key.\n    byte[] managementKey = ArrayPool<byte>.Shared.Rent(24);\n    try\n    {\n        loadManagementKey(managementKey.AsMemory(0, 24));\n        await session.AuthenticateAsync(managementKey.AsMemory(0, 24), cancellationToken);\n    }\n    finally\n    {\n        CryptographicOperations.ZeroMemory(managementKey.AsSpan(0, 24));\n        ArrayPool<byte>.Shared.Return(managementKey, clearArray: true);\n    }\n}\n",
      "disposition": {
        "id": "fence:src/Piv/CLAUDE.md:4",
        "status": "compile",
        "group": "store-authentication-callback",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/CLAUDE.md:5",
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 5,
      "exact_body_sha256": "4c9bd11db4b25743b64fd4c3279d947c67699584f1e6c9c78b558b5b34919036",
      "editor_normalized_sha256": "4c9bd11db4b25743b64fd4c3279d947c67699584f1e6c9c78b558b5b34919036",
      "body": "PivSession.GenerateKeyAsync\n  -> KeyProtocol.GenerateKeyAsync\n  -> builds key-generation TLV/APDU visibly\n  -> parses returned public key\n",
      "disposition": {
        "id": "fence:src/Piv/CLAUDE.md:5",
        "status": "non-executable",
        "reason": "Protocol-flow diagram retained as explanatory structure."
      }
    },
    {
      "id": "fence:src/Piv/CLAUDE.md:6",
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 6,
      "exact_body_sha256": "9d130e74836e29004f6c427ef935ce40cd88d276d10837180b765902660c4e67",
      "editor_normalized_sha256": "9d130e74836e29004f6c427ef935ce40cd88d276d10837180b765902660c4e67",
      "body": "[SkippableTheory]\n[WithYubiKey(Capability = DeviceCapabilities.Piv)]\npublic async Task GetMetadata_ReadOnly_Succeeds(YubiKeyTestState state)\n{\n    await using var session = await state.Device.CreatePivSessionAsync();\n    var metadata = await session.GetPinMetadataAsync();\n    Assert.NotNull(metadata);\n}\n",
      "disposition": {
        "id": "fence:src/Piv/CLAUDE.md:6",
        "status": "compile",
        "group": "metadata-test-annotation",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/PACKAGE_README.md:1",
      "path": "src/Piv/PACKAGE_README.md",
      "ordinal": 1,
      "exact_body_sha256": "74716490a0a242972fe228090ba3a51c426652f62de606c37d62f470687fc2f9",
      "editor_normalized_sha256": "74716490a0a242972fe228090ba3a51c426652f62de606c37d62f470687fc2f9",
      "body": "dotnet nuget add source https://yubico.github.io/Yubico.NET.SDK/alpha/index.json -n yubikit-alpha\ndotnet add package Yubico.YubiKit.Piv --prerelease\n",
      "disposition": {
        "id": "fence:src/Piv/PACKAGE_README.md:1",
        "status": "non-csharp",
        "reason": "Complete shell command example retained; command/device execution stays separately authorized."
