    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Attestation.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Attestation.cs",
      "ordinal": 1,
      "exact_body_sha256": "993c34a92f7ce4223fbc4a806830179745d3f8b0266b0281441c23ab830725ae",
      "editor_normalized_sha256": "00cc9d533b5c2708ecf784a39b0138b2b0a42e9432dd6879a5bb61b5948bd34a",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Attestation.GetAttestationAsync(\n    session, Slot.Authentication, ct);\n\nusing var attestCert = result.AttestationCertificate;\nusing var signerCert = result.IntermediateCertificate;\nif (result.Success && attestCert is not null)\n{\n    Console.WriteLine($\"Retrieved attestation: {attestCert.Subject}\");\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Attestation.cs:2:code:1",
        "status": "compile",
        "group": "tool-slot-attestation",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Attestation.cs:3:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Attestation.cs",
      "ordinal": 2,
      "exact_body_sha256": "46daea07268a243ae22477e1c2627e23e339ad9b7b4cd3b29c4dc4644e84e29b",
      "editor_normalized_sha256": "c26c99a88224f73c91b9d2821843aec7abd049d7cd4fb36c9618be9a574a0ccc",
      "body": "\nvar result = await Attestation.GetIntermediateCertificateAsync(session, ct);\n// This helper returns F9 in AttestationCertificate; IntermediateCertificate remains null.\nusing var f9Cert = result.AttestationCertificate;\nusing var additionalCert = result.IntermediateCertificate;\nif (result.Success && f9Cert is not null)\n{\n    Console.WriteLine(f9Cert.Subject);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Attestation.cs:3:code:1",
        "status": "compile",
        "group": "tool-f9-retrieval",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 1,
      "exact_body_sha256": "2b52e6dd517e67020b76370130dd2ab8c6c3017a80ff20e6b580a1b69ad5ed8a",
      "editor_normalized_sha256": "beed0d1766b0b38f7ccbf2b71f3d31364a2c9083436315841f63f58238aee8ba",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Certificates.GetCertificateAsync(session, Slot.Authentication, ct);\nusing var certificate = result.Certificate;\nif (result.Success && certificate is not null)\n{\n    Console.WriteLine($\"Subject: {certificate.Subject}\");\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:2:code:1",
        "status": "compile",
        "group": "tool-certificate-read",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:3:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 2,
      "exact_body_sha256": "6c0392cfc81f07f4216916a6fbbbf8617068c5c6aa50cf7eb3429da9f9beaf4a",
      "editor_normalized_sha256": "0a30aad4238770afc4f9376a57070ae065a8e558c0aed38059565551196c0102",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar certData = await File.ReadAllBytesAsync(\"certificate.pem\", ct);\nvar result = await Certificates.ImportCertificateAsync(\n    session, Slot.Authentication, certData, compress: false, cancellationToken: ct);\nusing var certificate = result.Certificate;\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:3:code:1",
        "status": "compile",
        "group": "tool-certificate-import",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:4:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 3,
      "exact_body_sha256": "ed4ab93fdd6d677a60408a356befc6e1e1d66ce1f4c3ed0f526f1c70841e30b8",
      "editor_normalized_sha256": "c8c626349a9eb320d2a119d44a086e287cb5d600f15a9c2a633d18518f3a268b",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Certificates.ExportCertificatePemAsync(session, Slot.Authentication, ct);\nusing var certificate = result.Certificate;\nif (result.Success && certificate is not null)\n{\n    var pem = certificate.ExportCertificatePem();\n    await File.WriteAllTextAsync(\"certificate.pem\", pem, ct);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:4:code:1",
        "status": "compile",
        "group": "tool-certificate-export",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:5:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 4,
      "exact_body_sha256": "4f4e402bcce40e9d33d76b251804ce048c5b614ec6c87911ce756d1a18518636",
      "editor_normalized_sha256": "a130dbaa0260aabfe5eafb53d96767e99cf7811d2ed460d188ca462172bc1283",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar result = await Certificates.DeleteCertificateAsync(session, Slot.Authentication, ct);\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:5:code:1",
        "status": "compile",
        "group": "tool-certificate-delete",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:6:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 5,
      "exact_body_sha256": "3d9392273c4ae0eabfa54d921b546314fd83abbe6f652811addcf1777101923e",
      "editor_normalized_sha256": "3e152cba7a32c4dab3169eda41013aa62ac3d2a18113df278b6c9be67dcbf220",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Certificates.GenerateSelfSignedAsync(\n    session, Slot.Authentication, \"CN=Test User\", 365, ct);\nusing var certificate = result.Certificate;\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:6:code:1",
        "status": "compile",
        "group": "tool-certificate-self-sign",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:7:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 6,
      "exact_body_sha256": "c276f2dc5cdb04f61e9f66224924e66c4d784c69acaec81b0a96053251507872",
      "editor_normalized_sha256": "86dbad84ece385bbfb9ca20cb2b4528fe7622168ab52cc27771cdd23555f2a25",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.VerifyPinAsync(pin, ct); // Borrowed caller-owned PIN; required by the slot policy.\n\nvar result = await Certificates.GenerateCsrAsync(\n    session, Slot.Authentication, \"CN=Test User\", ct);\n\nusing var certificate = result.Certificate;\nif (result.Success && result.CsrPem is { } csrPem)\n{\n    await File.WriteAllTextAsync(\"request.csr\", csrPem, ct);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Certificates.cs:7:code:1",
        "status": "compile",
        "group": "tool-certificate-csr",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Decryption.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Decryption.cs",
      "ordinal": 1,
      "exact_body_sha256": "4dd4776b2445650555b01b2b9854abbe59d8322487faa88ccbb780d3530fecbb",
      "editor_normalized_sha256": "d85461d0f8aa27769ecb644b32990681b83e830824e6fd14b9bdcd2f686c2e26",
      "body": "\nvar options = new SessionCreationOptions { UserPresencePrompt = userPresencePrompt };\nawait using var session = await device.CreatePivSessionAsync(options, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Decryption.DecryptDataAsync(\n    session,\n    Slot.KeyManagement,\n    encryptedBytes,\n    cancellationToken: ct);\n\nif (result.Success)\n{\n    var plaintext = result.DecryptedData;\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Decryption.cs:2:code:1",
        "status": "compile",
        "group": "tool-decryption-inspection",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/DeviceInfo.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/DeviceInfo.cs",
      "ordinal": 1,
      "exact_body_sha256": "6c8eefd47cd09b4af6b22b25fddc49d8338bd2070c38f8c9a8880cfd5b1d18d4",
      "editor_normalized_sha256": "79eab3463c91e6cbebe713b8d86b196a135cc9dbecda626c55fc85e8c387a162",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await DeviceInfoQuery.GetPivRetryInfoAsync(session, ct);\nif (result.Success)\n{\n    Console.WriteLine($\"PIN retries: {result.PinRetriesRemaining}\");\n    Console.WriteLine($\"PUK retries: {result.PukRetriesRemaining}\");\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/DeviceInfo.cs:2:code:1",
        "status": "compile",
        "group": "tool-retry-metadata",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/KeyGeneration.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/KeyGeneration.cs",
      "ordinal": 1,
      "exact_body_sha256": "c593a2c9659c67039524a619afc53fec5ca50c8fae3fed03ed091a54c3f5b27d",
      "editor_normalized_sha256": "8c9161884ee46727d10d38f971a1bae067129348618914d1bf4091b70c9c667f",
      "body": "\n// Requires an authorized target slot and a borrowed active managementKey buffer.\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar result = await KeyGeneration.GenerateKeyAsync(\n    session,\n    Slot.Authentication,\n    KeyType.P256,\n    PinPolicy.Once,\n    TouchPolicy.Cached,\n    ct);\n\nif (result.Success)\n{\n    var publicKeyBytes = result.PublicKey;\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/KeyGeneration.cs:2:code:1",
        "status": "compile",
        "group": "tool-key-generation",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 1,
      "exact_body_sha256": "2180bcc04af32e54d47a5f936c2777752ae8a35fc44cee0141c3f03d87f390b3",
      "editor_normalized_sha256": "75d76af2476ce10959b20fcce0c97f46ad5b2d89c46966f4f674b5f7d9a735ca",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar pin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    var result = await PinManagement.VerifyPinAsync(session, pin, ct);\n    if (result.Success)\n    {\n        Console.WriteLine(\"PIN verified\");\n    }\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:2:code:1",
        "status": "compile",
        "group": "tool-pin-verify",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:3:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 2,
      "exact_body_sha256": "d43af70158e6897596eecc9b7cbefc9bb43efb6a8cfbdb52c3368f6dbe5aeee8",
      "editor_normalized_sha256": "dc238ed1a73070f01d4c5f56691d32f65c3c5ce26f20651928aaf7847d744f36",
      "body": "\nvar oldPin = Encoding.UTF8.GetBytes(\"123456\");\nvar newPin = Encoding.UTF8.GetBytes(\"654321\");\ntry\n{\n    var result = await PinManagement.ChangePinAsync(session, oldPin, newPin, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(oldPin);\n    CryptographicOperations.ZeroMemory(newPin);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:3:code:1",
        "status": "compile",
        "group": "tool-pin-change",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:5:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 3,
      "exact_body_sha256": "83bf25944bf38e4613915239e7b2459eb03cf46be285b7bd51ff34f3688c4c47",
      "editor_normalized_sha256": "5edfc4189a762d3890fc1c218a9fa827095ad88fa7c7f6cc99cac79b5fc27333",
      "body": "\nvar puk = Encoding.UTF8.GetBytes(\"12345678\");\nvar newPin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    var result = await PinManagement.UnblockPinAsync(session, puk, newPin, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(puk);\n    CryptographicOperations.ZeroMemory(newPin);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:5:code:1",
        "status": "compile",
        "group": "tool-pin-unblock",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:7:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 4,
      "exact_body_sha256": "941ba85075b86f7f9c19878e8529b9ee37616b8694e823e3423ad2ef4afea700",
      "editor_normalized_sha256": "25611c53e506990eecdb3dc137eb565ea0785ac746116f519168c4308e96ad21",
      "body": "\n// Evaluation only: the session must use the 24-byte factory key with Triple-DES or AES-192.\nvar mgmtKey = PivSession.DefaultManagementKey.ToArray();\ntry\n{\n    var result = await PinManagement.AuthenticateAsync(session, mgmtKey, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(mgmtKey);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:7:code:1",
        "status": "compile",
        "group": "tool-management-authenticate",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:8:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 5,
      "exact_body_sha256": "9ca3318b1de5a07cdd0648016ace9ee2fc91c7c1804a0a9abd1fbedaca6584bf",
      "editor_normalized_sha256": "5308874e3fe2fc0c37b9d7e60381e2f369f0a1415fbb209e5502f2756c936cb4",
      "body": "\n// currentKey and newKey are caller-owned buffers; securely back up newKey before this task.\n// This example installs a 24-byte Triple-DES key on a compatible device.\nawait session.AuthenticateAsync(currentKey, ct);\nvar result = await PinManagement.ChangeManagementKeyAsync(\n    session, newKey, KeyType.TripleDes, requireTouch: false, cancellationToken: ct);\n// Keep the backup through fresh-session authentication; the caller clears both buffers in finally.\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/PinManagement.cs:8:code:1",
        "status": "compile",
        "group": "tool-management-rotation",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Reset.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Reset.cs",
      "ordinal": 1,
      "exact_body_sha256": "0a885a52c60cdc3fcd7c2a5c68278cd8e3544f6a1121bcb4f6a2221f8e241861",
      "editor_normalized_sha256": "82c0e05ecc68942b74c8526f519feca59a2e4200979bab2390e50c3751bd253f",
      "body": "\n// Requires an authorized reset decision; normal reset retains F9 material.\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\n// Ensure user confirms this destructive action\nif (userConfirmedReset)\n{\n    var result = await Reset.ResetPivApplicationAsync(session, ct);\n    if (result.Success)\n    {\n        Console.WriteLine(\"PIV application reset to factory defaults.\");\n    }\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Reset.cs:2:code:1",
        "status": "compile",
        "group": "tool-reset",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Signing.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Signing.cs",
      "ordinal": 1,
      "exact_body_sha256": "da981b89fa4edab16f2bd76c91af12a4a20c3b39936350fa44e521d1f906af81",
      "editor_normalized_sha256": "8ed84a88e44e21d3597c7f81182c2c30f3ae79fe39a0da9e34874d94e5d098ad",
      "body": "\nvar options = new SessionCreationOptions { UserPresencePrompt = userPresencePrompt };\n// Requires an application-owned prompt, caller-owned PIN/data and a provisioned P-256/P-384 slot.\nawait using var session = await device.CreatePivSessionAsync(options, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Signing.SignDataAsync(\n    session, \n    Slot.Signature,\n    dataBytes,\n    HashAlgorithmName.SHA256,\n    ct);\n\nif (result.Success)\n{\n    var signature = result.Signature;\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Signing.cs:2:code:1",
        "status": "compile",
        "group": "tool-signing",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/SlotInfo.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/SlotInfo.cs",
      "ordinal": 1,
      "exact_body_sha256": "5c2eecc2d091c10c7f0cfaaab8164f87e9444131f3590cc8067f25bf1d201352",
      "editor_normalized_sha256": "2d86478c5d6ed1fbbbfabedda073686357a3adf3406d4e2bf317055b0fa46834",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await SlotInfoQuery.GetAllSlotsInfoAsync(session, ct);\ntry\n{\n    if (result.Success)\n    {\n        foreach (var slot in result.Slots)\n            Console.WriteLine($\"{slot.Name}: Key={slot.HasKey}, Cert={slot.HasCertificate}\");\n    }\n}\nfinally\n{\n    foreach (var slot in result.Slots)\n        slot.Certificate?.Dispose();\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/SlotInfo.cs:2:code:1",
        "status": "compile",
        "group": "tool-slot-query",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/examples/PivTool/PivExamples/Verification.cs:2:code:1",
      "path": "src/Piv/examples/PivTool/PivExamples/Verification.cs",
      "ordinal": 1,
      "exact_body_sha256": "8096946d5f822b49f32363bf4c815f309c16dbb4079175bf15f2ee3e066d7750",
      "editor_normalized_sha256": "e4bbfed1e7ce4921b340728a551f7d85f955a121077119e360400261ff788700",
      "body": "\nawait using var session = await device.CreatePivSessionAsync(cancellationToken: ct);\n\nvar result = await Verification.VerifySignatureAsync(\n    session,\n    Slot.Signature,\n    originalData,\n    signatureBytes,\n    HashAlgorithmName.SHA256,\n    ct);\n\nif (result.Success && result.IsValid)\n{\n    Console.WriteLine(\"Signature is valid!\");\n}\n",
      "disposition": {
        "id": "xml:src/Piv/examples/PivTool/PivExamples/Verification.cs:2:code:1",
        "status": "compile",
        "group": "tool-host-verification",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/src/SlotMetadataExtensions.cs:2:code:1",
      "path": "src/Piv/src/SlotMetadataExtensions.cs",
      "ordinal": 1,
      "exact_body_sha256": "35d45576cb2bcfb6f5b0e47a7fe91825c3d04a66d992e5fb4eb672226f81a2bb",
      "editor_normalized_sha256": "f51636139fe3d7b49537de677484e89c8623a003def94d0eb3f96a16d4f52be6",
      "body": "\n// Requires an open session, firmware 5.3+ and a provisioned RSA slot.\nvar metadata = await session.GetSlotMetadataAsync(Slot.Authentication)\n    ?? throw new InvalidOperationException(\"Provision an RSA key first.\");\nusing var rsa = metadata.GetRsaPublicKey();\nbyte[] plaintext = \"example\"u8.ToArray();\ntry\n{\n    byte[] ciphertext = rsa.Encrypt(plaintext, RSAEncryptionPadding.OaepSHA256);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(plaintext);\n}\n",
      "disposition": {
        "id": "xml:src/Piv/src/SlotMetadataExtensions.cs:2:code:1",
        "status": "compile",
        "group": "rsa-extractor",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/src/SlotMetadataExtensions.cs:3:code:1",
      "path": "src/Piv/src/SlotMetadataExtensions.cs",
      "ordinal": 2,
      "exact_body_sha256": "a57b38d82eb8522ae59454110eb1b86643148bb2a06a0cf8de999c3076d6504f",
      "editor_normalized_sha256": "55c546bd9491a72abb1a3335c49617652b50905e722023662c0a4076ec2757f8",
      "body": "\n// Requires an open session, firmware 5.3+ and a provisioned P-256/P-384 slot.\nvar metadata = await session.GetSlotMetadataAsync(Slot.Authentication)\n    ?? throw new InvalidOperationException(\"Provision an EC key first.\");\nusing var ecdsa = metadata.GetECDsaPublicKey();\n// The host object is now available for signature verification.\n",
      "disposition": {
        "id": "xml:src/Piv/src/SlotMetadataExtensions.cs:3:code:1",
        "status": "compile",
        "group": "ecdsa-extractor",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "xml:src/Piv/tests/Yubico.YubiKit.Piv.IntegrationTests/PivSessionContentionTests.cs:1:code:1",
      "path": "src/Piv/tests/Yubico.YubiKit.Piv.IntegrationTests/PivSessionContentionTests.cs",
      "ordinal": 1,
      "exact_body_sha256": "c96434ec4ca2122fa52b6d9217f06571b722975048b60bf55c38ab380bca3386",
      "editor_normalized_sha256": "cc104f0f35044a49f16efdda927046a4d67814c74e9f64a9d27f4e60ba79969f",
      "body": "\n    await using var piv = await key.CreatePivSessionAsync(cancellationToken: ct);\n    await piv.VerifyPinAsync(pin, ct);\n    try\n    {\n        await key.GetDeviceInfoAsync(cancellationToken: ct);\n        throw new InvalidOperationException(\"Expected the ownership guard to reject the second connection.\");\n    }\n    catch (ConnectionInUseException)\n    {\n        Memory<byte> signature = await piv.SignOrDecryptAsync(Slot.Authentication, KeyType.P256, digest, ct);\n        CryptographicOperations.ZeroMemory(signature.Span);\n    }\n    ",
      "disposition": {
        "id": "xml:src/Piv/tests/Yubico.YubiKit.Piv.IntegrationTests/PivSessionContentionTests.cs:1:code:1",
        "status": "compile",
        "group": "session-contention-guard",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    }
  ],
