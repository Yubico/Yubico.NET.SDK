      "body": "using Yubico.YubiKey.Piv;\n\nusing var piv = new PivSession(device);\npiv.KeyCollector = keyCollector;\n\nvar publicKey = piv.GenerateKeyPair(\n    PivSlot.Authentication,\n    PivAlgorithm.EccP256,\n    PivPinPolicy.Default,\n    PivTouchPolicy.Default);\n",
      "disposition": {
        "id": "fence:docs/migration/v1-to-v2.md:11",
        "status": "historical",
        "reason": "Historical v1 half paired with the current PIV migration recipe; original body remains retained and outside current-v2 compilation."
      }
    },
    {
      "id": "fence:docs/migration/v1-to-v2.md:12",
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 12,
      "exact_body_sha256": "452cbf3268c6a11cf6e4958df785df954011c9d29041d8a224d67f3b37f96c64",
      "editor_normalized_sha256": "452cbf3268c6a11cf6e4958df785df954011c9d29041d8a224d67f3b37f96c64",
      "body": "using System.Security.Cryptography;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\n\nawait using var piv = await device.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\n\n// Evaluation only: the installed active key must be this 24-byte factory value.\nbyte[] managementKey = PivSession.DefaultManagementKey.ToArray();\ntry\n{\n    await piv.AuthenticateAsync(managementKey, cancellationToken);\n\n    var publicKey = await piv.GenerateKeyAsync(\n        Slot.Authentication,\n        KeyType.P256,\n        new KeyCreationOptions\n        {\n            PinPolicy = PinPolicy.Default,\n            TouchPolicy = TouchPolicy.Default\n        },\n        cancellationToken);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey);\n}\n",
      "disposition": {
        "id": "fence:docs/migration/v1-to-v2.md:12",
        "status": "compile",
        "group": "migration-generation",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:docs/migration/v1-to-v2.md:21",
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 21,
      "exact_body_sha256": "a8cf26edd87802d6241acf5d10b69f67ca7e9daf8d294a38a638057e30db9619",
      "editor_normalized_sha256": "a8cf26edd87802d6241acf5d10b69f67ca7e9daf8d294a38a638057e30db9619",
      "body": "using Yubico.YubiKey.Piv;\n\nusing var piv = new PivSession(device);\npiv.KeyCollector = keyCollector;\n\npiv.SetPinOnlyMode(PivPinOnlyMode.PinProtected, PivAlgorithm.Aes192);\n",
      "disposition": {
        "id": "fence:docs/migration/v1-to-v2.md:21",
        "status": "historical",
        "reason": "Historical v1 half paired with the current PIV migration recipe; original body remains retained and outside current-v2 compilation."
      }
    },
    {
      "id": "fence:docs/migration/v1-to-v2.md:22",
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 22,
      "exact_body_sha256": "d60887342483e088ad1e39dd4520613d9d38323f6eee9a98223977c2d2b5b8f5",
      "editor_normalized_sha256": "d60887342483e088ad1e39dd4520613d9d38323f6eee9a98223977c2d2b5b8f5",
      "body": "using Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Piv;\n\nstatic async Task EnableProtectedAdministrationAsync(\n    IYubiKey device,\n    ReadOnlyMemory<byte> pin,\n    ReadOnlyMemory<byte> activeManagementKey,\n    CancellationToken cancellationToken)\n{\n    await using var piv = await device.CreatePivSessionAsync(cancellationToken: cancellationToken);\n    await piv.AuthenticateAsync(activeManagementKey, cancellationToken);\n    await piv.SetPinOnlyModeAsync(\n        PinOnlyMode.PinProtected,\n        pin,\n        activeManagementKey,\n        cancellationToken);\n}\n",
      "disposition": {
        "id": "fence:docs/migration/v1-to-v2.md:22",
        "status": "compile",
        "group": "migration-protected-enable",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:docs/usage/user-interaction.md:1",
      "path": "docs/usage/user-interaction.md",
      "ordinal": 1,
      "exact_body_sha256": "a59f59abcbcf3f6a92fea0b7a1fd9de3755c1c256c92ac35bb0ea67ab389f951",
      "editor_normalized_sha256": "a59f59abcbcf3f6a92fea0b7a1fd9de3755c1c256c92ac35bb0ea67ab389f951",
      "body": "using Yubico.YubiKit.Cli.Shared.Output;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Piv;\n\nvar options = new SessionCreationOptions\n{\n    UserPresencePrompt = ConsoleUserPresencePrompt.Instance\n};\n\nawait using PivSession session = await yubiKey.CreatePivSessionAsync(\n    options,\n    cancellationToken);\n",
      "disposition": {
        "id": "fence:docs/usage/user-interaction.md:1",
        "status": "compile",
        "group": "shared-console-prompt",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:docs/usage/user-interaction.md:2",
      "path": "docs/usage/user-interaction.md",
      "ordinal": 2,
      "exact_body_sha256": "aadb7f3aa7711e6babbfbb6f67170eae06bec69826decf184b495644af78529a",
      "editor_normalized_sha256": "aadb7f3aa7711e6babbfbb6f67170eae06bec69826decf184b495644af78529a",
      "body": "using Yubico.YubiKit.Core.Credentials;\n\nstring message = context.Operation switch\n{\n    UserPresenceOperations.Ctap2.MakeCredential => \"Touch your YubiKey to create a passkey.\",\n    UserPresenceOperations.Ctap2.GetAssertion => \"Touch your YubiKey to sign in.\",\n    UserPresenceOperations.Piv.SignOrDecrypt => \"Touch your YubiKey for the PIV key operation.\",\n    _ when context.Application == UserPresenceApplications.Oath => \"Touch your YubiKey to generate a code.\",\n    _ => \"Touch your YubiKey to continue.\"\n};\n",
      "disposition": {
        "id": "fence:docs/usage/user-interaction.md:2",
        "status": "compile",
        "group": "shared-prompt-callbacks",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:docs/usage/user-interaction.md:3",
      "path": "docs/usage/user-interaction.md",
      "ordinal": 3,
      "exact_body_sha256": "109cd113261d954faf24c614590f0ffd85ec337e78394d0ef3a1c046f050d5a3",
      "editor_normalized_sha256": "109cd113261d954faf24c614590f0ffd85ec337e78394d0ef3a1c046f050d5a3",
      "body": "using (UserPresenceIntent.BeginScope(\"approve the transfer of 500 EUR\"))\n{\n    await client.GetAssertionAsync(requestOptions, cancellationToken: cancellationToken);\n}\n",
      "disposition": {
        "id": "fence:docs/usage/user-interaction.md:3",
        "status": "compile",
        "group": "shared-intent-await",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:docs/usage/user-interaction.md:4",
      "path": "docs/usage/user-interaction.md",
      "ordinal": 4,
      "exact_body_sha256": "cdb35996f0077d9974a37ad4ecf16805b34fd470e34c9cd7208f081d168728af",
      "editor_normalized_sha256": "cdb35996f0077d9974a37ad4ecf16805b34fd470e34c9cd7208f081d168728af",
      "body": "public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken)\n{\n    string operation = context.Operation switch\n    {\n        UserPresenceOperations.Ctap2.GetAssertion => \"sign-in\",\n        UserPresenceOperations.Ctap2.MakeCredential => \"passkey registration\",\n        _ => \"key operation\"\n    };\n\n    // \"Touch your YubiKey to approve the transfer of 500 EUR (sign-in).\"\n    Console.WriteLine(context.Intent is { } intent\n        ? $\"Touch your YubiKey to {intent} ({operation}).\"\n        : $\"Touch your YubiKey to confirm the {operation}.\");\n    return default;\n}\n",
      "disposition": {
        "id": "fence:docs/usage/user-interaction.md:4",
        "status": "compile",
        "group": "shared-prompt-callbacks",
        "reason": "Complete current body compiled in the named typed task with original text/hash retained."
      }
    },
    {
      "id": "fence:src/Piv/CLAUDE.md:1",
