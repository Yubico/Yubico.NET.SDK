  "original_bodies": [
    {
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 1,
      "baseline_line": 39,
      "sha256": "0af477e01e3a221a1fa69d8a02ab34dbd010dddad8d0f8aa3e5b51587c01ee5c",
      "body": "await using var session = await device.CreatePivSessionAsync(cancellationToken: cancellationToken);\n"
    },
    {
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 2,
      "baseline_line": 45,
      "sha256": "e700a69044060c5758652c2fa9760bd10c840c2f3f2f23c5365078fe7cb47d14",
      "body": "await using var connection = await device.ConnectAsync<ISmartCardConnection>(cancellationToken);\nawait using var session = await PivSession.CreateAsync(connection, cancellationToken: cancellationToken);\n"
    },
    {
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 3,
      "baseline_line": 52,
      "sha256": "7edf983d15f3e18d72c798ae92b24b900c16a476643d4c8615e9031c58059c93",
      "body": "PivSession public method\n  -> validate arguments and session state\n  -> ensure feature support when firmware-gated\n  -> call one shallow internal protocol helper\n  -> helper builds visible APDU/TLV payload\n  -> transmit through Core SmartCard protocol\n  -> parse response\n  -> zero sensitive source/intermediate buffers in finally\n"
    },
    {
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 4,
      "baseline_line": 91,
      "sha256": "36be32c03907b979d6daea547bf29c58a9f05167e09ceaf8160f72726f0df687",
      "body": "byte[]? managementKey = ArrayPool<byte>.Shared.Rent(24);\ntry\n{\n    FillManagementKey(managementKey.AsSpan(0, 24));\n    await session.AuthenticateAsync(managementKey.AsMemory(0, 24), cancellationToken);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey.AsSpan(0, 24));\n    ArrayPool<byte>.Shared.Return(managementKey, clearArray: true);\n}\n"
    },
    {
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 5,
      "baseline_line": 115,
      "sha256": "4c9bd11db4b25743b64fd4c3279d947c67699584f1e6c9c78b558b5b34919036",
      "body": "PivSession.GenerateKeyAsync\n  -> KeyProtocol.GenerateKeyAsync\n  -> builds key-generation TLV/APDU visibly\n  -> parses returned public key\n"
    },
    {
      "path": "src/Piv/CLAUDE.md",
      "ordinal": 6,
      "baseline_line": 164,
      "sha256": "9d130e74836e29004f6c427ef935ce40cd88d276d10837180b765902660c4e67",
      "body": "[SkippableTheory]\n[WithYubiKey(Capability = DeviceCapabilities.Piv)]\npublic async Task GetMetadata_ReadOnly_Succeeds(YubiKeyTestState state)\n{\n    await using var session = await state.Device.CreatePivSessionAsync();\n    var metadata = await session.GetPinMetadataAsync();\n    Assert.NotNull(metadata);\n}\n"
    },
    {
      "path": "src/Piv/PACKAGE_README.md",
      "ordinal": 1,
      "baseline_line": 14,
      "sha256": "74716490a0a242972fe228090ba3a51c426652f62de606c37d62f470687fc2f9",
      "body": "dotnet nuget add source https://yubico.github.io/Yubico.NET.SDK/alpha/index.json -n yubikit-alpha\ndotnet add package Yubico.YubiKit.Piv --prerelease\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 1,
      "baseline_line": 25,
      "sha256": "74716490a0a242972fe228090ba3a51c426652f62de606c37d62f470687fc2f9",
      "body": "dotnet nuget add source https://yubico.github.io/Yubico.NET.SDK/alpha/index.json -n yubikit-alpha\ndotnet add package Yubico.YubiKit.Piv --prerelease\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 2,
      "baseline_line": 34,
      "sha256": "207b4faf9f255923887b5bd96189d155c974fb304bbf836a2de307d6754e942d",
      "body": "using System.Security.Cryptography;\nusing System.Security.Cryptography.X509Certificates;\nusing System.Text;\nusing Yubico.YubiKit.Core.Abstractions;\nusing Yubico.YubiKit.Core.Credentials;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Core.Devices;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Piv;\n\nIYubiKey device = await YubiKeyManager.FindFirstAsync();\nawait using var session = await device.CreatePivSessionAsync();\n\nint pinAttempts = await session.GetPinAttemptsAsync();\nConsole.WriteLine($\"PIN attempts remaining: {pinAttempts}\");\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 3,
      "baseline_line": 61,
      "sha256": "05a32803214a6b9a1043bed8c336942d8555e46ba9757e91ba243f8bac506fc3",
      "body": "await using var session = await device.CreatePivSessionAsync();\n\nbyte[] managementKey = Convert.FromHexString(\"010203040506070801020304050607080102030405060708\");\ntry\n{\n    await session.AuthenticateAsync(managementKey);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey);\n}\nvar keyOptions = new KeyCreationOptions { PinPolicy = PinPolicy.Once, TouchPolicy = TouchPolicy.Never };\nIPublicKey publicKey = await session.GenerateKeyAsync(Slot.Authentication, KeyType.P256, keyOptions);\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 4,
      "baseline_line": 83,
      "sha256": "8a19109945481c91fa6bdcff30ddb1fa12f774a6a21aee809d55b991d646ff39",
      "body": "using var certificate = X509CertificateLoader.LoadCertificateFromFile(\"authentication.cer\");\nawait session.StoreCertificateAsync(Slot.Authentication, certificate, CertificateCompression.Automatic);\nusing X509Certificate2? stored = await session.GetCertificateAsync(Slot.Authentication);\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 5,
      "baseline_line": 91,
      "sha256": "a7c309676e67bd85c7dd8fcf141aac1bc45fb41f021db3ad71aeeb3bf5499bcf",
      "body": "await using var session = await device.CreatePivSessionAsync();\n\nbyte[] pin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    await session.VerifyPinAsync(pin);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n}\nbyte[] digest = SHA256.HashData(Encoding.UTF8.GetBytes(\"message to sign\"));\nMemory<byte> signature = await session.SignOrDecryptAsync(Slot.Authentication, digest);\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 6,
      "baseline_line": 119,
      "sha256": "ca8fe727d322c778aabf304fd3260fb21de2c9619067f783b11892536be2b6ae",
      "body": "sealed class TouchPrompt : IUserPresencePrompt\n{\n    public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken) =>\n        new(Console.Out.WriteLineAsync($\"Touch your YubiKey for {context.Application} {context.Scope}.\"));\n}\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 7,
      "baseline_line": 127,
      "sha256": "f0255a5d67fbf9956f2e67a1a9b16be868f0b2bb985edd5e8c0f231bba31d2f1",
      "body": "var options = new SessionCreationOptions { UserPresencePrompt = new TouchPrompt() };\nawait using var session = await device.CreatePivSessionAsync(options);\n"
    },
    {
      "path": "src/Piv/README.md",
      "ordinal": 8,
      "baseline_line": 201,
      "sha256": "11e682c0686ab1fa8be7904fe81d6fb2ff213b0c5ecea7b4796cd12b820b1f91",
      "body": "dotnet run --project src/Piv/examples/PivTool/PivTool.csproj\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Attestation.cs",
      "ordinal": 1,
      "baseline_line": 42,
      "sha256": "df512e7108b4b0e06898f98cef3652a37c77573c6b4e74faa8355d1a23b3a8b2",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar result = await Attestation.GetAttestationAsync(\n    session, Slot.Authentication, ct);\n\nif (result.Success)\n{\n    var attestCert = result.AttestationCertificate;\n    Console.WriteLine($\"Key attested: {attestCert!.Subject}\");\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Attestation.cs",
      "ordinal": 2,
      "baseline_line": 88,
      "sha256": "47932bd6408dce1ad3b494c8196995d6e89b2a0da406e89c37dd2a9c0169e9f5",
      "body": "var result = await Attestation.GetIntermediateCertificateAsync(session, ct);\nif (result.Success)\n{\n    var intermediateCert = result.IntermediateCertificate;\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 1,
      "baseline_line": 47,
      "sha256": "e57235c01e15c1fdddc406d688a1c111699fa62b76b3036d1844438d1d009099",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar result = await Certificates.GetCertificateAsync(session, Slot.Authentication, ct);\nif (result.Success)\n{\n    Console.WriteLine($\"Subject: {result.Certificate!.Subject}\");\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 2,
      "baseline_line": 87,
      "sha256": "d90b6b7d19455d9705f4f7debdbdb3cee657bfd6772f6edfedfd512bcd121785",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar certData = await File.ReadAllBytesAsync(\"certificate.pem\", ct);\nvar result = await Certificates.ImportCertificateAsync(\n    session, Slot.Authentication, certData, CertificateCompression.Automatic, ct);\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 3,
      "baseline_line": 137,
      "sha256": "3790fb2c237b39e9d76ab637dbf2b9e7c741913fba9315416fefb8ab5f471712",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar result = await Certificates.ExportCertificatePemAsync(session, Slot.Authentication, ct);\nif (result.Success && result.Certificate is not null)\n{\n    var pem = result.Certificate.ExportCertificatePem();\n    await File.WriteAllTextAsync(\"certificate.pem\", pem, ct);\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 4,
      "baseline_line": 179,
      "sha256": "0fef4dcb5f4b3688b22c9cf24cf1c7a1aab73bb11a015d2f2fb930bf3770c87f",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar result = await Certificates.DeleteCertificateAsync(session, Slot.Authentication, ct);\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 5,
      "baseline_line": 214,
      "sha256": "8a8091d202ae5da1df459195da45fd5dea309f432ae507377543bef80479067e",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\nawait session.AuthenticateAsync(managementKey, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Certificates.GenerateSelfSignedAsync(\n    session, Slot.Authentication, \"CN=Test User\", 365, ct);\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Certificates.cs",
      "ordinal": 6,
      "baseline_line": 324,
      "sha256": "2249384de683fad2f7c19100ecd76a4fde40a21171c4a1945c7c06fbfa74ec69",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar result = await Certificates.GenerateCsrAsync(\n    session, Slot.Authentication, \"CN=Test User\", ct);\n\nif (result.Success)\n{\n    await File.WriteAllTextAsync(\"request.csr\", result.CsrPem!, ct);\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Decryption.cs",
      "ordinal": 1,
      "baseline_line": 42,
      "sha256": "57c9c29cf98e9bbbb035f056e2a1aa573680b8d3309443487fb237be9577e326",
      "body": "var options = new SessionCreationOptions { UserPresencePrompt = userPresencePrompt };\nawait using var session = await device.CreatePivSessionAsync(options, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Decryption.DecryptDataAsync(\n    session,\n    Slot.KeyManagement,\n    encryptedBytes,\n    ct);\n\nif (result.Success)\n{\n    var plaintext = result.DecryptedData;\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/DeviceInfo.cs",
      "ordinal": 1,
      "baseline_line": 37,
      "sha256": "c6db0fdceafbbd89a7e5c1e79c153c381500e2d1eb56f2594ef5cfa01c50b88f",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar result = await DeviceInfoQuery.GetPivRetryInfoAsync(session, ct);\nif (result.Success)\n{\n    Console.WriteLine($\"PIN retries: {result.PinRetriesRemaining}\");\n    Console.WriteLine($\"PUK retries: {result.PukRetriesRemaining}\");\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/KeyGeneration.cs",
      "ordinal": 1,
      "baseline_line": 46,
      "sha256": "a3033d3847bd704a576365ac5e44e196abcb8a70c3091d39506a6623bc1f3003",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\nawait session.AuthenticateAsync(managementKey, ct);\n\nvar result = await KeyGeneration.GenerateKeyAsync(\n    session,\n    Slot.Authentication,\n    KeyType.P256,\n    PinPolicy.Once,\n    TouchPolicy.Cached,\n    ct);\n\nif (result.Success)\n{\n    var publicKeyBytes = result.PublicKey;\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 1,
      "baseline_line": 44,
      "sha256": "bb2c92c79589db7da894bff2c9cc83c108f3aac91843c0014b2b75e5de542597",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar pin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    var result = await PinManagement.VerifyPinAsync(session, pin, ct);\n    if (result.Success)\n    {\n        Console.WriteLine(\"PIN verified\");\n    }\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(pin);\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 2,
      "baseline_line": 95,
      "sha256": "dc238ed1a73070f01d4c5f56691d32f65c3c5ce26f20651928aaf7847d744f36",
      "body": "var oldPin = Encoding.UTF8.GetBytes(\"123456\");\nvar newPin = Encoding.UTF8.GetBytes(\"654321\");\ntry\n{\n    var result = await PinManagement.ChangePinAsync(session, oldPin, newPin, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(oldPin);\n    CryptographicOperations.ZeroMemory(newPin);\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 3,
      "baseline_line": 176,
      "sha256": "5edfc4189a762d3890fc1c218a9fa827095ad88fa7c7f6cc99cac79b5fc27333",
      "body": "var puk = Encoding.UTF8.GetBytes(\"12345678\");\nvar newPin = Encoding.UTF8.GetBytes(\"123456\");\ntry\n{\n    var result = await PinManagement.UnblockPinAsync(session, puk, newPin, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(puk);\n    CryptographicOperations.ZeroMemory(newPin);\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 4,
      "baseline_line": 246,
      "sha256": "e666c396c881515c16b21e15f0421dd1c567cfec119752925a8ee3b5f3ecd809",
      "body": "var mgmtKey = new byte[] { /* 24 bytes for 3DES, or 16/24/32 for AES */ };\ntry\n{\n    var result = await PinManagement.AuthenticateAsync(session, mgmtKey, ct);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(mgmtKey);\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/PinManagement.cs",
      "ordinal": 5,
      "baseline_line": 286,
      "sha256": "19af3851854ce2c3295df104a04e8b9a03fbc2c17be1f4f0ed2f6d72a3c5e2a5",
      "body": "// Authenticate with current key first\nawait session.AuthenticateAsync(currentKey);\n\n// Then change to new key\nvar newKey = new byte[24]; // or 16/32 for AES\nRandomNumberGenerator.Fill(newKey);\nvar result = await PinManagement.ChangeManagementKeyAsync(\n    session, newKey, KeyType.TripleDes, ct);\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Reset.cs",
      "ordinal": 1,
      "baseline_line": 41,
      "sha256": "2fc29efde0e51219fd96960d1e9b975344e47d00cf59a77d0207492317df899f",
      "body": "// WARNING: This destroys all PIV data!\nawait using var session = await device.CreatePivSessionAsync(ct);\n\n// Ensure user confirms this destructive action\nif (userConfirmedReset)\n{\n    var result = await Reset.ResetPivApplicationAsync(session, ct);\n    if (result.Success)\n    {\n        Console.WriteLine(\"PIV application reset to factory defaults.\");\n    }\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Signing.cs",
      "ordinal": 1,
      "baseline_line": 46,
      "sha256": "81e8957ea960306c5537e1a35097421ca1a3c12eeaac925ede5268f9d43d7dc9",
      "body": "var options = new SessionCreationOptions { UserPresencePrompt = userPresencePrompt };\nawait using var session = await device.CreatePivSessionAsync(options, ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Signing.SignDataAsync(\n    session, \n    Slot.Signature,\n    dataBytes,\n    HashAlgorithmName.SHA256,\n    ct);\n\nif (result.Success)\n{\n    var signature = result.Signature;\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/SlotInfo.cs",
      "ordinal": 1,
      "baseline_line": 45,
      "sha256": "e0656770e7714e6fbadf0371868cfe936709c666478af85819c295ea17916e2e",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar result = await SlotInfoQuery.GetAllSlotsInfoAsync(session, ct);\nif (result.Success)\n{\n    foreach (var slot in result.Slots)\n    {\n        Console.WriteLine($\"{slot.Name}: Key={slot.HasKey}, Cert={slot.HasCertificate}\");\n    }\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/PivExamples/Verification.cs",
      "ordinal": 1,
      "baseline_line": 44,
      "sha256": "588869dc8404fa9dc81e0f35c6800e04e5fde8bff70db6118073282eb0baa501",
      "body": "await using var session = await device.CreatePivSessionAsync(ct);\n\nvar result = await Verification.VerifySignatureAsync(\n    session,\n    Slot.Signature,\n    originalData,\n    signatureBytes,\n    HashAlgorithmName.SHA256,\n    ct);\n\nif (result.Success && result.IsValid)\n{\n    Console.WriteLine(\"Signature is valid!\");\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/README.md",
      "ordinal": 1,
      "baseline_line": 9,
      "sha256": "c76db116efb58487e48fe5b2e91cd1a737d79251e03b4882da62d403c80ff1b0",
      "body": "PivTool/\n\u251c\u2500\u2500 PivExamples/           # \ud83d\udc68\u200d\ud83d\udcbb PURE SDK EXAMPLES - Look here first!\n\u2502   \u251c\u2500\u2500 Results/           # Immutable result types\n\u2502   \u2502   \u251c\u2500\u2500 SigningResult.cs\n\u2502   \u2502   \u251c\u2500\u2500 DecryptionResult.cs\n\u2502   \u2502   \u251c\u2500\u2500 CertificateResult.cs\n\u2502   \u2502   \u2514\u2500\u2500 ...\n\u2502   \u251c\u2500\u2500 Signing.cs         # Signing operations\n\u2502   \u251c\u2500\u2500 Decryption.cs      # RSA decryption\n\u2502   \u251c\u2500\u2500 Verification.cs    # Signature verification\n\u2502   \u251c\u2500\u2500 Certificates.cs    # Certificate management\n\u2502   \u251c\u2500\u2500 KeyGeneration.cs   # Key generation\n\u2502   \u251c\u2500\u2500 PinManagement.cs   # PIN/PUK operations\n\u2502   \u251c\u2500\u2500 Attestation.cs     # Key attestation\n\u2502   \u251c\u2500\u2500 SlotInfo.cs        # Slot queries\n\u2502   \u251c\u2500\u2500 DeviceInfo.cs      # Device queries\n\u2502   \u2514\u2500\u2500 Reset.cs           # PIV reset\n\u2502\n\u251c\u2500\u2500 Cli/                   # CLI framework code (Spectre.Console)\n\u2502   \u251c\u2500\u2500 Output/            # Console formatting helpers\n\u2502   \u2514\u2500\u2500 Prompts/           # User input prompts\n\u2502\n\u251c\u2500\u2500 Features/              # Interactive menus (uses SDK + CLI)\n\u2502   \u2514\u2500\u2500 *.cs               # Feature implementations\n\u2502\n\u2514\u2500\u2500 Program.cs             # Application entry point\n"
    },
    {
      "path": "src/Piv/examples/PivTool/README.md",
      "ordinal": 2,
      "baseline_line": 42,
      "sha256": "604a06efff7da950e482b957ca0b0fb84c868dcd6058a9f6dc1fccd80869ca18",
      "body": "// Example: Sign data with a PIV key\nawait using var session = await device.CreatePivSessionAsync(ct);\nawait session.VerifyPinAsync(pin, ct);\n\nvar result = await Signing.SignDataAsync(\n    session, \n    Slot.Signature,\n    dataToSign,\n    HashAlgorithmName.SHA256,\n    ct);\n\nif (result.Success)\n{\n    Console.WriteLine($\"Signature: {Convert.ToBase64String(result.Signature.ToArray())}\");\n}\n"
    },
    {
      "path": "src/Piv/examples/PivTool/README.md",
      "ordinal": 3,
      "baseline_line": 78,
      "sha256": "622ca79d8f2830758a2481e13a12a931b966c39bb6351db47cad08103fdbb841",
      "body": "# From the repository root\ndotnet toolchain.cs build\n"
    },
    {
      "path": "src/Piv/examples/PivTool/README.md",
      "ordinal": 4,
      "baseline_line": 85,
      "sha256": "07738755f8ced758be7d91d5324dd1c5cfb784fe772a3f67c181d82ecb9c224c",
      "body": "# From the repository root\ndotnet run --project src/Piv/examples/PivTool/PivTool.csproj\n"
    },
    {
      "path": "src/Piv/examples/PivTool/README.md",
      "ordinal": 5,
      "baseline_line": 94,
      "sha256": "d3c62bf1137c874f156cfcd47c115001f9cd3cdb63a512ba9d0cba32e649558f",
      "body": "\ud83d\udccb Device Info         - Show connected YubiKey information\n\ud83d\udd10 PIN Management      - Manage PIN, PUK, and management key\n\ud83d\udd11 Key Generation      - Generate keys in PIV slots\n\ud83d\udcdc Certificate Ops     - Manage certificates in slots\n\u270d\ufe0f  Crypto Operations   - Sign, decrypt, verify operations\n\ud83d\udee1\ufe0f  Key Attestation     - Verify on-device key generation\n\ud83d\udcca Slot Overview       - View all PIV slots at a glance\n\u26a0\ufe0f  Reset PIV           - Reset to factory defaults\n"
    },
    {
      "path": "src/Piv/src/SlotMetadataExtensions.cs",
      "ordinal": 1,
      "baseline_line": 44,
      "sha256": "267965a0b9e0636a83a64b3021ecab2c8fc0864479303aa4b42ef31230e49bfc",
      "body": "var metadata = await session.GetSlotMetadataAsync(Slot.Authentication);\nusing var rsa = metadata.Value.GetRsaPublicKey();\nvar request = new CertificateRequest(\"CN=Test\", rsa, HashAlgorithmName.SHA256, RSASignaturePadding.Pkcs1);\n"
    },
    {
      "path": "src/Piv/src/SlotMetadataExtensions.cs",
      "ordinal": 2,
      "baseline_line": 104,
      "sha256": "6ec3ffe9c26773f3a4e392e308c57d729e8c06846357cbca8782c7ef9f0dffac",
      "body": "var metadata = await session.GetSlotMetadataAsync(Slot.Authentication);\nusing var ecdsa = metadata.Value.GetECDsaPublicKey();\nvar request = new CertificateRequest(\"CN=Test\", ecdsa, HashAlgorithmName.SHA256);\n"
    },
    {
      "path": "src/Piv/tests/Yubico.YubiKit.Piv.IntegrationTests/PivSessionContentionTests.cs",
      "ordinal": 1,
      "baseline_line": 35,
      "sha256": "2d2a016c43bb37fff40045d71e2a213bd9d238378abb67e1667457f4d4a47616",
      "body": "    await using var piv = await key.CreatePivSessionAsync();  // CCID handle #1, SELECT PIV\n    await piv.VerifyPinAsync(pin);                            // security state established\n    var info = await key.GetDeviceInfoAsync();                // CCID handle #2, SELECT Management\n    await piv.SignAsync(...);                                 // pre-fix: SW=0x6D00\n"
    },
    {
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 9,
      "baseline_line": 317,
      "sha256": "450f1dc005293d383aab52e5ad4ac271d2db98b6748d92a758f87edb4226b1c0",
      "body": "using Yubico.YubiKey.Piv;\n\nusing var piv = new PivSession(device);\n"
    },
    {
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 10,
      "baseline_line": 325,
      "sha256": "a5be9db52856b7c16ce8eb9cd283599340950c059bc3170f667d67b29fe47f4b",
      "body": "using Yubico.YubiKit.Piv;\n\nawait using var piv = await device.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\n"
    },
    {
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 11,
      "baseline_line": 342,
      "sha256": "c5cfe5e3e7fa3372b28eb71fed84bfd32ea87aa216af034acb0eea77699b4351",
      "body": "using Yubico.YubiKey.Piv;\n\nusing var piv = new PivSession(device);\npiv.KeyCollector = keyCollector;\n\nvar publicKey = piv.GenerateKeyPair(\n    PivSlot.Authentication,\n    PivAlgorithm.EccP256,\n    PivPinPolicy.Default,\n    PivTouchPolicy.Default);\n"
    },
    {
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 12,
      "baseline_line": 357,
      "sha256": "3825872d2aae8b79bf254cf64e3d35e2fd865c84b475787e3df1e0af3842efb7",
      "body": "using System.Security.Cryptography;\nusing Yubico.YubiKit.Core.Cryptography;\nusing Yubico.YubiKit.Piv;\n\nawait using var piv = await device.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\n\nbyte[] managementKey = GetManagementKeyBytes();\ntry\n{\n    await piv.AuthenticateAsync(managementKey, cancellationToken);\n\n    var publicKey = await piv.GenerateKeyAsync(\n        Slot.Authentication,\n        KeyType.P256,\n        new KeyCreationOptions\n        {\n            PinPolicy = PinPolicy.Default,\n            TouchPolicy = TouchPolicy.Default\n        },\n        cancellationToken);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey);\n}\n"
    },
    {
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 21,
      "baseline_line": 624,
      "sha256": "a8cf26edd87802d6241acf5d10b69f67ca7e9daf8d294a38a638057e30db9619",
      "body": "using Yubico.YubiKey.Piv;\n\nusing var piv = new PivSession(device);\npiv.KeyCollector = keyCollector;\n\npiv.SetPinOnlyMode(PivPinOnlyMode.PinProtected, PivAlgorithm.Aes192);\n"
    },
    {
      "path": "docs/migration/v1-to-v2.md",
      "ordinal": 22,
      "baseline_line": 635,
      "sha256": "820a4e1d7dc2a20e5a16cbaadab764b25ecc8916f51c67bba0d4f27643ff1d28",
      "body": "using System.Security.Cryptography;\nusing Yubico.YubiKit.Piv;\n\nawait using var piv = await device.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\n\nbyte[] managementKey = GetManagementKeyBytes();\nbyte[] pin = GetPinBytes();\ntry\n{\n    await piv.AuthenticateAsync(managementKey, cancellationToken);\n    await piv.SetPinOnlyModeAsync(\n        PinOnlyMode.PinProtected,\n        pin,\n        managementKey,\n        cancellationToken);\n}\nfinally\n{\n    CryptographicOperations.ZeroMemory(managementKey);\n    CryptographicOperations.ZeroMemory(pin);\n}\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 1,
      "baseline_line": 11,
      "sha256": "d70cb2ba21c45b2bce6196d1fc064592c1bf991890afd532333032f6da860f4e",
      "body": "await using PivSession piv = await yubiKey.CreatePivSessionAsync(\n    cancellationToken: cancellationToken);\nPinMetadata metadata = await piv.GetPinMetadataAsync(cancellationToken);\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 2,
      "baseline_line": 38,
      "sha256": "318e1d600007d9682a330cd9ee0ab8fb02fa9031bc36b3b37edbc4c4732ccc36",
      "body": "await using RawSmartCardSession raw =\n    await yubiKey.CreateRawSmartCardSessionAsync(cancellationToken);\n\n// Optional when the firmware version is known. Configure before the first APDU.\nraw.Configure(firmwareVersion);\n\nawait raw.SelectAsync(applicationId, cancellationToken);\nApduResponse response = await raw.TransmitAndReceiveAsync(\n    new ApduCommand(cla, ins, p1, p2, commandData),\n    throwOnError: false,\n    cancellationToken);\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 3,
      "baseline_line": 64,
      "sha256": "c89973710405dc9355bbeb345e86ef0d6fc52a79b76b33bfbb75cb50b5f84340",
      "body": "await using ISmartCardConnection connection =\n    await yubiKey.ConnectAsync<ISmartCardConnection>(cancellationToken);\n\nawait using (RawSmartCardSession raw =\n    await RawSmartCardSession.CreateAsync(connection, cancellationToken))\n{\n    raw.Configure(firmwareVersion);\n    await raw.SelectAsync(applicationId, cancellationToken);\n    await raw.TransmitAndReceiveAsync(command, cancellationToken: cancellationToken);\n}\n\n// RawSmartCardSession borrowed the connection, so it remains available for the next session.\nawait using PivSession piv = await PivSession.CreateAsync(connection, cancellationToken);\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 4,
      "baseline_line": 82,
      "sha256": "b2298d166d6a76d130750ebed9ab3775d271b2679426f79fe2252c924a8ca415",
      "body": "await using RawCtapHidSession raw =\n    await yubiKey.CreateRawCtapHidSessionAsync(cancellationToken);\n\nReadOnlyMemory<byte> response = await raw.SendAndReceiveAsync(\n    ctapHidCommand,\n    payload,\n    cancellationToken);\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 5,
      "baseline_line": 98,
      "sha256": "d3f9d4e02bf88ccf779784dcd47f1599056155e59afb8bb6529198cd729764e1",
      "body": "await using RawOtpHidSession raw =\n    await yubiKey.CreateRawOtpHidSessionAsync(cancellationToken);\n\nReadOnlyMemory<byte> response = await raw.SendAndReceiveAsync(\n    commandOrSlot,\n    payload,\n    cancellationToken);\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 6,
      "baseline_line": 112,
      "sha256": "d1ebf13f8409ed7cf58cd2a24008902092e1d5d5403af8744b51332f33877f0f",
      "body": "if (response.Length < expectedLength + 2 ||\n    !ChecksumUtils.CheckCrc(response.Span, expectedLength + 2))\n{\n    throw new InvalidOperationException(\"OTP response CRC validation failed.\");\n}\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 7,
      "baseline_line": 131,
      "sha256": "3bd0b61590590b2f50200473ccaf72d9ea010b73bf81ac18d4e1577ca04fc4f2",
      "body": "using ScpKeyParameters scpParameters = LoadScpParametersFromSecureStorage();\nawait using RawSmartCardSession raw = await yubiKey.CreateRawSmartCardSessionAsync(\n    scpParameters,\n    firmwareVersion,\n    cancellationToken: cancellationToken);\n\nawait raw.SelectAsync(applicationId, cancellationToken);\nApduResponse response = await raw.TransmitAndReceiveAsync(command, cancellationToken: cancellationToken);\n"
    },
    {
      "path": "docs/architecture/raw-access-tiers.md",
      "ordinal": 8,
      "baseline_line": 264,
      "sha256": "048e4a43422e260a9df70e5e85b7e1576cb644c625850265b5811e1ca4e311d5",
      "body": "// Before\nusing ISmartCardProtocol protocol = ProtocolFactory.Create(connection);\nawait protocol.SelectAsync(applicationId, cancellationToken);\n\n// After\nawait using RawSmartCardSession raw = await RawSmartCardSession.CreateAsync(connection, cancellationToken);\nawait raw.SelectAsync(applicationId, cancellationToken);\n"
    },
    {
      "path": "docs/usage/user-interaction.md",
      "ordinal": 1,
      "baseline_line": 15,
      "sha256": "a59f59abcbcf3f6a92fea0b7a1fd9de3755c1c256c92ac35bb0ea67ab389f951",
      "body": "using Yubico.YubiKit.Cli.Shared.Output;\nusing Yubico.YubiKit.Core.Sessions;\nusing Yubico.YubiKit.Piv;\n\nvar options = new SessionCreationOptions\n{\n    UserPresencePrompt = ConsoleUserPresencePrompt.Instance\n};\n\nawait using PivSession session = await yubiKey.CreatePivSessionAsync(\n    options,\n    cancellationToken);\n"
    },
    {
      "path": "docs/usage/user-interaction.md",
      "ordinal": 2,
      "baseline_line": 75,
      "sha256": "aadb7f3aa7711e6babbfbb6f67170eae06bec69826decf184b495644af78529a",
      "body": "using Yubico.YubiKit.Core.Credentials;\n\nstring message = context.Operation switch\n{\n    UserPresenceOperations.Ctap2.MakeCredential => \"Touch your YubiKey to create a passkey.\",\n    UserPresenceOperations.Ctap2.GetAssertion => \"Touch your YubiKey to sign in.\",\n    UserPresenceOperations.Piv.SignOrDecrypt => \"Touch your YubiKey for the PIV key operation.\",\n    _ when context.Application == UserPresenceApplications.Oath => \"Touch your YubiKey to generate a code.\",\n    _ => \"Touch your YubiKey to continue.\"\n};\n"
    },
    {
      "path": "docs/usage/user-interaction.md",
      "ordinal": 3,
      "baseline_line": 99,
      "sha256": "109cd113261d954faf24c614590f0ffd85ec337e78394d0ef3a1c046f050d5a3",
      "body": "using (UserPresenceIntent.BeginScope(\"approve the transfer of 500 EUR\"))\n{\n    await client.GetAssertionAsync(requestOptions, cancellationToken: cancellationToken);\n}\n"
    },
    {
      "path": "docs/usage/user-interaction.md",
      "ordinal": 4,
      "baseline_line": 106,
      "sha256": "cdb35996f0077d9974a37ad4ecf16805b34fd470e34c9cd7208f081d168728af",
      "body": "public ValueTask OnUserPresenceRequestedAsync(UserPresenceContext context, CancellationToken cancellationToken)\n{\n    string operation = context.Operation switch\n    {\n        UserPresenceOperations.Ctap2.GetAssertion => \"sign-in\",\n        UserPresenceOperations.Ctap2.MakeCredential => \"passkey registration\",\n        _ => \"key operation\"\n    };\n\n    // \"Touch your YubiKey to approve the transfer of 500 EUR (sign-in).\"\n    Console.WriteLine(context.Intent is { } intent\n        ? $\"Touch your YubiKey to {intent} ({operation}).\"\n        : $\"Touch your YubiKey to confirm the {operation}.\");\n    return default;\n}\n"
    }
  ],
