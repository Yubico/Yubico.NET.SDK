      "substitutions": {
        "manifest = json.loads(manifest_path.read_text())": "manifest = json.loads(manifest_path.read_text())\nmanifest['dependencies'] = [updated_dependencies.get(row['path'], row) for row in manifest['dependencies']]",
        "evidence = folder / context / 'evidence' / attempt": "evidence = OVERLAY / 'evidence' / context / attempt",
        "require(data['extraction_manifest_sha256'] == sha(manifest_path.read_bytes()), 'Capture binds another extraction manifest')": "require(data['extraction_manifest_sha256'] == sha(manifest_path.read_bytes()), 'Capture binds another extraction manifest')\n        require(data['post_format_overlay_sha256'] == overlay_sha and data['transform_binding_sha256'] == binding_sha, 'Post-format overlay/binding capture mismatch')"
