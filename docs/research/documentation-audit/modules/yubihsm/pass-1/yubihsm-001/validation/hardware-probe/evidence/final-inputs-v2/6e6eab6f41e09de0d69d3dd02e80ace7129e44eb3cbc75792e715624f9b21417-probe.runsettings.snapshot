<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <MaxCpuCount>1</MaxCpuCount>
    <!-- Execute each lane in its own filtered invocation. This is a last-resort
         host bound, not a cleanup mechanism or an expected device timeout. -->
    <TestSessionTimeout>120000</TestSessionTimeout>
    <ResultsDirectory>/tmp/opencode/yubihsm-001-hardware/results</ResultsDirectory>
    <TreatNoTestsAsError>true</TreatNoTestsAsError>
  </RunConfiguration>
</RunSettings>
