<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- The development NativeShims package comes from the private feed; credentials
       belong in the environment or user configuration, never in this file. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="YubicoInternal" value="https://nuget.pkg.github.com/Yubico/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="YubicoInternal">
      <package pattern="Yubico.NativeShims" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
