<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Yubico.YubiKit.Cli.Shared</RootNamespace>
    <AssemblyName>Yubico.YubiKit.Cli.Shared</AssemblyName>
    <IsPackable>false</IsPackable>

    <!-- Suppress analyzer warnings that are noisy for example/CLI apps -->
    <NoWarn>$(NoWarn);CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yubico.YubiKit.Cli.Shared.UnitTests" />
    <!-- Let OathTool's application-I/O seam use the shared selector's internal constructor. -->
    <InternalsVisibleTo Include="OathTool" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\src\Yubico.YubiKit.Core.csproj" />
    <ProjectReference Include="..\..\Management\src\Yubico.YubiKit.Management.csproj" />
  </ItemGroup>

</Project>
