<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>

    <!-- Enable Microsoft Testing Platform with xunit v3 -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <!-- Package versions come from Directory.Packages.props -->
    <!-- When using Microsoft Testing Platform, DON'T use Microsoft.NET.Test.Sdk -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- Test-only. The shipping SDK does not depend on System.Reactive; this exists purely so
         RxInteropTests can prove that a consumer who adds the package themselves still gets the
         full Rx operator surface over the SDK's IObservable<DeviceEvent>. Do not add this to any
         shipping project under src/*/src. -->
    <PackageReference Include="System.Reactive" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Yubico.YubiKit.Core.csproj"/>
    <!-- Compile the xUnit-free shared helper directly so this xUnit v3 project does not reference
         the xUnit v2-based Tests.Shared assembly or its Management dependency. -->
    <Compile Include="../../../Tests.Shared/Infrastructure/TransientScanRetry.cs"
             Link="Infrastructure/TransientScanRetry.cs" />
  </ItemGroup>

</Project>
