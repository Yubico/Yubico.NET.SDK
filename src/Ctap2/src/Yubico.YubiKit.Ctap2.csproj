<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFrameworks inherited from Directory.Build.props -->
    <RootNamespace>Yubico.YubiKit.Ctap2</RootNamespace>
    <AssemblyName>Yubico.YubiKit.Ctap2</AssemblyName>

    <!-- Package Metadata -->
    <Description>CTAP2 authenticator support for YubiKey devices including credential management, biometric authentication, and passwordless login.</Description>
    <PackageTags>yubikey;yubico;fido2;webauthn;ctap2;passwordless;biometric</PackageTags>

    <!-- Opts this published library into the shared Native AOT analyzer and metadata properties. -->
    <IsYubiKitSdkLibrary>true</IsYubiKitSdkLibrary>
  </PropertyGroup>

  <ItemGroup>
    <!-- For NSubstitute to mock internal types in tests -->
    <InternalsVisibleTo Include="Yubico.YubiKit.Ctap2.UnitTests" />
    <InternalsVisibleTo Include="Yubico.YubiKit.WebAuthn" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\src\Yubico.YubiKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="System.Formats.Cbor" />
  </ItemGroup>

</Project>
