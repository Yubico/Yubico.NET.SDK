<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFrameworks inherited from Directory.Build.props -->
    <RootNamespace>Yubico.YubiKit.Oath</RootNamespace>
    <AssemblyName>Yubico.YubiKit.Oath</AssemblyName>

    <!-- Package Metadata -->
    <Description>OATH (One-Time Password) support for YubiKey devices including TOTP and HOTP credential management and code generation.</Description>
    <PackageTags>yubikey;yubico;oath;totp;hotp;otp;2fa;mfa;authenticator</PackageTags>

    <!-- Native AOT: opts this SDK library into the shared AOT property block in
         Directory.Build.props/Directory.Build.targets. See docs/NATIVE-AOT.md for the support
         contract. -->
    <IsYubiKitSdkLibrary>true</IsYubiKitSdkLibrary>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yubico.YubiKit.Oath.UnitTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\src\Yubico.YubiKit.Core.csproj" />
  </ItemGroup>

</Project>
