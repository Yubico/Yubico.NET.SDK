<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFrameworks inherited from Directory.Build.props -->
    <RootNamespace>Yubico.YubiKit.OpenPgp</RootNamespace>
    <AssemblyName>Yubico.YubiKit.OpenPgp</AssemblyName>

    <!-- Package Metadata -->
    <Description>OpenPGP support for YubiKey devices including key management, encryption, decryption, signing, and authentication operations.</Description>
    <PackageTags>yubikey;yubico;openpgp;pgp;gpg;encryption;signing;smartcard</PackageTags>

    <!-- Native AOT: opts this SDK library into the shared AOT property block in
         Directory.Build.props/Directory.Build.targets. See docs/NATIVE-AOT.md for the support
         contract. -->
    <IsYubiKitSdkLibrary>true</IsYubiKitSdkLibrary>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\src\Yubico.YubiKit.Core.csproj" />
  </ItemGroup>

</Project>
