<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Core\src\Yubico.YubiKit.Core.csproj" />
    <ProjectReference Include="..\..\..\Management\src\Yubico.YubiKit.Management.csproj" />
    <ProjectReference Include="..\..\..\Piv\src\Yubico.YubiKit.Piv.csproj" />
    <ProjectReference Include="..\..\..\Fido2\src\Yubico.YubiKit.Fido2.csproj" />
    <ProjectReference Include="..\..\..\WebAuthn\src\Yubico.YubiKit.WebAuthn.csproj" />
    <ProjectReference Include="..\..\..\Oath\src\Yubico.YubiKit.Oath.csproj" />
    <ProjectReference Include="..\..\..\OpenPgp\src\Yubico.YubiKit.OpenPgp.csproj" />
    <ProjectReference Include="..\..\..\SecurityDomain\src\Yubico.YubiKit.SecurityDomain.csproj" />
    <ProjectReference Include="..\..\..\YubiOtp\src\Yubico.YubiKit.YubiOtp.csproj" />
    <ProjectReference Include="..\..\..\YubiHsm\src\Yubico.YubiKit.YubiHsm.csproj" />
  </ItemGroup>

  <Target Name="MarkShippingAssemblyReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_ShippingAssemblyReference Include="@(ProjectReference)">
        <SourceLine>[assembly: System.Reflection.AssemblyMetadataAttribute(&quot;PublicApiShippingAssembly&quot;, &quot;%(Filename)&quot;)]</SourceLine>
      </_ShippingAssemblyReference>
      <Compile Include="$(IntermediateOutputPath)PublicApiShippingAssemblies.g.cs" />
    </ItemGroup>
    <WriteLinesToFile
      File="$(IntermediateOutputPath)PublicApiShippingAssemblies.g.cs"
      Lines="@(_ShippingAssemblyReference->'%(SourceLine)')"
      Overwrite="true"
      WriteOnlyWhenDifferent="true" />
  </Target>
</Project>
