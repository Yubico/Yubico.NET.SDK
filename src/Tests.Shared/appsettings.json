{
  // These are real serial numbers, but they belong to dedicated team test devices only.
  // They are not sensitive and are safe to commit.
  "YubiKeyTests": {
    "AllowedSerialNumbers": [
      24070033,
      9681620,
      28293700,
      31683481,
      31683268,
      105,
      125,
      100,
      27365355,
      107,
      103,
      20260533
    ],
    // DO NOT set this to true except when testing YubiKey Security Key series devices
    // (FIDO-only editions that report no serial number). Enabling this authorizes ANY
    // connected device with an unreadable serial for destructive integration tests,
    // which can wipe a production key that happens to have serial visibility disabled.
    "AllowUnknownSerials": false
  }
}
