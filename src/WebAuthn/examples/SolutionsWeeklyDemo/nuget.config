<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="yubikit-alpha" value="https://yubico.github.io/Yubico.NET.SDK/alpha/index.json" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="yubikit-alpha">
      <package pattern="Yubico.YubiKit.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
