<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFrameworks inherited from Directory.Build.props -->
    <RootNamespace>Yubico.YubiKit.YubiHsm</RootNamespace>
    <AssemblyName>Yubico.YubiKit.YubiHsm</AssemblyName>

    <!-- Package Metadata -->
    <Description>YubiHSM support for YubiKey devices including hardware security module operations, key management, and cryptographic operations.</Description>
    <PackageTags>yubikey;yubico;yubihsm;hsm;hardware-security-module;crypto</PackageTags>

    <!-- Native AOT: opts this SDK library into the shared AOT property block in
         Directory.Build.props/Directory.Build.targets. See docs/NATIVE-AOT.md for the support
         contract. -->
    <IsYubiKitSdkLibrary>true</IsYubiKitSdkLibrary>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\src\Yubico.YubiKit.Core.csproj" />
  </ItemGroup>

</Project>
