<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TargetFrameworks inherited from Directory.Build.props -->
    <RootNamespace>Yubico.YubiKit.YubiOtp</RootNamespace>
    <AssemblyName>Yubico.YubiKit.YubiOtp</AssemblyName>

    <!-- Package Metadata -->
    <Description>YubiOTP support for YubiKey devices including Yubico OTP slot configuration, challenge-response, and static password programming.</Description>
    <PackageTags>yubikey;yubico;yubiotp;otp;challenge-response;static-password</PackageTags>

    <!-- Native AOT: opts this SDK library into the shared AOT property block in
         Directory.Build.props/Directory.Build.targets. See docs/NATIVE-AOT.md for the support
         contract. -->
    <IsYubiKitSdkLibrary>true</IsYubiKitSdkLibrary>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Core\src\Yubico.YubiKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Yubico.YubiKit.YubiOtp.UnitTests" />
  </ItemGroup>

</Project>
