<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsYubiKitSdkLibrary>false</IsYubiKitSdkLibrary>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Core/src/Yubico.YubiKit.Core.csproj" />
    <ProjectReference Include="../../src/Ctap2/src/Yubico.YubiKit.Ctap2.csproj" />
    <ProjectReference Include="../../src/Management/src/Yubico.YubiKit.Management.csproj" />
  </ItemGroup>
</Project>
