<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>14.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
    <IsYubiKitSdkLibrary>false</IsYubiKitSdkLibrary>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../scripts/toolchain/WindowsHidVerification/RequiredNativeChecks.cs" Link="RequiredNativeChecks.cs" />
    <Compile Include="../../scripts/toolchain/WindowsHidVerification/PublicationSeal.cs" Link="PublicationSeal.cs" />
    <ProjectReference Include="../../src/Core/src/Yubico.YubiKit.Core.csproj" />
  </ItemGroup>
</Project>
